融合适配：源 session-v2 调试视图在目标不存在（实验性 V2 视图未进入 v1.18.32），该段语义由
V1 主视口（routes/session）同一 invariant 承载；util/helper/四组 hunk/两测试宿主全量落位。
diff --git a/packages/tui/src/util/session-pending.ts b/packages/tui/src/util/session-pending.ts
--- a/packages/tui/src/util/session-pending.ts
+++ b/packages/tui/src/util/session-pending.ts
@@ -3,5 +3,31 @@
 export function hasStreamingAssistant(messages: Message[]) {
   return messages.some((message) => message.role === "assistant" && !message.time.completed)
 }
 
+// #458：视口裁剪判定接受宽化消息形状——V2 调试视图与 V1 主视口共用同一语义。
+type SessionViewportMessage = {
+  role?: string
+  type?: string
+  time: {
+    created: number
+    completed?: number
+  }
+}
+
+type SessionViewportState = {
+  stuckToBottom?: boolean
+}
+
+export function shouldCullSessionViewport(
+  messages: readonly SessionViewportMessage[],
+  state: SessionViewportState = {},
+) {
+  // 保持 sticky-bottom 流式热路径裁剪，但用户滚入历史时让屏外流式代码块继续测量。
+  if (!messages.some(isStreamingViewportAssistant)) return true
+  return state.stuckToBottom ?? true
+}
+
+function isStreamingViewportAssistant(message: SessionViewportMessage) {
+  return (message.role ?? message.type) === "assistant" && !message.time.completed
+}
 export function pendingAssistantIndex(messages: Message[], status: SessionStatus | undefined) {
diff --git a/packages/tui/src/routes/session/index.tsx b/packages/tui/src/routes/session/index.tsx
--- a/packages/tui/src/routes/session/index.tsx
+++ b/packages/tui/src/routes/session/index.tsx
@@ -78,5 +104,6 @@
   assistantTurnDuration,
-  hasStreamingAssistant,
   pendingAssistantIndex,
-  shouldRefreshStaleBusyStatus,
+  shouldCullSessionViewport,
+  shouldRefreshStaleBusyStatus,
+  // 裁剪判定收敛到 util：V1 主视口与 helper 单测共用同一语义；流式判定随 streamingActive 一并移交 helper。
 } from "../../util/session-pending"
@@ -271,4 +299,8 @@
   const messages = createMemo(() => sync.data.message[route.sessionID] ?? [])
-  // #135：任一 assistant 未完成则视为流式，关闭 viewport culling 避免裁剪抖动
-  const streamingActive = createMemo(() => hasStreamingAssistant(messages()))
+  // #458：culling 改由 stuck-to-bottom 状态驱动——粘底流式仍裁剪，滚入历史时不裁
+  const [viewportStuckToBottom, setViewportStuckToBottom] = createSignal(true)
+  // 粘底时流式裁剪保持渲染热路径；离底浏览历史时暂停裁剪保留测量。
+  const viewportCulling = createMemo(() =>
+    shouldCullSessionViewport(messages(), { stuckToBottom: viewportStuckToBottom() }),
+  )
   const messagesBeforeRevert = () => {
@@ -517,3 +549,11 @@
   const dialog = useDialog()
   const renderer = useRenderer()
+
+  // #458：渲染后读取 scroll 位置同步粘底信号；queueMicrotask 避免在渲染帧内写信号。
+  function syncSessionViewportStuckToBottom() {
+    if (!scroll || scroll.isDestroyed) return
+    const stuckToBottom = scroll.scrollTop >= Math.max(0, scroll.scrollHeight - scroll.viewport.height) - 1
+    if (stuckToBottom === untrack(viewportStuckToBottom)) return
+    queueMicrotask(() => setViewportStuckToBottom(stuckToBottom))
+  }
 
@@ -1397,4 +1437,5 @@
                 ref={(r) => (scroll = r)}
-                // #135：流式时禁用 viewportCulling，避免裁剪抖动
-                viewportCulling={!streamingActive()}
+                // #458：粘底流式仍裁剪；滚入历史时保留屏外块测量，renderAfter 同步粘底信号
+                viewportCulling={viewportCulling()}
+                renderAfter={syncSessionViewportStuckToBottom}
                 viewportOptions={{
diff --git a/packages/tui/test/util/session-pending.test.ts b/packages/tui/test/util/session-pending.test.ts
--- a/packages/tui/test/util/session-pending.test.ts
+++ b/packages/tui/test/util/session-pending.test.ts
@@ -8,3 +49,4 @@
   pendingAssistantIndex,
   shouldRefreshStaleBusyStatus,
+  shouldCullSessionViewport,
 } from "../../src/util/session-pending"
@@ -181,2 +223,15 @@
   })
+
+  // #458：视口裁剪三态——流式+默认粘底裁剪；流式+离底不裁；完成后恒裁
+  test("keeps session viewport culling enabled while an assistant message streams", () => {
+    expect(shouldCullSessionViewport([assistant("open")])).toBe(true)
+  })
+
+  test("pauses session viewport culling while streaming away from sticky bottom", () => {
+    expect(shouldCullSessionViewport([assistant("open")], { stuckToBottom: false })).toBe(false)
+  })
+
+  test("keeps session viewport culling enabled after the assistant message completes", () => {
+    expect(shouldCullSessionViewport([assistant("done", 2)])).toBe(true)
+  })
 })
