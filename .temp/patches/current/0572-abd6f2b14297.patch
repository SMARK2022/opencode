更新源码集成门禁以识别 active Session admission，并显式校验 Project 分支位于 workspace fallback 之前。

避免旧 Project-only 正则把已验证的跨目录 Session 修复误报为控制流回归。

适配说明：目标的该门禁已从 opencode 源码正则迁移为 tui 包纯函数合同（#164/#165 建立，#570 扩 activeSessionID 第三参）；本补丁把 source 的 active Session admission 语义边界对齐到该纯函数门禁——project 匹配优先返回、跨 Project 兑底仅由活动会话严格相等构成、undefined 显式排除。

diff --git a/packages/tui/test/cli/tui/event-single-delivery.test.ts b/packages/tui/test/cli/tui/event-single-delivery.test.ts
--- a/packages/tui/test/cli/tui/event-single-delivery.test.ts
+++ b/packages/tui/test/cli/tui/event-single-delivery.test.ts
@@ -18,5 +18,20 @@ describe("shouldDeliverScopedEvent", () => {
   test("delivers unscoped events once (no double-path)", () => {
     // #164：无 project 字段时放行一次
     expect(shouldDeliverScopedEvent({ directory: "/workspace" }, "proj-a")).toBe(true)
   })
+
+  // #572：对齐 #570 的 active Session admission 合同——project 分支是唯一跨 Project 兑底位置
+  test("admits mismatched-project events only through the active session branch", () => {
+    // global 事件不受 Project 或活动会话冲突限制，不能落入后面的隔离分支。
+    expect(shouldDeliverScopedEvent({ directory: "global", project: "proj-b", sessionID: "sess-2" }, "proj-a", "sess-1")).toBe(true)
+    // #572：project 不匹配时唯一放行路径是活动会话 ID 与事件 sessionID 严格相等
+    expect(shouldDeliverScopedEvent({ directory: "/x", project: "proj-b", sessionID: "sess-1" }, "proj-a", "sess-1")).toBe(true)
+    // #572：sessionID 不匹配或缺失时保持 Project 隔离，不因活动会话存在而放宽
+    expect(shouldDeliverScopedEvent({ directory: "/x", project: "proj-b", sessionID: "sess-2" }, "proj-a", "sess-1")).toBe(false)
+    expect(shouldDeliverScopedEvent({ directory: "/x", project: "proj-b" }, "proj-a", "sess-1")).toBe(false)
+    // #572：无活动会话时跨 Project 兑底必须关闭，防止 undefined === undefined 意外放行
+    expect(shouldDeliverScopedEvent({ directory: "/x", project: "proj-b", sessionID: "sess-1" }, "proj-a")).toBe(false)
+    // #572：project 匹配的返回先于 Session 判定，保持 #165 的 Project 分支优先级
+    expect(shouldDeliverScopedEvent({ directory: "/x", project: "proj-a", sessionID: "sess-2" }, "proj-a", "sess-1")).toBe(true)
+  })
 })
