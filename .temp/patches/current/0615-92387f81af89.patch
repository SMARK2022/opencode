From 92387f81af8914fe65fee41d5cd5e617d25262be Mon Sep 17 00:00:00 2001
From: SMARK <3222301373@qq.com>
Date: Fri, 11 Sep 2026 04:05:16 +0800
Subject: [PATCH] =?UTF-8?q?fix(ci):=20=E7=A7=BB=E9=99=A4=20opentui-source-?=
 =?UTF-8?q?revision=20=E5=86=97=E4=BD=99=E6=B8=85=E5=8D=95=EF=BC=8Cclosure?=
 =?UTF-8?q?=20=E9=AA=8C=E8=AF=81=E6=94=B9=E4=BB=8E=20package.json+git=20?=
 =?UTF-8?q?=E6=B4=BE=E7=94=9F?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

opentui-source-revision.json 是手写的第二信源（sourceGitlink/releaseTag/releaseCommit），
三个值全部可从 root package.json catalog（版本→tag）+ git（gitlink + ls-remote 远端 tag）
派生。它无生成脚本、每次 release 需手工同步，0.4.3-smark.12 版本 bump 漏改它导致 consumer
gate 误判失败（invalid source revision manifest）。

现移除该清单，verify-opentui-closure 始终走派生路径（verifyRemoteAnnotatedTagCommit 校验
gitlink==远端 tag commit 的 provenance 一致性，语义不变），test.yml 去掉
--source-revision-authorized。随删不再被引用的 verifySourceRevisionAuthorization 与其测试。

适配说明：目标的清单有实际build消费者，按source原意在现有CI闭包与构建证据owner改为catalog派生、checkout内读取父仓索引gitlink后删除清单；Nix归档源码不带Git元数据，不伪造commit身份。保留declaredSource和完整安装/native/executable证据；不存在的独立closure脚本/flag不恢复，派生声明不冒充远端授权，consumer CI保持原步骤。

diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -194,7 +194,8 @@ jobs:
   opentui-required:
     # #489：consumer 回归与 typecheck 必须同一 job 执行，避免不同安装图互相掩盖 peer 漂移。
-    # 目标谱系以 registry 0.4.5 承载 OpenTUI，无 smark.1 closure 校验面，测试直接钉住用户可见 seam。
     # 版本名不写死：gate 钉住的是 user-visible seam 行为，OpenTUI 版本由 catalog 决策单独管理。
+    # 构建声明从root catalog派生，checkout另采索引gitlink；不再维护随版本过期的手写清单。
+    # 声明、实际安装及远端tag授权是不同证据；consumer回归不能互相冒充这些事实。
     name: 必过 OpenTUI consumer gate
     runs-on: ubuntu-latest
     timeout-minutes: 45
diff --git a/packages/opencode/script/build.ts b/packages/opencode/script/build.ts
--- a/packages/opencode/script/build.ts
+++ b/packages/opencode/script/build.ts
@@ -191,4 +191,4 @@
-  const declared = await Bun.file(new URL("./opentui-source-revision.json", import.meta.url)).json()
-  // index身份是已选源码，声明不能用任意clean目录自证；发布commit另由远端annotated tag证明。
+  // 源码身份取父仓索引，版本及发布tag只取root catalog，不再读取手写清单。
+  // 完整annotated/peeled远端证据仍独立核对，声明不能冒充授权。
   const gitlink = (await $`git ls-files --stage -- thirdparty/opentui`.cwd(root).quiet().text()).trim().split(/\s+/)[1]
-  if (declared.schema !== 1 || declared.releaseTag !== tag || !/^[0-9a-f]{40}$/.test(declared.sourceGitlink) || !/^[0-9a-f]{40}$/.test(declared.releaseCommit) || gitlink !== declared.sourceGitlink) throw new Error("invalid OpenTUI source revision authorization")
+  if (!gitlink || !/^[0-9a-f]{40}$/.test(gitlink)) throw new Error("thirdparty/opentui gitlink is missing or invalid")
@@ -202,1 +202,1 @@
-  if (!refs.has(ref) || refs.get(`${ref}^{}`) !== declared.releaseCommit) throw new Error(`OpenTUI ${tag} is not annotated at the authorized release commit`)
+  if (!refs.has(ref) || refs.get(`${ref}^{}`) !== gitlink) throw new Error(`OpenTUI ${tag} is not annotated at gitlink ${gitlink}`)
@@ -221,4 +221,13 @@
-  // 声明的源码身份与实际包/产物证据分开记录，不以 gitlink 代替安装或远端 tag 授权验证。
-  const declaredSource = await Bun.file(new URL("./opentui-source-revision.json", import.meta.url)).json()
+  // 声明从root catalog与父仓索引派生，消除随版本手工同步的第二信源。
+  const root = path.resolve(dir, "../..")
+  const version = (await Bun.file(path.join(root, "package.json")).json()).workspaces.catalog["@opentui/core"]
+  // Nix源码归档不携带.git：缺席的源码身份不作声明，安装与产物证据仍照常验证。
+  const hasGit = fs.existsSync(path.join(root, ".git"))
+  const sourceGitlink = hasGit
+    ? (await $`git ls-files --stage -- thirdparty/opentui`.cwd(root).text()).trim().split(/\s+/)[1]
+    : undefined
+  if (hasGit && !sourceGitlink) throw new Error("thirdparty/opentui gitlink is missing")
+  // 同形releaseCommit仍是声明，不替代下方安装/native证据或远端tag授权验证。
+  const declaredSource = { schema: 1, sourceGitlink, releaseTag: `v${version}`, releaseCommit: sourceGitlink }
   // target 名、manifest 约束和 native 文件必须同时一致；只记录解析到的包名会掩盖 Bun 选错 ABI 的情况。
   if (
diff --git a/packages/opencode/script/opentui-source-revision.json b/packages/opencode/script/opentui-source-revision.json
deleted file mode 100644
--- a/packages/opencode/script/opentui-source-revision.json
+++ /dev/null
@@ -1,6 +0,0 @@
-{
-  "schema": 1,
-  "sourceGitlink": "0f64a76eb3f09fe5e12dfb55f2f1575d5b9ca3a2",
-  "releaseTag": "v0.4.3-smark.11",
-  "releaseCommit": "0f64a76eb3f09fe5e12dfb55f2f1575d5b9ca3a2"
-}
