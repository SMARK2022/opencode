+    expect(bash(String.raw`Move-Item -LiteralPath "H:\\DumpStack.log.tmp" -Destination "$env:TEMP\\DumpStack.to_delete" -Force -ErrorAction Stop`)).toMatchObject({ level: "cautious" })
