
diff --git a/packages/tui/test/routes/session/session-layout.test.ts b/packages/tui/test/routes/session/session-layout.test.ts
--- a/packages/tui/test/routes/session/session-layout.test.ts
+++ b/packages/tui/test/routes/session/session-layout.test.ts
@@ -148,3 +148,33 @@ async function renderTextareaFrame(opts: { width: number; height: number; conten
     setup.renderer.destroy()
   }
 }
+
+
+// [local-smark] reasoning 布局回归：目标 TUI 中 text 与 reasoning 预览共用
+// 同一条 messageContentWidth 管线（session/index.tsx 单一 memo），不存在两套
+// 宽度公式。锁定该管线与 ReasoningPart 同模块定义，防止日后拆分出独立
+// reasoning 宽度公式导致两套布局漂移
+describe("reasoning layout shares message width pipeline (#0414)", () => {
+  test("session index routes content width through a single messageContentWidth memo", async () => {
+    const { readFileSync } = await import("fs")
+    const path = await import("path")
+    const sessionSource = readFileSync(
+      path.resolve(import.meta.dir, "../../../src/routes/session/index.tsx"),
+      "utf-8",
+    )
+    // 单一宽度 memo：所有 part（text/reasoning/tool）共用同一可读宽计算
+    expect(sessionSource).toContain("const messageContentWidth = createMemo(() =>")
+    expect(sessionSource).toContain("sessionMessageContentWidth({")
+    // reasoning 渲染与宽度消费在同一模块，未引入独立 reasoning 宽度公式
+    expect(sessionSource).toContain("function ReasoningPart(")
+    expect(sessionSource).not.toMatch(/reasoning[A-Za-z]*Width\s*=/)
+    // [local-smark] 数据流闭环：ReasoningPart 必须经 ctx.width 消费共享 memo，
+    // 而 context 的 width getter 必须来自 messageContentWidth——内联独立公式
+    //（如 width: msgWidth - 1）或 chrome 偏移漂移会被以下两条捕获
+    const reasoningBody = sessionSource.slice(sessionSource.indexOf("function ReasoningPart("))
+    expect(reasoningBody.slice(0, reasoningBody.indexOf("\n}"))).toContain("ctx.width")
+    const providerAt = sessionSource.indexOf("get width()")
+    expect(providerAt).toBeGreaterThan(-1)
+    expect(sessionSource.slice(providerAt, providerAt + 120)).toContain("messageContentWidth()")
+  })
+})
