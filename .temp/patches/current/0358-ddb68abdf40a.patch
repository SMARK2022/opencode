Subject: [PATCH] =?UTF-8?q?fix(provider):=20=E6=95=B4=E8=AF=B7=E6=B1=82?=
 =?UTF-8?q?=E8=B6=85=E6=97=B6=E9=BB=98=E8=AE=A4=205=E2=86=9210=20=E5=88=86?=
 =?UTF-8?q?=E9=92=9F=20+=20chunk=20=E7=A9=BA=E9=97=B2=E8=B6=85=E6=97=B6?=
 =?UTF-8?q?=E9=BB=98=E8=AE=A4=203=20=E5=88=86=E9=92=9F?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

整请求绝对超时 DEFAULT_TIMEOUT_MS 从 300_000 放宽到 600_000,避免长输出被
5 分钟硬死线截断。该超时经 message-v2 transportError 归类为可重试,此前会触发
5 分钟超时→重试→再超时的循环;放宽后需要 ≤10 分钟的生成可单次完成。

chunkTimeout 未配置时由"不启用"改为回退 DEFAULT_CHUNK_TIMEOUT_MS=180_000,对所有
SSE 响应统一施加空闲保护。wrapSSE 仅对真正挂起(3 分钟无任何字节)的连接生效,
心跳/注释字节会重置计时器,活跃流式不受影响;显式配置值仍优先于默认。chunkAbortCtl
改为无条件创建并删除原跳过分支,wrapSSE 内部守卫对非 SSE/空 body 响应原样透传。
diff --git a/packages/core/src/v1/config/provider.ts b/packages/core/src/v1/config/provider.ts
index 9d3e1b397..b48526fdd 100644
--- a/packages/core/src/v1/config/provider.ts
+++ b/packages/core/src/v1/config/provider.ts
@@ -110,10 +110,10 @@ export const Info = Schema.Struct({
         }),
         timeout: Schema.optional(
           Schema.Union([PositiveInt, Schema.Literal(false)]).annotate({
-            description: "Timeout in milliseconds for full requests to this provider. Set to false to disable timeout.",
+            description: "Timeout in milliseconds for full requests to this provider. Default is 600000 (10 minutes). Set to false to disable timeout.",
           }),
         ).annotate({
-          description: "Timeout in milliseconds for full requests to this provider. Set to false to disable timeout.",
+          description: "Timeout in milliseconds for full requests to this provider. Default is 600000 (10 minutes). Set to false to disable timeout.",
         }),
         headerTimeout: Schema.optional(
           Schema.Union([PositiveInt, Schema.Literal(false)]).annotate({
@@ -126,7 +126,7 @@ export const Info = Schema.Struct({
         }),
         chunkTimeout: Schema.optional(PositiveInt).annotate({
           description:
-            "Timeout in milliseconds between streamed SSE chunks for this provider. If no chunk arrives within this window, the request is aborted.",
+            "Timeout in milliseconds between streamed SSE chunks for this provider. Default is 180000 (3 minutes). If no chunk arrives within this window, the request is aborted.",
         }),
       }),
       [Schema.Record(Schema.String, Schema.Any)],
diff --git a/packages/opencode/src/provider/provider.ts b/packages/opencode/src/provider/provider.ts
index 8d6e422e2..0d1cd91bd 100644
--- a/packages/opencode/src/provider/provider.ts
+++ b/packages/opencode/src/provider/provider.ts
@@ -35,8 +35,12 @@ import { RuntimeFlags } from "@/effect/runtime-flags"
 import { ProviderError } from "./error"
 
 const OPENAI_HEADER_TIMEOUT_DEFAULT = 10_000
-// 请求默认超时 5 分钟：覆盖无显式 timeout 的 provider 请求
-const DEFAULT_TIMEOUT_MS = 300_000
+// 整请求绝对超时:从 fetch 发起计时的硬死线,到点即中断(即使仍在持续来 chunk)。
+// 默认 10 分钟;其触发的 AbortSignal.timeout 错误在 message-v2 transportError 中归类为可重试。
+const DEFAULT_TIMEOUT_MS = 600_000
+// chunk 空闲超时:两个 SSE body 字节之间无数据达此时长才中止(心跳/注释字节会重置计时器)。
+// 默认 3 分钟,仅对真正挂起的连接生效;触发的 SSE_READ_TIMEOUT 同样可重试。
+const DEFAULT_CHUNK_TIMEOUT_MS = 180_000
 // #240：测试可访问的 fetch timing 捕获——供 llm.test.ts 验证 phase 序列和 payload 安全
 export const _testFetchTimingLog: Array<Record<string, unknown>> = []
 // #240：provider fetch timing 诊断——模块级回调，从 layer 的 bridge.fork 设置
@@ -2045,13 +2049,17 @@ for (const [id, provider] of configProviders) {
 
         options["fetch"] = async (input: any, init?: BunFetchRequestInit) => {
           const opts = init ?? {}
-          const chunkAbortCtl = typeof chunkTimeout === "number" && chunkTimeout > 0 ? new AbortController() : undefined
+          // chunkTimeout 未配置时回退到默认空闲超时;显式正值优先,保持用户可覆盖
+          const chunkTimeoutMs =
+            typeof chunkTimeout === "number" && chunkTimeout > 0 ? chunkTimeout : DEFAULT_CHUNK_TIMEOUT_MS
+          // 始终创建控制器:默认 chunk 超时启用 wrapSSE,对所有 SSE 响应统一施加空闲保护
+          const chunkAbortCtl = new AbortController()
           const headerTimeoutMs = headerTimeout === false ? undefined : headerTimeout
           const headerTimeoutCtl = typeof headerTimeoutMs === "number" ? timeoutController(headerTimeoutMs) : undefined
           const signals: AbortSignal[] = []
 
           if (opts.signal) signals.push(opts.signal)
-          if (chunkAbortCtl) signals.push(chunkAbortCtl.signal)
+          signals.push(chunkAbortCtl.signal)
           if (headerTimeoutCtl) signals.push(headerTimeoutCtl.signal)
           if (options["timeout"] !== false)
             signals.push(AbortSignal.timeout(typeof options["timeout"] === "number" ? options["timeout"] : DEFAULT_TIMEOUT_MS))
@@ -2079,10 +2087,11 @@ for (const [id, provider] of configProviders) {
           // #83：customFetch 仅鉴权透传；默认走 NetworkProxy.fetch 主路由
           // #83：provider 请求 purpose=provider，区别于基础设施和 npm
           // #240：fetch.start 只记录 method/timeout/bodyBytes——不含 body/auth/prompt
+          // 复用已解析的回退值,使诊断日志反映真实生效的空闲超时(显式值或默认 3 分钟)
           timing(timingInput, "fetch.start", {
             method: opts.method,
             timeoutMs: typeof options["timeout"] === "number" ? options["timeout"] : DEFAULT_TIMEOUT_MS,
-            chunkTimeoutMs: typeof chunkTimeout === "number" && chunkTimeout > 0 ? chunkTimeout : undefined,
+            chunkTimeoutMs,
             bodyBytes: bodyBytes(opts.body),
           })
           const res = await (
@@ -2112,8 +2121,8 @@ for (const [id, provider] of configProviders) {
             isSSE: contentType?.includes("text/event-stream") ?? false,
           })
 
-          if (!chunkAbortCtl) return res
-          return wrapSSE(res, chunkTimeout, chunkAbortCtl, timingInput)
+          // chunkAbortCtl 始终存在;wrapSSE 内部对非 event-stream / 空 body 响应会原样透传
+          return wrapSSE(res, chunkTimeoutMs, chunkAbortCtl, timingInput)
         }
 
         const bundledLoader = BUNDLED_PROVIDERS[model.api.npm]
diff --git a/packages/opencode/test/session/llm.test.ts b/packages/opencode/test/session/llm.test.ts
index 5d1439ba0..30e1ce046 100644
--- a/packages/opencode/test/session/llm.test.ts
+++ b/packages/opencode/test/session/llm.test.ts
@@ -932,6 +932,84 @@ describe("session.llm.stream", () => {
     },
   )
 
+  // [local-smark] 行为级验证：用户未配置 timeout / chunkTimeout 时，provider 必须回退到默认值——
+  // 整请求绝对超时 600000ms（10 分钟）、chunk 空闲超时 180000ms（3 分钟）。
+  // 通过 fetch.start 诊断事件里的 timeoutMs / chunkTimeoutMs 字段断言默认值，无需真正等待超时；
+  // 同时断言 sse.end 出现，证明默认 chunk 超时已启用 wrapSSE（此前未配置时不启用）。
+  it.instance(
+    "applies default overall and chunk timeouts when neither is configured",
+    () =>
+      Effect.gen(function* () {
+        _testFetchTimingLog.length = 0
+        const request = waitRequest(
+          "/chat/completions",
+          new Response(createChatStream("Hello"), {
+            status: 200,
+            headers: { "Content-Type": "text/event-stream" },
+          }),
+        )
+
+        const resolved = yield* Provider.use.getModel(
+          ProviderV2.ID.make("default-timeout-openai-compatible"),
+          ModelV2.ID.make("gpt-test"),
+        )
+        const sessionID = SessionID.make("session-provider-default-timeout")
+        const agent = {
+          name: "test",
+          mode: "primary",
+          options: {},
+          permission: [{ permission: "*", pattern: "*", action: "allow" }],
+        } satisfies Agent.Info
+        const user = {
+          id: MessageID.make("msg_user-provider-default-timeout"),
+          sessionID,
+          role: "user",
+          time: { created: Date.now() },
+          agent: agent.name,
+          model: { providerID: ProviderV2.ID.make("default-timeout-openai-compatible"), modelID: resolved.id },
+        } satisfies SessionV1.User
+
+        yield* drain({
+          user,
+          sessionID,
+          model: resolved,
+          agent,
+          system: ["You are a helpful assistant."],
+          messages: [{ role: "user", content: "Hello" }],
+          tools: {},
+        })
+
+        yield* Effect.promise(() => request)
+        // 默认 chunk 超时启用 wrapSSE，故完整 SSE 里程碑都会出现
+        const phases = _testFetchTimingLog.map((event) => event.phase)
+        expect(phases).toEqual(["fetch.start", "fetch.response", "sse.first_chunk", "sse.end"])
+        // 默认整请求绝对超时 10 分钟（从请求发起计时的硬死线）
+        expect(_testFetchTimingLog.find((event) => event.phase === "fetch.start")?.timeoutMs).toBe(600_000)
+        // 默认 chunk 空闲超时 3 分钟（两个 SSE 字节之间无数据才触发）
+        expect(_testFetchTimingLog.find((event) => event.phase === "fetch.start")?.chunkTimeoutMs).toBe(180_000)
+      }),
+    {
+      // 故意不设置 timeout / chunkTimeout，触发默认回退路径
+      config: () => ({
+        enabled_providers: ["default-timeout-openai-compatible"],
+        provider: {
+          "default-timeout-openai-compatible": {
+            npm: "@ai-sdk/openai-compatible",
+            name: "Default Timeout Provider",
+            options: { apiKey: "test-key", baseURL: `${state.server!.url.origin}/v1` },
+            models: {
+              "gpt-test": {
+                name: "GPT Test",
+                limit: { context: 400000, input: 272000, output: 128000 },
+                modalities: { input: ["text"], output: ["text"] },
+              },
+            },
+          },
+        },
+      }),
+    },
+  )
+
   // #240：验证 SSE timeout 诊断——直接测试 wrapSSE，绕过 drain/Effect runtime
   // #240：source 用 drain + Log.file() 轮询；目标用 wrapSSE 直调 + _testFetchTimingLog
   test("logs SSE timeout when a streaming response stalls after the first raw chunk", async () => {
