From 77ec24d3c406f9fe24a22c591a1ba54bdecbeed2 Mon Sep 17 00:00:00 2001
From: SMARK <3222301373@qq.com>
Date: Thu, 14 May 2026 19:42:34 +0800
Subject: [PATCH] chore: update package.json to add overrides for @opentui/core
 and @opentui/solid


diff --git a/package.json b/package.json
index 3c36b2255a..7430f2d9f8 100644
--- a/package.json
+++ b/package.json
@@ -135,9 +135,14 @@
     "electron"
   ],
   "overrides": {
+    // #146：OpenTUI 运行时必须经 catalog 钉死，禁止嵌套依赖漂移
     "@opentui/core": "catalog:",
+    // #146：keymap 与 core 同批 catalog（tip 更强覆盖，保留）
     "@opentui/keymap": "catalog:",
+    // #146：solid 与 core 同批 catalog，保证 TUI 渲染栈版本一致
     "@opentui/solid": "catalog:",
+    // #146：spinner 同步 catalog，避免与 core 版本分叉
+    "opentui-spinner": "catalog:",
     "@types/bun": "catalog:",
     "@types/node": "catalog:",
     // #102：钉死 poe-oauth 0.0.6，避免 * 解析到不兼容次版本
