@@ -14,6 +14,13 @@
   type ContextUsageData,
   type GridSquare,
 } from "../../util/context-usage"
+
+// #157：JSON 往返强制读取嵌套 Solid store（如 part.state.raw），浅拷贝数组不够
+// #157：TSX 下泛型用尾逗号，避免 <T> 被解析为 JSX
+export function contextUsageSnapshot<T,>(value: T): T {
+  return JSON.parse(JSON.stringify(value)) as T
+}
+
 
 // 格式化 token 数为人类可读的 k/m 简写
 function formatTokens(tokens: number) {
@@ -259,10 +266,12 @@
 
   // 收集计算输入：消息、部件、提供者、配置、代理、模型、VCS、路径、终端宽度
   const inputRaw = createMemo(() => {
-    // 展开拷贝消息数组：避免直接引用 sync 内部状态，防止后续 mutation 影响响应式追踪
-    const messages = [...(sync.data.message[props.sessionID] ?? [])]
-    // 按 messageID 分组部件列表
-    const parts = Object.fromEntries(messages.map((msg) => [msg.id, [...(sync.data.part[msg.id] ?? [])]]))
+    // #157：messages/parts 都 deep snapshot，嵌套 raw 增量才能触发 memo
+    const messages = contextUsageSnapshot([...(sync.data.message[props.sessionID] ?? [])])
+    // #157：parts 同样 deep-read，否则 state.raw 增长不重算
+    const parts = Object.fromEntries(
+      messages.map((msg) => [msg.id, contextUsageSnapshot([...(sync.data.part[msg.id] ?? [])])]),
+    )
     const paths = project.instance.path()
     return {
       messages,
diff --git a/packages/tui/test/context-usage.test.ts b/packages/tui/test/context-usage.test.ts
index 1111111111..2222222222 100644
--- a/packages/tui/test/context-usage.test.ts
+++ b/packages/tui/test/context-usage.test.ts
@@ -1,3 +1,6 @@
+import { contextUsageSnapshot } from "../src/routes/session/context-usage"
+import { createMemo, createRoot } from "solid-js"
+import { createStore } from "solid-js/store"
 import { describe, expect, test } from "bun:test"
 import type { Message, Part, Provider } from "@opencode-ai/sdk/v2"
 import { computeContextData, filterCompactedMessages } from "../src/util/context-usage"
@@ -503,3 +506,32 @@
     expect(part.inputBreakdown.messages.attachments).toBe(20)
   })
 })
+
+
+// #157：验证嵌套 raw 流式增量触发 memo（runs=2）
+test("snapshot tracks streaming tool input deltas", () => {
+  createRoot((dispose) => {
+    const [store, setStore] = createStore({
+      parts: [
+        {
+          id: "p1",
+          type: "tool",
+          state: { status: "pending", raw: "" },
+        },
+      ] as any[],
+    })
+    let runs = 0
+    const memo = createMemo(() => {
+      runs++
+      // #157：deep snapshot 读取嵌套 raw
+      return contextUsageSnapshot(store.parts)
+    })
+    expect(memo()[0].state.raw).toBe("")
+    expect(runs).toBe(1)
+    setStore("parts", 0, "state", "raw", '{"filePath"')
+    const snap = memo()
+    expect(snap[0].state.raw).toContain('{"filePath"')
+    expect(runs).toBe(2)
+    dispose()
+  })
+})
