diff --git a/packages/tui/src/context/sync.tsx b/packages/tui/src/context/sync.tsx
index 1111111111..2222222222 100644
--- a/packages/tui/src/context/sync.tsx
+++ b/packages/tui/src/context/sync.tsx
@@ -454,6 +454,17 @@
             event.properties.messageID,
             produce((draft) => {
               const part = draft[result.index]
+              // #157：pending tool 的 raw 在 state 下，不能走顶层 part[field]
+              if (
+                part.type === "tool" &&
+                part.state?.status === "pending" &&
+                event.properties.field === "raw"
+              ) {
+                // #157：与 processor tool-input-delta field:"raw" 对齐
+                const state = part.state as { raw?: string }
+                state.raw = (state.raw ?? "") + event.properties.delta
+                return
+              }
               const field = event.properties.field as keyof typeof part
               const existing = part[field] as string | undefined
               ;(part[field] as string) = (existing ?? "") + event.properties.delta
diff --git a/packages/tui/src/routes/session/context-usage.tsx b/packages/tui/src/routes/session/context-usage.tsx
index 1111111111..2222222222 100644
--- a/packages/tui/src/routes/session/context-usage.tsx
