diff --git a/packages/core/src/database/migration/20260723100000_normalize_global_session_path.ts b/packages/core/src/database/migration/20260723100000_normalize_global_session_path.ts
new file mode 100644
index 0000000000..cffe17793f
--- /dev/null
+++ b/packages/core/src/database/migration/20260723100000_normalize_global_session_path.ts
@@ -0,0 +1,18 @@
+import { Effect } from "effect"
+import type { DatabaseMigration } from "../migration"
+
+// #132：Windows 全局 session.path 补全盘符
+export default {
+  id: "20260723100000_normalize_global_session_path",
+  up(tx) {
+    return Effect.gen(function* () {
+      yield* tx.run(`UPDATE \`session\`
+SET \`path\` = replace(\`directory\`, '\\', '/')
+WHERE \`project_id\` = 'global'
+  AND \`path\` IS NOT NULL
+  AND substr(\`path\`, 2, 2) != ':/'
+  AND substr(replace(\`directory\`, '\\', '/'), 2, 2) = ':/'
+  AND substr(replace(\`directory\`, '\\', '/'), 4) = \`path\`;`)
+    })
+  },
+} satisfies DatabaseMigration.Migration
