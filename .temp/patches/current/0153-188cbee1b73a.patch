diff --git a/packages/opencode/test/effect/runner.test.ts b/packages/opencode/test/effect/runner.test.ts
index 1111111111..2222222222 100644
--- a/packages/opencode/test/effect/runner.test.ts
+++ b/packages/opencode/test/effect/runner.test.ts
@@ -138,6 +138,35 @@
 
       const exit = yield* Fiber.await(fiber)
       expect(Exit.isFailure(exit)).toBe(true)
+    }),
+  )
+
+  // #153：idle-first cancel — onIdle 必须在 finalizer 完成前触发
+  it.live(
+    "onIdle fires before interrupted run finalizers finish",
+    Effect.gen(function* () {
+      const s = yield* Scope.Scope
+      const idle = yield* Deferred.make<void>()
+      const release = yield* Deferred.make<void>()
+      // #153：onIdle 与 ensure 的 finalizer 竞序是本用例不变量
+      const runner = Runner.make<string>(s, {
+        onIdle: Deferred.succeed(idle, undefined).pipe(Effect.asVoid),
+      })
+
+      const run = yield* runner
+        .ensureRunning(Effect.never.pipe(Effect.ensuring(Deferred.await(release)), Effect.as("x")))
+        .pipe(Effect.forkChild)
+      yield* Effect.sleep("10 millis")
+
+      const cancel = yield* runner.cancel.pipe(Effect.forkChild)
+      // #153：250ms 内 idle 必须成功，证明 idle 不在 finalizer 之后
+      const idleExit = yield* Deferred.await(idle).pipe(Effect.timeout("250 millis"), Effect.exit)
+      expect(Exit.isSuccess(idleExit)).toBe(true)
+      expect(runner.busy).toBe(false)
+
+      yield* Deferred.succeed(release, undefined)
+      yield* Fiber.await(cancel)
+      yield* Fiber.await(run)
     }),
   )
 
