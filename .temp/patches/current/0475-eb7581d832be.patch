适配：目标两用例的 run/execute 调用已无 description 参数——重锚至 L284/L438 并剔除
description 上下文行，断言与载荷注释保留源文本。cmd.exe 路径 `;` 非分隔符时整串作为
echo 输出、toContain 仍通过（竞态本为 macOS 特有，sleep 在 cmd 不生效但无害）。
diff --git a/packages/opencode/test/tool/shell.test.ts b/packages/opencode/test/tool/shell.test.ts
--- a/packages/opencode/test/tool/shell.test.ts
+++ b/packages/opencode/test/tool/shell.test.ts
@@ -282,5 +282,8 @@
       Effect.gen(function* () {
         const result = yield* run({
-          command: "echo test",
+          // sleep 0.01 防止 macOS CI 上 echo builtin 退出过快导致 stdout 管道竞态：
+          // detached:true 创建新进程组时，Effect stream consumer 可能尚未订阅 proc.stdout，
+          // echo 已写入并退出，数据丢失。sleep 让 shell 存活足够久让 stream 订阅完成。
+          command: "echo test; sleep 0.01",
         })
         expect(result.metadata.exit).toBe(0)
diff --git a/packages/opencode/test/tool/shell.test.ts b/packages/opencode/test/tool/shell.test.ts
--- a/packages/opencode/test/tool/shell.test.ts
+++ b/packages/opencode/test/tool/shell.test.ts
@@ -438,5 +441,6 @@
           const result = yield* bash.execute(
             {
-              command: "echo fallback",
+              // sleep 0.01 防止 macOS CI 上 echo builtin 退出过快导致 stdout 管道竞态
+              command: "echo fallback; sleep 0.01",
             },
             ctx,
