GitHub Actions 默认 display_title 不再自动回退到 commit 消息，
导致 UI 只显示 workflow name 而非 commit message。
为三个 workflow 显式设置 run-name 为 head_commit.message，
非 push 事件（workflow_dispatch / pull_request）回退到 workflow name。

diff --git a/.github/workflows/build-opencode.yml b/.github/workflows/build-opencode.yml
index 366ea0f68e8cbad5da386adfba44b1d7f225aa18..adb0ec8c95b243b1cfa3c31028a09ecc90006320 100644
--- a/.github/workflows/build-opencode.yml
+++ b/.github/workflows/build-opencode.yml
@@ -1,4 +1,6 @@
 name: Build OpenCode CLI
+# 显式设置 run-name 为 commit 消息；GitHub Actions 默认 display_title 不再自动回退到 commit 消息
+run-name: ${{ github.event.head_commit.message || github.workflow }}
 
 on:
   workflow_dispatch:
diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
index 37e9521cf77934a8df481bbcda5c6c24aff1dd82..2c753cbf5c3bedf64afec3f0316e04ff3274ed7e 100644
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -1,4 +1,6 @@
 name: test
+# 显式设置 run-name 为 commit 消息；GitHub Actions 默认 display_title 不再自动回退到 commit 消息
+run-name: ${{ github.event.head_commit.message || github.workflow }}
 
 on:
   push:
diff --git a/.github/workflows/typecheck.yml b/.github/workflows/typecheck.yml
index b4bbe1ddd61d6b69af9f0364de6c4e84212f26e4..f11b45c3a39c0baf87281caa8b24a3f10931e65e 100644
--- a/.github/workflows/typecheck.yml
+++ b/.github/workflows/typecheck.yml
@@ -1,4 +1,6 @@
 name: typecheck
+# 显式设置 run-name 为 commit 消息；GitHub Actions 默认 display_title 不再自动回退到 commit 消息
+run-name: ${{ github.event.head_commit.message || github.workflow }}
 
 on:
   push:
