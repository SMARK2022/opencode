@@ -188,6 +188,32 @@ function isOrphanedInterruptedTool(part: SessionV1.ToolPart) {
   return part.state.status === "error" && part.state.metadata?.interrupted === true
 }
 
+
+// #173：无 active runner 时 cancel 仍须终态化 open tool，避免永久 pending
+function interruptedToolState(
+  state: SessionV1.ToolStatePending | SessionV1.ToolStateRunning,
+  now: number,
+): SessionV1.ToolStateError {
+  // #173：running 保留 start；pending 用 now 作 start
+  // #173：error 文案与 processor 中断路径对齐
+  return {
+    status: "error",
+    input: state.input,
+    error: "Tool execution aborted",
+    // #173：interrupted 标记供 UI/用量识别非模型失败
+    metadata: state.status === "running" ? { ...state.metadata, interrupted: true } : { interrupted: true },
+    time: { start: state.status === "running" ? state.time.start : now, end: now },
+  }
+}
+
+// #173：仅 pending/running 需要终态化
+type OpenToolPart = SessionV1.ToolPart & { state: SessionV1.ToolStatePending | SessionV1.ToolStateRunning }
+
+function isOpenToolPart(part: SessionV1.Part): part is OpenToolPart {
+  // #173：type guard 收窄，避免误写 completed/error
+  return part.type === "tool" && (part.state.status === "pending" || part.state.status === "running")
+}
+
 export interface Interface {
   readonly cancel: (sessionID: SessionID) => Effect.Effect<void>
   readonly prompt: (input: PromptInput) => Effect.Effect<SessionV1.WithParts, Image.Error>
@@ -228,6 +254,8 @@ const layer = Layer.effect(
     const llm = yield* LLM.Service
     const events = yield* EventV2Bridge.Service
     const flags = yield* RuntimeFlags.Service
+    // #173：同 session 并发 cancel 串行，避免双写终态竞态
+    const cancelLocks = new Map<SessionID, Semaphore.Semaphore>()
     const database = yield* Database.Service
     const { db } = database
     const ops = Effect.fn("SessionPrompt.ops")(function* () {
@@ -239,12 +267,24 @@ const layer = Layer.effect(
     })
 
     const cancel = Effect.fn("SessionPrompt.cancel")(function* (sessionID: SessionID) {
-      yield* Effect.logInfo("cancel", { "session.id": sessionID })
-      yield* state.cancel(sessionID)
-      // 中止待处理的 assistant 消息：标记 AbortedError 并完成 pending/running 工具部件
-      // Effect.ignore 确保 cancel 不会因子消息中止失败而失败
-      // #71/#153：cancel 时中止未完成 assistant
-      yield* abortPendingAssistants(sessionID).pipe(Effect.ignore)
+      // #173：每 session 一把信号量，合并并发 cancel
+      let lock = cancelLocks.get(sessionID)
+      if (!lock) {
+        // #173：lazy 创建，空闲 session 不占信号量
+        lock = Semaphore.makeUnsafe(1)
+        cancelLocks.set(sessionID, lock)
+      }
+      // #173：排队后续 cancel，不丢弃第二次请求
+      yield* lock.withPermits(1)(
+        Effect.gen(function* () {
+          yield* Effect.logInfo("cancel", { "session.id": sessionID })
+          yield* state.cancel(sessionID)
+          // 中止待处理的 assistant 消息：标记 AbortedError 并完成 pending/running 工具部件
+          // Effect.ignore 确保 cancel 不会因子消息中止失败而失败
+          // #71/#153：cancel 时中止未完成 assistant
+          yield* abortPendingAssistants(sessionID).pipe(Effect.ignore)
+        }),
+      )
     })
 
     // #153：cancel 收口所有未完成 assistant（含空 dangling）
@@ -285,7 +325,31 @@ const layer = Layer.effect(
         }),
         { discard: true },
       )
-      // #149：不在此强制写 tool error；各工具 cancel handler（如 bash 截断）负责收口，避免竞态
+      // #173：无 active runner 时仍终态化 open tool（#149 工具 handler 路径保留给 live tool）
+      yield* abortPendingToolParts(sessionID, pending, now)
+    })
+
+    // #173：把 pending/running tool 标为 interrupted error，防止 cancel 后卡死
+    // #173：assistant 终态化后再写 tool，保证 message 已 completed
+    const abortPendingToolParts = Effect.fn("SessionPrompt.abortPendingToolParts")(function* (
+      sessionID: SessionID,
+      pending: SessionV1.WithParts[],
+      now: number,
+    ) {
+      // #173：遍历 pending assistants 的 parts，只动 open tool
+      yield* Effect.forEach(
+        pending,
+        Effect.fnUntraced(function* (msg) {
+          for (const part of msg.parts) {
+            if (!isOpenToolPart(part)) continue
+            yield* sessions.updatePart({
+              ...part,
+              state: interruptedToolState(part.state, now),
+            })
+          }
+        }),
+        { discard: true },
+      )
     })
 
     const resolvePromptParts = Effect.fn("SessionPrompt.resolvePromptParts")(function* (template: string) {
diff --git a/packages/opencode/test/cli/tui/daemon.test.ts b/packages/opencode/test/cli/tui/daemon.test.ts
--- a/packages/opencode/test/cli/tui/daemon.test.ts
+++ b/packages/opencode/test/cli/tui/daemon.test.ts
@@ -28,10 +28,11 @@ afterEach(() => {
  * 在临时目录中启动守护进程，轮询直到锁文件出现且 HTTP 服务器响应。
  * 返回运行中的进程和锁文件内容。
  */
-async function spawnDaemon(lockPath: string) {
+async function spawnDaemon(lockPath: string, env: Record<string, string> = {}) {
   const proc = Bun.spawn([process.execPath, WORKER_TS], {
     env: {
       ...process.env,
+      ...env,
       OPENCODE_PROCESS_ROLE: "worker",
       OPENCODE_LOCK_PATH: lockPath,
     },
@@ -179,4 +180,49 @@ describe("daemon lifecycle", () => {
     },
     DAEMON_START_TIMEOUT_MS + 5_000,
   )
+  // #173：短 idle 超时 + SSE 断开后守护进程应退出并清锁
+  test(
+    "daemon exits after the last SSE client disconnects",
+    async () => {
+      await using tmp = await tmpdir()
+      const lockPath = path.join(tmp.path, "tui-server.json")
+      // #173：250ms idle，测试不必等 30s
+      const { proc, lock } = await spawnDaemon(lockPath, { OPENCODE_DAEMON_IDLE_TIMEOUT_MS: "250" })
+
+      try {
+        const ctrl = new AbortController()
+        const res = await fetch(`http://127.0.0.1:${lock.port}/global/event`, { signal: ctrl.signal })
+        expect(res.ok).toBe(true)
+        if (!res.body) throw new Error("missing SSE body")
+
+        const reader = res.body.pipeThrough(new TextDecoderStream()).getReader()
+        try {
+          const first = await reader.read()
+          // #173：先读到 connected，确认 SSE 计数已 +1
+          expect(first.value).toContain("server.connected")
+          // #173：连接期间必须仍存活，证明 idle 只在断开后计时
+          await Bun.sleep(750)
+          expect(ServerLockModule.alive(proc.pid)).toBe(true)
+        } finally {
+          ctrl.abort()
+          await reader.cancel().catch(() => undefined)
+          reader.releaseLock()
+        }
+
+        const deadline = Date.now() + 5_000
+        while (Date.now() < deadline && ServerLockModule.alive(proc.pid)) {
+          await Bun.sleep(50)
+        }
+        // #173：退出后进程与锁都应消失
+        expect(ServerLockModule.alive(proc.pid)).toBe(false)
+        expect(await Bun.file(lockPath).exists()).toBe(false)
+      } finally {
+        try {
+          proc.kill()
+        } catch {}
+      }
+    },
+    15_000,
+  )
+
 })
diff --git a/packages/opencode/test/session/prompt.test.ts b/packages/opencode/test/session/prompt.test.ts
