+  const outputStartIdx = ssIdx >= 0 ? ssIdx : isConfirmed ? -1 : lastParts.length
+    // #127：live 扫描终点：step-finish 之前，streaming 则到末尾
+  const outputEndIdx = isConfirmed && sfIdx >= 0 ? sfIdx : lastParts.length
+    let textC = 0, reasonC = 0, toolC = 0
