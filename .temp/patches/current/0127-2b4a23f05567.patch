+      assistantText: inputAssistantText + liveAssistantText,
+      reasoning: inputReasoning + liveReasoning,
+      toolCalls: inputToolCalls + liveToolCalls,
+      pending: pendingToolResultTokens + pendingAttachTokens,
+    }
   }
 
