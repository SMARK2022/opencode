diff --git a/packages/core/src/session/activity.ts b/packages/core/src/session/activity.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/src/session/activity.ts
@@ -0,0 +1,35 @@
+import { EventEmitter } from "events"
+
+const emitter = new EventEmitter()
+const active = new Set<symbol>()
+
+// #235：进程内统一跟踪 V1 session/shell 与 Native drain，保留 begin/end 契约。
+export function begin(id: string) {
+  // #235：不同 listener 可并行处理同一 ID，每次登记独占令牌，避免互相提前释放。
+  const token = Symbol(id)
+  active.add(token)
+  emitter.emit("change", active.size)
+
+  let done = false
+  return () => {
+    if (done) return
+    done = true
+    active.delete(token)
+    emitter.emit("change", active.size)
+  }
+}
+
+// #152：当前活跃 runner 数量
+export function count() {
+  return active.size
+}
+
+// #152：数量变化订阅，供 worker 重武装 idle 计时器
+export function onChange(cb: (count: number) => void) {
+  emitter.on("change", cb)
+  return () => {
+    emitter.off("change", cb)
+  }
+}
+
+export * as SessionActivity from "./activity"
