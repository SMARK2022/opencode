+      const { proc } = await spawnDaemon(lockPath, {
+        OPENCODE_DAEMON_IDLE_TIMEOUT_MS: "5000",
+        OPENCODE_DAEMON_STARTUP_IDLE_TIMEOUT_MS: "5000",
+        OPENCODE_DAEMON_LAUNCHER_PID: "987654321",
