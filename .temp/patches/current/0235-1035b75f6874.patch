   // 优雅关闭：清锁、停 HTTP、关库，避免陈旧锁残留
   
-  async function gracefulShutdown() {
+  async function gracefulShutdown(reason = "unknown") {
     if (shutdownInProgress) return
     shutdownInProgress = true
+    // #235：关闭前取消全部退出保护——避免关闭过程中 timer 再次触发递归关闭
+    cancelIdleTimer("shutdown")
+    cancelStartupIdleTimer("shutdown")
+    cancelLauncherWatcher("shutdown")
+    log.info("daemon shutting down", {
+      reason,
+      hadClient,
+      sseClients,
+      sessionActivity: SessionActivity.count(),
+    })
     // 仅当 token 匹配时删除锁，防止误删不再属于自己的锁
     await ServerLock.clearIfOwner(lockToken)
-    await InstanceRuntime.disposeAllInstances()
-    if (externalServer) await externalServer.stop(true)
-    await internalServer.stop(true)
+    // #235：disposeAllInstances 与 Server.stop(true) 在 Windows 顺序场景偶发挂起
+    // #235：（Effect scope closeScopeOnce/实例清理等残留句柄）。
+    // #235：整个清理序列包在 3s 总超时内——不论哪步挂起，daemon 都能完成 exit(0)
+    await Promise.race([
+      Promise.resolve().then(async () => {
+        await InstanceRuntime.disposeAllInstances()
+        if (externalServer) await externalServer.stop(true)
