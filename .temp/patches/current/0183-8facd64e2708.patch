     const label = truncateVisible(row.label, labelWidth)
-        // #181：行体固定指标槽位，便于扫读对齐
-    const base = `  ${fitVisible(label, labelWidth)} ${fitVisible(money(row.cost), 8)} ${fitVisible(String(row.tokens), 8)} ${fitVisible(String(row.calls), 5)} ${fitVisible(share, 5)}`
-        // #181：trend 用 │ 与 share 分隔
