diff --git a/packages/opencode/src/cli/cmd/stats-data.ts b/packages/opencode/src/cli/cmd/stats-data.ts
--- a/packages/opencode/src/cli/cmd/stats-data.ts
+++ b/packages/opencode/src/cli/cmd/stats-data.ts
@@ -345,8 +345,14 @@ const dayStart = (time: number) => {
 }
 
 // #174：dateLabel 供轴标签
-const dateLabel = (time: number) =>
-  new Date(time).toLocaleDateString(undefined, { month: "short", day: "numeric" })
+// #183：与 dayStart 同用本地日界，MM-DD 避免 locale 月名撑列
+export const dateLabel = (time: number) => {
+  // #183：本地月日两位零填充（禁止 getUTC*，否则非 UTC 时区日前移）
+  const d = new Date(time)
+  const mm = String(d.getMonth() + 1).padStart(2, "0")
+  const dd = String(d.getDate()).padStart(2, "0")
+  return `${mm}-${dd}`
+}
 
