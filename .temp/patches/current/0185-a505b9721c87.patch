diff --git a/packages/tui/test/routes/session/session-message-spacing.test.ts b/packages/tui/test/routes/session/session-message-spacing.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/tui/test/routes/session/session-message-spacing.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, test } from "bun:test"
+import { isVisibleAssistantPart } from "../../../src/routes/session/index"
+
+// #185：首个可见 part 选择逻辑（隐藏 completed tool / 空 text）
+describe("assistant visible parts (#185)", () => {
+  test("empty text is not visible", () => {
+    // #185：空 text 不抢首距
+    expect(isVisibleAssistantPart({ type: "text", text: "  " }, { showDetails: true, showThinking: true })).toBe(false)
+  })
+
+  test("completed tool hidden when details off", () => {
+    // #185：tool_details 关闭时 completed 工具不可见
+    expect(
+      isVisibleAssistantPart({ type: "tool", state: { status: "completed" } }, { showDetails: false, showThinking: true }),
+    ).toBe(false)
+  })
+
+  test("completed tool visible when details on", () => {
+    // #185：详情开启时 completed 工具可见
+    expect(
+      isVisibleAssistantPart({ type: "tool", state: { status: "completed" } }, { showDetails: true, showThinking: true }),
+    ).toBe(true)
+  })
+})
diff --git a/packages/tui/src/util/layout.ts b/packages/tui/src/util/layout.ts
--- a/packages/tui/src/util/layout.ts
+++ b/packages/tui/src/util/layout.ts
@@ -18,2 +18,6 @@
-    const value = margin(previous.get(el))
+    const sibling = previous.get(el)
+    // 组内工具保持紧排，跨助手消息至少隔一行；空消息组不会制造额外间距。
+    const boundary = el.parent && sibling?.parent && el.parent !== sibling.parent
+      && layoutGroups.has(el.parent) && layoutGroups.has(sibling.parent)
+    const value = Math.max(margin(sibling), boundary ? 1 : 0)
     if (el.marginTop !== value) el.marginTop = value
