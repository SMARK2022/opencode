 if (!ctx.showThinking()) return false
         return part.text.replace("[REDACTED]", "").trim().length > 0
       }
-      if (part.type === "tool") return true
+      // #185：工具是否计入 visibleParts 与 shouldHide 同口径
+      if (part.type === "tool")
