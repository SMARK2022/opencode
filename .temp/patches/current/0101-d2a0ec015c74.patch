diff --git a/sdks/vscode/src/notebook/run.ts b/sdks/vscode/src/notebook/run.ts
index 9bc24d086b..e194f75f06 100644
--- a/sdks/vscode/src/notebook/run.ts
+++ b/sdks/vscode/src/notebook/run.ts
@@ -139,6 +139,13 @@
 function resolveRunTarget(notebook: vscode.NotebookDocument, cellId: string, endCellId?: string) {
   // 两端都经完整别名解析器定位，同格的不同 ID 写法仍只选择同一格。
-  const startCell = resolveNotebookCell(notebook, undefined, cellId)
+  // #101：TOP/BOTTOM 解析为首/末 code-or-any cell 索引快捷方式
+  function resolveCell(id: string) {
+    const upper = id.toUpperCase()
+    if (upper === "TOP") return notebook.cellAt(0)
+    if (upper === "BOTTOM") return notebook.cellAt(Math.max(0, notebook.cellCount - 1))
+    return resolveNotebookCell(notebook, undefined, id)
+  }
+  const startCell = resolveCell(cellId)
   // endCellId 才是范围信号，省略它时即使提示 type=range 也沿源规则执行单格。
   if (!endCellId) return [startCell]
-  const endCell = resolveNotebookCell(notebook, undefined, endCellId)
+  const endCell = resolveCell(endCellId)
diff --git a/packages/core/src/tool/notebook.ts b/packages/core/src/tool/notebook.ts
--- a/packages/core/src/tool/notebook.ts
+++ b/packages/core/src/tool/notebook.ts
@@ -34,2 +34,3 @@
-  cellId: cellId.annotate({ description: "Stable start cell ID from vscode_notebook_summary, formatted like #VSC-xxxxxxxx." }),
+  // 只补参数广告；首末格解析与范围验证继续共用原生run入口。
+  cellId: cellId.annotate({ description: "Stable start cell ID from vscode_notebook_summary, formatted like #VSC-xxxxxxxx. Also supports TOP and BOTTOM for the first/last cell." }),
   endCellId: cellId.annotate({ description: "Stable ending cell ID, formatted like #VSC-xxxxxxxx. When provided, the bridge runs from cellId through this cell, inclusive." }).pipe(Schema.optional),
