diff --git a/packages/opencode/src/agent/agent.ts b/packages/opencode/src/agent/agent.ts
index b8cb349e65..82f9b5d60a 100644
--- a/packages/opencode/src/agent/agent.ts
+++ b/packages/opencode/src/agent/agent.ts
@@ -165,6 +165,9 @@ const layer = Layer.effect(
                 question: "allow",
                 plan_enter: "allow",
                 bash: "ask",
+                // #101：interactive 下 notebook 运行/环境操作需确认
+                vscode_notebook_run: "ask",
+                vscode_notebook_env: "ask",
               }),
               user,
             ),
diff --git a/packages/opencode/src/plugin/vscode-bridge.ts b/packages/opencode/src/plugin/vscode-bridge.ts
index c0eb2ff75b..62f817dc20 100644
--- a/packages/opencode/src/plugin/vscode-bridge.ts
+++ b/packages/opencode/src/plugin/vscode-bridge.ts
@@ -50,7 +50,8 @@ const runArgs = {
     .enum(["cell", "range"])
     .optional()
     .describe("Optional run kind hint. The bridge runs a range whenever endCellId is provided; otherwise it runs one cell."),
-  cellId: z.string().describe("Stable start cell ID from vscode_notebook_summary, formatted like #VSC-xxxxxxxx."),
+  // #101：cellId 支持 TOP/BOTTOM 快捷定位首末 cell
+  cellId: z.string().describe("Stable start cell ID from vscode_notebook_summary, formatted like #VSC-xxxxxxxx. Also supports TOP and BOTTOM for the first/last cell."),
   endCellId: z
     .string()
     .optional()
diff --git a/sdks/vscode/src/notebook/run.ts b/sdks/vscode/src/notebook/run.ts
index 9bc24d086b..e194f75f06 100644
--- a/sdks/vscode/src/notebook/run.ts
+++ b/sdks/vscode/src/notebook/run.ts
@@ -143,7 +143,14 @@ function resolveRunTarget(
   cellId: string,
   endCellId?: string,
 ): vscode.NotebookCell[] {
-  const startCell = resolveNotebookCell(notebook, undefined, cellId)
+  // #101：TOP/BOTTOM 解析为首/末 code-or-any cell 索引快捷方式
+  function resolveCell(id: string) {
+    const upper = id.toUpperCase()
+    if (upper === "TOP") return notebook.cellAt(0)
+    if (upper === "BOTTOM") return notebook.cellAt(Math.max(0, notebook.cellCount - 1))
+    return resolveNotebookCell(notebook, undefined, id)
+  }
+  const startCell = resolveCell(cellId)
   const norm = (id: string) => id.replace(/^#/, "")
   // 有 endCellId 且不等于 cellId → range；否则单 cell
   if (endCellId && norm(endCellId) !== norm(cellId)) {
@@ -151,7 +158,7 @@ function resolveRunTarget(
       // type=cell 时禁止不同 endCellId（#84 强化；与 SMARK 对齐）
       throw new Error("endCellId must not be set when type is cell unless it equals cellId")
     }
-    const endCell = resolveNotebookCell(notebook, undefined, endCellId)
+    const endCell = resolveCell(endCellId)
     if (endCell.index < startCell.index) {
       throw new Error("endCellId must refer to the same cell or a later cell than cellId")
     }
