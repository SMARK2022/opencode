+  const aboveIdx = localStart - 2
+  const belowIdx = localEnd
+  const aboveLine = aboveIdx >= 0 ? cellLines[aboveIdx] : undefined
+  const belowLine = belowIdx < cellLines.length ? cellLines[belowIdx] : undefined
