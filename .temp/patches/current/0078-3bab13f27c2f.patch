+  const globalEnd = Math.min(cellRange.end, range.end)
+  // 两个闭区间没有交集时拒绝修改，不把越界请求转为首行插入。
+  if (globalStart > globalEnd) {
+    throw new Error(`Global range [${range.start},${range.end}] out of bounds for cell c${c1(targetCell)}`)
+  }
