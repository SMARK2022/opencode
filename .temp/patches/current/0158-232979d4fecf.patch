diff --git a/packages/opencode/src/tool/shell.ts b/packages/opencode/src/tool/shell.ts
index 1111111111..2222222222 100644
--- a/packages/opencode/src/tool/shell.ts
+++ b/packages/opencode/src/tool/shell.ts
@@ -453,19 +453,28 @@
 function shellCompatibilityError(root: Node, shellName: string): string | undefined {
   if (process.platform !== "win32") return
   if (shellName !== "powershell" && shellName !== "pwsh" && shellName !== "cmd") return
-  for (const node of commands(root)) {
+  // #158：localCommands 过滤引号载荷，避免误杀 ssh/wsl 内 Unix 工具
+  for (const node of localCommands(root)) {
     const command = parts(node)
     const raw = command[0]?.text
     if (!raw) continue
     const name = raw.toLowerCase().replace(/\.exe$/, "")
     if (UNIX_TEXT_COMMANDS.has(name)) {
-      // Unix 文本工具在 Windows shell 中不存在，返回错误阻止执行
+      // #158：仅拦截本地管道中的 Unix 文本工具；引号内 ssh/wsl 载荷跳过
+      if (shellName === "powershell" || shellName === "pwsh") {
+        // #158：PowerShell 给出可操作替代，并提示远程命令留在远程字符串内
+        return [
+          `The current shell is ${shellName}, but the local command uses Unix utility \`${raw}\`.`,
+          `Use OpenCode's dedicated tools instead: read for files, grep for content search, glob for file search.`,
+          powershellUnixAlternative(name),
+          `Keep remote Unix pipelines inside the remote shell string (ssh/wsl), not as a local pipeline.`,
+        ].join(" ")
+      }
+      // #158：cmd 走 cmd 原生命令提示，不混入 PowerShell 说法
       return [
         `The current shell is ${shellName}, but the command uses Unix utility \`${raw}\`.`,
         `Use OpenCode's dedicated tools instead: read for files, grep for content search, glob for file search.`,
-        shellName === "powershell" || shellName === "pwsh"
-          ? `If a shell command is truly required, use PowerShell equivalents such as Get-Content -Tail or Select-String.`
-          : `If a shell command is truly required in cmd.exe, use cmd-native commands such as dir/type/findstr.`,
+        `If a shell command is truly required in cmd.exe, use cmd-native commands such as dir/type/findstr.`,
       ].join(" ")
     }
     if (shellName === "cmd" && name === "ls") {
@@ -482,6 +491,30 @@
 
 // 生成 per-shell 指引文本：Windows 下按 shell 类型提供 Unix 工具禁用和替代方案
 // powershell 5.1 不支持 && ||，需要用 A; if ($?) { B } 条件链
+
+// #158：只扫描本地 command 节点；祖先含 string 视为远程/WSL 引号载荷
+function localCommands(root: Node) {
+  return commands(root).filter((node) => {
+    let cur: Node | null = node
+    while (cur) {
+      // #158：string/raw_string 等类型包含 string 即视为载荷边界
+      if (cur.type.includes("string")) return false
+      cur = cur.parent
+    }
+    return true
+  })
+}
+
+// #158：PowerShell 本地 Unix 工具的可操作替代提示
+function powershellUnixAlternative(name: string) {
+  if (name === "head") return "Prefer Select-Object -First N for local pipelines."
+  if (name === "tail") return "Prefer Get-Content -Tail N or Select-Object -Last N."
+  if (name === "grep") return "Prefer Select-String for local content search."
+  if (name === "sed" || name === "awk") return "Prefer PowerShell -replace / ForEach-Object, or run inside POSIX/ssh."
+  // #158：默认回退到通用 PowerShell 工具提示
+  return "Prefer PowerShell-native commands, or run the Unix utility inside ssh/wsl."
+}
+
 function shellGuidance(name: string) {
   if (process.platform !== "win32") return ""
 
