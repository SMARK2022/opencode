融合适配：源 session-v2 InlineTool 段与 AssistantMessage renderAfter 段在目标无宿主（v1.18.32 的
AssistantMessage 无 renderAfter 像素清除、无 session-v2 视图）；InlineTool 首工具顶距落到 setPreLayoutSiblingMargin 回调。
diff --git a/packages/tui/src/routes/session/index.tsx b/packages/tui/src/routes/session/index.tsx
--- a/packages/tui/src/routes/session/index.tsx
+++ b/packages/tui/src/routes/session/index.tsx
@@ -2658,3 +2658,5 @@
         if (props.separate) alwaysSeparate.add(el)
         setPreLayoutSiblingMargin(el, (previous) => {
+          // #460：无前驱兄弟时承接消息级顶距——首个工具 part 与文本气泡基线一致。
+          if (!previous) return 1
           return props.separate ||
diff --git a/packages/tui/test/routes/session/shell-output-spacing.test.ts b/packages/tui/test/routes/session/shell-output-spacing.test.ts
--- a/packages/tui/test/routes/session/shell-output-spacing.test.ts
+++ b/packages/tui/test/routes/session/shell-output-spacing.test.ts
@@ -67,2 +67,12 @@
   })
+
+  // #460：首个工具 part 需要消息级顶距——无前驱兄弟时 margin=1（与文本气泡基线一致）
+  test("InlineTool gives first tool part message-level top spacing", () => {
+    const start = sessionSource.indexOf("function InlineToolRow(")
+    const end = sessionSource.indexOf("function BlockTool(")
+    const inlineToolSource = sessionSource.slice(start, end)
+    expect(start).toBeGreaterThan(-1)
+    expect(end).toBeGreaterThan(start)
+    expect(inlineToolSource).toContain('if (!previous) return 1')
+  })
 })
diff --git a/packages/tui/test/cli/tui/inline-tool-wrap-snapshot.test.tsx b/packages/tui/test/cli/tui/inline-tool-wrap-snapshot.test.tsx
--- a/packages/tui/test/cli/tui/inline-tool-wrap-snapshot.test.tsx
+++ b/packages/tui/test/cli/tui/inline-tool-wrap-snapshot.test.tsx
@@ -262,1 +262,3 @@
+    // 首个工具真实占一行消息顶距，组内紧排和跨消息分隔仍由下面的断言验证。
+    expect(frame.split("\n")[0]).toBe("")
     expect(frame).toMatch(/A1\n[^\n]*A2\n\n[^\n]*B1\n[^\n]*B2/)
@@ -317,1 +319,1 @@
-    expect(frame.split("\n").map((line) => line.trim())).toEqual(["~ Writing command", "auto review"])
+    expect(frame.split("\n").map((line) => line.trim())).toEqual(["", "~ Writing command", "auto review"])
diff --git a/packages/tui/test/cli/tui/__snapshots__/inline-tool-wrap-snapshot.test.tsx.snap b/packages/tui/test/cli/tui/__snapshots__/inline-tool-wrap-snapshot.test.tsx.snap
--- a/packages/tui/test/cli/tui/__snapshots__/inline-tool-wrap-snapshot.test.tsx.snap
+++ b/packages/tui/test/cli/tui/__snapshots__/inline-tool-wrap-snapshot.test.tsx.snap
