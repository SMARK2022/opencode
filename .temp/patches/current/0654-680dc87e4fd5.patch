-const emptyPartComponents = (): Extract<PartColdStats, { type: "step-finish" }>["components"] => ({
-  system: 0,
-  instructions: 0,
-  skills: 0,
-  toolSchemas: 0,
-  userMessages: 0,
-  assistantText: 0,
-  reasoning: 0,
-  toolCalls: 0,
-  toolResults: 0,
-  attachments: 0,
-})
