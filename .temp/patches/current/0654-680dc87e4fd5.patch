-function restoreSessionMessage(row: typeof SessionMessageTable.$inferSelect, value: Envelope) {
-  const data = structuredClone(row.data)
-  const restored = new Set<string>()
-  sessionMessageFields({ ...row, data }, (target, key, path, empty) => {
-    if (!Object.hasOwn(value.fields, path)) return
-    const field = value.fields[path]
-    if ((typeof empty === "string" && typeof field !== "string") ||
-      (Array.isArray(empty) && !Array.isArray(field)) || (isRecord(empty) && !isRecord(field)) ||
-      (path === "summary.diffs" && !isDiffs(field))) {
-      throw new CorruptionError({ message: `Native cold field is invalid: ${path}`, hash: row.cold_ref ?? undefined })
-    }
-    target[key] = field
-    restored.add(path)
-  })
-  // 路径与原骨架必须一一对应；不能把过期tool位置或未知字段静默丢掉。
-  if (restored.size !== Object.keys(value.fields).length) {
-    throw new CorruptionError({ message: "Native cold fields do not match their projection", hash: row.cold_ref ?? undefined })
-  }
-  return data
-}
