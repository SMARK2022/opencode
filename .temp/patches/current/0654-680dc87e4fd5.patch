+  // 原始 token/cost 数字留在同行，统计读取无需恢复诊断明细。
+  if (data.role === "assistant") {
+    // 生命周期和 provider token 保热；完整读取统一恢复历史诊断字段。
+    const projection = structuredClone(data)
+    const fields: Record<string, unknown> = {}
+    // inputEstimate仍供列表SQL直接读取；旧平铺诊断按已有白名单归档并完整恢复。
+    for (const [key, value] of Object.entries(data)) {
+      if (!["path", "inputChars", "inputTokens", "inputBreakdown"].includes(key) || value === undefined) continue
+      fields[key] = value
+      Reflect.deleteProperty(projection, key)
+    }
