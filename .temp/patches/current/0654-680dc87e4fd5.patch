+  }
+  // version 是格式演进边界，未知版本不能按相似字段结构猜测解释。
+  if (!isRecord(value) || value.version !== 1 || typeof value.type !== "string") {
+    throw new CorruptionError({ message: "Part cold Stats projection is invalid", hash })
+  }
