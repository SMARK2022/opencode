+    case !ctx.aborted && !APICallError.isInstance(e) && (() => {
+      // #191：在 catch-all 之前检查 transport 层瞬时故障
+      // #191：先解包 AI SDK RetryError，取 lastError 再判定
+      const retried = retryErrorCause(e)
