+      yield* withDb((db) => db.update(MessageTable).set({ time_created: 1 }).where(eq(MessageTable.id, messageID)).run())
+      const frozen = yield* withDb((db) => ColdStorage.freezeOwner(db, { type: "part", id, olderThanMs: 0 }))
