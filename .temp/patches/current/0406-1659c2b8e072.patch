+    expect(bash("rm -rf /root/../etc")).toMatchObject({ level: "dangerous" })
+    expect(bash("rm -rf /home/sunbenteng/../alice")).toMatchObject({ level: "dangerous" })
+    // /Users 本身和 /Users/<user> → dangerous
