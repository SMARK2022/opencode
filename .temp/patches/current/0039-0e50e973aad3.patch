diff --git a/.github/workflows/build-opencode.yml b/.github/workflows/build-opencode.yml
--- a/.github/workflows/build-opencode.yml
+++ b/.github/workflows/build-opencode.yml
@@ -65,16 +65,17 @@ jobs:
           chmod 755 "${DEB_DIR}/${PKG_NAME}/usr/local/bin/opencode"
 
           # heredoc 写入 control 文件：dpkg 要求字段顶格无缩进，EOF 标记结束
+          # control 内容必须顶格（column 0），否则 dpkg 解析字段时前导空格会导致格式错误
           cat > "${DEB_DIR}/${PKG_NAME}/DEBIAN/control" <<EOF
-          Package: opencode
-          Version: ${VERSION}
-          Section: utils
-          Priority: optional
-          Architecture: amd64
-          Maintainer: smark <smark@local>
-          Description: opencode AI-powered development tool (smark build)
-           A standalone AI coding assistant with TUI, version ${VERSION}.
-          EOF
+Package: opencode
+Version: ${VERSION}
+Section: utils
+Priority: optional
+Architecture: amd64
+Maintainer: smark <smark@local>
+Description: opencode AI-powered development tool (smark build)
+ A standalone AI coding assistant with TUI, version ${VERSION}.
+EOF
 
           dpkg-deb --build "${DEB_DIR}/${PKG_NAME}" "packages/opencode/dist/opencode_${VERSION}_amd64.deb"
 
@@ -123,6 +124,20 @@ jobs:
     steps:
       - uses: actions/checkout@v4
 
+      # Windows 原生编译工具链：Bun 在 Windows 构建时需编译 native addon
+      # setup-node 提供 node-gyp 所需的 Node.js 运行时（22 LTS）
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "22"
+
+      # setup-python：node-gyp 依赖 Python 构建 native addon，Windows runner 默认不带
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      # setup-msbuild：Windows C++ 编译工具链，native addon 的 .node 文件需 MSBuild
+      - uses: microsoft/setup-msbuild@v2
+
       - uses: ./.github/actions/setup-bun
 
       - name: Build Windows
