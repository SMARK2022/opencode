 // 安装命令必须可拆为安全数组：出现 shell 元字符即失败，阻断 CI 注入面。
+function envField(source: string, key: string) {
+  const match = source.match(new RegExp(`^          ${key}: (.+)$`, "m"))
+  return match?.[1]
+}
+
