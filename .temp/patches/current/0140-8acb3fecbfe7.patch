+        // 仅本次准备请求触发的内部转移，不能吞掉真实失败或用户中断。
+        const preflightCompaction = Symbol("preflight-compaction")
@@ -773,3 +775,8 @@
               // 每次请求准备都覆盖为未确认，旧 tokens 不得确认新请求体样本。
