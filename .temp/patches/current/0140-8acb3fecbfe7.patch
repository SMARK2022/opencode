               messages: { userText: msgUserChars, assistantText: msgAssistantChars, reasoning: msgReasoningChars, toolInput: msgToolInputChars, toolOutput: msgToolOutputChars, attachments: msgAttachmentChars, total: msgUserChars + msgAssistantChars + msgReasoningChars + msgToolInputChars + msgToolOutputChars + msgAttachmentChars },
             } as SessionV1.StepFinishPart["inputBreakdown"]
-            // 输入侧比率校准：从历史 step-finish 的 inputChars / inputTokens 推算
-            // 100k 字符上限避免长会话过度影响比率
+            // #140：输入侧比率校准（历史 step-finish inputChars/tokens），夹紧到 [3,4]
+            // #140：history 校准样本来自 step-finish.inputChars
             let historyInputChars = 0
             let historyInputTokens = 0
-            for (let i = msgs.length - 1; i >= 0 && historyInputChars < 100_000; i--) {
+            for (let i = msgs.length - 1; i >= 0 && historyInputChars < INPUT_CHARS_HISTORY_LIMIT; i--) {
               const m = msgs[i]
               if (m.info.role !== "assistant") continue
               const sf = m.parts.findLast((p) => p.type === "step-finish")
@@ -1418,11 +1422,27 @@ const layer = Layer.effect(
                 historyInputTokens += tokens
               }
             }
-            // 样本不足（<500 字符）时回退 /4，避免少量数据导致比值失真
-            const charsPerToken = historyInputTokens > 0 && historyInputChars > 500
-              ? historyInputChars / historyInputTokens
-              : 4
-            const estimatedInput = Math.round(inputChars / charsPerToken)
+            // #140：样本不足时回退 Token.estimate；有样本则夹紧比值
+            const estimatedInput =
+              historyInputTokens > 0 && historyInputChars > 500
+                ? Math.round(inputChars / clampCharsPerToken(historyInputChars / historyInputTokens))
+                : tokenEstimate([systemText, messagesText, toolsText].join("\n"))
+            // #140：用即将发送的 estimatedInput 做 overflow，而非 lastFinished 历史巨量
+            if (
+              yield* compaction.isOverflow({
+                tokens: { input: estimatedInput, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+                model,
+              })
+            ) {
+              // #140：auto compact 使用 estimatedInput 窗口
+              yield* compaction.create({
+                sessionID,
+                agent: lastUser.agent,
+                model: lastUser.model,
+                auto: true,
+              })
+              return "continue" as const
+            }
             // 将估算值写入 assistant message 供 TUI 流式显示，step-finish 到达后被真实值覆盖
             handle.message.tokens.input = estimatedInput
