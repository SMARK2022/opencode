+              if (!ctx.assistantMessage.summary && isOverflow({
+                cfg: yield* config.get(), model: ctx.model,
+                tokens: { input: ctx.assistantMessage.inputEstimate.input, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
