融合适配：owner 已在 packages/tui（0457 迁移）；保留 #111 collapseArmed 门控（目标更强契约），
canCollapse 信号+effect → 同步 collapsible memo（首帧前判定）；三处引用与结构测试同步迁移。
diff --git a/packages/tui/src/routes/session/index.tsx b/packages/tui/src/routes/session/index.tsx
--- a/packages/tui/src/routes/session/index.tsx
+++ b/packages/tui/src/routes/session/index.tsx
@@ -2756,17 +2756,14 @@
   const threshold = createMemo(() => props.threshold ?? 20)
   const charThreshold = createMemo(() => props.charThreshold ?? DEFAULT_BLOCK_CHAR_THRESHOLD)
-  // 字符阈值与行阈值同权判定——两个预算任一超限即可武装折叠。
-  // #111：canCollapse 只升不降
-  const [canCollapse, setCanCollapse] = createSignal(false)
-  createEffect(() => {
-    if (!collapseArmed()) return
-    if (canCollapse()) return
-    if (previewLines() > 0 && ((props.totalLines ?? 0) > threshold() || (props.totalChars ?? 0) > charThreshold())) {
-      setCanCollapse(true)
-    }
-  })
+  // #459：折叠资格改为同步 memo——effect 方案会让大 diff 先挂载一次再被预览替换，
+  // 首帧仍付出完整 DiffRenderable/tree-sitter 成本；同步判定在首次渲染前生效。
+  // 字符阈值与行阈值同权判定——两个预算任一超限即可折叠（#457）。
+  const collapsible = createMemo(() => {
+    if (!collapseArmed()) return false
+    if (previewLines() <= 0) return false
+    return (props.totalLines ?? 0) > threshold() || (props.totalChars ?? 0) > charThreshold()
+  })
   const [expanded, setExpanded] = createSignal(false)
-  // 目标以 canCollapse() 承担上游 collapsible() 的语义——统一收敛为 collapsed memo，
-  // 让下方 JSX 与上游保持同构引用。
-  const collapsed = createMemo(() => canCollapse() && !expanded())
+  // #459：collapsed 直接消费 collapsible——与上游同构，无需 canCollapse 信号中转。
+  const collapsed = createMemo(() => collapsible() && !expanded())
   const hasPreview = createMemo(() => props.preview !== undefined)
@@ -2796,3 +2793,3 @@
       borderColor={props.contextView ? theme.info : theme.background}
-      onMouseOver={() => (props.onClick || props.onRightClick || canCollapse()) && setHover(true)}
+      onMouseOver={() => (props.onClick || props.onRightClick || collapsible()) && setHover(true)}
       onMouseOut={() => setHover(false)}
@@ -2810,3 +2806,3 @@
         // #111：仅内置折叠武装时切换 expanded
-        if (canCollapse()) setExpanded((prev) => !prev)
+        if (collapsible()) setExpanded((prev) => !prev)
         props.onClick?.()
@@ -2854,3 +2849,3 @@
       </Show>
-      <Show when={canCollapse()}>
+      <Show when={collapsible()}>
         <box marginTop={1}>
diff --git a/packages/tui/test/routes/session/shell-output-spacing.test.ts b/packages/tui/test/routes/session/shell-output-spacing.test.ts
--- a/packages/tui/test/routes/session/shell-output-spacing.test.ts
+++ b/packages/tui/test/routes/session/shell-output-spacing.test.ts
@@ -61,2 +61,11 @@
   })
+
+  // #459：折叠资格在首次渲染前同步判定——信号+effect 方案会让大 diff 挂载后才降级
+  test("BlockTool decides collapse eligibility before mounting previews", () => {
+    const start = sessionSource.indexOf("function BlockTool(")
+    const end = sessionSource.indexOf("function Shell(")
+    const blockToolSource = sessionSource.slice(start, end)
+    expect(blockToolSource).toContain("const collapsible = createMemo")
+    expect(blockToolSource).not.toContain("setCanCollapse")
+  })
 })
