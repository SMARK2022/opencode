融合适配：同步 preview memo 和 bodyMounted 初值已在真实 BlockTool 承载首帧延迟挂载。
保留目标单一 owner 与展开后 renderable 常驻，适配源测试并验证真实正文挂载次数。
diff --git a/packages/tui/test/routes/session/shell-output-spacing.test.ts b/packages/tui/test/routes/session/shell-output-spacing.test.ts
--- a/packages/tui/test/routes/session/shell-output-spacing.test.ts
+++ b/packages/tui/test/routes/session/shell-output-spacing.test.ts
@@ -57,3 +57,13 @@
     expect(sessionSource).toContain("renderAfter={syncSessionViewportStuckToBottom}")
   })
+
+  // 首帧从实际 preview 同步决定正文挂载，不恢复已移除的内置折叠状态。
+  test("BlockTool decides collapse eligibility before mounting previews", () => {
+    const start = sessionSource.indexOf("function BlockTool(")
+    const end = sessionSource.indexOf("function Shell(")
+    const blockToolSource = sessionSource.slice(start, end)
+    expect(blockToolSource).toContain("const collapsed = createMemo(() => props.preview !== undefined)")
+    expect(blockToolSource).toContain("createSignal(!collapsed())")
+    expect(blockToolSource).not.toContain("setCanCollapse")
+  })
 })
diff --git a/packages/tui/test/routes/session/block-tool-collapse.test.tsx b/packages/tui/test/routes/session/block-tool-collapse.test.tsx
--- a/packages/tui/test/routes/session/block-tool-collapse.test.tsx
+++ b/packages/tui/test/routes/session/block-tool-collapse.test.tsx
@@ -26,2 +26,8 @@
   const output = Array.from({ length: 24 }, (_, index) => `source line ${index + 1}`).join("\n")
+  // 组件边界记录真实挂载次数，不能把折叠后隐藏误当成首帧未挂载。
+  let bodyMounts = 0
+  function Body() {
+    bodyMounts++
+    return <text>{output}</text>
+  }
 
@@ -43,1 +49,1 @@
-                    <text>{output}</text>
+                    <Body />
@@ -70,1 +76,2 @@
     expect(frame).not.toContain("source line 24")
+    expect(bodyMounts).toBe(0)
@@ -75,1 +82,2 @@
     expect(frame).toContain("source line 24")
+    expect(bodyMounts).toBe(1)
@@ -80,1 +88,2 @@
     expect(frame).not.toContain("source line 24")
+    expect(bodyMounts).toBe(1)
@@ -86,1 +95,2 @@
     expect(frame).toContain("source line 24")
+    expect(bodyMounts).toBe(1)
