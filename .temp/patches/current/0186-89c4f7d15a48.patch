 import path from "path"
 import { SessionPath } from "@opencode-ai/core/session/path"
 // #132：会话 path 规范化
@@ -146,6 +147,103 @@ export const {
     const fullSyncedSessions = new Set<string>()
     // #132：区分首次 connected 与重连
     let connectedOnce = false
+    // #186：同一 part/field 的相邻 delta 在 16ms 窗内合并，压低 Solid store 抖动
+    // #186：队列与 timer 均局部于 SyncProvider，不泄漏到 SDK 订阅层
+    let pendingPartDeltas: EventMessagePartDelta[] = []
+    let pendingPartDeltaTimer: Timer | undefined
+
+    function targetsSamePartDelta(previous: EventMessagePartDelta, next: EventMessagePartDelta) {
+      // #186：仅同 session/message/part/field 的相邻 delta 可合并；公共事件流仍逐条投递
+      // #186：field 不同（如 text vs raw）必须分桶，防止串写
+      return (
+        previous.properties.sessionID === next.properties.sessionID &&
+        previous.properties.messageID === next.properties.messageID &&
+        previous.properties.partID === next.properties.partID &&
+        previous.properties.field === next.properties.field
+      )
+    }
+
+    function coalescePartDeltas(events: readonly EventMessagePartDelta[]) {
+      // #186：线性扫一遍，只合并“相邻且同 key”的片段，跨 part 不合并
+      const result: EventMessagePartDelta[] = []
+      for (const event of events) {
+        const previous = result.at(-1)
+        if (!previous || !targetsSamePartDelta(previous, event)) {
+          // #186：边界切换：开启新桶，保留事件顺序语义
+          result.push(event)
+          continue
+        }
+        // #186：保留首条 id，只拼接 delta 文本；part.updated 等边界会先 flush
+        // #186：后到事件的 id 丢弃不影响 store，只服务合并槽位
+        result[result.length - 1] = {
+          ...previous,
+          properties: {
+            ...previous.properties,
+            delta: previous.properties.delta + event.properties.delta,
+          },
+        }
+      }
+      return result
+    }
+
+    function applyPartDelta(event: EventMessagePartDelta) {
+      // #186：orphan delta（part 尚未入 store）直接丢弃，与 hydration 竞态测试一致
+      const parts = store.part[event.properties.messageID]
+      if (!parts) return
+      const result = search(parts, event.properties.partID, (p) => p.id)
+      // #186：找不到 part 时不创建空壳，避免伪造 tool/text
+      if (!result.found) return
+      // #186：合并后的单次 apply 仍要 touch，保持活跃 part 跟踪
+      // #186：touch 必须在 setStore 前，供 sticky/scroll 活跃集使用
+      touchPart(event.properties.sessionID, event.properties.partID)
+      setStore(
+        "part",
+        event.properties.messageID,
+        produce((draft) => {
+          const part = draft[result.index]
+          // #157：pending tool 的 raw 在 state 下，不能走顶层 part[field]
+          if (
+            part.type === "tool" &&
+            part.state?.status === "pending" &&
+            event.properties.field === "raw"
+          ) {
+            // #157：与 processor tool-input-delta field:"raw" 对齐
+            const state = part.state as { raw?: string }
+            state.raw = (state.raw ?? "") + event.properties.delta
+            return
+          }
+          const field = event.properties.field as keyof typeof part
+          const existing = part[field] as string | undefined
+          ;(part[field] as string) = (existing ?? "") + event.properties.delta
+        }),
+      )
+    }
+
+    function flushPartDeltas() {
+      // #186：先清 timer 再消费队列，防止重入二次调度
+      if (pendingPartDeltaTimer) {
+        clearTimeout(pendingPartDeltaTimer)
+        pendingPartDeltaTimer = undefined
+      }
+      if (pendingPartDeltas.length === 0) return
+      // #186：取出快照后立刻清空，后续 enqueue 进入新窗
+      const events = coalescePartDeltas(pendingPartDeltas)
+      pendingPartDeltas = []
+      // #186：同帧 batch 写入，避免 N 次独立 store 通知
+      // #186：顺序仍按 coalesce 结果，跨 part 交替时保持到达序
+      batch(() => {
+        for (const event of events) applyPartDelta(event)
+      })
+    }
+
+    function enqueuePartDelta(event: EventMessagePartDelta) {
+      // #186：只入队不立刻写 store，把高频 token 片段留给 coalesce
+      pendingPartDeltas.push(event)
+      if (pendingPartDeltaTimer) return
+      // #186：16ms 对齐一帧；超时或非 delta 边界都会 flush
+      pendingPartDeltaTimer = setTimeout(flushPartDeltas, 16)
+    }
+
     const syncingSessions = new Map<string, Promise<void>>()
     const hydratingSessions = new Map<string, { messages: Set<string>; parts: Set<string> }>()
     const touchMessage = (sessionID: string, messageID: string) => {
@@ -179,6 +277,9 @@ export const {
     }
 
     event.subscribe((event, { directory, workspace }) => {
+      // #186：非 delta 事件前强制 flush，保证 part.updated / vcs 等看到完整文本
+      // #186：delta 自身不 flush，继续积攒同一 16ms 窗口
+      if (event.type !== "message.part.delta") flushPartDeltas()
       switch (event.type) {
         case "server.instance.disposed":
           void bootstrap()
@@ -445,32 +546,9 @@ export const {
         }
 
         case "message.part.delta": {
-          const parts = store.part[event.properties.messageID]
-          if (!parts) break
-          const result = search(parts, event.properties.partID, (p) => p.id)
-          if (!result.found) break
-          touchPart(event.properties.sessionID, event.properties.partID)
-          setStore(
-            "part",
-            event.properties.messageID,
-            produce((draft) => {
-              const part = draft[result.index]
-              // #157：pending tool 的 raw 在 state 下，不能走顶层 part[field]
-              if (
-                part.type === "tool" &&
-                part.state?.status === "pending" &&
-                event.properties.field === "raw"
-              ) {
-                // #157：与 processor tool-input-delta field:"raw" 对齐
-                const state = part.state as { raw?: string }
-                state.raw = (state.raw ?? "") + event.properties.delta
-                return
-              }
-              const field = event.properties.field as keyof typeof part
-              const existing = part[field] as string | undefined
-              ;(part[field] as string) = (existing ?? "") + event.properties.delta
-            }),
-          )
+          // #186：进入队列合并，applyPartDelta 内仍走 #157 raw 路径
+          // #186：此处禁止直接 setStore，否则绕过 coalesce 失去批处理收益
+          enqueuePartDelta(event)
           break
         }
 
@@ -505,6 +583,13 @@ export const {
       }
     })
 
+    onCleanup(() => {
+      // #186：卸载时丢弃未 flush 队列，避免定时器写已销毁 store
+      // #186：不在 cleanup 里 flush——组件已拆，UI 不再需要最后一帧
+      if (pendingPartDeltaTimer) clearTimeout(pendingPartDeltaTimer)
+      pendingPartDeltas = []
+    })
+
     const exit = useExit()
     const args = useArgs()
 
diff --git a/packages/tui/test/cli/cmd/tui/sync.test.tsx b/packages/tui/test/cli/cmd/tui/sync.test.tsx
--- a/packages/tui/test/cli/cmd/tui/sync.test.tsx
+++ b/packages/tui/test/cli/cmd/tui/sync.test.tsx
@@ -1,8 +1,8 @@
 /** @jsxImportSource @opentui/solid */
 import { describe, expect, test } from "bun:test"
 import { tmpdir } from "../../../fixture/fixture"
-import { mount, wait } from "./sync-fixture"
-import type { GlobalEvent } from "@opencode-ai/sdk/v2"
+import { directory, mount, wait, worktree } from "./sync-fixture"
+import type { AssistantMessage, GlobalEvent, ToolPart } from "@opencode-ai/sdk/v2"
 
 function branchEvent(branch: string, workspace?: string): GlobalEvent {
   return {
@@ -63,3 +63,128 @@ describe("tui sync", () => {
     }
   })
 })
+
+function assistantMessage(): AssistantMessage {
+  return {
+    id: "msg_1",
+    sessionID: "ses_1",
+    role: "assistant",
+    time: { created: 1 },
+    parentID: "user_1",
+    modelID: "model",
+    providerID: "provider",
+    mode: "build",
+    agent: "general",
+    path: { cwd: directory, root: worktree },
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+  }
+}
+
+function pendingToolPart(id = "part_1", callID = "call_1"): ToolPart {
+  return {
+    id,
+    sessionID: "ses_1",
+    messageID: "msg_1",
+    type: "tool",
+    callID,
+    tool: "apply_patch",
+    state: { status: "pending", input: {}, raw: "" },
+  }
+}
+
+function messageEvent(info: AssistantMessage): GlobalEvent {
+  return {
+    directory,
+    project: "proj_test",
+    payload: { id: "evt_message", type: "message.updated", properties: { sessionID: info.sessionID, info } },
+  }
+}
+
+function partEvent(part: ToolPart): GlobalEvent {
+  return {
+    directory,
+    project: "proj_test",
+    payload: { id: "evt_part", type: "message.part.updated", properties: { sessionID: part.sessionID, part, time: 1 } },
+  }
+}
+
+function deltaEvent(id: string, delta: string, partID = "part_1"): GlobalEvent {
+  // #186：测试事件工厂：field 固定 raw，覆盖 pending tool 路径
+  return {
+    directory,
+    project: "proj_test",
+    payload: {
+      id,
+      type: "message.part.delta",
+      properties: { sessionID: "ses_1", messageID: "msg_1", partID, field: "raw", delta },
+    },
+  }
+}
+
+describe("tui sync part delta coalesce (#186)", () => {
+  test("applies queued streaming part deltas to the sync store", async () => {
+    // #186：同 part raw 多段 delta 合并后仍得到完整文本
+    await using tmp = await tmpdir()
+    await Bun.write(`${tmp.path}/kv.json`, "{}")
+    const { app, emit, sync } = await mount(undefined, tmp.path)
+
+    try {
+      emit(messageEvent(assistantMessage()))
+      emit(partEvent(pendingToolPart()))
+      await wait(() => sync.data.part.msg_1?.[0]?.id === "part_1")
+
+      // #186：三段相邻 delta，合并后应为 "hello world"
+      emit(deltaEvent("delta_1", "hel"))
+      emit(deltaEvent("delta_2", "lo"))
+      emit(deltaEvent("delta_3", " world"))
+
+      await wait(
+        () =>
+          sync.data.part.msg_1?.[0]?.type === "tool" &&
+          sync.data.part.msg_1[0].state.status === "pending" &&
+          sync.data.part.msg_1[0].state.raw === "hello world",
+      )
+      expect(sync.data.part.msg_1?.[0]).toMatchObject({ state: { raw: "hello world" } })
+    } finally {
+      app.renderer.destroy()
+    }
+  })
+
+  test("flushes queued part deltas before non-delta event boundaries", async () => {
+    // #186：vcs 等非 delta 边界会先 flush，两 part 各自文本完整
+    await using tmp = await tmpdir()
+    await Bun.write(`${tmp.path}/kv.json`, "{}")
+    const { app, emit, project, sync } = await mount(undefined, tmp.path)
+
+    try {
+      project.workspace.set("ws_a")
+      emit(messageEvent(assistantMessage()))
+      emit(partEvent(pendingToolPart()))
+      emit(partEvent(pendingToolPart("part_2", "call_2")))
+      await wait(() => sync.data.part.msg_1?.length === 2)
+
+      // #186：交替 part 的 delta 不能跨 part 粘连；vcs 触发边界 flush
+      emit(deltaEvent("delta_1", "a"))
+      emit(deltaEvent("delta_2", "b", "part_2"))
+      emit(deltaEvent("delta_3", "c"))
+      emit(branchEvent("flush", "ws_a"))
+
+      await wait(
+        () =>
+          sync.data.part.msg_1?.[0]?.type === "tool" &&
+          sync.data.part.msg_1[0].state.status === "pending" &&
+          sync.data.part.msg_1[0].state.raw === "ac" &&
+          sync.data.part.msg_1[1]?.type === "tool" &&
+          sync.data.part.msg_1[1].state.status === "pending" &&
+          sync.data.part.msg_1[1].state.raw === "b" &&
+          sync.data.vcs?.branch === "flush",
+      )
+      expect(sync.data.part.msg_1?.[0]).toMatchObject({ state: { raw: "ac" } })
+      expect(sync.data.part.msg_1?.[1]).toMatchObject({ state: { raw: "b" } })
+      expect(sync.data.vcs?.branch).toBe("flush")
+    } finally {
+      app.renderer.destroy()
+    }
+  })
+})
