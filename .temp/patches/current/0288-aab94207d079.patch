From aab94207d079704fa23f194b8ea855e340da0c56 Mon Sep 17 00:00:00 2001
From: SMARK2022 <3222301373@qq.com>
Date: Wed, 10 Jun 2026 01:33:46 +0800
Subject: [PATCH] feat(shell): update compress_output snapshot and add compress_output: false to byte limit test
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit


diff --git a/packages/opencode/test/tool/__snapshots__/parameters.test.ts.snap b/packages/opencode/test/tool/__snapshots__/parameters.test.ts.snap
--- a/packages/opencode/test/tool/__snapshots__/parameters.test.ts.snap
+++ b/packages/opencode/test/tool/__snapshots__/parameters.test.ts.snap
@@ -25,7 +25,7 @@
       "type": "string",
     },
     "compress_output": {
-      "description": "Whether this shell call may compress repetitive output before returning it. Strongly prefer omitting this field to follow the user's default; set false only for exact raw formatting.",
+      "description": "Whether this shell call may compress repetitive output, oversized lines, and terminal progress noise before returning it. Strongly prefer omitting this field to follow the user's default; set false only for exact raw formatting.",
       "type": "boolean",
     },
     "timeout": {

diff --git a/packages/opencode/test/tool/shell.test.ts b/packages/opencode/test/tool/shell.test.ts
--- a/packages/opencode/test/tool/shell.test.ts
+++ b/packages/opencode/test/tool/shell.test.ts
@@ -1512,7 +1512,10 @@
       Effect.gen(function* () {
         const byteCount = Truncate.MAX_BYTES + 10000
         const result = yield* run({
           command: fill("bytes", byteCount),
+          // #288：本用例只验证截断边界；重复字节默认会被 bash 压缩器折叠，
+          // 导致压缩后的可见输出低于 byte limit，所以这里显式关闭压缩。
+          compress_output: false,
         })
         mustTruncate(result)
         expect(result.output).toContain('<opencode_notice type="output_truncated" source="shell"')
