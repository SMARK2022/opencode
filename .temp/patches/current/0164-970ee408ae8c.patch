From 970ee408ae8c9452e96a505ba0ca685fb3fdebd8 Mon Sep 17 00:00:00 2001
From: SMARK2022 <3222301373@qq.com>
Date: Mon, 18 May 2026 19:31:02 +0800
Subject: [PATCH] feat: enhance event handling and add tests for streaming
 semantics

- Added a return statement in the event handler to prevent further processing when a global or project-specific event is matched.

diff --git a/packages/tui/src/context/event.ts b/packages/tui/src/context/event.ts
index 1111111111..2222222222 100644
--- a/packages/tui/src/context/event.ts
+++ b/packages/tui/src/context/event.ts
@@ -1,5 +1,6 @@
 import type { Event } from "@opencode-ai/sdk/v2"
 import { useSDK } from "./sdk"
+import { useProject } from "./project"
 import path from "path"
 
 const normalizedDirectory = new Map<string, string>()
@@ -35,10 +36,25 @@
   workspace: string | undefined
 }
 
+
+// #164：全局 directory 事件始终投递（重连/跨实例广播）
+// #164/#165：显式 project 字段必须匹配当前项目，防止共享 daemon SSE 跨项目泄漏
+export function shouldDeliverScopedEvent(
+  event: { directory?: string; project?: string },
+  currentProject?: string,
+) {
+  // #164：global 目录事件无条件放行
+  if (event.directory === "global") return true
+  // #165：有 project 时只匹配当前 project，不回退 workspace
+  if (event.project) return event.project === currentProject
+  return true
+}
+
 export function useEvent() {
   const sdk = useSDK()
 
   function subscribe(handler: (event: Event, metadata: EventMetadata) => void) {
+    const project = useProject()
     return sdk.event.on("event", (event) => {
       if (event.payload.type === "sync") {
         return
@@ -47,6 +63,17 @@
       // #132：server.connected 始终投递，支撑重连恢复
       if ((event.payload as { type?: string }).type === "server.connected") {
         handler(event.payload, { directory: event.directory, workspace: event.workspace })
+        return
+      }
+
+      // #164/#165：单次投递前做 project/global 作用域判定
+      const currentProject = project.project()
+      if (
+        !shouldDeliverScopedEvent(
+          { directory: event.directory, project: (event as { project?: string }).project },
+          currentProject,
+        )
+      ) {
         return
       }
 
diff --git a/packages/tui/test/cli/tui/event-single-delivery.test.ts b/packages/tui/test/cli/tui/event-single-delivery.test.ts
new file mode 100644
index 0000000000..2222222222
--- /dev/null
+++ b/packages/tui/test/cli/tui/event-single-delivery.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, test } from "bun:test"
+import { shouldDeliverScopedEvent } from "../../../src/context/event"
+
+// #164：单次投递 + 作用域判定；防止 part.delta 双写与跨项目泄漏
+// #164：函数可单测，不依赖完整 TUI mount
+describe("shouldDeliverScopedEvent", () => {
+  test("delivers global directory events always", () => {
+    // #164：global 目录事件始终投递
+    expect(shouldDeliverScopedEvent({ directory: "global" }, "proj-a")).toBe(true)
+  })
+
+  test("delivers project-tagged events only for matching project", () => {
+    // #165：project 不匹配则丢弃
+    expect(shouldDeliverScopedEvent({ directory: "/x", project: "proj-a" }, "proj-a")).toBe(true)
+    expect(shouldDeliverScopedEvent({ directory: "/x", project: "proj-b" }, "proj-a")).toBe(false)
+  })
+
+  test("delivers unscoped events once (no double-path)", () => {
+    // #164：无 project 字段时放行一次
+    expect(shouldDeliverScopedEvent({ directory: "/workspace" }, "proj-a")).toBe(true)
+  })
+})
