diff --git a/packages/tui/src/util/connection-error.ts b/packages/tui/src/util/connection-error.ts
new file mode 100644
index 0000000000..9ae361655b
--- /dev/null
+++ b/packages/tui/src/util/connection-error.ts
@@ -0,0 +1,46 @@
+// #139：识别可恢复的网络/连接错误，供 SSE 重连静默吞掉
+export namespace ConnectionError {
+  export function isConnectionError(error: unknown): boolean {
+    if (error == null) return false
+    if (typeof error === "string") return matchMessage(error)
+    if (typeof error !== "object") return false
+    const err = error as { name?: string; message?: string; code?: string; cause?: unknown }
+    // #139：中止视为可恢复连接中断
+    if (err.name === "AbortError") return true
+    if (typeof err.code === "string" && matchCode(err.code)) return true
+    if (typeof err.message === "string" && matchMessage(err.message)) return true
+    // #139：递归 cause 链
+    if (err.cause) return isConnectionError(err.cause)
+    return false
+  }
+}
+
+function matchCode(code: string) {
+  const c = code.toUpperCase()
+  return (
+    c === "ECONNRESET" ||
+    c === "ECONNREFUSED" ||
+    c === "ECONNABORTED" ||
+    c === "ETIMEDOUT" ||
+    c === "ENOTFOUND" ||
+    c === "EAI_AGAIN" ||
+    c === "EPIPE" ||
+    c === "UND_ERR_CONNECT_TIMEOUT" ||
+    c === "UND_ERR_SOCKET"
+  )
+}
+
+function matchMessage(message: string) {
+  const m = message.toLowerCase()
+  // #139：message 关键字启发式
+  return (
+    m.includes("fetch failed") ||
+    m.includes("network") ||
+    m.includes("econnreset") ||
+    m.includes("econnrefused") ||
+    m.includes("etimedout") ||
+    m.includes("socket hang up") ||
+    m.includes("aborted") ||
+    m.includes("connection")
+  )
+}
diff --git a/packages/tui/test/util/connection-error.test.ts b/packages/tui/test/util/connection-error.test.ts
new file mode 100644
index 0000000000..e304375e4e
--- /dev/null
+++ b/packages/tui/test/util/connection-error.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, test } from "bun:test"
+import { ConnectionError } from "../../src/util/connection-error"
+
+describe("ConnectionError.isConnectionError", () => {
+  // #139：AbortError 可恢复
+  test("detects AbortError", () => {
+    expect(ConnectionError.isConnectionError(Object.assign(new Error("aborted"), { name: "AbortError" }))).toBe(true)
+  })
+  // #139：fetch failed 可恢复
+  test("detects fetch failed message", () => {
+    expect(ConnectionError.isConnectionError(new Error("fetch failed"))).toBe(true)
+  })
+  // #139：ECONNRESET code
+  test("detects ECONNRESET code", () => {
+    expect(ConnectionError.isConnectionError(Object.assign(new Error("x"), { code: "ECONNRESET" }))).toBe(true)
+  })
+  // #139：cause 链
+  test("walks cause chain", () => {
+    const root = Object.assign(new Error("wrap"), {
+      cause: Object.assign(new Error("inner"), { code: "ECONNREFUSED" }),
+    })
+    expect(ConnectionError.isConnectionError(root)).toBe(true)
+  })
+  test("rejects ordinary errors", () => {
+    expect(ConnectionError.isConnectionError(new Error("validation failed"))).toBe(false)
+  })
+})
