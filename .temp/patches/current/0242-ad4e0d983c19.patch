 export const filterCompactedEffect = Effect.fnUntraced(function* (sessionID: SessionID) {
   // #205：压缩恢复需要 hidden 结构锚点作为边界；visible() 会从返回的 prompt 窗口剔除它们
   return filterCompacted(yield* stream(sessionID, { includeHidden: true }))
