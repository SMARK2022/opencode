 export const CatalogModelStatus = Schema.Literals(["alpha", "beta", "deprecated"])
@@ -146,6 +147,9 @@
   Effect.gen(function* () {
     const fs = yield* FSUtil.Service
     const events = yield* EventV2.Service
+    // #268：yield HttpClient.HttpClient 后接 filterStatusOk——后续 execute 拿到的是已过滤客户端
+    const http = HttpClient.filterStatusOk(yield* HttpClient.HttpClient)
+    // #268：filterStatusOk 把 4xx/5xx 转为失败——目录源拉取失败不得以空目录静默成功
     // #150：模型源 HTTP 仅走 NetworkProxy.routedFetch
 
     const source = Flag.OPENCODE_MODELS_URL || "https://models.dev"
@@ -164,23 +167,23 @@
     })
 
     const fetchApi = Effect.fn("ModelsDev.fetchApi")(function* () {
-      // infrastructure 用途走 NetworkProxy.routedFetch，真正应用系统代理（非仅 resolve）
-      // #71：非 2xx 用 Effect.fail（可被 refresh 的 ignore 吞掉），禁止 Promise throw 变 defect
-      const res = yield* Effect.tryPromise({
-        try: () =>
-          NetworkProxy.routedFetch(`${source}/api.json`, {
-            purpose: "infrastructure",
+      // #268：HttpClient seam 替代直接 routedFetch——保留测试和 recorder 注入能力；
+      // #268：失败仍走 Effect.fail 通道，refresh 的 ignore 吞掉语义与 #71 一致
+      // #268：生产路径由 infrastructureHttpClientLayer 接到 NetworkProxy，不能改成裸 FetchHttpClient
+      return yield* Effect.gen(function* () {
+        const result = yield* http.execute(
+          HttpClientRequest.get(`${source}/api.json`, {
             headers: { "User-Agent": USER_AGENT },
           }),
-        catch: (cause) => cause as Error,
-      }).pipe(Effect.timeout("10 seconds"))
-      if (!res.ok) {
-        return yield* Effect.fail(new Error(`models.dev fetch failed: ${res.status}`))
-      }
-      return yield* Effect.tryPromise({
-        try: () => res.text(),
-        catch: (cause) => cause as Error,
-      })
+        )
+        return yield* result.text
+      }).pipe(
+        // #268：保留 10 秒超时边界，超时必须覆盖响应体读取
+        Effect.timeoutOrElse({
+          duration: Duration.seconds(10),
+          orElse: () => Effect.fail(new Error("Failed to fetch models.dev: timeout")),
+        }),
+      )
     })
 
     const loadFromDisk = fs.readJson(Flag.OPENCODE_MODELS_PATH ?? filepath).pipe(
@@ -263,7 +265,8 @@ const layer = Layer.effect(
   }),
 )
 
-// #150：ModelsDev 不再依赖 Effect HttpClient 层
-export const node = makeGlobalNode({ service: Service, layer: layer, deps: [FSUtil.node, EventV2.node] })
+// #268：ModelsDev 现在依赖 HttpClient seam，生产路径由 NetworkProxy 提供
+// #268：provide 放在 node 边界而非 layer 内——layer 保持可注入，生产组装才固定走 NetworkProxy
