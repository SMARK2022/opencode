diff --git a/packages/core/src/network-proxy.ts b/packages/core/src/network-proxy.ts
index 04de50deb..c01e24e51 100644
--- a/packages/core/src/network-proxy.ts
+++ b/packages/core/src/network-proxy.ts
@@ -1,5 +1,8 @@
 export * as NetworkProxy from "./network-proxy"
 
+import { Effect } from "effect"
+import { HttpClient, HttpClientError, HttpClientRequest, HttpClientResponse } from "effect/unstable/http"
+
 // #83：purpose 分流插件/provider/基础设施流量
 export type Purpose = "local" | "provider" | "infrastructure" | "npm" | "plugin" | "unknown"
 
@@ -212,6 +215,35 @@
   return fetch(input, init)
 }
 
+// #268：Effect HttpClient 与 NetworkProxy 之间的桥——调用方依赖 HttpClient，真实传输回到 NetworkProxy fetch
+// #268：infrastructure 固定 purpose，仅用于 models.dev 等基础设施元数据请求
+export const infrastructureHttpClientLayer = HttpClient.layerMergedContext(
+  Effect.succeed(
+    HttpClient.make((request, _url, signal) =>
+      Effect.gen(function* () {
+        const web = yield* HttpClientRequest.toWeb(request, { signal }).pipe(
+          Effect.mapError(
+            (cause) =>
+              new HttpClientError.HttpClientError({
+                reason: new HttpClientError.TransportError({ request, cause }),
+  // #268：错误统一映射 TransportError——消费方拿到的是 Effect HttpClient 错误契约而非裸 fetch 异常
+              }),
+          ),
+        )
+        return yield* Effect.tryPromise({
+          try: () => fetch(web, { purpose: "infrastructure", signal }),
+          // #268：signal 由 HttpClient 调用方传入——外层超时的中断经此传播到传输层
+          catch: (cause) =>
+            new HttpClientError.HttpClientError({
+              reason: new HttpClientError.TransportError({ request, cause }),
+            }),
+        }).pipe(Effect.map((response) => HttpClientResponse.fromWeb(request, response)))
+      }),
+    ),
+  ),
+)
+
+
 /**
  * Primary network fetch entry point.
  *
diff --git a/packages/core/test/network-proxy.test.ts b/packages/core/test/network-proxy.test.ts
index 3643243ea..2d1e6b92f 100644
--- a/packages/core/test/network-proxy.test.ts
+++ b/packages/core/test/network-proxy.test.ts
@@ -1,4 +1,6 @@
 import { afterEach, describe, expect, test } from "bun:test"
+import { Effect } from "effect"
+import { HttpClient } from "effect/unstable/http"
 import { NetworkProxy } from "../src/network-proxy"
 
 const originalFetch = globalThis.fetch
@@ -27,4 +29,35 @@
     expect(called).toBe(false)
     expect(response).toBeInstanceOf(Error)
   })
+
+  test("infrastructureHttpClientLayer keeps Effect HTTP calls off global fetch mocks", async () => {
+  // #268：mock fetch 计数必须为 0——证明 Effect HTTP 走原生 fetch 桥而非全局 mock
+    let called = false
+  // #268：Object.assign 保留原 fetch 引用——afterEach 恢复后不影响同文件其他用例
+    globalThis.fetch = Object.assign(() => {
+      called = true
+      return Promise.resolve(new Response("mocked"))
+    }, { preconnect: originalFetch.preconnect })
+    // #268：本地 Bun server 固定成功路径：缺少 HttpClient layer 会直接失败
+    const server = Bun.serve({
+      port: 0,
+      fetch() {
+        return new Response("native")
+      },
+    })
+
+    try {
+      const body = await Effect.runPromise(
+        HttpClient.get(`${server.url}`).pipe(
+          Effect.provide(NetworkProxy.infrastructureHttpClientLayer),
+          Effect.flatMap((response) => response.text),
+        ),
+      )
+
+      expect(body).toBe("native")
+      expect(called).toBe(false)
+    } finally {
+      server.stop(true)
+    }
+  })
 })
