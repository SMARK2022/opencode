diff --git a/packages/tui/src/routes/session/index.tsx b/packages/tui/src/routes/session/index.tsx
index 7fcee68c770875018ba003fbba3e6fc70ba9acdd..b69271eed6025a3914cbc424245592735cfdded8 100644
--- a/packages/tui/src/routes/session/index.tsx
+++ b/packages/tui/src/routes/session/index.tsx
@@ -2222,10 +2222,66 @@
   const limited = createMemo(() => {
     if (expanded() || !collapsed().overflow) return code()
     return collapsed().output
+  })
+  // 文件覆写 diff：当 write 工具覆写已有文件时，metadata.diff 包含 git diff 格式的变更
+  const diff = createMemo(() => props.metadata.diff as string | undefined)
+  // 覆写判断：文件已存在且 diff 非空时显示 diff 视图
+  const isOverwrite = createMemo(() => props.metadata.exists === true && !!diff())
+  // diff 样式：跟随用户配置的 diff_style，stacked 模式下使用 unified 视图
+  // diff 视图模式：stacked 模式强制 unified，auto 模式按终端宽度选择 split/unified
+  const diffView = createMemo(() => {
+    const diffStyle = ctx.tui.diff_style
+    if (diffStyle === "stacked") return "unified"
+    return ctx.width > 120 ? "split" : "unified"
   })
+  // diff 统计：计算添加/删除行数，超过 20 行时显示展开/收缩
+  const diffStats = createMemo(() => {
+    const d = diff()
+    if (!d) return { added: 0, removed: 0, total: 0 }
+    const added = (d.match(/^\+[^+]/gm) || []).length
+    const removed = (d.match(/^-[^-]/gm) || []).length
+    return { added, removed, total: added + removed }
+  })
+  const diffOverflow = createMemo(() => diffStats().total > 20)
 
   return (
     <Switch>
+      <Match when={isOverwrite()}>
+        <BlockTool
+          title={"← Write " + pathFormatter.format(stringValue(props.input.filePath)) + (diffStats().added > 0 || diffStats().removed > 0 ? ` (+${diffStats().added}/-${diffStats().removed})` : "")}
+          part={props.part}
+          onClick={diffOverflow() ? () => setExpanded((prev) => !prev) : undefined}
+        >
+          {/* diff 高度限制：折叠时最多显示 15 行，展开时显示全部 */}
+          <box paddingLeft={1} maxHeight={expanded() ? undefined : 15}>
+            <diff
+              diff={diff()!}
+              syncScroll={true}
+              view={diffView()}
+              filetype={filetype(stringValue(props.input.filePath))}
+              syntaxStyle={syntax()}
+              showLineNumbers={true}
+              width="100%"
+              wrapMode={ctx.diffWrapMode()}
+              fg={theme.text}
+              addedBg={theme.diffAddedBg}
+              removedBg={theme.diffRemovedBg}
+              contextBg={theme.diffContextBg}
+              addedSignColor={theme.diffHighlightAdded}
+              removedSignColor={theme.diffHighlightRemoved}
+              lineNumberFg={theme.diffLineNumber}
+              lineNumberBg={theme.diffContextBg}
+              addedLineNumberBg={theme.diffAddedLineNumberBg}
+              removedLineNumberBg={theme.diffRemovedLineNumberBg}
+            />
+          </box>
+          <Show when={diffOverflow()}>
+            <text fg={theme.textMuted}>{expanded() ? "Click to collapse" : "Click to expand"}</text>
+          </Show>
+          {/* 诊断信息：覆写后显示 LSP 错误和警告 */}
+          <Diagnostics diagnostics={props.metadata.diagnostics} filePath={stringValue(props.input.filePath) ?? ""} />
+        </BlockTool>
+      </Match>
       <Match when={props.metadata.diagnostics !== undefined}>
         <BlockTool
           title={"# Wrote " + pathFormatter.format(stringValue(props.input.filePath))}
@@ -2555,6 +2611,8 @@
           {/* 使用 maxHeight 限制初始显示高度，展开时移除限制 */}
           <box paddingLeft={1} maxHeight={expanded() ? undefined : 15}>
             <diff
+              // 同步滚动：diff 视图与代码视图同步滚动，提升编辑体验
+              syncScroll={true}
               diff={diffContent()}
               view={view()}
               filetype={ft()}
@@ -2652,6 +2710,7 @@
                 {/* 内联 diff 组件：移除独立 Diff 函数，直接使用 maxHeight 控制折叠 */}
                     <box paddingLeft={1} maxHeight={patchExpanded() ? undefined : 15}>
                       <diff
+                        syncScroll={true}
                         diff={file.patch || ""}
                         view={view()}
                         filetype={filetype(file.filePath)}


