diff --git a/packages/core/test/effect/cross-spawn-spawner.test.ts b/packages/core/test/effect/cross-spawn-spawner.test.ts
index fc4e3db6a..733374ff1 100644
--- a/packages/core/test/effect/cross-spawn-spawner.test.ts
+++ b/packages/core/test/effect/cross-spawn-spawner.test.ts
@@ -112,7 +112,10 @@ describe("cross-spawn spawner", () => {
             ChildProcess.make(process.execPath, ["-e", "process.stdout.write(process.cwd())"], { cwd: tmp.path }),
           ),
         )
-        expect(yield* Effect.promise(() => fs.realpath(out))).toBe(yield* Effect.promise(() => fs.realpath(tmp.path)))
+        // #269：macOS 可报 /private/var，Windows runner 可报 8.3 短路径：同时 realpath 两侧并 normalize
+        const expected = yield* Effect.promise(() => fs.realpath(tmp.path))
+        const actual = yield* Effect.promise(() => fs.realpath(out))
+        expect(path.normalize(actual)).toBe(path.normalize(expected))
       }),
     )
 
diff --git a/packages/opencode/src/plugin/tui/runtime.ts b/packages/opencode/src/plugin/tui/runtime.ts
index 801598c78..3330a6f31 100644
--- a/packages/opencode/src/plugin/tui/runtime.ts
+++ b/packages/opencode/src/plugin/tui/runtime.ts
@@ -1029,11 +1029,13 @@ export async function installPlugin(spec: string, options?: { global?: boolean }
 
 export async function dispose() {
   const task = loaded
+  // #269：在 await 前捕获 state，避免 await 期间新 init() 设置 runtime 后被误清空
+  const state = runtime
   loaded = undefined
   dir = ""
   if (task) await task.catch((error) => fail("failed to finish loading tui plugins during disposal", { error }))
-  const state = runtime
-  runtime = undefined
+  // #269：只有 runtime 仍指向本轮 state 时才清空
+  if (runtime === state) runtime = undefined
   if (!state) return
   const queue = [...state.plugins].reverse()
   for (const plugin of queue) {
diff --git a/packages/opencode/src/server/routes/instance/httpapi/handlers/session.ts b/packages/opencode/src/server/routes/instance/httpapi/handlers/session.ts
index 57234a67d..23e871453 100644
--- a/packages/opencode/src/server/routes/instance/httpapi/handlers/session.ts
+++ b/packages/opencode/src/server/routes/instance/httpapi/handlers/session.ts
@@ -487,6 +487,11 @@ export const sessionHandlers = HttpApiBuilder.group(InstanceHttpApi, "session",
   // 助手用量明细：返回请求下所有助手消息的 token 分布
   const requestUsageAssistants = Effect.fn("SessionHttpApi.requestUsageAssistants")(function* (ctx) {
     yield* requireSession(ctx.params.sessionID)
+    // #269：先确认父请求存在，避免缺失 request 被误解释为“存在但 assistant 为空”
+    const result = yield* usageSvc.get({ sessionID: ctx.params.sessionID, requestID: ctx.params.requestID }).pipe(
+      Effect.mapError(() => new HttpApiError.NotFound({})),
+    )
+    if (!result) return yield* new HttpApiError.NotFound({})
     const rows = yield* usageSvc.assistants({ sessionID: ctx.params.sessionID, requestID: ctx.params.requestID })
     return rows.map(mapAssistant)
   })
