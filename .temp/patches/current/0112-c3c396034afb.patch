         return {
           title: isDeleting ? `Press ${keybind.print("session_delete")} again to confirm` : x.title,
           bg: isDeleting ? theme.error : undefined,
@@ -169,6 +213,7 @@ export function DialogSessionList() {
           category,
           footer,
           gutter: isWorking ? () => <Spinner /> : undefined,
+          previewLines,
         }
       })
   })
