+// #155：复用 strip-ansi 去 CSI 序列
+import stripAnsi from "strip-ansi"
 import { PermissionV1 } from "@opencode-ai/core/v1/permission"
 import { Effect, Schema } from "effect"
 import { SessionV1 } from "@opencode-ai/core/v1/session"
@@ -96,6 +98,40 @@
       ? Def<P, M>
       : never
 
+
+// #155：终端可见文本清理：CRLF→LF，去 ANSI，C0/C1 转 \xHH
+function sanitizeVisibleText(text: string) {
+  return stripAnsi(text.replace(/\r\n/g, "\n")).replace(/[\u0000-\u0008\u000b-\u001f\u007f-\u009f]/g, (char) => {
+    return `\\x${char.charCodeAt(0).toString(16).padStart(2, "0")}`
+  })
+}
+
+// #155：仅顶层 string metadata 字段
+// #155：metadata 顶层 string 字段逐项清理
+function sanitizeMetadata<M extends Record<string, unknown>>(metadata: M | undefined) {
+  if (!metadata) return metadata
+  let changed = false
+  const next: Record<string, unknown> = { ...metadata }
+  for (const [key, value] of Object.entries(metadata)) {
+    if (typeof value !== "string") continue
+    const safe = sanitizeVisibleText(value)
+    if (safe !== value) {
+      changed = true
+      next[key] = safe
+    }
+  }
+  return changed ? (next as M) : metadata
+}
+
+// #155：统一最终 output/metadata 清理入口
+function sanitizeResult<M extends Record<string, unknown>>(result: { output: string; metadata: M }) {
+  // #155：output 主文本必清
+const output = sanitizeVisibleText(result.output)
+  const metadata = sanitizeMetadata(result.metadata) ?? result.metadata
+  if (output === result.output && metadata === result.metadata) return result
+  return { ...result, output, metadata }
+}
+
 function wrap<Parameters extends Schema.Decoder<unknown>, Result extends Metadata>(
   id: string,
   init: Init<Parameters, Result>,
@@ -111,6 +147,16 @@
       const decode = Schema.decodeUnknownEffect(toolInfo.parameters)
