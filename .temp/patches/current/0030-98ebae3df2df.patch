   readonly options?: AppProcess.RunOptions
@@ -75,1 +77,3 @@
-        runs.push({ command: command.command, cwd: command.options.cwd, shell: command.options.shell, options })
+        // 在既有 process 观察边界记录真正交给 spawner 的环境，不重复执行命令。
+        runs.push({ command: command.command, cwd: command.options.cwd, shell: command.options.shell,
+          env: command.options.env, extendEnv: command.options.extendEnv, options })
@@ -202,2 +206,11 @@
             expect(assertions).toMatchObject([{ sessionID, action: "bash", resources: ["pwd"], save: ["pwd"] }])
+            // 真实 leaf 的环境必须继承宿主，四项 Windows 覆盖与已有 options 精确对应。
+            expect(runs[0]?.extendEnv).toBe(true)
+            expect(runs[0]?.env).toEqual(process.platform === "win32" ? {
+              PYTHONIOENCODING: "utf-8",
+              PYTHONUTF8: "1",
+              JAVA_TOOL_OPTIONS: `${process.env.JAVA_TOOL_OPTIONS || ""} -Dfile.encoding=UTF-8`.trim(),
+              RUBYOPT: `${process.env.RUBYOPT || ""} -Eutf-8`.trim(),
+            } : {})
+            expect(runs).toHaveLength(1)
             // 真正 BashTool 节点注册的 typed source 必须描述实际进程选择，不只测试 formatter。
diff --git a/packages/core/test/shell.test.ts b/packages/core/test/shell.test.ts
--- a/packages/core/test/shell.test.ts
+++ b/packages/core/test/shell.test.ts
@@ -23,2 +23,19 @@
 describe("shell", () => {
+  test("builds Windows UTF-8 overlays without mutating the inherited environment", () => {
+    const env = { PATH: "configured-path", JAVA_TOOL_OPTIONS: "-Xmx1g", RUBYOPT: "-w", PYTHONUTF8: "0" }
+    // 平台作为纯输入覆盖两支，不写全局环境或伪造 process.platform。
+    expect(Shell.utf8Environment(env, "linux")).toEqual({})
+    expect(Shell.utf8Environment(env, "darwin")).toEqual({})
+    expect(Shell.utf8Environment(env, "win32")).toEqual({
+      PYTHONIOENCODING: "utf-8", PYTHONUTF8: "1",
+      JAVA_TOOL_OPTIONS: "-Xmx1g -Dfile.encoding=UTF-8", RUBYOPT: "-w -Eutf-8",
+    })
+    // 空值必须 trim 掉前导空格；任意非编码变量仍由 process 环境继承。
+    expect(Shell.utf8Environment({}, "win32")).toEqual({
+      PYTHONIOENCODING: "utf-8", PYTHONUTF8: "1",
+      JAVA_TOOL_OPTIONS: "-Dfile.encoding=UTF-8", RUBYOPT: "-Eutf-8",
+    })
+    expect(env).toEqual({ PATH: "configured-path", JAVA_TOOL_OPTIONS: "-Xmx1g", RUBYOPT: "-w", PYTHONUTF8: "0" })
+  })
+
   test("normalizes shell names", () => {
