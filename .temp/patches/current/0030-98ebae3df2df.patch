@@ -221,2 +221,6 @@
                 shell,
+                // UTF-8 覆盖附着于现有 ChildProcess；保持宿主环境继承，不复制或重跑采集流程。
+                extendEnv: true,
+                // V2 尚无插件 shell.env owner；这里只叠加源编码设置，不能恢复 legacy hook。
+                env: Shell.utf8Environment(),
                 stdin: "ignore",
