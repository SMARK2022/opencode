 }
 
@@ -1365,6 +1367,44 @@
  * 主入口：压缩传入的可见文本，返回压缩后的文本以及详细的统计信息
  * 优化后的流水线顺序：Secret redaction → 虚拟终端渲染 → 模板化压缩 → 多行块 → 单行重复 → 高熵长行 → 行内模式
  */
+// CLIXML 解码器：将 PowerShell 的 CLIXML XML 格式解码为纯文本
+// CLIXML 是 PowerShell 的 XML 错误序列化格式，将终端彩色文本包装在 <Objs><S S="...">_xHHHH_</S></Objs> 中
+// 返回解码后的多行文本（包装在 <high-entropy powershell-clixml> 标签中），非 CLIXML 输入返回 null
+function transformPowerShellClixml(text: string): string | null {
+  const trimmed = text.trimStart()
+  // CLIXML 前缀检查：必须以 <Objs 开头才是 CLIXML 格式
+  if (!trimmed.startsWith("<Objs") && !/^[\s\S]*<Objs\b/.test(trimmed)) return null
+
+  // 提取 <S S="...">text</S> 节点中的文本内容
+  const decoded = /<S\s+S="[^"]*">([^<]*)<\/S>/gi
+  const parts: string[] = []
+  let match: RegExpExecArray | null
+  while ((match = decoded.exec(text)) !== null) {
+    parts.push(clixmlDecodeHexEscapes(match[1]))
+  }
+  if (parts.length === 0) return null
+
+  let plain = parts.join("")
+  // 清除 ANSI 控制序列：CLIXML 解码后可能残留终端颜色码
+  plain = plain.replace(ANSI_GLOBAL_RE, "")
+  // 统一换行符：将 \r\n 转换为 \n
+  plain = plain.replace(/\r\n/g, "\n")
+  plain = plain.trimEnd()
+
+  if (!plain) return null
+
+  return `<high-entropy powershell-clixml>${plain}</high-entropy>`
+}
+
+// 十六进制转义解码：PowerShell CLIXML 使用 _xHHHH_ 格式编码 Unicode 字符
+function clixmlDecodeHexEscapes(value: string): string {
+  return value.replace(/_x([0-9A-Fa-f]{4,})_/g, (_, hex) => {
+    const num = parseInt(hex, 16)
+    // 保留可打印 ASCII 范围；非打印控制字符原样传递（ANSI 清除在后续步骤执行）
+    return String.fromCharCode(num)
+  })
+}
+
 export function compressVisibleOutput(text: string, configInput?: Partial<CompressionConfig>): CompressResult {
   const config = configOf(configInput)
   const originalBytes = byteLen(text)
@@ -1382,6 +1422,23 @@
     highEntropyLines: 0,
     secretsRedacted: 0,
     applied: false,
+  }
+
+  // 步骤 0a：PowerShell CLIXML 解码 — 在主压缩流程之前将 CLIXML 转换为纯文本
+  const clixml = transformPowerShellClixml(text)
+  if (clixml) {
+    const compressedBytes = byteLen(clixml)
+    return {
+      text: clixml,
+      stats: {
+        ...emptyStats,
+        compressedBytes,
+        savedBytes: originalBytes - compressedBytes,
+        savingRatio: originalBytes > 0 ? (originalBytes - compressedBytes) / originalBytes : 0,
+        highEntropyLines: 1,
+        applied: true,
+      },
+    }
   }
 
   // 禁用或不值得压缩时直接返回


