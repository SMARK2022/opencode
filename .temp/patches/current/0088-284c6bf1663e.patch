--- a/packages/opencode/src/tool/bash-compress.ts
+++ b/packages/opencode/src/tool/bash-compress.ts
@@ -1133,6 +1133,8 @@
   if (/^data:image\/[^;]+;base64,/.test(line)) return 'data-uri'
   if (/^[{[].*[}\]]$/.test(line.trim()) && line.length > 1000) return 'minified-json'
   if (/^[0-9a-f]{64,}$/i.test(line.trim())) return 'hex-dump'
+  // PowerShell CLIXML 检测：识别 <Objs> 开头的 CLIXML 格式输出，用于后续解码
