daemon stop 主动关闭共享后台时，先向已连接 TUI 广播 daemon-stop 事件，让 TUI 走正常退出路径。

同时将 lock 清理延后到实例 dispose、server stop 和 Database.close 之后。

diff --git a/packages/opencode/src/cli/tui/worker.ts b/packages/opencode/src/cli/tui/worker.ts
index 849a91e..e14c1cb 100644
--- a/packages/opencode/src/cli/tui/worker.ts
+++ b/packages/opencode/src/cli/tui/worker.ts
@@ -15,6 +15,7 @@ import { Database } from "@opencode-ai/core/database/database"
 import { ServerLock } from "@/cli/tui/server-lock"
 import { onSseClientCountChange } from "@/server/routes/instance/httpapi/handlers/global"
 import { SessionActivity } from "@/session/activity"
+import { DisposedReason, Event as ServerEvent } from "@/server/event"
 
 Heap.start()
 
@@ -119,8 +120,8 @@ if (isDaemon) {
       sseClients,
       sessionActivity: SessionActivity.count(),
     })
-    // 仅当 token 匹配时删除锁，防止误删不再属于自己的锁
-    await ServerLock.clearIfOwner(lockToken)
+    // #273：daemon stop 时先广播事件，让 TUI 走正常退出路径
+    if (reason === DisposedReason.DaemonStop) notifyDaemonStop()
     // #259：control server 随 daemon 一起关闭——避免端口残留
     controlServer?.stop(true)
     // #235：disposeAllInstances 与 Server.stop(true) 在 Windows 顺序场景偶发挂起
@@ -136,9 +137,22 @@ if (isDaemon) {
     ])
     // 关闭数据库前执行 WAL TRUNCATE 检查点，确保数据落盘
     Database.close()
+    // #273：lock 清理延后到 dispose/stop/Database.close 之后，避免新 daemon 过早接管
+    await ServerLock.clearIfOwner(lockToken)
     process.exit(0)
   }
 
+  // #273：daemon stop 时向已连接 TUI 广播 global.disposed 事件
+  function notifyDaemonStop() {
+    GlobalBus.emit("event", {
+      directory: "global",
+      payload: {
+        type: ServerEvent.Disposed.type,
+        properties: { reason: DisposedReason.DaemonStop },
+      },
+    })
+  }
+
   // SIGTERM 触发优雅关闭
   process.on("SIGTERM", () => void gracefulShutdown("signal:SIGTERM"))
 
@@ -211,7 +225,7 @@ if (isDaemon) {
       if (request.method !== "POST" || url.pathname !== ServerLock.CONTROL_SHUTDOWN_PATH)
         return new Response("not found", { status: 404 })
       // #259：setTimeout 避免在 fetch handler 内直接关闭——让响应先返回
-      setTimeout(() => void gracefulShutdown("daemon-stop"), 0).unref?.()
+      setTimeout(() => void gracefulShutdown(DisposedReason.DaemonStop), 0).unref?.()
       return Response.json({ ok: true })
     },
   })
