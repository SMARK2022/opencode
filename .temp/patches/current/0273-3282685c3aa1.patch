+          // #273：直接调用 exit 函数，原因作为参数传递
+          void exit("opencode daemon stopped.")
+          break
         case "server.instance.disposed":
+          // #273：daemon stop 已设置退出标志，不再重连
+          if (daemonStopSeen) break
           void bootstrap()
           break
         case "server.connected":
@@ -682,7 +696,6 @@ export const {
       pendingPartDeltas = []
     })
 
