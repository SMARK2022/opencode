HttpApiApp.webHandler 是进程级缓存实例，单个 MCP 测试释放它会关闭后续请求复用的 scope，导致 Goal 恢复清理在隐藏消息后被中断。改为借用共享 handler，保留原有 Instance 和数据库清理。

复现并消除 MCP 在前、Goal 在后的顺序相关失败；Windows 与 Linux 完整 server 回归、原 CI 顺序重放及包内类型检查均通过，不修改生产逻辑或放宽测试断言。
适配说明（0643，目标 v1.18.32）：
1. 唯一 source 文件 packages/opencode/test/server/httpapi-mcp.test.ts 在目标同路径同职责；生产 owner src/server/routes/instance/httpapi/server.ts 的 webHandler 同为 lazy 进程级缓存＋共享 memoMap，不变式与 source 完全一致。
2. 目标 0642 基线从未引入 source 的 handlerScoped acquireRelease（各用例就地借用 HttpApiApp.webHandler()，全仓无 handler.dispose 调用），source 修复针对的释放回归在目标不存在；不凭空重建该 bug 形态再删除。
3. 完整移植 source 修复后语义：TestHandler 类型后新增 source 逐字不变式注释与 sharedHandler = Effect.sync(() => HttpApiApp.webHandler())，4 处就地获取全部改为 yield* sharedHandler（source 为 3 处；目标第 4 处 not-found 用例属同一获取面，一并收敛，终态与 source 一致：MCP HttpApi 用例一律经共享 seam 借用）。
4. 保留全部既有用例、Instance 与 resetDatabase 清理及断言，不改生产逻辑；test/mcp/* 单元测试与 V2（packages/core 无 MCP handler 测试，packages/server 的 webHandler 每次新建实例）均无共享 handler 关切，无需适配。

diff --git a/packages/opencode/test/server/httpapi-mcp.test.ts b/packages/opencode/test/server/httpapi-mcp.test.ts
index 42a4398..13ba458 100644
--- a/packages/opencode/test/server/httpapi-mcp.test.ts
+++ b/packages/opencode/test/server/httpapi-mcp.test.ts
@@ -22,6 +22,10 @@ function app() {
 type TestApp = ReturnType<typeof app>
 type TestHandler = ReturnType<typeof HttpApiApp.webHandler>
 
+// webHandler 是进程共享实例；单个测试不能关闭后续 HTTP 请求仍会使用的 scope。
+// 目标基线本就地借用且从不 dispose；集中为 sharedHandler seam 统一获取面并显式承载该不变式。
+const sharedHandler = Effect.sync(() => HttpApiApp.webHandler())
+
 const request = Effect.fnUntraced(function* (
   handler: TestHandler,
   route: string,
@@ -61,7 +65,7 @@ describe("mcp HttpApi", () => {
     () =>
       Effect.gen(function* () {
         const tmp = yield* TestInstance
-        const handler = HttpApiApp.webHandler()
+        const handler = yield* sharedHandler
         const response = yield* request(handler, McpPaths.status, tmp.directory)
 
         expect(response.status).toBe(200)
@@ -85,7 +89,7 @@ describe("mcp HttpApi", () => {
     () =>
       Effect.gen(function* () {
         const tmp = yield* TestInstance
-        const handler = HttpApiApp.webHandler()
+        const handler = yield* sharedHandler
         const added = yield* request(handler, McpPaths.status, tmp.directory, {
           method: "POST",
           headers: { "content-type": "application/json" },
@@ -131,7 +135,7 @@ describe("mcp HttpApi", () => {
     () =>
       Effect.gen(function* () {
         const tmp = yield* TestInstance
-        const handler = HttpApiApp.webHandler()
+        const handler = yield* sharedHandler
         const start = yield* request(handler, "/mcp/demo/auth", tmp.directory, { method: "POST" })
         expect(start.status).toBe(400)
 
@@ -194,7 +198,7 @@ describe("mcp HttpApi", () => {
     () =>
       Effect.gen(function* () {
         const tmp = yield* TestInstance
-        const handler = HttpApiApp.webHandler()
+        const handler = yield* sharedHandler
 
         for (const input of [
           { method: "POST", route: "/mcp/missing/auth" },
