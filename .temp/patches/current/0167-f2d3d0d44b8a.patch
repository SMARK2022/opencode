@@ -546,51 +653,272 @@ add_to_path() {
     fi
 }
 
-XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
-current_shell=$(basename "${SHELL:-sh}")
+# #167：识别字面路径 / $HOME 相对 / ~ 相对是否已写入
+profile_has_install_dir() {
+    # #167：去重必须覆盖三种写法，否则默认全量扫描会双写
+    # #167：文件不存在视为未写入，允许后续 touch 创建
+    local config_file=$1
+    local home_relative=""
+    local tilde_relative=""
 
-case $current_shell in
-    fish)
-        config_files="$HOME/.config/fish/config.fish"
-    ;;
-    zsh)
-        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
-    ;;
-    bash)
-        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
-    ;;
-    ash)
-        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
-    ;;
-    sh)
-        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
-    ;;
-    *)
-        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
-    ;;
-esac
+    [ -f "$config_file" ] || return 1
 
-if [[ "$no_modify_path" != "true" ]]; then
-    config_file=""
-    for file in $config_files; do
-        if [[ -f $file ]]; then
-            config_file=$file
-            break
+    if profile_has_path_line "$config_file" "$INSTALL_DIR"; then
+        return 0
+    fi
+
+    if [[ "$INSTALL_DIR" == "$HOME/"* ]]; then
+        home_relative="\$HOME/${INSTALL_DIR#"$HOME/"}"
+        tilde_relative="~/${INSTALL_DIR#"$HOME/"}"
+        if profile_has_path_line "$config_file" "$home_relative" || profile_has_path_line "$config_file" "$tilde_relative"; then
+            return 0
+        fi
+    fi
+
+    return 1
+}
+
+# #167：只认 PATH=/export PATH=/fish_add_path 行上的 install dir 片段
+profile_has_path_line() {
+    # #167：排除注释/普通文本中偶然出现的目录字符串
+    # #167：fish_add_path 与 export PATH 共用同一去重入口
+    local config_file=$1
+    local install_dir=$2
+
+    grep -F "$install_dir" "$config_file" 2>/dev/null | grep -E '(^|[[:space:]])(export[[:space:]]+PATH=|PATH=|fish_add_path)' >/dev/null 2>&1
+}
+
+# #167：profile_targets 去重追加
+append_profile() {
+    # #167：同一 run 内目标列表必须稳定去重
+    # #167：保持用户指定顺序，先 explicit 后扫描
+    local file=$1
+    local existing
+
+    if [ "${#profile_targets[@]}" -gt 0 ]; then
+        for existing in "${profile_targets[@]}"; do
+            if [ "$existing" = "$file" ]; then
+                return 0
+            fi
+        done
+    fi
+
+    profile_targets+=("$file")
+}
+
+# #167：展开 ~/ 为 $HOME，供 --path-profile
+normalize_profile_path() {
+    # #167：仅展开 tilde，不解析其他 shell 扩展，避免意外求值
+    # #167：相对路径保持原样交给调用方
+    case "$1" in
+        "~")
+            echo "$HOME"
+        ;;
+        "~/"*)
+            echo "$HOME/${1#"~/"}"
+        ;;
+        *)
+            echo "$1"
+        ;;
+    esac
+}
+
+# #167：按 shell 列出候选 profile；ash/sh 不再写 /etc/profile
+append_shell_profile_candidates() {
+    # #167：zsh 增加 .zprofile，覆盖登录 shell 场景
+    # #167：故意不写 /etc/profile，避免系统级污染
+    local shell_name=$1
+
+    case $shell_name in
+        fish)
+            append_candidate "$HOME/.config/fish/config.fish"
+        ;;
+        zsh)
+            append_candidate "${ZDOTDIR:-$HOME}/.zshrc"
+            append_candidate "${ZDOTDIR:-$HOME}/.zprofile"
+            append_candidate "${ZDOTDIR:-$HOME}/.zshenv"
+            append_candidate "$XDG_CONFIG_HOME/zsh/.zshrc"
+            append_candidate "$XDG_CONFIG_HOME/zsh/.zprofile"
+            append_candidate "$XDG_CONFIG_HOME/zsh/.zshenv"
+        ;;
+        bash)
+            append_candidate "$HOME/.bashrc"
+            append_candidate "$HOME/.bash_profile"
+            append_candidate "$HOME/.profile"
+            append_candidate "$XDG_CONFIG_HOME/bash/.bashrc"
+            append_candidate "$XDG_CONFIG_HOME/bash/.bash_profile"
+        ;;
+        ash|sh)
+            append_candidate "$HOME/.ashrc"
+            append_candidate "$HOME/.profile"
+        ;;
+        *)
+            append_shell_profile_candidates bash
+        ;;
+    esac
+}
+
+# #167：候选列表去重
+append_candidate() {
+    # #167：候选去重与目标去重分离，避免扫描阶段丢文件
+    local file=$1
+    local existing
+
+    if [ "${#profile_candidates[@]}" -gt 0 ]; then
+        for existing in "${profile_candidates[@]}"; do
+            if [ "$existing" = "$file" ]; then
+                return 0
+            fi
+        done
+    fi
+
+    profile_candidates+=("$file")
+}
+
+# #167：默认扫描 bash/zsh/fish/sh 全部候选
+append_all_shell_profile_candidates() {
+    # #167：顺序 bash→zsh→fish→sh，稳定可测
+    # #167：覆盖跨 shell 用户（bash 登录但日常 zsh）
+    append_shell_profile_candidates bash
+    append_shell_profile_candidates zsh
+    append_shell_profile_candidates fish
+    append_shell_profile_candidates sh
+}
+
+# #167：无已存在 profile 时按当前 shell 创建默认目标
+select_default_profile() {
+    # #167：优先已存在文件，减少凭空创建
+    # #167：最终 fallback 按当前 SHELL 选一个可创建路径
+    local file
+
+    for file in "${profile_candidates[@]}"; do
+        if [ -f "$file" ]; then
+            append_profile "$file"
+            return 0
         fi
     done
 
-    if [[ -z $config_file ]]; then
-        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
-        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
-    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
-        case $current_shell in
-            fish)
-                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
-            ;;
-            *)
-                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
+    case $current_shell in
+        fish)
+            append_profile "$HOME/.config/fish/config.fish"
+        ;;
+        zsh)
+            append_profile "${ZDOTDIR:-$HOME}/.zshrc"
+        ;;
+        bash)
+            append_profile "$HOME/.bashrc"
+        ;;
+        *)
+            append_profile "$HOME/.profile"
+        ;;
+    esac
+}
+
+# #167：选择所有已存在候选；若无则 fallback 默认
+select_existing_profiles() {
+    # #167：默认策略核心：所有已存在候选都写
+    # #167：空结果才 fallback，避免“静默不写 PATH”
+    local file
+
+    for file in "${profile_candidates[@]}"; do
+        if [ -f "$file" ]; then
+            append_profile "$file"
+        fi
+    done
+
+    if [ "${#profile_targets[@]}" -eq 0 ]; then
+        select_default_profile
+    fi
+}
+
+# #167：/dev/tty 交互；无 TTY 返回失败由调用方回退
+select_interactive_profiles() {
+    # #167：读写 /dev/tty，不与管道 stdin 争用
+    # #167：用户全选 N 时允许零写入并警告
+    local file
+    local reply
+
+    if [ ! -r /dev/tty ] || [ ! -w /dev/tty ]; then
+        print_message warning "--interactive requested but no TTY is available; using default profile selection."
+        return 1
+    fi
+
+    print_message info "Select shell config files to update for opencode PATH:"
+    for file in "${profile_candidates[@]}"; do
+        if [ -f "$file" ]; then
+            printf "Update %s? [y/N] " "$file" > /dev/tty
+        else
+            printf "Create and update %s? [y/N] " "$file" > /dev/tty
+        fi
+
+        IFS= read -r reply < /dev/tty || reply=""
+        case $reply in
+            y|Y|yes|YES|Yes)
+                append_profile "$file"
             ;;
         esac
+    done
+
+    if [ "${#profile_targets[@]}" -eq 0 ]; then
+        print_message warning "No shell config file selected; PATH was not modified."
+    fi
+
+    return 0
+}
+
+# #167：fish 用 fish_add_path；其它 shell 写 export PATH=...
+path_command_for_profile() {
+    # #167：路径一律双引号，兼容含空格的 INSTALL_DIR
+    # #167：fish 专用 fish_add_path，避免 export 语法无效
+    local config_file=$1
+
+    case "$config_file" in
+        */fish/config.fish)
+            echo "fish_add_path \"$INSTALL_DIR\""
+        ;;
+        *)
+            echo "export PATH=\"$INSTALL_DIR:\$PATH\""
+        ;;
+    esac
+}
+
+XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
+current_shell=$(basename "${SHELL:-sh}")
+profile_candidates=()
+profile_targets=()
+
+if [[ "$no_modify_path" != "true" ]]; then
+    # #167：优先级 explicit path-profile > all-shell > interactive > 默认全量已存在
+    # #167：--no-modify-path 整段跳过，保留二进制安装成功语义
+    # #167：explicit 列表不再二次扫描，尊重用户白名单
+    if [ "${#path_profiles[@]}" -gt 0 ]; then
+        for file in "${path_profiles[@]}"; do
+            append_profile "$(normalize_profile_path "$file")"
+        done
+    elif [ "$all_shell_profiles_requested" = "true" ]; then
+        append_all_shell_profile_candidates
+        select_existing_profiles
+    elif [ "$interactive_path" = "true" ]; then
+        append_all_shell_profile_candidates
+        if ! select_interactive_profiles; then
+            profile_candidates=()
+            append_all_shell_profile_candidates
+            select_existing_profiles
+        fi
+    else
+        append_all_shell_profile_candidates
+        select_existing_profiles
+    fi
+
+    if [ "${#profile_targets[@]}" -gt 0 ]; then
+        for file in "${profile_targets[@]}"; do
+            add_to_path "$file" "$(path_command_for_profile "$file")"
+        done
+    fi
+
+    if [ "${#profile_targets[@]}" -eq 0 ]; then
+        print_message warning "No shell config file selected. You may need to manually add to PATH:"
+        print_message info "  export PATH=\"$INSTALL_DIR:\$PATH\""
     fi
 fi
 
diff --git a/README.zh.md b/README.zh.md
--- a/README.zh.md
+++ b/README.zh.md
@@ -46,19 +46,34 @@
 ### 安装
 
 ```bash
-# 直接安装 (YOLO)
-curl -fsSL https://opencode.ai/install | bash
+# SMARK 发行版安装（推荐）
+curl -fsSL https://github.com/SMARK2022/opencode/releases/latest/download/install | bash
+```
+
+> **#167 注意**：`OPENCODE_INSTALL_DIR=... curl ... | bash` 时 env 只作用于 `curl`，不会传到管道里的 `bash`。应写成先下载 install 再 `env OPENCODE_INSTALL_DIR=... bash /tmp/opencode-install`。
+
+#### 安装脚本行为（#167）
+
+| 场景 | 行为 |
+|---|---|
+| 目标目录已有同版本 | **重装刷新**，不跳过 |
+| PATH 上别处已有同版本 | 警告后仍安装到目标目录 |
+| 默认 PATH 改写 | 更新**所有已存在**的支持 shell profile |
+| sudo（uid=0 且 `SUDO_USER`） | 默认拒绝；需 `--allow-sudo` |
 
-# 软件包管理器
-npm i -g opencode-ai@latest        # 也可使用 bun/pnpm/yarn
-scoop install opencode             # Windows
-choco install opencode             # Windows
-brew install anomalyco/tap/opencode # macOS 和 Linux（推荐，始终保持最新）
-brew install opencode              # macOS 和 Linux（官方 brew formula，更新频率较低）
-sudo pacman -S opencode            # Arch Linux (Stable)
-paru -S opencode-bin               # Arch Linux (Latest from AUR)
-mise use -g opencode               # 任意系统
-nix run nixpkgs#opencode           # 或用 github:anomalyco/opencode 获取最新 dev 分支
+#### 常用安装参数
+
+| 参数 | 含义 |
+|---|---|
+| `--path-profile <path>` | 只改写指定 profile（可重复） |
+| `--all-shell-profiles` | 扫描全部支持 profile |
+| `--interactive` | 交互选择（无 TTY 回退默认） |
+| `--allow-sudo` | 允许在 sudo 下运行 |
+| `--no-modify-path` | 不改任何 shell profile |
+
+```bash
+# 兼容上游一键安装（非 SMARK 默认仓库）
+curl -fsSL https://opencode.ai/install | bash
 ```
 
