@@ -529,13 +622,27 @@ else
     download_and_install
 fi
 
-# #156：可选写 shell rc；--no-modify-path 跳过
+# #156：可选写 shell rc；#167：多 profile / 去重 / 可创建缺失文件
 add_to_path() {
+    # #167：写入失败不得中断已成功的二进制安装
