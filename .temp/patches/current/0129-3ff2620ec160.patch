       "if ($LASTEXITCODE -ne $null) { exit $LASTEXITCODE }",
     ].join("\n"),
     "utf16le",
diff --git a/packages/opencode/test/tool/bash-compress.test.ts b/packages/opencode/test/tool/bash-compress.test.ts
