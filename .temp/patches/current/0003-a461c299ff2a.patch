+    const chars = (sync.data.part[last.id] ?? []).reduce((sum, part) => {
+      // ignored 文本不进入模型输出，计入字符估算会把隐藏的合成内容收费化。
+      if (part.type === "text" && !part.ignored) return sum + part.text.length
