+    // 放宽 last 查找条件：不再要求 output > 0，流式输出中也需展示用量
+    // 尚未回传 usage 的助手也承载流式正文；按 output 筛选会错误选中上一轮回复。
+    const last = msg.findLast((item): item is AssistantMessage => item.role === "assistant")
