@@ -64,7 +66,7 @@ This runs `check-types && lint && node esbuild.js --production`.
 
 <!-- #110：Windows/Bun 下 vsce 嵌套 npm prepublish 会丢 PATH；package.json 已删除该 hook -->
 <!-- #110：vsix 必须 npm exec + --no-dependencies + dist 输出 -->
-<!-- #110：扩展版本与 CLI 1.17.24-smark 对齐 -->
+<!-- #110：扩展版本与 CLI 1.17.25-smark 对齐 -->
 <!-- #141：vsix 与 opencode 主版本同号协同升号 -->
 This project intentionally does not define `vscode:prepublish`. `vsce package` runs that hook through an internal `npm run vscode:prepublish` child process. In some Windows/Bun terminal environments that nested child process can lose `npm` from `PATH`, producing:
 
@@ -90,7 +92,7 @@ npx @vscode/vsce ls
 
 ```powershell
 $env:PATH="C:\Users\Lenovo\.bun\bin;$env:PATH"
-npm exec --yes --package @vscode/vsce -- vsce package --no-dependencies -o "dist/SMARK2022.opencode-ide-bridge-1.17.24.vsix"
+npm exec --yes --package @vscode/vsce -- vsce package --no-dependencies -o "dist/SMARK2022.opencode-ide-bridge-1.17.25.vsix"
 ```
 
 The output file is written under `sdks/vscode/dist/` together with the compiled extension bundle.
@@ -106,7 +108,7 @@ bun run vsix
 <!-- 「VSIX Artifact Structure」：回滚：uninstall 后清缓存再装旧包 -->
 
 ```
-dist/SMARK2022.opencode-ide-bridge-1.17.24.vsix
+dist/SMARK2022.opencode-ide-bridge-1.17.25.vsix
 ├─ [Content_Types].xml
 ├─ extension.vsixmanifest
 └─ extension/
@@ -135,7 +137,7 @@ dist/SMARK2022.opencode-ide-bridge-1.17.24.vsix
 <!-- 「Local VSIX Install」：scripts.vsix 的 dist 输出是安装契约 -->
 
 ```powershell
-code --install-extension .\dist/SMARK2022.opencode-ide-bridge-1.17.24.vsix --force
+code --install-extension .\dist/SMARK2022.opencode-ide-bridge-1.17.25.vsix --force
 ```
 
