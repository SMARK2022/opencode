From 60f600d1dcb2bb51379031e4d799cb38bc56fd46 Mon Sep 17 00:00:00 2001
From: SMARK2022 <3222301373@qq.com>
Date: Fri, 29 May 2026 15:25:09 +0800
Subject: [PATCH] feat(compaction): 修复：memento 现在从 rawHistory 采集，再用原来的 20%/20K
diff --git a/packages/opencode/src/session/compaction.ts b/packages/opencode/src/session/compaction.ts
index e3c4c0786..433ee7ed5 100644
--- a/packages/opencode/src/session/compaction.ts
+++ b/packages/opencode/src/session/compaction.ts
@@ -111,12 +111,16 @@ function collectRecentUserMessages(input: { messages: SessionV1.WithParts[]; max
   // #256：从最新到最旧反向收集——预算有限时先保住最新指令；压缩标记消息本身不是用户指令。
   for (const msg of input.messages.toReversed()) {
     if (msg.info.role !== "user") continue
+    // #257：撤销/隐藏产生的消息一律不进 memento——它们不是有效的用户意图
+    if (msg.info.hidden) continue
     if (msg.parts.some((part) => part.type === "compaction")) continue
     // #256：只保留用户手写文本——synthetic 编辑器/文件上下文与 ignored 修复文本
     // 已由其他通道表示，再进 memento 会把记忆变成又一个无界上下文源。
     const text = msg.parts
       .flatMap((part) => {
         if (part.type !== "text") return []
+        // #257：hidden part 同样排除——撤销粒度可到 part 级
+        if (part.hidden) return []
         if (part.synthetic || part.ignored) return []
         const text = part.text.trim()
         return text ? [text] : []
@@ -450,8 +454,11 @@ const layer = Layer.effect(
       // #256：visibleHistory 与 select 共用——memento 从可见窗口收集，避免把 hidden 的
       // 压缩标记/summary 对当作用户指令回放。
       const visibleHistory = history.filter((_, index) => !hidden.has(index))
+      // #257：memento 从 rawHistory 采集——filterCompacted 会移除已压缩 head，但那些
+      // 原始最近用户指令仍应有一次有界截断机会进入下次交接；hidden/synthetic/ignored/
+      // 压缩标记内容由 collectRecentUserMessages 内部排除。
       const recentUserMessages = collectRecentUserMessages({
-        messages: visibleHistory,
+        messages: rawHistory,
         maxTokens: preserveRecentUserBudget({ cfg, model, outputTokenMax: flags.outputTokenMax }),
       })
       const selected = yield* select({
diff --git a/packages/opencode/test/session/compaction.test.ts b/packages/opencode/test/session/compaction.test.ts
index 633b4aeb7..d7f4ca5ea 100644
--- a/packages/opencode/test/session/compaction.test.ts
+++ b/packages/opencode/test/session/compaction.test.ts
@@ -1183,9 +1183,64 @@
     { git: true },
   )
 
   itCompaction.instance(
     // #256：synthetic/ignored 文本不得污染 memento——过滤按 part 粒度生效
-    "keeps synthetic and ignored user text out of recent user mementos",
+    "preserves raw recent user instructions across repeated compactions",
+    () => {
+      const stub = llm()
+      const mementoModel = createModel({ context: 10_000, output: 8_000 })
+      stub.push(reply("first summary"))
+      stub.push(reply("second summary"))
+      return Effect.gen(function* () {
+        const test = yield* TestInstance
+        const ssn = yield* SessionNs.Service
+        const session = yield* ssn.create({})
+        yield* createUserMessage(
+          session.id,
+          `raw instruction before prior compaction ${"x".repeat(100_000)} end of raw instruction`,
+        )
+        yield* createSummaryCompaction(session.id)
+        // #257：第一次压缩后 raw 指令被 summary 覆盖——第二次压缩仍从 rawHistory 找回它
+
+        let msgs = yield* ssn.messages({ sessionID: session.id })
+        let parent = msgs.at(-1)?.info.id
+        expect(parent).toBeTruthy()
+        // #257：第二次压缩基于第一次压缩后的尾部——memento 只携带尚未被压缩边界覆盖的原始指令
+        yield* SessionCompaction.use.process({ parentID: parent!, messages: msgs, sessionID: session.id, auto: false })
+
+        const latest = yield* createUserMessage(session.id, "latest request after prior compaction")
+        yield* createAssistantMessage(session.id, latest.id, test.directory)
+        yield* createSummaryCompaction(session.id)
+
+        msgs = yield* ssn.messages({ sessionID: session.id })
+        parent = msgs.at(-1)?.info.id
+        expect(parent).toBeTruthy()
+        yield* SessionCompaction.use.process({ parentID: parent!, messages: msgs, sessionID: session.id, auto: false })
+
+        const compactionPart = yield* readCompactionPart(session.id)
+        // #257：readCompactionPart 读最近一次压缩边界——两次压缩后取第二次的 memento
+        const recentUserMemento = MessageV2.formatRecentUserMemento(compactionPart?.recent_user_messages ?? [])
+
+        // #257：核心不变量——首次压缩前的 raw 指令在第二次压缩后仍须完整出现在 memento 中
+        expect(recentUserMemento).toContain("latest request after prior compaction")
+        expect(recentUserMemento).toContain("raw instruction before prior compaction")
+        expect(recentUserMemento).toContain("truncated for compaction memento")
+        expect(recentUserMemento).not.toContain("end of raw instruction")
+        expect(TokenEstimate.estimateText(recentUserMemento)).toBeLessThanOrEqual(400)
+        // #257：10K 窗口 20% 预算——跨压缩截断仍须保持同一上限
+      }).pipe(
+        withCompaction({
+          llm: stub.llmLayer,
+          provider: ProviderTest.fake({ model: mementoModel }),
+          config: cfg({ tail_turns: 1, preserve_recent_tokens: 20 }),
+        }),
+      )
+    },
+    { git: true },
+  )
+
+  itCompaction.instance(
+    "keeps synthetic, ignored, and hidden user text out of recent user mementos",
     () => {
       const stub = llm()
       stub.push(reply("summary"))
@@ -1278,6 +1328,21 @@ const exit = yield* Fiber.await(fiber).pipe(Effect.timeout("5 seconds"))
           text: "ignored text should not be preserved",
           ignored: true,
         })
+        yield* ssn.updatePart({
+          id: PartID.ascending(),
+          messageID: latest.id,
+          sessionID: session.id,
+          type: "text",
+          text: "hidden text part should not be preserved",
+          hidden: { time: Date.now(), reason: "undo" },
+        // #257：hidden 结构为 {time, reason}——撤销标记必须同时排除 part 与整条消息
+        })
+        const hiddenMsg = yield* createUserMessage(session.id, "hidden message should not be preserved")
+        yield* ssn.updateMessage({
+          ...hiddenMsg,
+        // #257：对已创建消息二次更新打 hidden 标记——比创建时传参更接近真实撤销路径
+          hidden: { time: Date.now(), reason: "undo" },
+        })
         yield* ssn.updateMessage({
           id: MessageID.ascending(),
           role: "assistant",
@@ -1306,10 +1369,11 @@ const exit = yield* Fiber.await(fiber).pipe(Effect.timeout("5 seconds"))
         const compactedContext = JSON.stringify(modelMessages)
 
         expect(compactedContext).toContain("real instruction")
-        // #256：synthetic/ignored part 附加在同一消息上——过滤按 part 粒度生效
-        // #256：synthetic/ignored 文本绝不能进入 memento——它们已被其他通道表示
+        // #257：synthetic/ignored/hidden 都按 part 粒度排除——hidden 消息整体跳过
         expect(compactedContext).not.toContain("synthetic editor context should not be preserved")
         expect(compactedContext).not.toContain("ignored text should not be preserved")
+        expect(compactedContext).not.toContain("hidden text part should not be preserved")
+        expect(compactedContext).not.toContain("hidden message should not be preserved")
       }).pipe(withCompaction({ llm: stub.llmLayer, config: cfg({ tail_turns: 1, preserve_recent_tokens: 20 }) }))
     },
     { git: true },
diff --git a/packages/core/src/session/history.ts b/packages/core/src/session/history.ts
--- a/packages/core/src/session/history.ts
+++ b/packages/core/src/session/history.ts
@@ -1,4 +1,4 @@
-import { and, asc, desc, eq, gt, gte, ne, or } from "drizzle-orm"
+import { and, asc, desc, eq, gt, gte, lte, ne, or } from "drizzle-orm"
 import { Effect, Schema } from "effect"
 import { Database } from "../database/database"
 import { MessageDecodeError } from "./error"
@@ -100,4 +100,18 @@
   )).filter((entry) => !hidden(entry.message.metadata?.hidden))
 })
 
+// memento只读本次边界内的原始user行，不经过latestCompaction，也不从旧摘要反推原话。
+export const rawUserMessages = Effect.fn("SessionHistory.rawUserMessages")(function* (
+  db: DatabaseService,
+  sessionID: SessionSchema.ID,
+  throughSeq: number,
+) {
+  const rows = yield* db.select().from(SessionMessageTable).where(and(
+    eq(SessionMessageTable.session_id, sessionID), eq(SessionMessageTable.type, "user"), lte(SessionMessageTable.seq, throughSeq),
+  )).orderBy(asc(SessionMessageTable.seq)).all().pipe(Effect.orDie)
+  const messages = yield* Effect.forEach(rows, decodeMessageRow)
+  // 使用同一合法hidden合同；synthetic、助手和未promote的inbox本来就不属于user行。
+  return messages.flatMap(message => message.type === "user" && !hidden(message.metadata?.hidden) ? [message] : [])
+})
+
 export * as SessionHistory from "./history"
diff --git a/packages/core/src/session/compaction.ts b/packages/core/src/session/compaction.ts
--- a/packages/core/src/session/compaction.ts
