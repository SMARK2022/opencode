+      matchLen = result.length
+      strategy = "line-trimmed"
+    }
+  }
+
+  // 第三阶：块首尾 trim，最后才放宽
+  if (matchIdx === -1) {
+    const trimmedOld = old.trim()
+    matchIdx = src.indexOf(trimmedOld)
