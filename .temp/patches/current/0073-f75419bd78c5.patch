+// #73：包装 globalThis.fetch，使未改调用方也走代理
+export function installGlobalFetch(defaultPurpose: Purpose = "unknown") {
+  // #73：幂等安装，禁止重复包裹
+if (globalFetchInstalled) return
+  const original = globalThis.fetch.bind(globalThis) as FetchFn
