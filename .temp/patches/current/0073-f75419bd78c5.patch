+// #73：单一 routedFetch spy + 当前 active payload，避免多次 spyOn/afterEach restore 互相踩踏
+type WellKnownRoutedPayload = {
+  seen: { wellKnown?: string; remote?: string; authorization?: string }
+  wellKnown: unknown
+  remote?: unknown
+  remoteHtml?: string
+}
+let activeWellKnownRouted: WellKnownRoutedPayload | undefined
+let wellKnownRoutedFetchInstalled = false
+afterEach(() => {
+  // #73：用例结束后清空 active payload，避免污染真实网络用例
+  activeWellKnownRouted = undefined
+})
+// #73：只安装一次 spy，避免 last-spy 被 restore 后漏拦
+function ensureWellKnownRoutedFetchSpy() {
+  if (wellKnownRoutedFetchInstalled) return
+  wellKnownRoutedFetchInstalled = true
+  // #73：保留原 routedFetch，无 active fixture 时透传给真实/FetchHttpClient 用例
+  const original = NetworkProxy.routedFetch.bind(NetworkProxy)
+  // #73：拦截 well-known/remote_config 的 routedFetch，避免真实访问 example.com
+  spyOn(NetworkProxy, "routedFetch").mockImplementation(async (inputUrl, init) => {
+    const payload = activeWellKnownRouted
+    const url = typeof inputUrl === "string" ? inputUrl : inputUrl instanceof URL ? inputUrl.toString() : inputUrl.url
+    if (!payload) {
+      return original(inputUrl as any, init as any)
+    }
+    if (url.includes(".well-known/opencode")) {
+      payload.seen.wellKnown = url
+      return new Response(JSON.stringify(payload.wellKnown), {
+        status: 200,
+        headers: { "content-type": "application/json" },
+      })
+    }
+    if (url.includes("config.example.com") && (payload.remote !== undefined || payload.remoteHtml !== undefined)) {
+      payload.seen.remote = url
+      payload.seen.authorization = new Headers(init?.headers).get("authorization") ?? undefined
+      if (payload.remoteHtml !== undefined) {
+        return new Response(payload.remoteHtml, { status: 200, headers: { "content-type": "text/html; charset=utf-8" } })
+      }
+      return new Response(JSON.stringify(payload.remote), {
+        status: 200,
+        headers: { "content-type": "application/json" },
+      })
+    }
+    return new Response(JSON.stringify({}), { status: 404, headers: { "content-type": "application/json" } })
+  })
+}
