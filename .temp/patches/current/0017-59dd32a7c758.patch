diff --git a/packages/opencode/src/session/request-usage.ts b/packages/opencode/src/session/request-usage.ts
new file mode 100644
--- /dev/null
+++ b/packages/opencode/src/session/request-usage.ts
@@ -0,0 +1,515 @@
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { Database } from "@opencode-ai/core/database/database"
+import { Context, Effect, Layer, Option, Schema } from "effect"
+import { SessionV1 } from "@opencode-ai/core/v1/session"
+import { and, desc, eq, lt, sql } from "drizzle-orm"
+import { RequestUsageTable, RequestUsageAssistantTable } from "@opencode-ai/core/session/request-usage.sql"
+import { MessageV2 } from "./message-v2"
+import type { SessionID, MessageID } from "./schema"
+
+// 请求来源类型：用户命令、shell 执行、系统压缩
+// 请求来源枚举：区分用户命令、shell 执行和系统压缩
+// 请求来源枚举：区分用户命令、shell 执行、系统压缩、普通提示词、系统继续、未知
+export type Source = "prompt" | "command" | "shell" | "system_compaction" | "system_continue" | "unknown"
+
+// 请求状态类型
+// 请求状态类型：运行中、已完成、错误、中止
+// 请求状态枚举：运行中、已完成、错误、中止
+export type Status = "running" | "completed" | "error" | "aborted"
+
+// Token 用量统计结构
+// Token 用量统计结构：输入、输出、推理、缓存读写、总计
+export type Tokens = {
+  input: number
+  output: number
+  reasoning: number
+  cache: { read: number; write: number }
+  total: number
+}
+
+// 请求级别的用量记录
+// 请求级别的用量记录：一个用户请求对应一行
+export type Request = {
+  sessionID: SessionID
+  requestID: MessageID
+  rootRequestID: MessageID
+  source: Source
+  status: Status
+  agent: string
+  model: { providerID: string; modelID: string; variant?: string }
+  assistantCount: number
+  stepCount: number
+  tokens: Tokens
+  cost: number
+  error?: string
+  time: { created: number; updated: number; completed?: number }
+}
+
+// 助手消息级别的用量记录
+// 助手消息级别的用量记录：每个助手回复对应一行
+export type Assistant = {
+  sessionID: SessionID
+  requestID: MessageID
+  assistantMessageID: MessageID
+  rootRequestID: MessageID
+  status: Status
+  model: { providerID: string; modelID: string; variant?: string }
+  stepCount: number
+  tokens: Tokens
+  cost: number
+  error?: string
+  time: { created: number; updated: number; completed?: number }
+}
+
+// 服务接口：追踪每轮请求的 token 用量
+// 服务接口：追踪每轮请求的 token 用量生命周期
+// begin → recordAssistant → complete
+export interface Interface {
+  // 创建或重置一个请求用量记录
+  readonly begin: (input: {
+    sessionID: SessionID
+    requestID: MessageID
+    rootRequestID?: MessageID
+    source: Source
+    agent: string
+    providerID: string
+    modelID: string
+    variant?: string
+    timeCreated?: number
+  }) => Effect.Effect<void, any, any>
+  // 记录一个助手消息的用量数据
+  readonly recordAssistant: (input: {
+    sessionID: SessionID
+    requestID: MessageID
+    assistant: SessionV1.Assistant
+  }) => Effect.Effect<void, any, any>
+  // 标记请求完成（成功/错误/中止）
+  readonly complete: (input: {
+    sessionID: SessionID
+    requestID: MessageID
+    status?: Status
+    error?: string
+    timeCompleted?: number
+  }) => Effect.Effect<void, any, any>
+  // 获取单个请求的用量
+  readonly get: (input: { sessionID: SessionID; requestID: MessageID }) => Effect.Effect<Request | undefined, any, any>
+  // 列出会话的请求用量
+  readonly list: (input: {
+    sessionID: SessionID
+    limit?: number
+    before?: number
+    rootRequestID?: MessageID
+    source?: Source
+  }) => Effect.Effect<Request[], any, any>
+  // 获取请求下所有助手消息的用量
+  readonly assistants: (input: { sessionID: SessionID; requestID: MessageID }) => Effect.Effect<Assistant[], any, any>
+}
+
+// 服务标识
+// 服务标识：用于 Context 注入和依赖解析
+// Effect Schema 定义：用于 HTTP API 端点的响应类型校验
+export const SourceSchema = Schema.String
+export const StatusSchema = Schema.String
+// 请求用量 Schema：HTTP API 响应类型
+export const RequestUsageSchema = Schema.Struct({
+  sessionID: Schema.String, requestID: Schema.String, rootRequestID: Schema.optional(Schema.String),
+  source: SourceSchema, status: StatusSchema, agent: Schema.String, providerID: Schema.String, modelID: Schema.String,
+  variant: Schema.optional(Schema.String),
+  tokens: Schema.Struct({ input: Schema.Number, output: Schema.Number, reasoning: Schema.Number, cache: Schema.Struct({ read: Schema.Number, write: Schema.Number }), total: Schema.Number }),
+  costMicros: Schema.Number, timeCreated: Schema.Number, timeUpdated: Schema.Number,
+  // 请求级别的额外统计字段
+  assistantCount: Schema.Number, stepCount: Schema.Number, error: Schema.optional(Schema.String), timeCompleted: Schema.optional(Schema.Number),
+})
+// 助手用量 Schema：HTTP API 响应类型
+export const AssistantUsageSchema = Schema.Struct({
+  sessionID: Schema.String, requestID: Schema.String, assistantID: Schema.String, rootRequestID: Schema.optional(Schema.String),
+  providerID: Schema.String, modelID: Schema.String, variant: Schema.optional(Schema.String),
+  status: Schema.String, stepCount: Schema.Number, error: Schema.optional(Schema.String), timeCompleted: Schema.optional(Schema.Number),
+  tokens: Schema.Struct({ input: Schema.Number, output: Schema.Number, reasoning: Schema.Number, cache: Schema.Struct({ read: Schema.Number, write: Schema.Number }), total: Schema.Number }),
+  costMicros: Schema.Number, timeCreated: Schema.Number, timeUpdated: Schema.Number,
+})
+
+export class Service extends Context.Service<Service, Interface>()("@opencode/SessionRequestUsage") {}
+
+// 微秒转美元
+// 微秒转美元：数据库以整数微秒存储，展示时转为美元
+const toCost = (micros: number) => micros / 1_000_000
+// 美元转微秒：避免浮点精度问题，使用整数存储
+const toMicros = (cost: number) => Math.round(cost * 1_000_000)
+
+// 空的 token 统计：用于累加初始值
+const emptyTotals = (): Tokens => ({
+  input: 0,
+  output: 0,
+  reasoning: 0,
+  cache: { read: 0, write: 0 },
+  total: 0,
+})
+
+// 数据库行转 Request 类型
+// 数据库行转 Request 类型：字段名从 snake_case 映射到 camelCase
+const rowToRequest = (row: typeof RequestUsageTable.$inferSelect): Request => ({
+  sessionID: row.session_id,
+  requestID: row.request_id,
+  rootRequestID: row.root_request_id,
+  source: row.source as Source,
+  status: row.status as Status,
+  agent: row.agent,
+  model: {
+    providerID: row.provider_id,
+    modelID: row.model_id,
+    variant: row.variant ?? undefined,
+  },
+  assistantCount: row.assistant_count,
+  stepCount: row.step_count,
+  tokens: {
+    input: row.tokens_input,
+    output: row.tokens_output,
+    reasoning: row.tokens_reasoning,
+    cache: { read: row.tokens_cache_read, write: row.tokens_cache_write },
+    total: row.tokens_total,
+  },
+  cost: toCost(row.cost_micros),
+  error: row.error_message ?? undefined,
+  time: {
+    created: row.time_created,
+    updated: row.time_updated,
+    completed: row.time_completed ?? undefined,
+  },
+})
+
+// 数据库行转 Assistant 类型
+// 数据库行转 Assistant 类型：同 rowToRequest 的映射逻辑
+const rowToAssistant = (row: typeof RequestUsageAssistantTable.$inferSelect): Assistant => ({
+  sessionID: row.session_id,
+  requestID: row.request_id,
+  assistantMessageID: row.assistant_message_id,
+  rootRequestID: row.root_request_id,
+  status: row.status as Status,
+  model: {
+    providerID: row.provider_id,
+    modelID: row.model_id,
+    variant: row.variant ?? undefined,
+  },
+  stepCount: row.step_count,
+  tokens: {
+    input: row.tokens_input,
+    output: row.tokens_output,
+    reasoning: row.tokens_reasoning,
+    cache: { read: row.tokens_cache_read, write: row.tokens_cache_write },
+    total: row.tokens_total,
+  },
+  cost: toCost(row.cost_micros),
+  error: row.error_message ?? undefined,
+  time: {
+    created: row.time_created,
+    updated: row.time_updated,
+    completed: row.time_completed ?? undefined,
+  },
+})
+
+// 服务实现层
+// 服务实现层：所有方法使用 Effect.gen + Database.Service 访问数据库
+const layer = Layer.effect(
+  Service,
+  Effect.gen(function* () {
