目标测试为 v1.18.32 形态（仅 afterEach 一个重置点；源的 finally 两点不存在）；
restoreExitCode helper 落位：Bun 把赋 undefined 视为 no-op，重置必须归零而非还原 undefined。
diff --git a/packages/opencode/test/cli/tui/thread.test.ts b/packages/opencode/test/cli/tui/thread.test.ts
--- a/packages/opencode/test/cli/tui/thread.test.ts
+++ b/packages/opencode/test/cli/tui/thread.test.ts
@@ -33,4 +33,4 @@
   // #271：每次测试后重置退出码，避免检验分支设置的 exitCode 影响后续用例
   afterEach(() => {
-    process.exitCode = originalExitCode
+  restoreExitCode(originalExitCode)
   })
@@ -476 +476,7 @@
 })
+
+function restoreExitCode(exitCode: typeof process.exitCode) {
+  // #462：Bun 对已置位的 exitCode 再赋 undefined 是 no-op；Linux 上会以退出码 1 误报失败，
+  // 统一重置为 0 而不是还原捕获值里的 undefined。
+  process.exitCode = exitCode ?? 0
+}
