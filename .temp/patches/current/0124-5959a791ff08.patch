diff --git a/packages/tui/src/util/token-accounting.ts b/packages/tui/src/util/token-accounting.ts
index 2c0a60a43c..de3bb321e8 100644
--- a/packages/tui/src/util/token-accounting.ts
+++ b/packages/tui/src/util/token-accounting.ts
@@ -263,21 +263,30 @@ export function tokenAccounting(
   stepInput += pendingToolResultTokens + pendingAttachTokens
 
   // ── 6. request totals（confirmed + in-flight）─────────
-  const stepDelta = stepConfirmed ? 0 : stepInput + stepOutput
-  const totalInput = confirmedRequest.input + stepDelta
+  // #124：input 与 output 必须分开，stepOutput 不能混进 totalInput
+  const totalInput = confirmedRequest.input + (stepConfirmed ? 0 : stepInput)
   const totalOutput = confirmedRequest.output + (stepConfirmed ? 0 : stepOutput)
 
-  // ── 7. breakdown（来自 latest assistant 的 step-finish）───────
-  // #122：有 inputBreakdown 时按字符占比分配确认 input 总量
+  // ── 7. breakdown（优先 step-finish confirmed，fallback step-start）───────
+  // #124：streaming 期间可用 step-start 的 daemon 字符快照
   let breakdown: TokenAccounting["breakdown"] = null
-  if (stepSF && stepSF.inputBreakdown && stepSF.inputChars) {
-    const bd = stepSF.inputBreakdown as {
+  // #124：定位最近的 step-start 字符快照
+  const ssIdx = lastParts.findLastIndex((p) => p.type === "step-start" && p.inputBreakdown)
+  // #124：无 step-start 时 breakdown 仅能等 step-finish
+  const stepSS = ssIdx >= 0 ? lastParts[ssIdx] : undefined
+  const breakdownSrc = stepSF?.inputBreakdown ? stepSF : stepSS
+  if (breakdownSrc?.inputBreakdown && breakdownSrc.inputChars) {
+    const bd = breakdownSrc.inputBreakdown as {
       system: number; instructions: number; skills: number; tools: number
       messages: { userText: number; assistantText: number; reasoning: number; toolInput: number; toolOutput: number; attachments: number; total: number }
     }
-    const confirmedInput = stepSF.tokens.input + stepSF.tokens.cache.read + stepSF.tokens.cache.write
-    const denom = stepSF.inputChars as number
+    // #124：确认量用 provider tokens；否则用 daemon inputTokens/chars
+    const confirmedInput = stepSF?.tokens
+      ? stepSF.tokens.input + stepSF.tokens.cache.read + stepSF.tokens.cache.write
+      : (Number(stepSS?.inputTokens) || Math.round((Number(stepSS?.inputChars) || 0) / inputRatio))
+    const denom = Number(breakdownSrc.inputChars)
 
+    // #124：按字符占比把确认/估算 input 分到各分类
     const alloc = (chars: number) => denom > 0 ? Math.round((chars / denom) * confirmedInput) : 0
     const system = alloc(bd.system)
     const instructions = alloc(bd.instructions)
@@ -288,7 +297,8 @@ export function tokenAccounting(
     const attachments = alloc(bd.messages.attachments)
 
     let assistantText: number; let reasoning: number; let toolCalls: number
-    if (stepConfirmed) {
+    if (stepConfirmed && stepSF?.tokens) {
+      // #124：仅 confirmed step-finish 拆 output/reasoning
       reasoning = stepSF.tokens.reasoning
       const visibleOutput = stepSF.tokens.output
       const textChars = bd.messages.assistantText
diff --git a/packages/tui/test/util/token-accounting.test.ts b/packages/tui/test/util/token-accounting.test.ts
index cc35077c1a..e8927a98ca 100644
--- a/packages/tui/test/util/token-accounting.test.ts
+++ b/packages/tui/test/util/token-accounting.test.ts
@@ -63,3 +63,47 @@ describe("tokenAccounting", () => {
     expect(acc.ratio.input).toBeGreaterThan(1)
   })
 })
+
+  // #124：streaming 期间 step-start breakdown 可用
+  test("breakdown available from step-start during streaming (before step-finish)", () => {
+    const msgs = [
+      { id: "u1", role: "user", time: { created: 0 } },
+      {
+        id: "a1",
+        role: "assistant",
+        parentID: "u1",
+        cost: 0,
+        tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+        time: { created: 1 },
+      },
+    ]
+    const parts: Record<string, any[]> = {
+      a1: [
+        {
+          id: "ss",
+          type: "step-start",
+          inputChars: 1000,
+          inputTokens: 400,
+          inputBreakdown: {
+            system: 200,
+            instructions: 100,
+            skills: 50,
+            tools: 50,
+            messages: {
+              userText: 100,
+              assistantText: 80,
+              reasoning: 0,
+              toolInput: 40,
+              toolOutput: 80,
+              attachments: 100,
+              total: 400,
+            },
+          },
+        },
+      ],
+    }
+    const acc = tokenAccounting(msgs as any, (id) => parts[id] ?? [])
+    expect(acc.breakdown).not.toBeNull()
+    // #124：200/1000 * 400 = 80
+    expect(acc.breakdown!.system).toBe(80)
+  })
diff --git a/packages/schema/src/v1/session.ts b/packages/schema/src/v1/session.ts
index f0eb8df148..fe549dcdc0 100644
--- a/packages/schema/src/v1/session.ts
+++ b/packages/schema/src/v1/session.ts
@@ -244,6 +244,27 @@ export const StepStartPart = Schema.Struct({
   ...partBase,
   type: Schema.Literal("step-start"),
   snapshot: Schema.optional(Schema.String),
+  // #124：请求发出前的字符/token 快照，供 streaming 展示
+  // #124：inputTokens 为 upload 时估算，非 provider 最终值
+  inputChars: Schema.optional(NonNegativeInt),
+  inputTokens: Schema.optional(NonNegativeInt),
+  inputBreakdown: Schema.optional(
+    Schema.Struct({
+      system: NonNegativeInt,
+      instructions: NonNegativeInt,
+      skills: NonNegativeInt,
+      tools: NonNegativeInt,
+      messages: Schema.Struct({
+        userText: NonNegativeInt,
+        assistantText: NonNegativeInt,
+        reasoning: NonNegativeInt,
+        toolInput: NonNegativeInt,
+        toolOutput: NonNegativeInt,
+        attachments: NonNegativeInt,
+        total: NonNegativeInt,
+      }),
+    }),
+  ),
 }).annotate({ identifier: "StepStartPart" })
 export type StepStartPart = Types.DeepMutable<Schema.Schema.Type<typeof StepStartPart>>
 
diff --git a/packages/opencode/src/session/processor.ts b/packages/opencode/src/session/processor.ts
index 48711aba4e..f361084936 100644
--- a/packages/opencode/src/session/processor.ts
+++ b/packages/opencode/src/session/processor.ts
@@ -461,12 +461,20 @@ const layer = Layer.effect(
 
           case "step-start":
             if (!ctx.snapshot) ctx.snapshot = yield* snapshot.track()
+            // #124：把 daemon 请求前快照写入 step-start，供 streaming 展示分类
             yield* session.updatePart({
               id: PartID.ascending(),
               messageID: ctx.assistantMessage.id,
               sessionID: ctx.sessionID,
               snapshot: ctx.snapshot,
               type: "step-start",
+              // #124：TUI tokenAccounting 读这些字段做 step-start breakdown
+              inputChars: ctx.inputChars,
+              inputTokens:
+                ctx.assistantMessage.tokens.input +
+                ctx.assistantMessage.tokens.cache.read +
+                ctx.assistantMessage.tokens.cache.write,
+              inputBreakdown: ctx.inputBreakdown,
             })
             return
 
