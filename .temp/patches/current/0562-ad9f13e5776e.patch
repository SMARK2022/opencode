diff --git a/packages/opencode/src/plugin/openai/codex.ts b/packages/opencode/src/plugin/openai/codex.ts
--- a/packages/opencode/src/plugin/openai/codex.ts
+++ b/packages/opencode/src/plugin/openai/codex.ts
@@ -581,6 +581,8 @@ export async function CodexAuthPlugin(input: PluginInput, options: CodexAuthPlug
       if (input.model.providerID !== "openai") return
       // #169：openai oauth 会话对外伪装 Codex TUI，保留 tip session-id / title 头
       Object.assign(output.headers, CODEX_HEADERS)
+      // #562：session-id 必须用连字符键——ws 池与 Codex 兼容代理只认该形态维持缓存亲和
+      // （源补丁的下划线→连字符修正已由上游 #29471 吸收，此处固化亲和合同不可回退）。
       output.headers["session-id"] = input.sessionID
       // Temporary fetch-layer hack: title generation currently shares the conversation
       // session ID, so the OpenAI plugin marks it for HTTP fallback until transport
