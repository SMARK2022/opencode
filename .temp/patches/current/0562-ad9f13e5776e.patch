@@ -432,1 +433,6 @@
     expect(reviewModels[1]).toMatchObject({ id: "reviewer", providerID: "override" })
+    // 保留原override验证，再经真实reviewer入口确认OpenAI代理头；fake client不发网络请求。
+    reviewSettings = new Config.Info({ auto_review: new ConfigAutoReview.Info({ model: "openai/reviewer" }) })
+    expect(yield* service.ask({ ...automatic, action: "external_directory", resources: ["/openai"], metadata: { action_kind: "shell", command: "git add ." } })).toMatchObject({ effect: "allow" })
+    expect(reviewModels.at(-1)).toMatchObject({ id: "reviewer", providerID: "openai" })
+    expect(reviewRequests.at(-1)?.http?.headers).toEqual({ "session-id": "ses_test" })

diff --git a/packages/opencode/test/plugin/codex.test.ts b/packages/opencode/test/plugin/codex.test.ts
--- a/packages/opencode/test/plugin/codex.test.ts
+++ b/packages/opencode/test/plugin/codex.test.ts
@@ -67,1 +67,7 @@
     expect(output.headers["User-Agent"]).toBe(CODEX_USER_AGENT)
+    // header命名与非OpenAI早退均由真实hook产生，不以手写运输头自证。
+    expect(output.headers["session-id"]).toBe("session-id")
+    expect(output.headers.session_id).toBeUndefined()
+    const other = { headers: {} as Record<string, string> }
+    await hooks["chat.headers"]!({ sessionID: "other-session", model: { providerID: "anthropic" } } as never, other)
+    expect(other.headers).toEqual({})

diff --git a/packages/opencode/src/plugin/openai/codex.ts b/packages/opencode/src/plugin/openai/codex.ts
--- a/packages/opencode/src/plugin/openai/codex.ts
+++ b/packages/opencode/src/plugin/openai/codex.ts
@@ -581,6 +581,7 @@ export async function CodexAuthPlugin(input: PluginInput, options: CodexAuthPlug
       if (input.model.providerID !== "openai") return
       // #169：openai oauth 会话对外伪装 Codex TUI，保留 tip session-id / title 头
       Object.assign(output.headers, CODEX_HEADERS)
+      // 兼容代理识别连字符session-id；保留完整Session身份，不能替换为缩短的正文缓存键。
       output.headers["session-id"] = input.sessionID
       // Temporary fetch-layer hack: title generation currently shares the conversation
       // session ID, so the OpenAI plugin marks it for HTTP fallback until transport
