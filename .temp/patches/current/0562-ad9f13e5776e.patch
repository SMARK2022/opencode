diff --git a/packages/core/src/session/runner/llm.ts b/packages/core/src/session/runner/llm.ts
--- a/packages/core/src/session/runner/llm.ts
+++ b/packages/core/src/session/runner/llm.ts
@@ -315,2 +315,4 @@
             "x-session-affinity": session.id,
+            // 代理按连字符头识别OpenAI会话；header保留完整身份，不复用缩短的正文缓存键。
+            ...(model.provider === "openai" ? { "session-id": session.id } : {}),
             "X-Session-Id": session.id,

diff --git a/packages/core/src/permission/reviewer.ts b/packages/core/src/permission/reviewer.ts
--- a/packages/core/src/permission/reviewer.ts
+++ b/packages/core/src/permission/reviewer.ts
@@ -80,1 +80,3 @@
           model: selected.model, system: PermissionReviewerPrompt.buildSystemPrompt(tenant),
+          // reviewer直接调用LLM而不经过V1插件，同一OpenAI会话仍需使用相同代理亲和身份。
+          ...(selected.model.provider === "openai" ? { http: { headers: { "session-id": session.id } } } : {}),

diff --git a/packages/core/test/session-runner.test.ts b/packages/core/test/session-runner.test.ts
--- a/packages/core/test/session-runner.test.ts
+++ b/packages/core/test/session-runner.test.ts
@@ -3446,2 +3446,5 @@
       yield* setup
+      // 正文键保持64字符，而代理header必须区分两个完整的真实Session ID。
+      currentModel = Model.make({ id: model.id, provider: "openai", route: model.route })
+      yield* Effect.addFinalizer(() => Effect.sync(() => { currentModel = model }))
       const longSessionID = SessionV2.ID.make(`ses_${"a".repeat(64)}`)
@@ -3470,1 +3473,3 @@
       expect(keys[0]).not.toBe(keys[1])
+      expect(requests.map(request => request.http?.headers?.["session-id"])).toEqual([longSessionID, otherLongSessionID])
+      expect(requests.every(request => request.http?.headers?.session_id === undefined)).toBe(true)

diff --git a/packages/core/test/permission.test.ts b/packages/core/test/permission.test.ts
