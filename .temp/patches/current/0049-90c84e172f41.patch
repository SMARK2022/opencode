+type PermissionRuleLike = { permission: string; pattern: string; action: string }
+const EDIT_TOOL_NAMES = new Set(["edit", "write", "apply_patch"])
+// 简单通配：仅支持 * 为任意子串
+function matchWild(value: string, pattern: string) {
+  if (pattern === "*") return true
+  if (!pattern.includes("*")) return value === pattern
+  const chunks = pattern.split("*")
+  let idx = 0
+  for (let i = 0; i < chunks.length; i++) {
+    const chunk = chunks[i]
+    if (chunk.length === 0) continue
+    const found = value.indexOf(chunk, idx)
+    if (found < 0) return false
+    if (i === 0 && found !== 0) return false
+    idx = found + chunk.length
+  }
+  if (!pattern.endsWith("*") && idx !== value.length) return false
+  return true
+}
+// 自后向前匹配权限规则，后写覆盖先写
+function evaluateRule(permission: string, pattern: string, ruleset: readonly PermissionRuleLike[] = []) {
+  for (let i = ruleset.length - 1; i >= 0; i--) {
+    const rule = ruleset[i]
+    if (matchWild(permission, rule.permission) && matchWild(pattern, rule.pattern)) return rule
+  }
+  return undefined
+}
+// 仅 pattern=* 且 action=deny 计入 disabled 集合
+function disabledTools(names: string[], ruleset: readonly PermissionRuleLike[] = []) {
+  return new Set(
+    names.filter((name) => {
+      const permission = EDIT_TOOL_NAMES.has(name) ? "edit" : name
+      const rule = evaluateRule(permission, "*", ruleset)
+      return rule?.pattern === "*" && rule.action === "deny"
+    }),
+  )
