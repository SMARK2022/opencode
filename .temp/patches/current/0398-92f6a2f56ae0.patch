+            // [local-smark] 标记本轮已产生 tool 调用，用于 finish-step 空完成检测
+            ctx.hasToolCall = true
             const part = yield* session.updatePart({
               id: ctx.toolcalls[value.id]?.partID ?? PartID.ascending(),
