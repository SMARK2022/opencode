@@ -701,6 +716,25 @@ export const layer = Layer.effect(
                 })
               }
             }
+            // [local-smark] 空完成检测：provider 返回了 finish-step 但本轮没有产生
+            // 任何 text/reasoning/tool 输出，且 finishReason="other"（AI SDK 对
