@@ -0,0 +1,27 @@
+import type { Message, SessionStatus } from "@opencode-ai/sdk/v2"
+
+// #154：是否存在未完成 assistant 流
+// #154：仅看 assistant.time.completed，不依赖可能 stale 的 session_status
+export function hasStreamingAssistant(messages: Message[]) {
+  return messages.some((message) => message.role === "assistant" && !message.time.completed)
+}
+
+// #154：保留 tip 的 completed 游标过滤，避免旧 incomplete assistant 误判 pending
+// #154：pending 绑定 status+messages，供 prompt 与 force-sync 共用
+export function pendingAssistantID(messages: Message[], status: SessionStatus | undefined) {
+  if (!status || status.type === "idle") return undefined
+  const completed = messages.findLast((message) => message.role === "assistant" && message.time.completed)?.id
+  return messages.findLast(
+    (message) =>
+      message.role === "assistant" &&
+      !message.time.completed &&
+      (!completed || message.id > completed),
+  )?.id
+}
+
+// #154：busy 但无 open stream 时强制刷新，避免 prompt 永久禁用
+// #154：busy 且无 open stream 时触发强制刷新
+// #154：busy 但消息流已无未完成 assistant 时才 force-sync，避免误刷
+export function shouldRefreshStaleBusyStatus(messages: Message[], status: SessionStatus | undefined) {
+  return status?.type === "busy" && !hasStreamingAssistant(messages)
+}
