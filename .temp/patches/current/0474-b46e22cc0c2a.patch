From b46e22cc0c2a73557bd54ae19ebe1c2a76dd7f7a Mon Sep 17 00:00:00 2001
From: SMARK2022 <3222301373@qq.com>
Date: Sun, 5 Jul 2026 14:51:02 +0800
Subject: [PATCH] fix(shell): preserve non-Windows process group isolation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8

原回退提前在473保留，两侧实际descriptor均为非Windows detached；此处验证真实进程调用边界，不重复更改owner。
diff --git a/packages/core/test/tool-bash.test.ts b/packages/core/test/tool-bash.test.ts
--- a/packages/core/test/tool-bash.test.ts
+++ b/packages/core/test/tool-bash.test.ts
@@ -82,2 +82,4 @@
         if (command._tag !== "StandardCommand") throw new Error("expected standard command")
+        // 非Windows独立进程组是取消/超时隔离契约，不能为规避stdout竞态改成仅Linux。
+        expect(command.options.detached).toBe(process.platform !== "win32")
         // 仅在测试观察边界解码传输包装；完整argv仍保留，真实编码由另一个实进程用例验证。
