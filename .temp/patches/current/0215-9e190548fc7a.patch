+  private partialControl(text: string) {
+    const esc = text.lastIndexOf('\x1b')
+    if (esc < 0) return ''
+    const suffix = text.slice(esc)
+    if (suffix === '\x1b') return suffix
+    if (/^\x1b\[[0-9;?]*$/.test(suffix)) return suffix
+    return ''
+  }
