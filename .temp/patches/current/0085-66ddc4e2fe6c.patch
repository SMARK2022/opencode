diff --git a/packages/opencode/src/session/prompt.ts b/packages/opencode/src/session/prompt.ts
index 57efcffb9c..aa1f9a7b53 100644
--- a/packages/opencode/src/session/prompt.ts
+++ b/packages/opencode/src/session/prompt.ts
@@ -1402,7 +1402,9 @@ const layer = Layer.effect(
               if (!chars || chars < 100) continue
               const tokens = (sf.tokens.input ?? 0) + (sf.tokens.cache?.read ?? 0) + (sf.tokens.cache?.write ?? 0)
               if (typeof chars === "number" && chars > 0 && tokens > 0) {
-                historyInputChars += chars
+                // 附件不参与输入侧 chars/token 密度校准
+                const bd = (sf as any).inputBreakdown
+                historyInputChars += Math.max(0, chars - (bd?.messages?.attachments ?? 0))
                 historyInputTokens += tokens
               }
             }
diff --git a/packages/tui/src/util/context-usage.ts b/packages/tui/src/util/context-usage.ts
index 81cb73914c..6bb53c03d4 100644
--- a/packages/tui/src/util/context-usage.ts
+++ b/packages/tui/src/util/context-usage.ts
@@ -1234,7 +1234,8 @@ export async function computeContextData(input: ComputeContextDataInput): Promis
     // 服务端细分：toolInput 记调用，toolOutput 记结果
     toolCallTokens = Math.round(bd.messages.toolInput / ratio)
     toolResultTokens = Math.round(bd.messages.toolOutput / ratio)
-    inputMessageTokens = Math.round((bd.messages.userText + bd.messages.attachments) / ratio)
+    // 附件用视觉估算 tokens，不混入文本 chars/ratio 桶
+    inputMessageTokens = Math.round(bd.messages.userText / ratio) + msg.details.attachments
     outputMessageTokens = Math.round((bd.messages.assistantText + bd.messages.reasoning) / ratio)
   } else {
     skillTokens = estimate(skillListing, ratio)
@@ -1337,7 +1338,8 @@ export async function computeContextData(input: ComputeContextDataInput): Promis
             reasoning: Math.round(bd.messages.reasoning / ratio),
             toolCalls: Math.round(bd.messages.toolInput / ratio),
             toolResults: Math.round(bd.messages.toolOutput / ratio),
-            attachments: Math.round(bd.messages.attachments / ratio),
+            // 与 inputMessageTokens 同源：附件用 details 视觉估算
+            attachments: msg.details.attachments,
             compactionSummary: 0,
           }
         : msg.details,
diff --git a/packages/tui/src/util/token-estimate.ts b/packages/tui/src/util/token-estimate.ts
index 3a0365db4b..0c05837149 100644
--- a/packages/tui/src/util/token-estimate.ts
+++ b/packages/tui/src/util/token-estimate.ts
@@ -52,7 +52,9 @@ export function charsPerTokenFromHistory(
         (p.tokens?.input ?? 0) + (p.tokens?.cache?.read ?? 0) + (p.tokens?.cache?.write ?? 0)
       // 样本不足 100 字符忽略，避免早期噪声主导密度
       if (typeof inputChars !== "number" || inputChars < 100 || inputTokens <= 0) continue
-      totalChars += inputChars
+      // 附件字符不参与文本密度校准：视觉/base64 与自然语言密度不同
+      const bd = p.inputBreakdown as { messages?: { attachments?: number } } | undefined
+      totalChars += Math.max(0, inputChars - (bd?.messages?.attachments ?? 0))
       totalTokens += inputTokens
     }
   }
