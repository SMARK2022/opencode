+      summaryInitialized: SessionTable.summary_initialized,
+      summaryInitDirty: SessionTable.summary_init_dirty,
+      summarySeed: SessionTable.summary_seed,
+    })
+    .from(SessionTable)
+    .where(eq(SessionTable.id, sessionID))
+    .get()
