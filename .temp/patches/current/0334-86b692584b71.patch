@@ -62,4 +62,8 @@ function voiceTranscriberFromMcpConfig(input: unknown, cwd: string): VoiceTranscriber {
     // 与原本地MCP一致，相对脚本以项目目录解析，不以配置文件目录解析。
     const resolved = path.isAbsolute(mcpServer) ? mcpServer : path.resolve(cwd, mcpServer)
