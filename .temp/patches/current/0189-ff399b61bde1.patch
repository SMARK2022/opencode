diff --git a/packages/tui/src/component/prompt/index.tsx b/packages/tui/src/component/prompt/index.tsx
--- a/packages/tui/src/component/prompt/index.tsx
+++ b/packages/tui/src/component/prompt/index.tsx
@@ -176,7 +176,10 @@ export function Prompt(props: PromptProps) {
   const exit = useExit()
   const dimensions = useTerminalDimensions()
   // #109：窄终端隐藏累计 token 括号
-  const showCumulative = createMemo(() => dimensions().width > 120)
+  // #189：改按 prompt 实际分配宽度，侧栏挤压时即使终端很宽也要紧凑
+  const [promptWidth, setPromptWidth] = createSignal(dimensions().width)
+  // #189：阈值 100 列（相对终端 120 更贴近 prompt 槽）
+  const showCumulative = createMemo(() => promptWidth() > 100)
   const { theme, syntax } = useTheme()
   const kv = useKV()
   const animationsEnabled = createMemo(() => kv.get("animations_enabled", true))
@@ -1429,9 +1432,17 @@ export function Prompt(props: PromptProps) {
   const maxHeight = createMemo(() => tuiConfig.prompt?.max_height ?? Math.max(6, Math.floor(dimensions().height / 3)))
   const moveLabelWidth = createMemo(() => Math.max(12, Math.min(44, dimensions().width - 48)))
 
+  function syncPromptWidth(this: BoxRenderable) {
+    // #189：renderBefore 读取 flex 后最终宽度，避免只看终端列数
+    // #189：宽度未变则跳过 setStore，减少无意义重渲染
+    const width = Math.max(1, this.width)
+    if (width === untrack(promptWidth)) return
+    setPromptWidth(width)
+  }
+
   return (
     <>
-      <box ref={(r: BoxRenderable) => (anchor = r)} visible={props.visible !== false} width="100%">
+      <box ref={(r: BoxRenderable) => (anchor = r)} visible={props.visible !== false} width="100%" renderBefore={syncPromptWidth}>
         <box
           width="100%"
           border={["left"]}
diff --git a/packages/tui/src/routes/session/index.tsx b/packages/tui/src/routes/session/index.tsx
--- a/packages/tui/src/routes/session/index.tsx
+++ b/packages/tui/src/routes/session/index.tsx
@@ -2164,12 +2164,13 @@ function PendingStats(props: { stats: PendingToolInputStats | undefined }) {
   const { theme } = useTheme()
   return (
     <>
-      <Show when={props.stats?.removed}>
-        <span style={{ fg: theme.diffRemoved }}> -{props.stats!.removed}</span>
-      </Show>
+      {/* #189：先 + 后 -，与 diff 习惯及测试期望 +N -M 一致 */}
       <Show when={props.stats?.added}>
         <span style={{ fg: theme.diffAdded }}> +{props.stats!.added}</span>
       </Show>
+      <Show when={props.stats?.removed}>
+        <span style={{ fg: theme.diffRemoved }}> -{props.stats!.removed}</span>
+      </Show>
     </>
   )
 }
diff --git a/packages/tui/src/routes/session/pending-tool-input.ts b/packages/tui/src/routes/session/pending-tool-input.ts
--- a/packages/tui/src/routes/session/pending-tool-input.ts
+++ b/packages/tui/src/routes/session/pending-tool-input.ts
@@ -10,13 +10,13 @@ export type PendingToolInputStats = {
   removed: number
 }
 
-// #187：UI 文案纯函数；本 patch 先 - 后 +（#189 再调换为 +N -M）
+// #189：UI 文案纯函数改为先 + 后 -，锁定 +N -M
 export function formatPendingCounts(stats: PendingToolInputStats | undefined) {
   if (!stats) return ""
   let out = ""
-  // #187：removed 在前，对齐最初 PendingStats 扫读
-  if (stats.removed) out += ` -${stats.removed}`
+  // #189：added 优先，与 PendingStats 及 frame 期望一致
   if (stats.added) out += ` +${stats.added}`
+  if (stats.removed) out += ` -${stats.removed}`
   return out
 }
 
@@ -28,7 +28,8 @@ export function formatPendingPathLabel(filePath: string | undefined, fileCount:
 }
 
 // #187：pending 统计刷新间隔；过密会跟手抖，过疏会丢进度感
-export const PENDING_TOOL_INPUT_PROGRESS_INTERVAL = 200
+// #189：从 200 降到 50，跟手流式 raw
+export const PENDING_TOOL_INPUT_PROGRESS_INTERVAL = 50
 
 // #187：按 tool 名选择流式 JSON 字段扫描器；未知 tool 空实现
 export function createPendingToolInputParser(tool: string) {
