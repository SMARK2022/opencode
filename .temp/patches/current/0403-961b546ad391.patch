diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -21,6 +21,11 @@ permissions:
 
 env:
   FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
+  # CI 环境禁止 LSP server 自动下载：runner 预装 .NET SDK 时 CSharp/FSharp server
+  # 会触发 dotnet tool install 下载 roslyn-language-server，耗时 >30s 导致 BOM
+  # 测试（.cs 文件触发 CSharp server spawn）超时。所有有 auto-download 的
+  # LSP server 均在 spawn 中检查此 flag。
+  OPENCODE_DISABLE_LSP_DOWNLOAD: "true"
 
 jobs:
 # #263：核心必过/上游警告的分层契约——只有 core/httpapi/vscode 挡合并，上游兼容性只出告警
diff --git a/packages/opencode/test/tool/shell.test.ts b/packages/opencode/test/tool/shell.test.ts
--- a/packages/opencode/test/tool/shell.test.ts
+++ b/packages/opencode/test/tool/shell.test.ts
@@ -240,8 +240,10 @@ describe("tool.shell", () => {
         projectRoot,
         Effect.gen(function* () {
           // 单引号内的内容不应被 shell 二次展开；管道要求 shell 进程而非直接 exec
+          // sleep 0.01 防止 macOS CI 上 echo|tr 管道退出过快导致 stdout 竞态
+          //（detached:true + Bun 调度抖动，与 "basic" 测试同款问题）
           const result = yield* run({
-            command: "echo 'hello world' | tr a-z A-Z",
+            command: "echo 'hello world' | tr a-z A-Z; sleep 0.01",
           })
           expect(result.metadata.exit).toBe(0)
           expect(result.metadata.output).toContain("HELLO WORLD")
@@ -1483,7 +1485,8 @@ describe("tool.shell abort", () => {
         projectRoot,
         Effect.gen(function* () {
           const result = yield* run({
-            command: `echo stdout_msg && echo stderr_msg >&2`,
+            // sleep 0.01 防止 macOS CI 上 echo 退出过快导致 stdout 管道竞态
+            command: `echo stdout_msg && echo stderr_msg >&2; sleep 0.01`,
           })
           expect(result.output).toContain("stdout_msg")
           expect(result.output).toContain("stderr_msg")
@@ -1626,7 +1629,8 @@ describe("tool.shell abort", () => {
       projectRoot,
       Effect.gen(function* () {
         const result = yield* run({
-          command: `echo ok`,
+          // sleep 0.01 防止 macOS CI 上 echo 退出过快导致 stdout 管道竞态
+          command: `echo ok; sleep 0.01`,
         })
 
         expect(result.metadata.exit).toBe(0)
