+const outlineCache = new Map<string, { outline: Outline | undefined; size: number; modifiedMs: number }>()
+const OUTLINE_CACHE_LIMIT = 50
+
+export async function readOutlineCached(
+  filepath: string,
+  total: number,
+  offset: number,
+  size: number,
+  modifiedMs: number,
