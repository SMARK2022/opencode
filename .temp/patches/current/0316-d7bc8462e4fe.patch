diff --git a/packages/opencode/src/cli/cmd/tui/win32.ts b/packages/opencode/src/cli/cmd/tui/win32.ts
index 1aaa80aecd69447d454f52ac0d23c64765d0461e..5eac3013bbb82938b3d9a0362309d5856ac38538 100644
