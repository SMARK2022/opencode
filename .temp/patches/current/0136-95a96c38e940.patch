diff --git a/packages/tui/src/util/context-usage.ts b/packages/tui/src/util/context-usage.ts
index 9efe05cdc4..39d5073cb8 100644
--- a/packages/tui/src/util/context-usage.ts
+++ b/packages/tui/src/util/context-usage.ts
@@ -1221,7 +1221,11 @@ export async function computeContextData(input: ComputeContextDataInput): Promis
     maxTokens || undefined,
   )
   const stepConfirmed = acc.step.confirmed
-  const instructions = stepConfirmed ? await gatherInstructionFiles(input) : []
+  // #136：磁盘扫描需确认；测试/注入 instructionFiles 未确认也可展示
+  const instructions =
+    stepConfirmed || input.instructionFiles !== undefined
+      ? await gatherInstructionFiles(input)
+      : []
   let instructionDetails = instructions.map((item) => ({ path: item.path, tokens: estimate(item.content, ratio) }))
   const messageText = msg.text.join("\n")
   // 加载的指令路径去重：已在消息文本中出现的跳过
@@ -1233,9 +1237,12 @@ export async function computeContextData(input: ComputeContextDataInput): Promis
   }
 
   // #125：未确认时 skills/toolDefs 为空，分类总量仍可由 bd 路径填充
-  const skills = stepConfirmed ? await gatherSkills(input) : []
+  // #136：skills 同：确认可 FS；未确认仅走注入早返回
+  const skills =
+    stepConfirmed || input.skills !== undefined ? await gatherSkills(input) : []
   const skillListing = skillsSection(skillInfo(skills))
   // #125：磁盘扫描仍需 stepConfirmed；嵌入 catalog 的 toolDefs 始终可组装（避免历史 tool call 塌缩）
+  // #136：嵌入 catalog 的 toolDefs 始终组装；磁盘扫描仍由 stepConfirmed/注入门控
   let toolDefs = await toolDefinitionTokens(
     input,
     compacted,
@@ -1244,6 +1251,7 @@ export async function computeContextData(input: ComputeContextDataInput): Promis
     { modelID: modelInfo.modelID, providerID: modelInfo.providerID },
     ratio,
   )
+
   // 系统提示词 = 基础提示 + 环境信息 + 用户自定义 system 覆盖
   const systemText = [
     baseSystemPrompt(input, lastUser, modelInfo.model),
@@ -1354,11 +1362,15 @@ export async function computeContextData(input: ComputeContextDataInput): Promis
     { name: "Autocompact buffer", tokens: window.compactionBuffer, color: "textMuted", isDeferred: true },
   ]
 
+  // #136：主 total = 最近 step 上下文窗口；footer 的 details.usage 仍是会话累计
+  // #136：step 窗口优先于 used 重建，对齐模型当前上下文占用
+  const stepWindowTokens = acc.step.input + acc.step.output
   return {
     model: [modelInfo.providerID, modelInfo.modelID].filter(Boolean).join("/") || "(unknown)",
-    totalTokens: used,
+    totalTokens: stepWindowTokens > 0 ? stepWindowTokens : used,
     maxTokens,
-    percentage: maxTokens ? used / maxTokens : 0,
+    // #136：percentage 与 totalTokens 同源窗口，避免主柱与百分比分叉
+    percentage: maxTokens ? (stepWindowTokens > 0 ? stepWindowTokens : used) / maxTokens : 0,
     categories,
     // 无模型限制时用已用+缓冲+自由作为网格基数，保证网格有内容
     gridRows: contextGrid(categories, maxTokens || Math.max(used + window.compactionBuffer + free, 1), { columns: input.columns }),
