+++ b/packages/opencode/test/storage/goal-migration.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, test } from "bun:test"
+import { Database } from "bun:sqlite"
+
+// [local-smark] goal_continue_on_error 迁移兼容性测试
+// 验证旧 session_goal 行在添加 continue_on_error 列后：
+// 1. 迁移不抛错 2. 新列默认 false 3. 原有字段不变。
+// 目标架构：core 使用 TS migration（migration.gen），无 drizzle sql 目录，
+// 因此这里直接复现 20260726100000 建表 + 20260812100000 ALTER 的组合语义
+describe("goal continue_on_error migration", () => {
+  test("migrates existing session_goal rows with default false", () => {
+    const sqlite = new Database(":memory:")
+    // 建表（等价 20260726100000_session_goal 的 CREATE TABLE）
+    sqlite.run(`CREATE TABLE \`session_goal\` (
+      \`session_id\` text PRIMARY KEY,
+      \`id\` text NOT NULL,
+      \`objective\` text NOT NULL,
+      \`status\` text NOT NULL,
+      \`token_budget\` integer,
+      \`tokens_used\` integer DEFAULT 0 NOT NULL,
+      \`time_used_seconds\` integer DEFAULT 0 NOT NULL,
+      \`time_created\` integer NOT NULL,
+      \`time_updated\` integer NOT NULL
+    )`)
+    // 插入旧结构行（无 continue_on_error 列）
+    sqlite.run(
+      "INSERT INTO session_goal (session_id, id, objective, status, token_budget, tokens_used, time_used_seconds, time_created, time_updated) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
+      ["ses_test", "goal_1", "test objective", "active", 50000, 1000, 30, 1, 1],
+    )
+
+    // 应用新 migration（20260812100000_goal_continue_on_error 的 ALTER）
+    expect(() =>
+      sqlite.run(`ALTER TABLE \`session_goal\` ADD \`continue_on_error\` integer DEFAULT false NOT NULL`),
+    ).not.toThrow()
+
+    // 验证新列默认 false（SQLite boolean: 0 = false）
+    const row = sqlite.query("SELECT * FROM session_goal WHERE session_id = ?").get("ses_test") as any
+    expect(row.continue_on_error).toBe(0)
+
+    // 验证原有字段不变
+    expect(row.id).toBe("goal_1")
+    expect(row.objective).toBe("test objective")
+    expect(row.status).toBe("active")
+    expect(row.token_budget).toBe(50000)
+    expect(row.tokens_used).toBe(1000)
+    expect(row.time_used_seconds).toBe(30)
+    expect(row.time_created).toBe(1)
+    expect(row.time_updated).toBe(1)
+  })
+})
