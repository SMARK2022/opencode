@@ -143,13 +156,231 @@ class ReadStop extends Schema.TaggedErrorClass<ReadStop>()("ReadStop", {}) {}
 // purpose in the LLM tool-call path (the model emits typed JSON). The JSON
 // Schema output is identical (`type: "number"`), so the LLM view is
 // unchanged; purely CLI-facing uses must now send numbers rather than strings.
+
+// #142：可见上下文 stub 状态
+// #142：stub 两种语义：同区间已见 / 被更大区间覆盖
+type ReadStubStatus = "stub_same_range_visible" | "stub_covered_range_visible"
+
+// #142：区间元数据写入 metadata.read，供后续 stub 比对
+type ReadRangeMeta = {
+  path: string
+  canonicalPath: string
+  type: "file"
+  size: number
+  modified: string
+  modifiedMs: number
+  start: number
+  end: number
+  total: number
+  returned: number
+  stub: boolean
+  stubStatus?: ReadStubStatus
+  coveredBy?: string
+}
+
+// #142：统一 metadata 形状，保证 read 字段可选
+// #142：统一返回 Metadata，避免 Tool.define 推断分裂
+function readToolMetadata(input: Metadata) {
+  return input
+}
+
+// #142：结构标签转义，防止 path/content 破坏 XML 外壳
+// #142：结构字段 escape
+function escapeXmlText(input: string) {
+  return input.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")
+}
+
+// #142：属性值额外转义引号
+// #142：属性引号 escape
+function escapeXmlAttr(input: string) {
+  return escapeXmlText(input).replaceAll('"', "&quot;").replaceAll("'", "&apos;")
+}
+
+// #142：mtime 稳定字符串，供 stub 版本比对
+// #142：mtime 显示串
+function formatModified(ms: number) {
+  const date = new Date(ms)
+  const pad = (n: number) => String(n).padStart(2, "0")
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(
+    date.getMinutes(),
+  )}:${pad(date.getSeconds())}`
+}
+
+// #142：兼容 bigint/number size
+// #142：size 统一 number
+function fileSizeOf(stat: { size: unknown }) {
+  return typeof stat.size === "bigint" ? Number(stat.size) : Number(stat.size)
+}
+
+// #142：Windows 规范化后小写，保证同路径可见集合
+// #142：路径规范化键
+function canonicalReadPath(filepath: string) {
+  return process.platform === "win32" ? FSUtil.normalizePath(filepath).toLowerCase() : filepath
+}
+
+// #142：Option<Date> 解包为 ms
+// #142：Option mtime 解包
+function modifiedMsOf(stat: { mtime: Option.Option<Date> }) {
+  return Math.floor(Option.getOrElse(stat.mtime, () => new Date(0)).getTime())
+}
+
+// #142：metadata.read 运行时守卫
+// #142：read 元数据 type guard
+function isReadRangeMeta(input: unknown): input is ReadRangeMeta {
+  if (!input || typeof input !== "object") return false
+  const item = input as Record<string, unknown>
+  return (
+    typeof item.path === "string" &&
+    typeof item.canonicalPath === "string" &&
+    item.type === "file" &&
+    typeof item.size === "number" &&
+    typeof item.modified === "string" &&
+    typeof item.modifiedMs === "number" &&
+    typeof item.start === "number" &&
+    typeof item.end === "number" &&
+    typeof item.total === "number" &&
+    typeof item.returned === "number" &&
+    typeof item.stub === "boolean"
+  )
+}
+
+// #142：从会话历史收集同文件、未 stub 的可见读取
+// #142：扫描 assistant 已完成 read
+function collectVisibleReads(messages: Array<{ info: { role: string }; parts: any[] }>, canonicalPath: string) {
+  const reads: ReadRangeMeta[] = []
+  for (let i = messages.length - 1; i >= 0; i--) {
+    const msg = messages[i]
+    if (msg.info.role !== "assistant") continue
+    for (const part of msg.parts) {
+      if (part.type !== "tool" || part.tool !== "read") continue
+      if (part.state.status !== "completed" || part.state.time.compacted) continue
+      const meta = (part.state.metadata as { read?: unknown } | undefined)?.read
+      if (!isReadRangeMeta(meta) || meta.stub) continue
+      if (meta.canonicalPath !== canonicalPath) continue
+      reads.push(meta)
+    }
+  }
+  return reads
+}
+
+// #142：决定是否 stub
+function findReadStub(visibleReads: ReadRangeMeta[], current: ReadRangeMeta) {
+  // #142：仅当同文件版本已在上下文可见时抑制输出
+  // #142：仅同 size+mtime 视为同文件版本
+  const sameVersion = visibleReads.filter((item) => item.modifiedMs === current.modifiedMs && item.size === current.size)
+  // #142：完全相同 start-end 优先 stub_same_range
+  const sameRange = sameVersion.find((item) => item.start === current.start && item.end === current.end)
+  if (sameRange) return { status: "stub_same_range_visible" as const }
+  // #142：完全覆盖子区间也可 stub
+  const covering = sameVersion.find((item) => item.start <= current.start && item.end >= current.end)
+  // #142：子区间被已见区间覆盖
+  if (covering) return { status: "stub_covered_range_visible" as const, coveredBy: `${covering.start}-${covering.end}` }
+  return undefined
+}
+
+// #142：计算 overlap note
+function findOverlapNote(visibleReads: ReadRangeMeta[], current: ReadRangeMeta) {
+  const overlaps = visibleReads
+    .filter((item) => item.modifiedMs === current.modifiedMs && item.size === current.size)
+    .map((item) => {
+      const start = Math.max(item.start, current.start)
+      const end = Math.min(item.end, current.end)
+      return end >= start ? { start, end, lines: end - start + 1 } : undefined
+    })
+    .filter((item): item is { start: number; end: number; lines: number } => !!item)
+  if (!overlaps.length) return undefined
+  const lines = overlaps.reduce((sum, item) => sum + item.lines, 0)
+  const span = Math.max(1, current.end - current.start + 1)
+  // #142：小重叠不提示，避免噪音
+  if (lines < OVERLAP_MIN_LINES && lines / span < OVERLAP_MIN_RATIO) return undefined
+  return overlaps.map((item) => `${item.start}-${item.end}`).join(",")
+}
+
+// #142：渲染 content 行
+function renderContentLines(raw: string[], offset: number) {
+  return raw
+    .map((line, i) => {
+      // #142：结构化包装字段转义；内容行 escape 防破坏 XML 结构（#145 改为原文）
+      if (line.length <= MAX_LINE_LENGTH) return `${i + offset}: ${escapeXmlText(line)}`
+      return `${i + offset}: ${escapeXmlText(line.slice(0, MAX_LINE_LENGTH))} (line truncated to ${MAX_LINE_LENGTH} chars)`
+    })
+    .join("\n")
+}
+
+// #142：完整结构化输出
+function renderReadOutput(input: {
+  path: string
+  size: number
+  modified: string
+  start: number
+  end: number
+  total: number
+  returned: number
+  raw: string[]
+  cut: boolean
+  more: boolean
+  outline?: Outline
+  overlap?: string
+}) {
+  // #142：结构外壳 path/type/file/range 固定顺序
+  const output: string[] = [
+    `<path>${escapeXmlText(input.path)}</path>`,
+    `<type>file</type>`,
+    `<file size="${input.size}" modified="${escapeXmlAttr(input.modified)}" />`,
+    `<range start="${input.start}" end="${input.end}" total="${input.total}" returned="${input.returned}" />`,
+  ]
+  // #142：outline 仅插入结构提示区
+  if (input.outline?.items.length) {
+    output.push(`<outline truncated="${input.outline.truncated ? "true" : "false"}">`)
+    output.push(input.outline.items.map(escapeXmlText).join("\n"))
+    output.push("</outline>")
+  }
+  // #142：部分重叠仍返回内容，附加 note
+  if (input.overlap) output.push(`<note type="overlap" ranges="${escapeXmlAttr(input.overlap)}" />`)
+  // #142：content 包裹可见行（#145 决定是否 escape 行文本）
+  output.push("<content>")
+  output.push(renderContentLines(input.raw, input.start))
+  output.push("</content>")
+  // #142：字节截断与行截断用不同 reason
+  if (input.cut) output.push(`<more offset="${input.end + 1}" reason="byte_limit" />`)
+  else if (input.more) output.push(`<more offset="${input.end + 1}" reason="line_limit" />`)
+  return output.join("\n")
+}
+
+// #142：stub 结构化输出
+function renderReadStub(input: {
+  path: string
+  size: number
+  modified: string
+  start: number
+  end: number
+  total: number
+  status: ReadStubStatus
+  coveredBy?: string
+}) {
+  const msg =
+    input.status === "stub_same_range_visible"
+      ? "Requested range is already visible in the current context."
+      : `Requested range is covered by already visible range ${input.coveredBy}.`
+  return [
+    `<path>${escapeXmlText(input.path)}</path>`,
+    `<type>file</type>`,
+    `<file size="${input.size}" modified="${escapeXmlAttr(input.modified)}" />`,
+    `<range start="${input.start}" end="${input.end}" total="${input.total}" returned="0" />`,
+    `<stub status="${input.status}"${input.coveredBy ? ` covered_by="${escapeXmlAttr(input.coveredBy)}"` : ""}>`,
+    msg,
+    "</stub>",
+  ].join("\n")
+}
+
+
 export const Parameters = Schema.Struct({
   filePath: Schema.String.annotate({ description: "The absolute path to the file or directory to read" }),
   offset: Schema.optional(NonNegativeInt).annotate({
     description: "The line number to start reading from (1-indexed)",
   }),
   limit: Schema.optional(NonNegativeInt).annotate({
-    description: "The maximum number of lines to read (defaults to 400)",
+    description: "The maximum number of lines to read (defaults to 200)",
   }),
 })
 
