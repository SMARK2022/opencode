+const MIN_LINES = 600
+const MAX_ENTRIES = 32
+const MAX_CHARS = 640
+const MAX_ITEM_CHARS = 60
+const MAX_SCAN_LINES = 3000
+
+const SOURCE_EXTENSIONS = new Set([
+  ".ts",
+  ".tsx",
+  ".js",
+  ".jsx",
+  ".mjs",
+  ".cjs",
