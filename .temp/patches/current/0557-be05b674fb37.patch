+    ...item.tail,
+  ] as Array<{ choices?: Array<{ delta?: { tool_calls?: Array<{ index: number; function?: { name?: string } }> } }> }>) {
+    const call = line.choices?.[0]?.delta?.tool_calls?.[0]
+    if (!call) continue
+    if (call.function?.name) index++
+    call.index = index
+  }
+  return item
+}
