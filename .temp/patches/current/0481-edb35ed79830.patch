               conceal={ctx.conceal()}
+              onChunks={handleChunks}
               fg={theme.textMuted}
-              wrapMode={!inMinimal() || expanded() ? "word" : "char"}
+              wrapMode={expanded() || !overflow() ? "word" : "char"}
             />
           </box>
           {/* [local-smark] 展开入口必须位于正文裁剪区之外，避免按钮也被五行上限隐藏。
@@ -1960,16 +2017,9 @@ const renderedContent = createMemo(() => displayContent() || content())
               行数判断会让 footer 闪烁；流式中默认收缩语义要求 footer 与裁剪同步 */}
           <Show
             when={
-              inMinimal() &&
               !expanded() &&
-              (!isDone() ||
-                renderedContent().split(String.fromCharCode(10)).length > 5 ||
