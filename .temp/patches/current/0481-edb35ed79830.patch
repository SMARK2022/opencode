-                    (rows, line) => rows + Math.max(1, Math.ceil(Bun.stringWidth(line) / Math.max(1, ctx.width - 5))),
-                    0,
-                  ) > 5)
+              // #481：toggle 出现与否按 word-wrap 实测 overflow 判定（渲染未就绪=false）。
