index 0000000000000000000000000000000000000000..696d706f7274207b206578706563742c20746573
--- /dev/null
+++ b/packages/tui/test/routes/session/reasoning-disclosure.test.tsx
@@ -0,0 +1,113 @@
+import { expect, test } from "bun:test"
+import { randomUUID } from "node:crypto"
+import { mkdir, writeFile } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import path from "node:path"
+import { testRender } from "@opentui/solid"
+import { TuiPathsProvider, TuiStartupProvider } from "../../../src/context/runtime"
+import { KVProvider } from "../../../src/context/kv"
+import { TuiConfigProvider } from "../../../src/config"
+import { ThemeProvider } from "../../../src/context/theme"
+import { RouteProvider } from "../../../src/context/route"
+// #481：ReasoningPart 行为契约锁定——
+// 短内容零展开入口、无 overflow 依据时点击不预写折叠状态、visibility 主键整块隐藏。
+// overflow 的 word-wrap 实测依赖 code 高亮回调（headless 下不上报），
+// 因此本文件锁定可稳定复现的三个契约面；overflow 数值路径由生产流式链路覆盖。
+import { ReasoningPartView, context as SessionContext } from "../../../src/routes/session"
+
+const makeCtx = (showThinking: () => boolean) => ({
+  width: 60,
+  sessionID: "ses_test",
+  conceal: () => false,
+  showThinking,
+  showTimestamps: () => false,
+  showDetails: () => true,
+  showGenericToolOutput: () => true,
+  diffWrapMode: () => "word" as const,
+  providers: () => new Map(),
+  sync: {} as never,
+  tui: {} as never,
+})
+
+const makePart = (text: string) => ({
+  id: "prt_test",
+  type: "reasoning" as const,
+  text,
+  metadata: undefined,
+  time: { start: Date.now(), end: Date.now() },
+})
+
+async function setup() {
+  const stateDir = path.join(tmpdir(), `reasoning-kv-${randomUUID()}`)
+  await mkdir(stateDir, { recursive: true })
+  await writeFile(path.join(stateDir, "kv.json"), "{}")
+  return stateDir
+}
+
+function Harness(props: { showThinking: () => boolean; text: string; stateDir: string }) {
+  return (
+    <TuiPathsProvider value={{ cwd: "/work", home: "/home/t", state: props.stateDir, worktree: "/work" }}>
+      <TuiStartupProvider value={{ skipInitialLoading: true }}>
+        <KVProvider>
+          <TuiConfigProvider config={{ theme: undefined } as never}>
+            <ThemeProvider mode="dark" source={{ discover: async () => ({}) }}>
+              <RouteProvider>
+                <SessionContext.Provider value={makeCtx(props.showThinking)}>
+                  <ReasoningPartView last part={makePart(props.text) as never} message={{} as never} />
+                </SessionContext.Provider>
+              </RouteProvider>
+            </ThemeProvider>
+          </TuiConfigProvider>
+        </KVProvider>
+      </TuiStartupProvider>
+    </TuiPathsProvider>
+  )
+}
+
+test("done reasoning renders Thought header for short content", async () => {
+  const stateDir = await setup()
+  const app = await testRender(() => <Harness showThinking={() => true} text={"第一行推理\n第二行推理"} stateDir={stateDir} />, { width: 60, height: 30 })
+  await new Promise((resolve) => setTimeout(resolve, 100))
+  try {
+    await app.waitForFrame((frame) => frame.includes("Thought"))
+    const frame = app.captureCharFrame()
+    // header 出现（done 态折叠词汇），短内容无展开入口
+    expect(frame).toContain("Thought")
+    expect(frame).not.toContain("展开查看完整推理")
+  } finally {
+    app.renderer.destroy()
+  }
+})
+
+test("clicking header without overflow evidence does not preset expanded state", async () => {
+  const stateDir = await setup()
+  const app = await testRender(() => <Harness showThinking={() => true} text={"第一行推理\n第二行推理"} stateDir={stateDir} />, { width: 60, height: 30 })
+  await new Promise((resolve) => setTimeout(resolve, 100))
+  try {
+    await app.waitForFrame((frame) => frame.includes("Thought"))
+    // #481 防预写契约：无 overflow 依据（渲染未上报）时点击 toggle 是 no-op，
+    // header 保持折叠词汇 "+"，不能因点击而翻转或泄露展开入口
+    await app.mockMouse.click(10, 5)
+    await new Promise((resolve) => setTimeout(resolve, 50))
+    const frame = app.captureCharFrame()
+    expect(frame).toContain("Thought")
+    expect(frame).not.toContain("展开查看完整推理")
+  } finally {
+    app.renderer.destroy()
+  }
+})
+
+test("visibility off hides the whole reasoning block including header", async () => {
+  const stateDir = await setup()
+  const app = await testRender(() => <Harness showThinking={() => false} text={"第一行推理\n第二行推理"} stateDir={stateDir} />, { width: 60, height: 30 })
+  await new Promise((resolve) => setTimeout(resolve, 100))
+  try {
+    // visibility 主键为 false：标题与正文一起消失（整块 Show 门）
+    await new Promise((resolve) => setTimeout(resolve, 100))
+    const frame = app.captureCharFrame()
+    expect(frame).not.toContain("Thought")
+    expect(frame).not.toContain("展开查看完整推理")
+  } finally {
+    app.renderer.destroy()
+  }
+})
