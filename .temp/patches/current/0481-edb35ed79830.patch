-function ReasoningPart(props: { last: boolean; part: ReasoningPart; message: AssistantMessage }) {
+// #481：导出供行为测试直接渲染（disclosure/overflow 行为契约锁定）；
+// 本地名避开 import type 的 ReasoningPart（SDK 类型）在值空间的遮蔽歧义
+export function ReasoningPartView(props: { last: boolean; part: ReasoningPart; message: AssistantMessage }) {
   const { theme } = useTheme()
   const ctx = use()
+  // #481：visibility 决定整块可见性（由 Session 层 showThinking 提供）；disclosure
+  // （expanded/overflow）是本 run 局部状态，visibility 切换不重置它。
   // Collapsed by default in hide mode: a single line throughout, so the
   // layout never shifts. Click to open the full markdown block, click to close.
   const [expanded, setExpanded] = createSignal(false)
+  // post-conceal 渲染文本缓存：Code 的 onChunks 在高亮渲染期上报实际可见文本，
+  // conceal 变更使缓存失效（下方 effect 重置）。
+  const [rendered, setRendered] = createSignal<string[] | undefined>(undefined)
 
   const content = createMemo(() => {
     // OpenRouter encrypts some reasoning blocks; drop the placeholder.
@@ -1901,7 +1909,53 @@ const renderedContent = createMemo(() => displayContent() || content())
   const isDone = createMemo(() => props.part.time.end !== undefined)
   // #137：完成后 remount 推理块，避免高度测量粘滞
   const completedKey = createMemo(() => `${ctx.width}@${renderedContent()}`)
-  const inMinimal = createMemo(() => ctx.thinkingMode() === "hide")
+  // #481：word-wrap 实测行数——TextBufferView 按终端宽度做真实换行测量，替代
+  // 字符数/宽度的启发式估算（估算会低估 CJK/长词换行的真实行数）。句柄用后即毁，
+  // 避免 native 内存滞留。
+  const measureReasoningRows = (text: string) => {
+    if (!text) return 0
+    const buffer = TextBuffer.create("wcwidth")
+    const view = TextBufferView.create(buffer)
+    try {
+      view.setWrapMode("word")
+      // #481：无显式宽度时 native 端可能用默认值，换行测量必须与当前终端列数一致
+      view.setWrapWidth(Math.max(1, ctx.width))
+      buffer.setText(text)
+      return view.getVirtualLineCount()
+    } finally {
+      buffer.destroy()
+      view.destroy()
+    }
+  }
+  // overflow：post-conceal 渲染文本实测行数 > 五行预算。高亮分段数不是视觉行数，
+  // 必须逐段 word-wrap 实测求和；渲染未就绪（异步高亮未上报）时按 false 处理——
+  // 无依据不显示 toggle，防止短内容点击预写状态。
+  const overflow = createMemo(() => {
+    const chunks = rendered()
+    if (!chunks) return false
+    return reasoningRowsTotal(chunks) > REASONING_PREVIEW_ROWS
+  })
+  // #481：Code 高亮渲染回调——generation 边界（context.content）防止旧回调覆盖新 delta；
+  // 上报的 post-conceal 文本作为 overflow 实测依据。参数类型与 Code 属性签名结构兼容。
+  const handleChunks = (chunks: TextChunk[], context: ChunkRenderContext) => {
+    if (context.content !== renderedContent()) return chunks
+    setRendered(chunks.map((chunk) => chunk.text))
+    return chunks
+  }
+  // #481：word-wrap 总行数——分段测量求和近似整段换行（高亮分段边界通常即词边界，
+  // 求和与整段测量的偏差不跨五行阈值时无影响）
+  const reasoningRowsTotal = (chunks: string[]) => {
+    let total = 0
+    for (const chunk of chunks) total += measureReasoningRows(chunk)
+    return total
+  }
+  createEffect(
+    on(ctx.conceal, () => {
+      // #481：conceal 变更使 post-conceal 文本缓存失效——重置后 overflow 暫回 false，
+      // 展开入口先消失再等新渲染上报；disclosure（expanded）刻意不重置
+      setRendered(undefined)
+    }),
+  )
   const duration = createMemo(() => {
     const end = props.part.time.end
     return end === undefined ? 0 : Math.max(0, end - props.part.time.start)
@@ -1910,12 +1964,14 @@ const renderedContent = createMemo(() => displayContent() || content())
   const syntax = createSyntaxStyleMemo(() => generateSubtleSyntax(theme))
 
