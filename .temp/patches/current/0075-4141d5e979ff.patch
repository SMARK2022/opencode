 import { createThrottledSignal, createTokenFlowPulse } from "../../util/signal"
 import { sumConfirmed as sharedSumConfirmed, computeFinalTokens, charsPerTokenFromHistory } from "../../util/token-estimate"
 
 const id = "internal:sidebar-context"
+// 侧边栏 RTT 探测间隔：串行 setTimeout，避免 interval 重叠
+// 侧边栏 RTT 探测间隔：串行 setTimeout，避免 interval 重叠
+const PING_INTERVAL = 1_000
 
 const money = new Intl.NumberFormat("en-US", {
   style: "currency",
@@ -14,6 +19,111 @@ const money = new Intl.NumberFormat("en-US", {
 
 function View(props: { api: TuiPluginApi; session_id: string }) {
   const theme = () => props.api.theme.current
+  // 读当前选中模型，决定 ping 的 provider/model
+const local = useLocal()
+
+  // 当前模型 API origin：local.model 优先，回退最近 assistant；空/非法 URL 不探测
+  // 解析 API origin：local.model 优先，回退最近 assistant
+// 空串/非法 URL 返回 null，避免 new URL 抛错刷 offline
+const targetApiUrl = createMemo(() => {
+    const selected = local.model.current()
+    const messages = props.api.state.session.messages(props.session_id)
+    const lastAsst = messages.filter((m) => m.role === "assistant").at(-1)
+    const last =
+      lastAsst && lastAsst.role === "assistant"
+        ? (lastAsst as { providerID?: string; modelID?: string })
+        : undefined
+    const providerID = selected?.providerID ?? last?.providerID
+    const modelID = selected?.modelID ?? last?.modelID
+    if (!providerID || !modelID) return null
+    const provider = props.api.state.provider.find((item) => item.id === providerID)
+    const model = provider?.models[modelID]
+    const configuredBaseUrl = provider?.options?.baseURL
+    const baseUrl =
+      typeof configuredBaseUrl === "string" && configuredBaseUrl !== ""
+        ? configuredBaseUrl
+        : model?.api?.url
+    if (typeof baseUrl !== "string" || baseUrl === "") return null
+    try {
+      // 只 ping origin：避免路径 404，更接近纯网络 RTT
+      return new URL(baseUrl).origin
+    } catch {
+      return null
+    }
+  })
+
+  // latency 仅在 ok 时有值；down/init 清空
+const [latency, setLatency] = createSignal<number | null>(null)
+  // ping 三态：init 静音 / ok 着色 / down offline
+const [pingStatus, setPingStatus] = createSignal<"ok" | "down" | "init">("init")
+  // 代理路径 🌐，直连 ⚡，帮助诊断路由
+const [isProxy, setIsProxy] = createSignal(false)
+
+  createEffect(
+    on(targetApiUrl, (url) => {
+      if (!url) {
+        setLatency(null)
+        setPingStatus("init")
+        setIsProxy(false)
+        return
+      }
+
+      // URL 变更或卸载时置 false，丢弃在途响应
+let active = true
+      let timer: ReturnType<typeof setTimeout> | undefined
+      const ping = async () => {
+        if (!active) return
+        const t0 = Date.now()
+        try {
+          // 与业务请求相同 purpose，反映真实代理路径
+const route = await NetworkProxy.resolveProxyRoute(url, "provider")
+          if (!active) return
+          setIsProxy(route.type === "proxy")
+          const res = await NetworkProxy.routedFetch(url, {
+            method: "HEAD",
+            signal: AbortSignal.timeout(3000),
+            purpose: "provider",
+          } as RequestInit)
+          const elapsed = Date.now() - t0
+          if (!active) return
+          // 仅 502/503/504 记 offline；其余状态仍展示 RTT
+          // 仅网关错误记 offline；其它 4xx/5xx 仍展示 RTT
+if (res.status === 502 || res.status === 503 || res.status === 504) {
+            setPingStatus("down")
+            setLatency(null)
+          } else {
+            setPingStatus("ok")
+            setLatency(elapsed)
+          }
+        } catch {
+          if (active) {
+            setPingStatus("down")
+            setLatency(null)
+          }
+        }
+        // 串行调度：上次结束后再等 1s，避免 interval 重叠
+if (active) timer = setTimeout(ping, PING_INTERVAL)
+      }
+
+      ping()
+      onCleanup(() => {
+        active = false
+        if (timer) clearTimeout(timer)
+      })
+    }),
+  )
+
+  // RTT 着色：<300 success / <800 warning / 否则 error
+  // RTT 着色阈值：<300 success / <800 warning / 否则 error
+const latencyDisplay = createMemo(() => {
+    const icon = isProxy() ? "🌐" : "⚡"
+    if (pingStatus() === "init") return { text: `${icon} ...`, fg: theme().textMuted }
+    if (pingStatus() === "down") return { text: `${icon} offline`, fg: theme().error }
+    const l = latency()!
+    const fg = l < 300 ? theme().success : l < 800 ? theme().warning : theme().error
+    return { text: `${icon} ${l}ms`, fg }
+  })
+
   const msg = createMemo(() => props.api.state.session.messages(props.session_id))
   const session = createMemo(() => props.api.state.session.get(props.session_id))
   const cost = createMemo(() => session()?.cost ?? 0)
@@ -102,7 +212,16 @@ function View(props: { api: TuiPluginApi; session_id: string }) {
       <text fg={theme().textMuted}><span style={{ fg: flow().input ? theme().text : theme().textMuted }}>↑</span> {state().input.toLocaleString()}({state().totalInput.toLocaleString()}) · <span style={{ fg: flow().output ? theme().text : theme().textMuted }}>↓</span> {state().output.toLocaleString()}({state().totalOutput.toLocaleString()})</text>
       <text fg={theme().textMuted}>{state().tokens.toLocaleString()} ({state().totalTokens.toLocaleString()}) tokens</text>
       <text fg={theme().textMuted}>{state().percent ?? 0}% used</text>
-      <text fg={theme().textMuted}>{money.format(cost())} spent</text>
+      {/* 无可用 API URL 时不渲染延迟段，避免永远显示 ... */}
+      <text fg={theme().textMuted}>
+        {money.format(cost())} spent
+        {targetApiUrl() && (
+          <>
+            {" · "}
+            <span style={{ fg: latencyDisplay().fg }}>{latencyDisplay().text}</span>
+          </>
+        )}
+      </text>
     </box>
   )
 }
