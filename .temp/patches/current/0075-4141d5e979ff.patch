+// SDK 默认 API URL：未显式配置 api 时回退到三大官方端点
+// 三大 SDK 官方端点：provider 未配 api 时兜底
+const SDK_DEFAULT_API_URL: Record<string, string> = {
+  "@ai-sdk/anthropic": "https://api.anthropic.com/v1",
