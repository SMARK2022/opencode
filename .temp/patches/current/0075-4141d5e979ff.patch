+    if (pingStatus() === "down") return { text: `${icon} offline`, fg: theme().error }
+    const value = latency()
+    if (value === null) return { text: `${icon} ...`, fg: theme().textMuted }
+    return { text: `${icon} ${value}ms`, fg: value < 300 ? theme().success : value < 800 ? theme().warning : theme().error }
+  })
+
   return (
