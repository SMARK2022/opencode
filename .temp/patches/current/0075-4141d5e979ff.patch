+  // 沿源功能跟随当前选择；历史 API ID 不能唯一标识 Catalog 别名。
+  const targetApiUrl = createMemo(() => {
+    // 等待持久化选择就绪，避免冷启动时探测随后会被恢复状态替换的临时模型。
+    if (!local.model.ready) return null
+    const selected = local.model.current()
