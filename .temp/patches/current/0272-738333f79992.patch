     .trimEnd()
 }
 
+// #272：Linux 上 OpenTUI 渲染器的 gutter 列宽可能漂移，固定列坐标点击不稳定
+// 此函数返回可见文本在帧中的 {x, y} 位置，供测试用于精准定位而非固定列
+function findVisibleText(frame: string[], text: string): { x: number; y: number } | undefined {
+  const y = frame.findIndex((line) => line.includes(text))
+  if (y < 0) return undefined
+  const x = frame[y].indexOf(text)
+  if (x < 0) return undefined
+  return { x, y }
+}
+
