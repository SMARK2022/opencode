From aa1d0d27c371fd644a41dbbc60f10505c95bf6fb Mon Sep 17 00:00:00 2001
From: SMARK <3222301373@qq.com>
Date: Mon, 25 May 2026 03:06:21 +0800
Subject: [PATCH] fix(shell): 修改 PowerShell 模块的日志偏好设置为默认静默，避免输出污染

diff --git a/packages/opencode/src/tool/shell.ts b/packages/opencode/src/tool/shell.ts
index c188fc96bd..9e4dc16393 100644
--- a/packages/opencode/src/tool/shell.ts
+++ b/packages/opencode/src/tool/shell.ts
@@ -383,11 +383,14 @@ function psUtf8(command: string) {
     "$OutputEncoding = [Console]::OutputEncoding",
     // #129：关掉进度条噪声
     "$ProgressPreference = 'SilentlyContinue'",
-    // #129：信息/警告/调试流继续输出
+    // #129：信息/警告流继续输出
     "$InformationPreference = 'Continue'",
     "$WarningPreference = 'Continue'",
-    "$VerbosePreference = 'Continue'",
-    "$DebugPreference = 'Continue'",
+    // #221：默认静默 verbose/debug——PowerShell 模块自动加载时会向 verbose/debug
+    // #221：流写入大量噪声，混入 *>&1 合并后会污染终端输出和 LLM 上下文；
+    // #221：用户仍可在命令内显式 $VerbosePreference='Continue' 重新开启。
+    "$VerbosePreference = 'SilentlyContinue'",
+    "$DebugPreference = 'SilentlyContinue'",
     "& {",
     command,
     // #129：*&1 合并全部流到 stdout（#130 将收窄 stderr）
