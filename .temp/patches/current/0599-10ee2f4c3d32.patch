适配说明：保留source五hunk并按真实V1上下文重锚；共享prompt保存唯一时间预算文本，V1保留局部常量名，Core原生reviewer同步120秒与单份后缀。按最近失败种类选择协议或时间提示，三次尝试、596的窄400协商和取消边界不变；既有Core回归覆盖首轮、超时及混合链。


diff --git a/packages/core/src/permission/reviewer/prompt.ts b/packages/core/src/permission/reviewer/prompt.ts
--- a/packages/core/src/permission/reviewer/prompt.ts
+++ b/packages/core/src/permission/reviewer/prompt.ts
@@ -24,3 +24,9 @@
 // #198：默认租户策略从 policy.md 导入——可在 config 中用 policy_path 或 policy 字段覆盖或追加
 export const DEFAULT_TENANT_POLICY = DEFAULT_POLICY
 
+// 超时才提示600词软预算；保留意图/风险/策略清单，重建上下文不能引用不可见的上一轮分析。
+export const TIME_BUDGET_RETRY_USER_ITEM = {
+  type: "text" as const,
+  text: "Time advisory: a previous attempt at this review exceeded its time budget. Think concisely now: keep reasoning within roughly 600 words. State the user's intent and authorization, the action's concrete risk, and the policy rule that matches, then submit the decision. Do not re-derive the transcript, do not re-check alternatives repeatedly, and do not stall in 'wait, but…' loops.",
+}
+
diff --git a/packages/core/src/config/auto-review.ts b/packages/core/src/config/auto-review.ts
--- a/packages/core/src/config/auto-review.ts
+++ b/packages/core/src/config/auto-review.ts
@@ -10,3 +10,3 @@
   // 与V1相同，单次执行期限不包含后续补试及清理的全部墙钟时间。
-  timeout_ms: Schema.Number.pipe(Schema.optional).annotate({ description: "Reviewer execution timeout per attempt in milliseconds. At most three attempts. Defaults to 90000." }),
+  timeout_ms: Schema.Number.pipe(Schema.optional).annotate({ description: "Reviewer execution timeout per attempt in milliseconds. At most three attempts. Timeout retries append a time-budget advisory to the prompt. Defaults to 120000." }),
   policy_path: Schema.String.pipe(Schema.optional),
diff --git a/packages/core/src/permission/reviewer.ts b/packages/core/src/permission/reviewer.ts
--- a/packages/core/src/permission/reviewer.ts
+++ b/packages/core/src/permission/reviewer.ts
@@ -79,3 +79,3 @@
       // 只在reviewer解码边界接受source允许的文本裁决，通用generateObject契约保持严格。
-      const attempt = (index: number, nudged = false): Effect.Effect<PermissionReviewerSchema.Assessment, Failed | LLMError> => Effect.gen(function* () {
+      const attempt = (index: number, retry?: "protocol" | "timeout"): Effect.Effect<PermissionReviewerSchema.Assessment, Failed | LLMError> => Effect.gen(function* () {
         const forced = !toolChoiceRejectedProviders.has(selected.model.provider)
@@ -86,1 +86,1 @@
-          prompt: items.map((item) => item.text).join("\n\n") + (nudged ? "\n\nSubmit a valid decision using the generate_object tool. Avoid prose, questions, explanations of inability, and offers to execute the action. Keep the supplied evidence and requested action unchanged. If tool calls are unavailable, reply with ONLY the JSON decision object." : ""),
+          prompt: items.map((item) => item.text).join("\n\n") + (retry === "timeout" ? "\n\n" + PermissionReviewerPrompt.TIME_BUDGET_RETRY_USER_ITEM.text : retry === "protocol" ? "\n\nSubmit a valid decision using the generate_object tool. Avoid prose, questions, explanations of inability, and offers to execute the action. Keep the supplied evidence and requested action unchanged. If tool calls are unavailable, reply with ONLY the JSON decision object." : ""),
@@ -103,8 +103,8 @@
         // 单次超时位于重试内侧；取消保持interruption，绝不能变成批准或补试。
-        Effect.timeoutOrElse({ duration: options.timeout_ms ?? 90_000, orElse: () => Effect.fail(new Failed({ reason: "auto reviewer timed out" })) }),
+        Effect.timeoutOrElse({ duration: options.timeout_ms ?? 120_000, orElse: () => Effect.fail(new Failed({ reason: "auto reviewer timed out" })) }),
         Effect.catchIf((error) => error instanceof Failed || error.reason._tag === "InvalidProviderOutput", (error) => {
           if (index >= 2) return Effect.fail(error)
-          // 超时保留原提示；协议错误只加一次格式nudge，不重建或扩张授权证据。
-          return attempt(index + 1, nudged || !(error instanceof Failed && error.reason === "auto reviewer timed out"))
+          // 以最近失败选择单份后缀；混合链不保留旧nudge，也不改变三次预算或授权证据。
+          return attempt(index + 1, error instanceof Failed && error.reason === "auto reviewer timed out" ? "timeout" : "protocol")
         }),
       )
diff --git a/packages/core/test/permission.test.ts b/packages/core/test/permission.test.ts
--- a/packages/core/test/permission.test.ts
+++ b/packages/core/test/permission.test.ts
@@ -49,3 +49,5 @@
     reviewRequests.push(request)
+    // 先固定本次挂起计划再发布开始信号，下一轮计划不能反向影响当前运输。
+    const hanging = reviewHangs > 0
     if (reviewStarted) yield* Deferred.succeed(reviewStarted, undefined)
     // 只在强制选择时产生typed400，不连真实provider；去参请求仍走同一个fake运输边界。
@@ -58,1 +60,1 @@
-    if (reviewHangs > 0) {
+    if (hanging) {
@@ -568,6 +570,11 @@
-    // 真正中断第一次运输后才补试，超时补试保持相同证据且不添加协议nudge。
+    // 真正中断首次运输；超时补试保留完整证据前缀，只附加一份时间预算。
     expect(yield* Fiber.join(fiber)).toMatchObject({ effect: "allow" })
     expect(reviewInterrupted).toBe(1)
     expect(reviewRequests).toHaveLength(2)
-    expect(reviewRequests[1]?.messages).toEqual(reviewRequests[0]?.messages)
+    const timeoutInputs = reviewRequests.map((request) => request.messages.flatMap((message) => message.content).filter((part) => part.type === "text").map((part) => part.text).join("\n"))
+    expect(timeoutInputs[0]).not.toContain("Time advisory")
+    expect(timeoutInputs[1]).toContain("Time advisory")
+    expect(timeoutInputs[1]).toContain("600 words")
+    expect(timeoutInputs[1]?.split("\n\nTime advisory:")[0]).toBe(timeoutInputs[0])
+    expect(timeoutInputs[1]?.match(/Time advisory:/g)).toHaveLength(1)
     reviewText = "Based on my analysis:\n" + JSON.stringify({ ...assessment, rationale: 'bounded } transfer with "quoted" evidence' })
@@ -585,3 +592,27 @@
     expect(JSON.stringify(reviewRequests[0]?.messages)).not.toContain("Submit a valid decision using the generate_object tool")
     expect(JSON.stringify(reviewRequests[1]?.messages)).toContain("Submit a valid decision using the generate_object tool")
+    // 第一轮协议失败、第二轮挂起超时、第三轮成功；用已有运输闸门确定性交错，不靠睡眠。
+    reviewRequests.length = 0
+    reviewGate = yield* Deferred.make<void>()
+    reviewStarted = yield* Deferred.make<void>()
+    const mixed = yield* service.ask({ ...input, metadata: { ...input.metadata, diff: "mixed" } }).pipe(Effect.forkChild)
+    yield* Deferred.await(reviewStarted)
+    reviewHangs = 1
+    reviewStarted = yield* Deferred.make<void>()
+    yield* Deferred.succeed(reviewGate, undefined)
+    reviewGate = undefined
+    yield* Deferred.await(reviewStarted)
+    malformed = false
+    yield* TestClock.adjust("1 second")
+    expect(yield* Fiber.join(mixed)).toMatchObject({ effect: "allow" })
+    expect(reviewInterrupted).toBe(2)
+    expect(reviewRequests).toHaveLength(3)
+    expect(JSON.stringify(reviewRequests[0]?.messages)).not.toContain("Time advisory")
+    expect(JSON.stringify(reviewRequests[1]?.messages)).toContain("Submit a valid decision using the generate_object tool")
+    expect(JSON.stringify(reviewRequests[1]?.messages)).not.toContain("Time advisory")
+    // 最近失败是超时，第三轮不能同时携带旧协议提示或多份时间预算。
+    expect(JSON.stringify(reviewRequests[2]?.messages)).toContain("Time advisory")
+    expect(JSON.stringify(reviewRequests[2]?.messages)).toContain("600 words")
+    expect(JSON.stringify(reviewRequests[2]?.messages)).not.toContain("Submit a valid decision using the generate_object tool")
+    expect(JSON.stringify(reviewRequests[2]?.messages).match(/Time advisory:/g)).toHaveLength(1)
     // 首个完整对象不符契约时不能继续寻找后面的allow对象。
diff --git a/packages/core/src/v1/config/permission.ts b/packages/core/src/v1/config/permission.ts
--- a/packages/core/src/v1/config/permission.ts
+++ b/packages/core/src/v1/config/permission.ts
