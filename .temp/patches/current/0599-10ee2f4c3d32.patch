适配说明：保留source五hunk并按真实V1上下文重锚；共享prompt保存唯一时间预算文本，V1保留局部常量名，Core原生reviewer同步120秒与单份后缀。按最近失败种类选择协议或时间提示，三次尝试、596的窄400协商和取消边界不变；既有Core回归覆盖首轮、超时及混合链。


diff --git a/packages/core/src/permission/reviewer/prompt.ts b/packages/core/src/permission/reviewer/prompt.ts
--- a/packages/core/src/permission/reviewer/prompt.ts
+++ b/packages/core/src/permission/reviewer/prompt.ts
@@ -27,3 +27,9 @@
 export const PROTOCOL_RETRY_TEXT = "Protocol retry: your previous reply was rejected because it did not submit the decision. Avoid prose, questions, explanations of inability, and offers to execute the action — none of these produce a decision. Reassess the same evidence and reply with exactly one permission_review_decision call. If you believe tool calls are unavailable, reply with ONLY the JSON object {\"risk_level\",\"user_authorization\",\"outcome\",\"rationale\"} as your entire message."
 
+// 超时才提示600词软预算；保留意图/风险/策略清单，重建上下文不能引用不可见的上一轮分析。
+export const TIME_BUDGET_RETRY_USER_ITEM = {
+  type: "text" as const,
+  text: "Time advisory: a previous attempt at this review exceeded its time budget. Think concisely now: keep reasoning within roughly 600 words. State the user's intent and authorization, the action's concrete risk, and the policy rule that matches, then submit the decision. Do not re-derive the transcript, do not re-check alternatives repeatedly, and do not stall in 'wait, but…' loops.",
+}
+
 // #206：输出合约增加 transcript 用途限定——仅用于推断用户意图、范围、授权和本地证据，不作为策略指令
diff --git a/packages/core/src/config/auto-review.ts b/packages/core/src/config/auto-review.ts
--- a/packages/core/src/config/auto-review.ts
+++ b/packages/core/src/config/auto-review.ts
@@ -10,3 +10,3 @@
   // 与V1相同，单次执行期限不包含后续补试及清理的全部墙钟时间。
-  timeout_ms: Schema.Number.pipe(Schema.optional).annotate({ description: "Reviewer execution timeout per attempt in milliseconds. At most three attempts. Defaults to 90000." }),
+  timeout_ms: Schema.Number.pipe(Schema.optional).annotate({ description: "Reviewer execution timeout per attempt in milliseconds. At most three attempts. Timeout retries append a time-budget advisory to the prompt. Defaults to 120000." }),
   policy_path: Schema.String.pipe(Schema.optional),
diff --git a/packages/core/src/permission/reviewer.ts b/packages/core/src/permission/reviewer.ts
--- a/packages/core/src/permission/reviewer.ts
+++ b/packages/core/src/permission/reviewer.ts
@@ -176,3 +176,3 @@
           // 每次拥有完整执行期限；仍先完成原onExit收尾，再向外层交付超时供补试。
-          Effect.timeoutOrElse({ duration: options.timeout_ms ?? 90_000, orElse: () => Effect.fail(timedOut) }),
+          Effect.timeoutOrElse({ duration: options.timeout_ms ?? 120_000, orElse: () => Effect.fail(timedOut) }),
           Effect.onExit((exit) => Effect.gen(function* () {
@@ -220,7 +220,7 @@
           Effect.catchIf((error) => error === protocolError || error === timedOut, (error) => {
             if (index >= 2) return Effect.fail(error)
-            // 协议仅追加同一条原话；超时保留当前提示，必须等上次收尾后才重试。
-            return attempt(index + 1, error === protocolError ? `${prompt}\n\n${PermissionReviewerPrompt.PROTOCOL_RETRY_TEXT}` : currentPrompt)
+            // 以最近失败重建单份后缀；先完成原收尾，不累积旧提示或扩大授权证据。
+            return attempt(index + 1, `${prompt}\n\n${error === protocolError ? PermissionReviewerPrompt.PROTOCOL_RETRY_TEXT : PermissionReviewerPrompt.TIME_BUDGET_RETRY_USER_ITEM.text}`)
           }),
         )
       const result = yield* attempt(0)
diff --git a/packages/core/test/permission.test.ts b/packages/core/test/permission.test.ts
--- a/packages/core/test/permission.test.ts
+++ b/packages/core/test/permission.test.ts
@@ -1083,6 +1083,12 @@
     expect(interrupted).toBe(1)
     expect(reviewRequests).toHaveLength(2)
-    expect(reviewRequests[1]?.messages).toEqual(reviewRequests[0]?.messages)
+    // 超时补试保持证据原文，只追加source的一份时间预算，不累积协议提示。
+    const timeoutInputs = reviewRequests.map((request) => request.messages.flatMap((message) => message.content).filter((part) => part.type === "text").map((part) => part.text).join("\n"))
+    expect(timeoutInputs[0]).not.toContain("Time advisory")
+    expect(timeoutInputs[1]).toContain("Time advisory")
+    expect(timeoutInputs[1]).toContain("600 words")
+    expect(timeoutInputs[1]?.split("\n\nTime advisory:")[0]).toBe(timeoutInputs[0])
+    expect(timeoutInputs[1]?.match(/Time advisory:/g)).toHaveLength(1)
     expect(reviewTerminalWriteFailures).toBe(0)
     expect(reviewTerminals).toEqual(["tool", "assistant"])
     const child = yield* database.db.select().from(SessionTable).where(eq(SessionTable.parent_id, SessionV2.ID.make("ses_test"))).get().pipe(Effect.orDie)
@@ -1105,6 +1111,37 @@
     expect(interrupted).toBe(3)
     expect(reviewRequests).toHaveLength(3)
     expect((yield* sessions.context(childID)).filter(message => message.type === "assistant").every(message => message.time.completed !== undefined)).toBe(true)
+    // 完整文本事件表示已完成但未裁决的协议失败；缺text-start会成为运输defect而不应重试。
+    const mixedStarted = yield* Deferred.make<void>()
+    reviewRequests.length = 0
+    reviewScript = [Stream.make(
+      LLMEvent.textStart({ id: "mixed" }), LLMEvent.textDelta({ id: "mixed", text: "No decision" }), LLMEvent.textEnd({ id: "mixed" }),
+      LLMEvent.stepFinish({ index: 0, reason: "stop" }), LLMEvent.finish({ reason: "stop" }),
+    ), hang(mixedStarted), success]
+    const mixed = yield* service.ask(request("mixed-retry")).pipe(Effect.forkScoped)
+    yield* Deferred.await(mixedStarted)
+    yield* TestClock.adjust("1 second")
+    expect(yield* Fiber.join(mixed)).toMatchObject({ effect: "allow" })
+    expect(reviewRequests).toHaveLength(3)
+    const mixedInputs = reviewRequests.map(item => JSON.stringify(item.messages))
+    expect(mixedInputs[0]).not.toContain("Time advisory")
+    expect(mixedInputs[1]).toContain("Protocol retry:")
+    expect(mixedInputs[1]).not.toContain("Time advisory")
+    expect(mixedInputs[2]).toContain("600 words")
+    expect(mixedInputs[2]).not.toContain("Protocol retry:")
+    expect(mixedInputs[2]?.match(/Time advisory:/g)).toHaveLength(1)
+    // 未配置时真实期限为120秒；显式1000ms的前述回归继续证明配置优先。
+    reviewSettings = new Config.Info({ approvals_reviewer: "auto_review", auto_review: new ConfigAutoReview.Info({ strict: true, fallback: "deny" }) })
+    const defaultStarted = yield* Deferred.make<void>()
+    reviewRequests.length = 0
+    reviewScript = [hang(defaultStarted), success]
+    const defaultTimeout = yield* service.ask(request("default-timeout")).pipe(Effect.forkScoped)
+    yield* Deferred.await(defaultStarted)
+    yield* TestClock.adjust("119999 millis")
+    expect(reviewRequests).toHaveLength(1)
+    yield* TestClock.adjust("1 millis")
+    expect(yield* Fiber.join(defaultTimeout)).toMatchObject({ effect: "allow" })
+    expect(reviewRequests).toHaveLength(2)
     // 外部取消不是单次超时，不能消费补试次数或留下人工pending。
     const cancelStarted = yield* Deferred.make<void>()
     reviewRequests.length = 0
diff --git a/packages/core/src/v1/config/permission.ts b/packages/core/src/v1/config/permission.ts
--- a/packages/core/src/v1/config/permission.ts
+++ b/packages/core/src/v1/config/permission.ts
@@ -17,10 +17,10 @@ export type ApprovalsReviewer = Schema.Schema.Type<typeof ApprovalsReviewer>
 export const AutoReview = Schema.Struct({
   // #196：reviewer 配置与 permission rules 并列，控制 `action: "auto"` 的解析方式，
   // #196：但这些字段本身不是 rules，Permission.fromConfig 会跳过它们。
-  // #196：model 指定 reviewer 使用的模型；timeout_ms 默认 90 秒。
+  // #196：model 指定 reviewer 使用的模型；599 起 timeout_ms 默认 120 秒（超时重试附时间预算后缀）。
   model: Schema.optional(Schema.String).annotate({ description: "Reviewer model in provider/model form." }),
   // timeout_ms限制单次执行，共1次初始加2次重试，不把清理开销计成执行总界。
-  timeout_ms: Schema.optional(Schema.Number).annotate({ description: "Reviewer execution timeout per attempt in milliseconds. At most three attempts (one initial attempt plus two retries). Defaults to 90000." }),
+  timeout_ms: Schema.optional(Schema.Number).annotate({ description: "Reviewer execution timeout per attempt in milliseconds. At most three attempts (one initial attempt plus two retries). Timeout retries append a time-budget advisory to the prompt. Defaults to 120000." }),
   // #196：policy_path 和 policy 追加到默认 tenant policy 之后。
   policy_path: Schema.optional(Schema.String).annotate({ description: "Markdown policy file appended to the default tenant policy." }),
   policy: Schema.optional(Schema.String).annotate({ description: "Inline markdown policy appended to the reviewer policy prompt." }),

diff --git a/packages/opencode/src/permission/reviewer/service.ts b/packages/opencode/src/permission/reviewer/service.ts
--- a/packages/opencode/src/permission/reviewer/service.ts
+++ b/packages/opencode/src/permission/reviewer/service.ts
@@ -98,6 +98,8 @@
 // consumers from confusing protocol retry cleanup with undo or session repair.
 const PROTOCOL_RETRY_HIDDEN_REASON = "permission-reviewer-protocol-retry"
 // #227：协议失败重试的隐藏原因——首次尝试的畸形输出在重试前隐藏，避免用户把 JSON/散文答案误读为已批准
+// 两条reviewer路径共用预算措辞；仅超时后的新请求追加，不污染首次证据。
+const TIME_BUDGET_RETRY_USER_ITEM = PermissionReviewerPrompt.TIME_BUDGET_RETRY_USER_ITEM
 // reviewer 总尝试次数：1 初始 + 2 重试。协议错误与超时共用该预算。
 const MAX_REVIEWER_ATTEMPTS = 3
 const PROTOCOL_RETRY_USER_ITEM = {
@@ -214,7 +216,8 @@
             }) as Effect.Effect<Schema.Schema.Type<typeof Assessment>, Error, never>
           }
           // timeout_ms是每次执行预算，共三次尝试；清理开销不构成严格的总墙钟上限。
-          const perAttemptTimeout = autoReview?.timeout_ms ?? 90_000
+          // 默认120秒覆盖source观测长尾；显式配置与三次尝试总数不变。
+          const perAttemptTimeout = autoReview?.timeout_ms ?? 120_000
           // 显式返回注解：递归函数的返回类型无法推断（TS7023/7024）
           const reviewerRetry = (attemptNum: number, currentMessages: readonly ModelMessage[], hideProtocolFailure: boolean): Effect.Effect<Schema.Schema.Type<typeof Assessment>, Error> =>
             runReviewerAttempt(currentMessages, hideProtocolFailure).pipe(
@@ -226,10 +229,12 @@
               // 旧代码顺序相反，超时绕过了重试。
               Effect.catchIf(isReviewerRetryable, (error) => {
                 if (attemptNum >= MAX_REVIEWER_ATTEMPTS - 1) return Effect.fail(error)
-                // 协议错误：附加 protocol nudge 修复提交格式；超时：保持原 prompt
+                // 按最近失败重建单份后缀；协议→超时只留时间预算，不累积旧格式提示。
                 const nextMessages = isReviewerDecisionProtocolError(error)
                   ? buildMessages({ system, userItems: [...userItems, PROTOCOL_RETRY_USER_ITEM] })
-                  : currentMessages
+                  : error instanceof ReviewerTimedOut
+                    ? buildMessages({ system, userItems: [...userItems, TIME_BUDGET_RETRY_USER_ITEM] })
+                    : currentMessages
                 return reviewerRetry(attemptNum + 1, nextMessages, false)
               }),
             )

