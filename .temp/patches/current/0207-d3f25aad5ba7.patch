+// #207：原始文本 token 保留源偏移——localCommands 用它过滤解析器恢复的载荷命令，不依赖 tree-sitter 对畸形 WSL/SSH 字符串的恢复形状
+type Token = {
+  text: string
+  start: number
+  end: number
+}
+
+// #207：远程载荷范围的源偏移区间——localCommands 排除落在远程范围内的命令节点
+type Range = {
+  start: number
+  end: number
+}
+
+// #207：命令段是主机 shell 分隔符切分的文本片段——保留源偏移以支持 tokenizeLocalSegment
+type Segment = Range & {
+  text: string
+}
