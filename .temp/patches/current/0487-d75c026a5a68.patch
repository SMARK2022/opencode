From d75c026a5a68914958f4473fbc5d6cbd1a0c986f Mon Sep 17 00:00:00 2001
From: SMARK <3222301373@qq.com>
Date: Tue, 14 Jul 2026 17:33:31 +0800
Subject: [PATCH] fix(version): 更新opencode版本至1.15.10-smark
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

适配：源为 bun.lock 版本回声追平（1.15.9-smark -> 1.15.10-smark，对齐 package.json 权威值）；
目标谱系同样存在 lock 回声漂移（1.18.38-smark），按同一追平语义落点对齐 1.18.44-smark。
diff --git a/bun.lock b/bun.lock
--- a/bun.lock
+++ b/bun.lock
@@ -565,8 +565,9 @@
     // 版本与 packages/opencode/package.json 保持一致，frozen install 依赖 bun.lock 同步
     "packages/opencode": {
       "name": "opencode",
-      "version": "1.18.38-smark",
+      // #487：lock版本回声追平package.json权威值，frozen install依赖此同步。
+      "version": "1.18.44-smark",
       "optionalDependencies": { "sharp": "0.33.5" }, // #59：可选压缩依赖，复用上游既有 0.33.5 解析树
       "bin": {
         "opencode": "./bin/opencode",
       },
