+        git.defaultBranch(cwd),
+        git.run(["config", "user.name"], { cwd }).pipe(
+          Effect.map((r) => r.text().trim()),
+          Effect.orElseSucceed(() => ""),
+        ),
+        git.status(cwd).pipe(
+          Effect.map((items) => items.map((item) => `${item.code} ${item.file}`).join("\n")),
+          Effect.orElseSucceed(() => ""),
+        ),
+        git.run(["log", "--oneline", "-n", "5"], { cwd }).pipe(
