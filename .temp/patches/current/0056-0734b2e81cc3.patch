+// 预热外部插件：在写锁/监听前动态 import，避免 TUI 在冷编译时等死
+async function warmupExternalPlugins() {
+  // pure 安装面不加载用户插件，预热会浪费启动预算且与 pure 契约冲突
+  if (Flag.OPENCODE_PURE) return
+  try {
+    const configPath = path.join(Global.Path.config, "opencode.json")
+    const raw = await Bun.file(configPath).text().catch(() => null)
+    if (!raw) return
+    const config = JSON.parse(raw) as { plugin?: unknown }
+    const plugins = Array.isArray(config.plugin) ? config.plugin : []
+    // 并行 import：墙钟取最慢插件，与 60s waitMs 配套；串行求和会误杀多插件冷启动
+    await Promise.all(
+      plugins.map(async (spec) => {
+        try {
+          const name = typeof spec === "string" ? spec : Array.isArray(spec) ? spec[0] : (spec as { package?: string })?.package
+          if (typeof name !== "string" || !name) return
+          const { resolvePluginTarget, createPluginEntry } = await import("@/plugin/shared")
+          const target = await resolvePluginTarget(name)
+          // kind=server：守护进程侧入口，与 TUI 客户端插件面分离
+          const entry = await createPluginEntry(name, target, "server")
+          if (entry?.entry) await import(entry.entry)
+        } catch {
+          // best-effort：单个插件失败不阻塞守护进程启动
+        }
+      }),
+    )
+  } catch {
+    // best-effort：配置缺失或解析失败忽略
+  }
+}
