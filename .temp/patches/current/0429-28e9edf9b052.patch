+            reason: null,
+            blocked_reason: null,
+            blocked_streak: 0,
+            blocked_last_turn_id: null,
+            terminal_turn_id: null,
+            time_updated: now,
+          })
+          .where(eq(SessionGoalTable.session_id, sessionID))
+          .run()
+          .pipe(Effect.orDie)
