+    }),
+  { git: true },
+)
+
+it.instance(
+  "active recovery from user-produced terminal through tool is rejected",
+  () =>
+    Effect.gen(function* () {
+      const goalSvc = yield* SessionGoal.Service
+      const sessions = yield* SessionNs.Service
+      const tool = yield* GoalTool
+      const def = yield* tool.init()
+
