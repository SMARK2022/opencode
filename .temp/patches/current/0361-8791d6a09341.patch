+function reviewerTokenCaptureFixture(authInfo: Auth.Info) {
+  const parts: SessionV1.Part[] = []
+  const model = reviewerModel(OPENAI_PROVIDER_ID)
+  const fetch = Object.assign(
+    async (_input: RequestInfo | URL, _init?: RequestInit) =>
