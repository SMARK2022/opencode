适配：目标 install 块多一个 fff-bun 原生包（第三行同入重试环）；test.yml 矩阵锚在 L71-76；
install-target 纯函数与其测试原样落位（新文件无冲突）。
diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -73,5 +73,19 @@
             os_label: Windows
             runner: windows-latest
             command: GITHUB_ACTIONS=false bun run --cwd packages/http-recorder test --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml
             junit: packages/http-recorder/.artifacts/unit/junit.xml
+          # macOS 覆盖 opencode/core 的平台分支；http-recorder 保留既有双平台矩阵。
+          # 与现有必过项使用相同 test/JUnit 契约，filewatcher 标志仍按 runner 判断。
+          - id: opencode-macos
+            label: packages/opencode
+            os_label: macOS
+            runner: macos-latest
+            command: GITHUB_ACTIONS=false bun turbo test --filter=opencode --continue=dependencies-successful -- --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml
+            junit: packages/opencode/.artifacts/unit/junit.xml
+          - id: core-macos
+            label: packages/core
+            os_label: macOS
+            runner: macos-latest
+            command: GITHUB_ACTIONS=false bun run --cwd packages/core test --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml
+            junit: packages/core/.artifacts/unit/junit.xml
     defaults:
diff --git a/packages/opencode/script/build.ts b/packages/opencode/script/build.ts
--- a/packages/opencode/script/build.ts
+++ b/packages/opencode/script/build.ts
@@ -11,4 +11,5 @@
 import { fileURLToPath } from "url"
 import { createSolidTransformPlugin } from "@opentui/solid/bun-plugin"
+import { resolveInstallTarget } from "./install-target"
 
 const __filename = fileURLToPath(import.meta.url)
@@ -202,7 +203,20 @@
 const binaries: Record<string, string> = {}
 if (!skipInstall) {
-  await $`bun install --os="*" --cpu="*" @opentui/core@${pkg.dependencies["@opentui/core"]}`
-  await $`bun install --os="*" --cpu="*" @parcel/watcher@${pkg.dependencies["@parcel/watcher"]}`
-  await $`bun install --os="*" --cpu="*" @ff-labs/fff-bun@${pkg.dependencies["@ff-labs/fff-bun"]}`
+  // #468：只安装目标 OS/arch 的原生变体，避免 macOS CI 下载 win32 包触发 bun IntegrityCheckFailed。
+  const { os: installOs, cpu: installCpu } = resolveInstallTarget(osFilter, archFilter, singleFlag)
+
+  // bun 不会在完整性校验失败时自动重试（oven-sh/bun#26879）；手动重试并清缓存防损坏 tarball 阻断 CI。
+  for (let attempt = 1; attempt <= 3; attempt++) {
+    try {
+      await $`bun install --os="${installOs}" --cpu="${installCpu}" @opentui/core@${pkg.dependencies["@opentui/core"]}`
+      await $`bun install --os="${installOs}" --cpu="${installCpu}" @parcel/watcher@${pkg.dependencies["@parcel/watcher"]}`
+      await $`bun install --os="${installOs}" --cpu="${installCpu}" @ff-labs/fff-bun@${pkg.dependencies["@ff-labs/fff-bun"]}`
+      break
+    } catch (e) {
+      if (attempt === 3) throw e
+      console.error(`bun install failed (attempt ${attempt}/3), clearing cache and retrying...`, e)
+      await $`bun pm cache rm`.quiet().nothrow()
+    }
+  }
 }
 for (const item of targets) {
diff --git a/packages/opencode/script/install-target.ts b/packages/opencode/script/install-target.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7034abb6e36b8c77fda3f700394e3c95997df65a
--- /dev/null
+++ b/packages/opencode/script/install-target.ts
@@ -0,0 +1,12 @@
+// 安装平台必须与构建过滤一致：singleFlag > osFilter > "*"，避免下载非目标平台原生包。
+// 错配会在 macOS 安装 win32 包时触发 IntegrityCheckFailed（oven-sh/bun#26879）。
+export function resolveInstallTarget(
+  osFilter: string | undefined,
+  archFilter: string | undefined,
+  singleFlag: boolean,
+): { os: string; cpu: string } {
+  // singleFlag 优先：--single 只构建当前平台，install 也只装当前平台原生包
+  const os = singleFlag ? process.platform : (osFilter ?? "*")
+  const cpu = singleFlag ? process.arch : (archFilter ?? "*")
+  return { os, cpu }
+}
diff --git a/packages/opencode/test/script/install-target.test.ts b/packages/opencode/test/script/install-target.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..39599bc1627bb9a0d9b52e65de78fc431110fa60
--- /dev/null
+++ b/packages/opencode/test/script/install-target.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, test } from "bun:test"
+import { resolveInstallTarget } from "../../script/install-target"
+
+describe("resolveInstallTarget", () => {
+  // macOS CI 传 --os=darwin，需要 darwin-arm64 和 darwin-x64 两个原生包
+  test("--os=darwin 且无 --arch 时安装该 OS 的全部 arch 变体", () => {
+    expect(resolveInstallTarget("darwin", undefined, false)).toEqual({ os: "darwin", cpu: "*" })
+  })
+
+  // Windows CI 传 --os=win32 --arch=x64，精确到单个平台变体
+  test("--os=win32 --arch=x64 精确到单 arch", () => {
+    expect(resolveInstallTarget("win32", "x64", false)).toEqual({ os: "win32", cpu: "x64" })
+  })
+
+  // Linux CI 传 --os=linux，需两个 arch
+  test("--os=linux 且无 --arch 时安装该 OS 的全部 arch 变体", () => {
+    expect(resolveInstallTarget("linux", undefined, false)).toEqual({ os: "linux", cpu: "*" })
+  })
+
+  // 本地 --single 构建：target 过滤逻辑中 singleFlag 优先于 osFilter（build.ts L158-179），
+  // install 目标必须与之一致，否则会安装非目标平台的原生包
+  test("--single 优先于 --os，使用当前平台", () => {
+    const result = resolveInstallTarget("darwin", undefined, true)
+    expect(result.os).toBe(process.platform)
+    expect(result.cpu).toBe(process.arch)
+  })
+
+  test("--single 且无 --os 时使用当前平台", () => {
+    const result = resolveInstallTarget(undefined, undefined, true)
+    expect(result.os).toBe(process.platform)
+    expect(result.cpu).toBe(process.arch)
+  })
+
+  // 本地全平台构建（无任何过滤参数），需所有平台原生包供 Bun.compile 交叉编译
+  test("无参数时回退到全平台 --os=* --cpu=*", () => {
+    expect(resolveInstallTarget(undefined, undefined, false)).toEqual({ os: "*", cpu: "*" })
+  })
+
+  // --arch 单独使用时仍安装该 arch 的全部 OS 变体
+  test("仅 --arch=arm64 时 CPU 过滤但 OS 保持全部", () => {
+    expect(resolveInstallTarget(undefined, "arm64", false)).toEqual({ os: "*", cpu: "arm64" })
+  })
+
+  // 回归：osFilter 和 singleFlag 同时存在时 singleFlag 优先，
+  // 防止 --single --os=darwin 在 Linux 上错误安装 darwin 包
+  test("singleFlag + osFilter + archFilter 同时存在时 singleFlag 优先", () => {
+    const result = resolveInstallTarget("linux", "x64", true)
+    expect(result.os).toBe(process.platform)
+    expect(result.cpu).toBe(process.arch)
+  })
+})
