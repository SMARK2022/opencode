Subject: [PATCH] =?UTF-8?q?fix(goal):=20=E7=A7=BB=E9=99=A4=20goalSet=20?=
 =?UTF-8?q?=E7=AB=AF=E7=82=B9=E9=87=8D=E5=A4=8D=E7=9A=84=20HttpApiError.Ba?=
 =?UTF-8?q?dRequest=20=E4=BF=AE=E5=A4=8D=20SDK=20build?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

goalSet 端点的 error 数组同时声明了 HttpApiError.BadRequest(400) 和
GoalApiError(400)，两个相同状态码导致 Effect OpenAPI 生成器在合并
响应时丢弃 effect_HttpApiError_BadRequest schema 定义但保留 $ref
引用，SDK build 的 createClient 阶段报 MissingPointerError。

移除 HttpApiError.BadRequest，仅保留 GoalApiError(携带 data.message，
严格优于空的 BadRequest) + ApiNotFoundError(404)。其他 28+ 端点仍
使用 HttpApiError.BadRequest，schema 定义不受影响。

diff --git a/packages/sdk/js/src/v2/gen/types.gen.ts b/packages/sdk/js/src/v2/gen/types.gen.ts
--- a/packages/sdk/js/src/v2/gen/types.gen.ts
+++ b/packages/sdk/js/src/v2/gen/types.gen.ts
@@ -11702,7 +11702,7 @@
 export type SessionGoalSetErrors = {
   /**
-   * BadRequest | GoalApiError | InvalidRequestError
+   * GoalApiError | InvalidRequestError
    */
-  400: EffectHttpApiErrorBadRequest | GoalApiError | InvalidRequestError
+  400: GoalApiError | InvalidRequestError
   /**
    * NotFoundError
diff --git a/packages/sdk/openapi.json b/packages/sdk/openapi.json
--- a/packages/sdk/openapi.json
+++ b/packages/sdk/openapi.json
@@ -9553,13 +9553,10 @@
           "400": {
-            "description": "BadRequest | GoalApiError | InvalidRequestError",
+            "description": "GoalApiError | InvalidRequestError",
             "content": {
               "application/json": {
                 "schema": {
                   "anyOf": [
-                    {
-                      "$ref": "#/components/schemas/effect_HttpApiError_BadRequest"
-                    },
                     {
                       "$ref": "#/components/schemas/GoalApiError"
                     },
                     {
diff --git a/packages/opencode/src/server/routes/instance/httpapi/groups/session.ts b/packages/opencode/src/server/routes/instance/httpapi/groups/session.ts
index f0991a15a9a772a43627dec7ef071c6dec51a456..f0334567bf4b8d44568eb22ca6d767e9af154eaf 100644
--- a/packages/opencode/src/server/routes/instance/httpapi/groups/session.ts
+++ b/packages/opencode/src/server/routes/instance/httpapi/groups/session.ts
@@ -600,7 +600,10 @@ export const SessionApi = HttpApi.make("session")
           query: WorkspaceRoutingQuery,
           payload: GoalSetPayload,
           success: described(GoalResponse, "Updated session goal"),
-          error: [HttpApiError.BadRequest, GoalApiError, ApiNotFoundError],
+          // 只声明 GoalApiError(400) + ApiNotFoundError(404)，不重复声明 HttpApiError.BadRequest(400)。
+          // 两个 400 会导致 OpenAPI 生成重复响应码，SDK build 的 tsc 阶段失败。
+          // GoalApiError 携带 data.message，严格优于空的 BadRequest。
+          error: [GoalApiError, ApiNotFoundError],
         }).annotateMerge(
           OpenApi.annotations({
             identifier: "session.goal.set",
