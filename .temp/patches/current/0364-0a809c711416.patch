diff --git a/packages/schema/src/session-goal.ts b/packages/schema/src/session-goal.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e2884f6ea4095a14b78184ce82ce582aab437a7e
--- /dev/null
+++ b/packages/schema/src/session-goal.ts
@@ -0,0 +1,47 @@
+export * as SessionGoal from "./session-goal"
+import { Schema } from "effect"
+import { define, inventory } from "./event"
+import { optional } from "./schema"
+import { SessionID } from "./session-id"
+
+// [local-smark] goal 状态机：active 为唯一续跑态；paused/complete/blocked 均为停止态，
+// 由 tool 或用户显式切换——loop 不自动迁移状态，避免与用户意图冲突。
+export const Status = Schema.Literals(["active", "paused", "complete", "blocked"] as const)
+export type Status = Schema.Schema.Type<typeof Status>
+
+// #364：持久化会话目标：一个 session 最多一个 current goal。
+// tokenBudget 为 null 表示无预算限制（unbounded）。
+export const Goal = Schema.Struct({
+  sessionID: SessionID,
+  id: Schema.String,
+  objective: Schema.String,
+  status: Status,
+  // tokenBudget 三态：缺省=不改、null=unbounded、正数=预算上限
+  tokenBudget: optional(Schema.NullOr(Schema.Number)),
+  tokensUsed: Schema.Number,
+  timeUsedSeconds: Schema.Number,
+  time: Schema.Struct({
+    created: Schema.Number,
+    updated: Schema.Number,
+  }),
+}).annotate({ identifier: "SessionGoal" })
+export interface Goal extends Schema.Schema.Type<typeof Goal> {}
+
+// [local-smark] goal.updated 事件：TUI sidebar 与 footer 依赖此事件实时刷新 goal 面板；
+// 事件载荷携带完整 Goal 快照，消费方无需二次查询。
+const Updated = define({
+  type: "session.goal.updated",
+  schema: {
+    sessionID: SessionID,
+    goal: Goal,
+  },
+})
+// [local-smark] goal.cleared 事件：清除后 sidebar 隐藏 goal 区块；
+// 事件仅带 sessionID——goal 数据已物理删除，无需携带快照。
+const Cleared = define({
+  type: "session.goal.cleared",
+  schema: {
+    sessionID: SessionID,
+  },
+})
+export const Event = { Updated, Cleared, Definitions: inventory(Updated, Cleared) }
diff --git a/packages/core/src/session/goal.sql.ts b/packages/core/src/session/goal.sql.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3f0af94cc2c4f5862691298ab7dc3f89e3a05ac6
--- /dev/null
+++ b/packages/core/src/session/goal.sql.ts
@@ -0,0 +1,32 @@
+import { index, integer, sqliteTable, text } from "drizzle-orm/sqlite-core"
+import { SessionTable } from "./sql"
+import type { SessionSchema } from "./schema"
+import { Timestamps } from "../database/schema.sql"
+
+// #364：goal 状态枚举：只有 active 会触发自动续跑；
+// paused/blocked/complete 均为停止态，loop 正常退出不续跑。
+export const GOAL_STATUSES = ["active", "paused", "complete", "blocked"] as const
+export type GoalStatus = (typeof GOAL_STATUSES)[number]
+
+// #364：session_id 做主键 → 一个 session 最多一个 current goal。
+// FK cascade delete 确保删除 session 时 goal 自动清理，
+// 与 request_usage/todo 表的级联模式一致。
+export const SessionGoalTable = sqliteTable(
+  "session_goal",
+  {
+    session_id: text()
+      .$type<SessionSchema.ID>()
+      .primaryKey()
+      .references(() => SessionTable.id, { onDelete: "cascade" }),
+    id: text().notNull(),
+    objective: text().notNull(),
+    status: text().$type<GoalStatus>().notNull(),
+    // null 表示无预算限制（unbounded）；
+    // 正数表示 token 上限，达到后状态自动切 budget_limited（未来扩展）。
+    token_budget: integer(),
+    tokens_used: integer().notNull().default(0),
+    time_used_seconds: integer().notNull().default(0),
+    ...Timestamps,
+  },
+  (table) => [index("session_goal_status_idx").on(table.session_id, table.status)],
+)
