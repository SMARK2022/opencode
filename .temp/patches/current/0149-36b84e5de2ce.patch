diff --git a/packages/opencode/src/effect/runner.ts b/packages/opencode/src/effect/runner.ts
index 9c2060a96e..8cc506bcea 100644
--- a/packages/opencode/src/effect/runner.ts
+++ b/packages/opencode/src/effect/runner.ts
@@ -111,7 +111,8 @@ export const make = <A, E = never>(
       yield* Deferred.succeed(shell.cancelled, undefined).pipe(Effect.asVoid)
       // 非阻塞中断：fork 到 scope 中执行，避免等待 fiber 终止
       // Effect.exit 确保中断不抛出异常到调用链，forkIn 将其隔离到 scope
-      yield* Fiber.interrupt(shell.fiber).pipe(Effect.exit, Effect.forkIn(scope), Effect.asVoid)
+      // #149：await interrupt，避免 shell 取消竞态
+      yield* Fiber.interrupt(shell.fiber).pipe(Effect.exit, Effect.asVoid)
     })
 
   const ensureRunning = (work: Effect.Effect<A, E>) =>
@@ -178,8 +179,9 @@ export const make = <A, E = never>(
         return [
           Effect.gen(function* () {
             // 先 fail done 唤醒等待者，再非阻塞中断 fiber
-            yield* Deferred.fail(st.run.done, new Cancelled()).pipe(Effect.exit, Effect.asVoid)
-            yield* Fiber.interrupt(st.run.fiber).pipe(Effect.exit, Effect.forkIn(scope), Effect.asVoid)
+            // #149：先中断 fiber 再 fail done，避免未 settle 的工具输出被抢先收口
+            yield* Fiber.interrupt(st.run.fiber)
+            yield* Deferred.fail(st.run.done, new Cancelled()).pipe(Effect.asVoid)
             yield* idleIfCurrent()
           }),
           { _tag: "Idle" } as const,
