   return [get, throttled]
 }
 
+// 默认 1s 与 footer 秒级显示粒度一致；调小只增加重绘频率不改变口径
+export function createRefreshClock(active: Accessor<boolean>, ms = 1000) {
+  const [now, setNow] = createSignal(Date.now())
+
+  createEffect(
+    on(active, (enabled) => {
+      // 这个 clock 只负责驱动 UI 重新计算"当前时间"，不持有业务计时起点。
+      // 耗时边界必须继续来自 session messages，保证重连和组件重挂载后口径不变。
+      // 切换 active 时先立即对时一次，避免启用瞬间显示陈旧时间
+      setNow(Date.now())
+      if (!enabled) return
+
+      // interval 只写 now 信号；所有耗时 memo 派生自它，卸载时随 onCleanup 终止
+      const timer = setInterval(() => setNow(Date.now()), ms)
+      onCleanup(() => clearInterval(timer))
+    }),
+  )
+
+  // now 作为只读 Accessor 下发；调用方不得写入，起点权威始终在 session messages
+  return now
+}
 export function createFadeIn(show: Accessor<boolean>, enabled: Accessor<boolean>) {
   const [alpha, setAlpha] = createSignal(show() ? 1 : 0)
   let revealed = show()
diff --git a/packages/tui/src/util/locale.ts b/packages/tui/src/util/locale.ts
--- a/packages/tui/src/util/locale.ts
+++ b/packages/tui/src/util/locale.ts
@@ -48,11 +48,38 @@ export function duration(input: number) {
     const seconds = Math.floor((input % 60000) / 1000)
     return `${minutes}m ${seconds}s`
   }
+  // 跨天后秒/分级精度已无阅读价值，降级为天+小时
   if (input < 86400000) {
     const hours = Math.floor(input / 3600000)
     const minutes = Math.floor((input % 3600000) / 60000)
     return `${hours}h ${minutes}m`
   }
+  // 天级以后不返回秒——上墙文本长度优先
+  const days = Math.floor(input / 86400000)
+  const hours = Math.floor((input % 86400000) / 3600000)
+  return `${days}d ${hours}h`
+}
+
+// 分段阈值（1s/1min/1h/1d）与 duration() 保持同一套边界，避免同会话两种口径
+export function durationClock(input: number) {
+  // 面向"正在刷新"的 turn/clock 展示：起点来自持久化 message timestamp，
+  // 和本地刷新 tick 通常不会整秒对齐；这里必须向下取整，避免 1.1s、2.1s
+  // 这种看起来像计时漂移的小数秒，同时不夸大已经经过的真实耗时。
+  // 毫秒段保留 ms 单位：秒级向下取整后 0s 会与未开始混淆
+  if (input < 1000) return `${input}ms`
+  if (input < 60000) return `${Math.floor(input / 1000)}s`
+  if (input < 3600000) {
+    const minutes = Math.floor(input / 60000)
+    const seconds = Math.floor((input % 60000) / 1000)
+    return `${minutes}m ${seconds}s`
+  }
+  // 跨天后秒/分级精度已无阅读价值，降级为天+小时
+  if (input < 86400000) {
+    const hours = Math.floor(input / 3600000)
+    const minutes = Math.floor((input % 3600000) / 60000)
+    return `${hours}h ${minutes}m`
+  }
+  // 天级以后不返回秒——上墙文本长度优先
   const days = Math.floor(input / 86400000)
   const hours = Math.floor((input % 86400000) / 3600000)
   return `${days}d ${hours}h`
