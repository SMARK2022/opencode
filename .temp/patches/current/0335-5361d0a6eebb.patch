           set -euo pipefail
-
           if gh release view "$TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
-            echo "Release $TAG already exists; assets will be replaced in the next step."
+            echo "Release $TAG already exists; updating notes and assets."
+            gh release edit "$TAG" --repo "$GITHUB_REPOSITORY" --notes-file release-notes.md
           else
             # #156：release 创建下沉到 checksums，避免空 release
             gh release create "$TAG" \
               --repo "$GITHUB_REPOSITORY" \
               --target "$GITHUB_SHA" \
               --title "$TAG" \
-              --notes "OpenCode smark build $VERSION"
+              --notes-file release-notes.md
           fi
 
