From 9f52803e680e9bba24c5c5dfe6ce98abfb6d7f57 Mon Sep 17 00:00:00 2001
From: SMARK <3222301373@qq.com>
Date: Fri, 16 Oct 2026 15:29:50 +0800
Subject: [PATCH] =?UTF-8?q?fix(session):=20=E5=A4=8D=E7=94=A8=E7=8E=B0?=
 =?UTF-8?q?=E6=9C=89=E9=87=8D=E8=AF=95=E5=A4=84=E7=90=86=20Cloudflare=20?=
 =?UTF-8?q?=E6=8B=A6=E6=88=AA=E4=B8=8E=E9=99=90=E6=B5=81?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

将可识别的 Cloudflare HTML 403 和 HTTP 429 纳入 SessionRetry，即使 SDK 标记为不可重试也沿用原有无限重试、退避和 Retry-After 处理；不限定 Provider，不新增重试计数或次数上限。

保留普通鉴权、权限及内容策略错误的既有判定，增加跨 Provider 拦截与 429 回归测试，避免间歇性网关拦截直接终止会话。

diff --git a/packages/core/src/session/retry.ts b/packages/core/src/session/retry.ts
index 91dab73ee391977d3015bf21cd16ac2bb41c0422..1b0e098b74ebae821b6ef3e276d4f787075430ac 100644
--- a/packages/core/src/session/retry.ts
+++ b/packages/core/src/session/retry.ts
@@ -1,6 +1,7 @@
 import type { NamedError } from "../util/error"
 import { SessionV1 } from "../v1/session"
 import { Cause, Clock, Duration, Effect, Schedule } from "effect"
+import { isCloudflareBlock } from "@opencode-ai/llm"
 import { iife } from "../util/iife"
 import { GO_UPSELL_MESSAGE, GO_UPSELL_URL } from "./retry-constants"
 export { GO_UPSELL_MESSAGE, GO_UPSELL_URL }
@@ -94,9 +95,12 @@
     // 5xx errors are transient server failures and should always be retried,
     // even when the provider SDK doesn't explicitly mark them as retryable.
     // #191：移除 status !== undefined 守卫——无 statusCode 的可重试错误（transport）也应重试
+    // SDK的不可重试标志不能覆盖明确429或Cloudflare拦截，退避与既有文本识别仍归原policy。
     if (
       !error.data.isRetryable &&
+      status !== 429 &&
+      !isCloudflareBlock(status, error.data.responseHeaders, error.data.responseBody ?? "") &&
       !(status !== undefined && status >= 500) &&
       !matchesRetryableMessage(error.data.message) &&
       !matchesRetryableMessage(error.data.responseBody)
     )
