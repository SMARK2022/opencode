经 BS.1770 响度分析，0.4 时 stereo 综合响度约 -29.7 LUFS，
偏轻于多数 macOS 系统提示音。0.5 时约 -27.8 LUFS / -13.9 dBTP，
与 Pop(-29)、Ping(-28.8) 同区间，提醒力更充分且不刺耳。

diff --git a/packages/opencode/specs/tui-plugins.md b/packages/opencode/specs/tui-plugins.md
index c02e1a495c5292a74d3494ac4f4a3d3b59187167..9e32f26b2f827eee7fcd70c0e3279b83299a24ed 100644
--- a/packages/opencode/specs/tui-plugins.md
+++ b/packages/opencode/specs/tui-plugins.md
@@ -34,7 +34,7 @@ Example:
     "enabled": true,
     "notifications": true,
     "sound": true,
-    "volume": 0.4,
+    "volume": 0.5,
     "sound_pack": "opencode.default",
     "sounds": {
       "error": "/Users/me/sounds/error.mp3"
diff --git a/packages/opencode/src/cli/cmd/tui/config/tui.ts b/packages/opencode/src/cli/cmd/tui/config/tui.ts
index e1baa5ca76b49619ef316258c61319a8cac01e92..cdd17f9b57bff18ce620a9be98abc34b4c68157e 100644
--- a/packages/opencode/src/cli/cmd/tui/config/tui.ts
+++ b/packages/opencode/src/cli/cmd/tui/config/tui.ts
@@ -331,7 +331,12 @@ const loadState = Effect.fn("TuiConfig.loadState")(function* (ctx: { directory:
       enabled: acc.result.attention?.enabled ?? true,
       notifications: acc.result.attention?.notifications ?? true,
       sound: acc.result.attention?.sound ?? true,
-      volume: acc.result.attention?.volume ?? 0.4,
+      // 默认音量 0.5：经 BS.1770 响度分析，内嵌 done 音效在此增益下
+      // stereo 综合响度约 -27.8 LUFS、true peak 约 -13.9 dBTP，
+      // 与 macOS 系统提示音（Pop -29 LUFS、Ping -28.8 LUFS）同区间偏轻，
+      // 既有足够提醒力又不至于在频繁触发时形成听觉疲劳。
+      // 0.4 偏轻（约 -29.7 LUFS），0.6+ 会比多数系统提示音更突出。
+      volume: acc.result.attention?.volume ?? 0.5,
       sound_pack: acc.result.attention?.sound_pack ?? "opencode.default",
       sounds: acc.result.attention?.sounds ?? {},
     },
