+    if (["-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env", "--super-prefix", "--attr-source"].includes(token)) {
+      i += 2
+      continue
+    }
+    // 附着值和无值全局选项整个跳过，不把路径或配置误识别为子命令。
