+++ b/packages/opencode/src/tool/shell.ts
@@ -23,6 +23,58 @@
 import { ShellPrompt, type Parameters } from "./shell/prompt"
 import { BashArity } from "@/permission/arity"
 
+// Git 写操作的子命令集合：这些命令会修改仓库状态，需要用户明确授权
+// Git 写操作集合：修改 refs/index/工作树，须最新用户明确授权
+const GIT_WRITES = new Set(["add", "commit", "merge", "rebase", "cherry-pick", "revert", "pull", "push", "checkout", "switch", "restore", "reset", "clean"])
+// Git stash 写操作：修改 stash 栈，同样需要明确授权
+// stash 写动作集合：push/pop/apply 等修改 stash 栈
+const GIT_STASH_WRITES = new Set(["push", "pop", "apply", "drop", "clear", "branch"])
+
+// 解析 git 子命令，跳过 -c/--git-dir/--work-tree/--namespace 等带值参数
+// 大小写不敏感，处理 Windows .exe 后缀
+function gitSubcommand(tokens: string[]): string | undefined {
+  // 全 token 小写后再比 flag
+  const lower = tokens.map((t) => t.toLowerCase())
+  const cmd = lower[0]?.replace(/\.exe$/, "")
+  if (cmd !== "git") return undefined
+  let i = 1
+  while (i < lower.length) {
+    const t = lower[i]
+    if (t === "-c" || t === "--git-dir" || t === "--work-tree" || t === "--namespace") {
+      i += 2
+      continue
+    }
+    // --git-dir=value 等形式无单独 token 值，靠 startsWith("-") 整段跳过
+    if (t.startsWith("-")) {
+      i++
+      continue
+    }
+    return t
+  }
+  return undefined
+}
+
+// 判断是否为高风险 git 写操作：stash 写操作或任何 GIT_WRITES 中的子命令
+// 用于阻止这些命令被自动加入 always-allow 前缀建议
+// 危险 git 写操作不得 always-allow，必须走最新用户显式授权
+function riskyGit(tokens: string[]): boolean {
+  const sub = gitSubcommand(tokens)
+  if (!sub) return false
+  // stash 子命令需要检查具体操作（push/pop/apply 等才是写操作）
+  // stash 动作必须从 stash 词之后扫描，避免 git -c x=y stash push 被 slice(2) 误判
+  if (sub === "stash") {
+    // 裸 git stash 默认等同于 push，视为写操作
+    const lower = tokens.map((x) => x.toLowerCase())
+    const stashAt = lower.findIndex((x) => x === "stash" || x === "stash.exe")
+    const after = stashAt >= 0 ? lower.slice(stashAt + 1) : lower.slice(2)
+    const action = after.find((x) => !x.startsWith("-"))
+    if (!action) return true
+    return GIT_STASH_WRITES.has(action)
+  }
+  return GIT_WRITES.has(sub)
+}
