From 1efc5c8a2a1e5aaa1d2dd994c1013f3ffd2a0a1f Mon Sep 17 00:00:00 2001
From: SMARK2022 <3222301373@qq.com>
Date: Thu, 30 Apr 2026 17:10:34 +0800
Subject: [PATCH] test(image): retain optional resizer intent through Photon output

diff --git a/packages/opencode/test/image/image.test.ts b/packages/opencode/test/image/image.test.ts
--- a/packages/opencode/test/image/image.test.ts
+++ b/packages/opencode/test/image/image.test.ts
@@ -74,6 +74,11 @@
       source.free()
       expect(resized.get_width()).toBeLessThanOrEqual(2_000)
       expect(resized.get_height()).toBeLessThanOrEqual(2_000)
+      // Photon 必须真正缩放并保持单像素高度，输出声明也须匹配实际 PNG 编码。
+      expect(resized.get_width()).toBe(2_000)
+      expect(resized.get_height()).toBe(1)
+      expect(result.mime).toBe("image/png")
+      expect(result.url.startsWith("data:image/png;base64,")).toBe(true)
       resized.free()
     }),
   )
