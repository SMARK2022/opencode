diff --git a/packages/opencode/src/permission/index.ts b/packages/opencode/src/permission/index.ts
--- a/packages/opencode/src/permission/index.ts
+++ b/packages/opencode/src/permission/index.ts
@@ -81,6 +81,19 @@
       let needsAuto = false
       const autoPatterns: string[] = []
 
+      // #285：raw_patterns 是 shell 解析的原始拒绝证据，绕过 canonical pattern 评估
+      for (const pattern of rawDenyPatterns(request.metadata)) {
+        const denied = rawDenyRule(request.permission, pattern, ruleset)
+        yield* Effect.logInfo("evaluated raw deny evidence", { permission: request.permission, pattern, denied: Boolean(denied) })
+        if (denied) {
+        // #285：命中 deny 立即 fail-closed，不给后续 ask 规则截获的机会；
+        // ruleset 过滤只保留本 permission 相关规则，错误对象不含无关规则
+          return yield* new PermissionV1.DeniedError({
+            ruleset: ruleset.filter((rule) => Wildcard.match(request.permission, rule.permission)),
+          })
+        }
+      }
+
       // #199：逐 pattern 评估规则。静态 deny 立即 fail-closed；auto 收集后统一交由
       // #199：precheck+reviewer 决定；ask 累积到 needsAsk 等待用户审批。三者优先级
       // #199：由 evaluate 的 last-match-wins 决定，此处只分流不复核规则语义。
@@ -350,6 +361,29 @@
   return Boolean(input && typeof input === "object" && !Array.isArray(input))
 }
 
+function rawDenyPatterns(metadata: Readonly<Record<string, unknown>>) {
+  const patterns = metadata.raw_patterns
+  if (!Array.isArray(patterns)) return []
+  // #285：raw_patterns 由 shell 解析产出，用于原始命令证据的拒绝检查。
+  // 它是 deny-only：敏感 env 赋值规则保持硬停止，不赋予原始文本 allow/auto/ask 权限。
+  return patterns.filter((pattern): pattern is string => typeof pattern === "string")
+  // #285：filter 型守卫保持下游类型收窄，调用方无需再断言
+}
+
+function rawDenyRule(permission: string, pattern: string, ruleset: PermissionV1.Ruleset) {
+  // #285：不使用 last-match-wins 评估器或已批准规则。原始证据对 canonical
+  // pattern 不可见，因此 GITHUB_TOKEN=* 的 deny 必须保持终端性，即使后续 bash:* allow。
+  return ruleset.find(
+    (rule) =>
+      rule.action === "deny" &&
+      rule.pattern !== "*" &&
+      Wildcard.match(permission, rule.permission) &&
+      Wildcard.match(pattern, rule.pattern),
+      // #285：rule.pattern !== "*" 防止通配兜底规则吞掉原始证据检查；
+      // 只有显式命名 pattern 的 deny 才能命中 raw_patterns
+  )
+}
+
 export function merge(...rulesets: PermissionV1.Ruleset[]): PermissionV1.Rule[] {
   return rulesets.flat()
 }


diff --git a/packages/opencode/src/permission/precheck.ts b/packages/opencode/src/permission/precheck.ts
--- a/packages/opencode/src/permission/precheck.ts
+++ b/packages/opencode/src/permission/precheck.ts
@@ -216,7 +216,33 @@
   // #232：默认回到 general allow，除非上方的结构化边界（如 workspace delete metadata）
   // #232：先把它们提升到 cautious。
   if (input.permission !== "bash") return { level: "general", reason: "precheck only has bash coverage" }
-  return evaluateShell(typeof input.metadata.command === "string" ? input.metadata.command : input.patterns.join(" && "), 0)
+  return bashEffect(input)
+}
+
+function bashEffect(input: {
+  patterns: readonly string[]
+  metadata: Readonly<Record<string, unknown>>
+}) {
+  const command = typeof input.metadata.command === "string" ? input.metadata.command : undefined
+  // #285：metadata.command 缺省时退化为 patterns 拼接，保持与旧 evaluateShell 兼容；
+  // 存在原始命令时始终以其为最低基线
+  const patternCommand = input.patterns.join(" && ")
+  if (!command) return evaluateShell(patternCommand, 0)
+
+  const raw = evaluateShell(command, 0)
+  if (!patternCommand.trim() || patternCommand === command) return raw
+  // #285：canonical 与原始命令相同时无需二次评估，避免重复解析
+
+  // #285：shell metadata 是原始审计证据，permission patterns 是 canonical 规则键。
+  // auto precheck 必须同时考虑两个视角并保留更高风险，防止原始危险载荷被削弱，
+  // 也不能让 env 赋值将 git push --force 从 cautious 降为 general。
+  return maxRisk(raw, evaluateShell(patternCommand, 0))
+}
+
+function maxRisk(left: Decision, right: Decision) {
+// #285：双视角取风险更高者——env 赋值不得降低 git push --force 的 cautious 等级，
+// 原始危险载荷也不得因安全 pattern 被降级
+  return LEVELS.indexOf(right.level) > LEVELS.indexOf(left.level) ? right : left
 }
 
 // #232：external_directory 边界统一为 cautious review seam——shell 发起的访问复用同一条


