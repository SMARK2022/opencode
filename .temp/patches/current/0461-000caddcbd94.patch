目标已携带更强修复（node 替代 bun + resolveSync），源 build hunk 判 SUPERSEDED；本 current 补注 resolveSync
的路径解析理据（源修复的另一半），regen 两文件为源时代漂移（内容经抽样已由目标既有 gen 覆盖），见 record。
diff --git a/packages/sdk/js/script/build.ts b/packages/sdk/js/script/build.ts
--- a/packages/sdk/js/script/build.ts
+++ b/packages/sdk/js/script/build.ts
@@ -118,4 +118,5 @@
 await $`rm -rf dist`
-// TypeScript's CLI is a Node entrypoint; running it through Bun can leave the Windows CI SDK build alive.
+// TypeScript 的 CLI 是 Node 入口：经由 Bun 启动会在 Windows CI 上让 SDK 构建进程悬挂不退（#461）；
+// resolveSync 把 tsc 定位到本 workspace 依赖内的绝对路径，避免 PATH 上的同名二进制劫持。
 await $`node ${Bun.resolveSync("typescript/bin/tsc", dir)}`
 await $`rm openapi.json`

diff --git a/packages/sdk/js/script/build.ts b/packages/sdk/js/script/build.ts
index 1bb93def57fdec15badb9fcf56290e16d7ed6c9c..2edd6a23b1283bb6d39e76a2e1acf5256db74a3c 100755
--- a/packages/sdk/js/script/build.ts
+++ b/packages/sdk/js/script/build.ts
@@ -115,6 +115,25 @@ if (sseTypesPatched === sseTypesSource) {
 }
 await Bun.write(sseTypesPath, sseTypesPatched)
 
+// cancel() 返回 Promise，同步 try/catch 接不到原生 fetch 取消响应体后的拒绝。
+// 修补生成入口，避免下次 SDK 再生成时丢失清理责任。
+const ssePath = "./src/v2/gen/core/serverSentEvents.gen.ts"
+const sseSource = await Bun.file(ssePath).text()
+const ssePatched = sseSource.replace(
+  /const abortHandler = \(\) => \{\s*try \{\s*reader\.cancel\(\);?\s*\} catch \{\s*\/\/ noop\s*\}\s*\};?/,
+  `const abortHandler = () => {
+    // 只消化当前请求的取消，真实清理失败仍交给既有 SSE 错误通道。
+    void reader.cancel().catch((error: unknown) => {
+      if (signal.aborted && error === signal.reason) return
+      onSseError?.(error)
+    })
+  }`,
+)
+if (ssePatched === sseSource) {
+  throw new Error(`SSE cancellation patch did not apply; generated transport may have changed (${ssePath})`)
+}
+await Bun.write(ssePath, ssePatched)
+
 await $`bun prettier --write src/gen`
 await $`bun prettier --write src/v2`
 await $`rm -rf dist`
diff --git a/packages/sdk/js/src/v2/gen/core/serverSentEvents.gen.ts b/packages/sdk/js/src/v2/gen/core/serverSentEvents.gen.ts
index 056a812593223d1fed57b7b0bbaac58f4ab37c23..df0cb3f8f6067606f8fed87d4ae2a14fc1add8c5 100644
--- a/packages/sdk/js/src/v2/gen/core/serverSentEvents.gen.ts
+++ b/packages/sdk/js/src/v2/gen/core/serverSentEvents.gen.ts
@@ -137,11 +137,11 @@ export const createSseClient = <TData = unknown>({
         let buffer = ""
 
         const abortHandler = () => {
-          try {
-            reader.cancel()
-          } catch {
-            // noop
-          }
+          // 只消化当前请求的取消，真实清理失败仍交给既有 SSE 错误通道。
+          void reader.cancel().catch((error: unknown) => {
+            if (signal.aborted && error === signal.reason) return
+            onSseError?.(error)
+          })
         }
 
         signal.addEventListener("abort", abortHandler)
