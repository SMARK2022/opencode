 /** @jsxImportSource @opentui/solid */
 import { describe, expect, test } from "bun:test"
 import { testRender } from "@opentui/solid"
+import { createOpencodeClient } from "@opencode-ai/sdk/v2"
 import { onMount } from "solid-js"
