--- a/packages/opencode/src/session/overflow.ts
+++ b/packages/opencode/src/session/overflow.ts
@@ -6,14 +6,19 @@
 import type { MessageV2 } from "./message-v2"
 
 const COMPACTION_BUFFER = 20_000
+// 最小压缩缓冲区：确保即使 provider reserve 很大也有足够空间
+const COMPACTION_BUFFER_MIN = 5_000
 
 export function usable(input: { cfg: ConfigV1.Info; model: Provider.Model; outputTokenMax?: number }) {
   const context = input.model.limit.context
   if (context === 0) return 0
 
-  const reserved =
-    input.cfg.compaction?.reserved ??
-    Math.min(COMPACTION_BUFFER, ProviderTransform.maxOutputTokens(input.model, input.outputTokenMax))
+// 计算 provider reserve：context 减去 input limit 的差额
+  const inputLimit = input.model.limit.input ?? 0
+  const providerReserve = inputLimit > 0 ? Math.max(0, context - inputLimit) : 0
+  // 默认缓冲：从 COMPACTION_BUFFER 中减去 provider reserve，但不低于 MIN
+  const defaultBuffer = Math.max(COMPACTION_BUFFER_MIN, COMPACTION_BUFFER - providerReserve)
+  const reserved = input.cfg.compaction?.reserved ?? defaultBuffer
   return input.model.limit.input
     ? Math.max(0, input.model.limit.input - reserved)
     : Math.max(0, context - ProviderTransform.maxOutputTokens(input.model, input.outputTokenMax))

