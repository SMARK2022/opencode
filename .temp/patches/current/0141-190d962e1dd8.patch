-dist/SMARK2022.opencode-ide-bridge-1.17.23.vsix
+dist/SMARK2022.opencode-ide-bridge-1.17.24.vsix
 ├─ [Content_Types].xml
 ├─ extension.vsixmanifest
 └─ extension/
@@ -132,7 +135,7 @@ dist/SMARK2022.opencode-ide-bridge-1.17.23.vsix
 <!-- 「Local VSIX Install」：scripts.vsix 的 dist 输出是安装契约 -->
 
 ```powershell
-code --install-extension .\dist/SMARK2022.opencode-ide-bridge-1.17.23.vsix --force
+code --install-extension .\dist/SMARK2022.opencode-ide-bridge-1.17.24.vsix --force
 ```
 
