From eb439379e2b3cba28fe3d6b85c4593dbbfb3dfc2 Mon Sep 17 00:00:00 2001
From: SMARK2022 <3222301373@qq.com>
Date: Sun, 5 Jul 2026 14:33:36 +0800
Subject: [PATCH] fix(tui,shell): increase DialogPrompt height; preserve corrected process isolation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8

紧邻原始474撤回了本项临时linux-only workaround；按用户授权提前保留该修正，两个真实owner均维持非Windows进程组。
保留源编辑框增高，并同步既有真实渲染断言，不重复旧shell构造或改变kill/输出归属。
diff --git a/packages/tui/src/ui/dialog-prompt.tsx b/packages/tui/src/ui/dialog-prompt.tsx
--- a/packages/tui/src/ui/dialog-prompt.tsx
+++ b/packages/tui/src/ui/dialog-prompt.tsx
@@ -150,7 +150,6 @@
-          // minHeight=3 保证空态有足够视觉空间；maxHeight=9 让长文本（如 6400 字符的 goal objective）
-          // 能随内容增长显示更多行，避免固定 3 行只能看到一小段。与主 Prompt 的 minHeight+maxHeight 模式一致。
-          // 对话框 medium 宽度 60 chars，减去 padding 各 2 chars 后 textarea 可用 56 chars 宽。
+          // 空态保留3行，长objective最多显示15行；只扩展可见窗口，不限制或截断6400字符正文。
+          // medium宽60时内容宽56；24行终端中标题、15行正文和footer仍有布局余量。
           minHeight={3}
-          maxHeight={9}
+          maxHeight={15}
           ref={(val: TextareaRenderable) => {
             textarea = val
diff --git a/packages/tui/test/cli/tui/dialog-prompt.test.tsx b/packages/tui/test/cli/tui/dialog-prompt.test.tsx
--- a/packages/tui/test/cli/tui/dialog-prompt.test.tsx
+++ b/packages/tui/test/cli/tui/dialog-prompt.test.tsx
@@ -116,1 +116,1 @@
-    expect(textarea.height).toBe(9)
+    expect(textarea.height).toBe(15)
