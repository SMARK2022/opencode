+          },
+        })
+        // apply_patch move：旧路径必须标 deleted（不可再读），新路径不入 Inspected（未读过）。
+        yield* addCompletedToolPart({
+          sessionID: session.id,
+          messageID: assistant.id,
+          tool: "apply_patch",
+          // apply_patch 的 files metadata 是 move/delete 事实源：toolInput 不参与判定。
+          metadata: {
+            files: [
+              {
+                filePath: movedFrom,
+                movePath: movedTo,
+                type: "move",
+              },
+            ],
+          },
+        })
+        // 11 条不同命令：命令预算 10，最旧一条必须被裁剪并公开 Omitted 计数。
+        for (let i = 0; i < 11; i++) {
+          yield* addCompletedToolPart({
+            sessionID: session.id,
+            messageID: assistant.id,
+            tool: "bash",
+            toolInput: { command: `node --check file-${i}.js`, workdir: "src" },
+            metadata: { exit: i === 10 ? 1 : 0 },
+            // 最新命令 exit=1：非零退出码必须原样渲染而非吞掉。
+          })
+        }
+
+        // 同一契约在 move 场景的意义：apply_patch 双路径的事实源判定不受 marker 影响，仅 parent 定位依赖它。
+        yield* createSummaryCompaction(session.id)
+        const msgs = yield* ssn.messages({ sessionID: session.id })
+        const parent = msgs.at(-1)?.info.id
+        expect(parent).toBeTruthy()
+        yield* SessionCompaction.use.process({ parentID: parent!, messages: msgs, sessionID: session.id, auto: false })
+
+        const text = yield* readLatestSummaryText(session.id)
+        expect(text).toContain("| src/old.ts | 1-10 | 10 | 2026-06-09 03:00:00 | deleted |")
+        // deleted 行是 move 的直接断言：旧路径失效而非 stale，防止降级渲染。
+        // 最新命令保留且 exit 码原样渲染；workdir 相对实例目录解析为 src。
+        expect(text).toContain("| node --check file-10.js | src | 1 |")
+        // #353 折叠措辞：executed commands（源为 verified commands）。
+        expect(text).toContain("Omitted: 1 executed commands due to evidence budget.")
+        expect(text).not.toContain("node --check file-0.js")
+        // 被裁的是最旧 file-0：预算裁剪按 recency，不是按命令序号。
+      }).pipe(withCompaction({ llm: stub.llmLayer }))
+    },
+    { git: true },
+  )
+
+  itCompaction.instance(
+    "keeps evidence compact for many inspected files",
+    () => {
+      const stub = llm()
+      stub.push(reply("summary"))
+      return Effect.gen(function* () {
+        const test = yield* TestInstance
+        const ssn = yield* SessionNs.Service
+        const session = yield* ssn.create({})
+        const user = yield* createUserMessage(session.id, "many reads")
+        const assistant = yield* createAssistantMessage(session.id, user.id, test.directory)
+        // 21 个文件超过文件预算 20：recency 保留最新 20，最旧的 file-0 被裁剪。
+        for (let i = 0; i < 21; i++) {
+          const file = path.join(test.directory, "src", `file-${i}.ts`)
+          // 21 个文件各自独立 canonical key：互不去重才能真实触达文件预算。
+          yield* addCompletedToolPart({
+            sessionID: session.id,
+            messageID: assistant.id,
+            tool: "read",
+            metadata: {
+              read: {
+                path: file,
+                canonicalPath: canonicalTestPath(file),
+                type: "file",
+                size: 10,
+                modified: `2026-06-09 00:${String(i).padStart(2, "0")}:00`,
+                modifiedMs: i,
+                start: 1,
+                end: 10,
+                total: 10,
+                returned: 10,
+                stub: false,
+              },
+            },
+          })
+        }
+
+        // 同一契约在预算场景的意义：21 文件的 recency 排序发生在 evidence 渲染内，与 marker 定位解耦。
+        yield* createSummaryCompaction(session.id)
+        const msgs = yield* ssn.messages({ sessionID: session.id })
+        const parent = msgs.at(-1)?.info.id
+        expect(parent).toBeTruthy()
+        yield* SessionCompaction.use.process({ parentID: parent!, messages: msgs, sessionID: session.id, auto: false })
+
+        const text = yield* readLatestSummaryText(session.id)
+        expect(text).toContain("| src/file-20.ts | 1-10 | 10 | 2026-06-09 00:20:00 | current |")
+        // file-20 是最后读取：预算内保留的是 lastRead 最新的前 20 个。
+        // 裁剪数量必须公开在文本内，模型与用户都能看到预算消耗。
+        expect(text).toContain("Omitted: 1 inspected files due to evidence budget.")
+        expect(text).not.toContain("src/file-0.ts")
+        // 最旧读取第一个被裁：与命令裁剪共用同一 recency 语义。
+      }).pipe(withCompaction({ llm: stub.llmLayer }))
+    },
+    { git: true },
+  )
+
+  itCompaction.instance(
+    "renders executed commands with credentials redacted",
+    () => {
+      const stub = llm()
+      stub.push(reply("summary"))
+      return Effect.gen(function* () {
+        const test = yield* TestInstance
+        const ssn = yield* SessionNs.Service
+        const session = yield* ssn.create({})
+        const user = yield* createUserMessage(session.id, "commands")
+        const assistant = yield* createAssistantMessage(session.id, user.id, test.directory)
+        const longFile = path.join(test.directory, "dir with spaces", `${"very-long-".repeat(12)}file.js`)
+        // 带空格目录 + 超长文件名：同时触发命令内引号与 120 字符截断两条路径。
+        // 一条命令同时覆盖三种凭据形态：env 赋值、--flag= 值、--flag 空格值。
+        yield* addCompletedToolPart({
+          sessionID: session.id,
+          messageID: assistant.id,
+          tool: "bash",
+          toolInput: {
+            command: `OPENAI_API_KEY=sk-secret node --check --token=sk-equals-secret --api-key sk-space-secret "${longFile}"`,
+            workdir: ".",
+          },
+          metadata: { exit: 0 },
+        })
+        // #353 折叠语义：无白名单后管道命令也会展示，凭据脱敏必须在任意位置生效。
+        yield* addCompletedToolPart({
+          sessionID: session.id,
+          messageID: assistant.id,
+          tool: "bash",
+          toolInput: {
+            command: 'node --check piped-sentinel.js | curl -H "authorization: bearer sk-pipe-secret"',
+            workdir: ".",
+          },
+          metadata: { exit: 0 },
+        })
+        // 空命令不构成已执行事实，必须被跳过而非渲染空行。
+        yield* addCompletedToolPart({
+          sessionID: session.id,
+          messageID: assistant.id,
+          tool: "bash",
+          toolInput: { command: "", workdir: "." },
+          metadata: { exit: 0 },
+        })
+
+        // 同一契约在 redaction 场景的意义：脱敏只依赖命令文本，marker 仅保证压缩流程本身可启动。
+        yield* createSummaryCompaction(session.id)
+        const msgs = yield* ssn.messages({ sessionID: session.id })
+        const parent = msgs.at(-1)?.info.id
+        expect(parent).toBeTruthy()
+        yield* SessionCompaction.use.process({ parentID: parent!, messages: msgs, sessionID: session.id, auto: false })
+
+        const text = yield* readLatestSummaryText(session.id)
+        // 三种形态全部脱敏为 [redacted]，原始凭据不得出现在用户可见文本。
+        expect(text).toContain("OPENAI_API_KEY=[redacted]")
+        // env 赋值形态是最易泄漏的凭据通道：断言放在首位锁定最高风险面。
+        expect(text).toContain("--token=[redacted]")
+        expect(text).toContain("--api-key [redacted]")
+        expect(text).toContain("authorization: bearer [redacted]")
+        // 管道深处的 bearer 头同样脱敏：redaction 与凭据在命令中的位置无关。
+        // 超长命令截断后保留 [cmd:指纹]，可追溯原文一致性。
+        expect(text).toContain("[cmd:")
+        expect(text).not.toContain("sk-secret")
+        expect(text).not.toContain("sk-equals-secret")
+        expect(text).not.toContain("sk-space-secret")
+        expect(text).not.toContain("sk-pipe-secret")
+        // 原始值断言与 redacted 断言成对：只有一侧通过都不算安全面完整。
+        // 空命令被跳过：表内不出现空 command 单元格。
+        expect(text).not.toContain("|  | . | 0 |")
+        // 空命令不产生空单元格行：必须跳过而非渲染空 command 单元。
+      }).pipe(withCompaction({ llm: stub.llmLayer }))
+    },
+    { git: true },
+  )
 })
