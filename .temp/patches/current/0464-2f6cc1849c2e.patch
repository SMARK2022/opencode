+const EVIDENCE_HANDOFF_KIND = "compaction_evidence_handoff"
+const EVIDENCE_FILE_LIMIT = 20
+const EVIDENCE_FILE_RANGE_LIMIT = 8
+const EVIDENCE_COMMAND_LIMIT = 10
+const EVIDENCE_TODO_LIMIT = 100
