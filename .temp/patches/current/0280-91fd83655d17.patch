- */
-export function deriveSubagentSessionPermission(
-  input: {
-    parentSessionPermission: PermissionV1.Ruleset
-    subagent: Agent.Info
-  },
-  // 父 allow 不扩张子能力；空默认只供没有父代理限制的独立 helper 调用。
