diff --git a/packages/opencode/src/agent/subagent-permissions.ts b/packages/opencode/src/agent/subagent-permissions.ts
index 36ab2d4a7..8bae32acc 100644
--- a/packages/opencode/src/agent/subagent-permissions.ts
+++ b/packages/opencode/src/agent/subagent-permissions.ts
@@ -1,33 +1,110 @@
 import { PermissionV1 } from "@opencode-ai/core/v1/permission"
+import { Wildcard } from "@opencode-ai/schema/wildcard"
 import type { Agent } from "./agent"
 
 /**
  * Build the `permission` ruleset for a subagent's session when it's spawned
  * via the task tool. Combines:
  *
- * 1. The parent session's deny rules and external_directory rules.
- *    Ordered parent-agent non-allow restrictions also bound delegation;
- *    matching parent asks and denies take precedence over session grants.
- * 2. Default `todowrite` and `task` denies if the subagent's own ruleset
+ * 1. The subagent's own agent ruleset: its capability boundaries stay the base.
+ * 2. The parent **agent's** explicit admission ceilings — `ask` and `auto`
+ *    make subagent execution no less strict than the delegating agent without
+ *    coupling the behavior to a specific agent name.
+ * 3. The parent **session's** runtime ceilings — nested subagents inherit
+ *    already-derived `ask`/`auto`/`deny` overlays, while `allow` exceptions are
+ *    preserved only when the child agent already allows the same boundary.
+ * 4. Default `todowrite` and `task` denies if the subagent's own ruleset
  *    doesn't already permit them.
  */
 export function deriveSubagentSessionPermission(
   input: {
     parentSessionPermission: PermissionV1.Ruleset
     subagent: Agent.Info
   },
-  // 父 allow 不扩张子能力；空默认只供没有父代理限制的独立 helper 调用。
+  // 父代理权限来自当前委派上下文；独立 helper 调用可省略。
   parentAgentPermission: PermissionV1.Ruleset = [],
 ): PermissionV1.Ruleset {
   const canTask = input.subagent.permission.some((rule) => rule.permission === "task")
   const canTodo = input.subagent.permission.some((rule) => rule.permission === "todowrite")
+  const parentHasCatchAllDeny = parentAgentPermission.some(
+    (rule) => rule.permission === "*" && rule.action === "deny",
+  )
+  const ceilings = [
+    ...parentAgentPermission.flatMap((rule) => parentAgentCeiling(rule, input.subagent.permission, parentHasCatchAllDeny)),
+    ...input.parentSessionPermission.flatMap((rule) => forwardParentSessionRule(rule, input.subagent.permission)),
+  ]
+
   return [
-    ...input.parentSessionPermission.filter(
-      (rule) => rule.permission === "external_directory" || rule.action === "deny",
-    ),
-    // source 后写父 non-allow：ask/deny 均覆盖会话 grant，原序保留最后匹配语义。
-    ...parentAgentPermission.filter((rule) => rule.action !== "allow"),
+    ...ceilings,
+    ...subagentDenyOverrides(input.subagent.permission, ceilings),
     ...(canTodo ? [] : [{ permission: "todowrite" as const, pattern: "*" as const, action: "deny" as const }]),
     ...(canTask ? [] : [{ permission: "task" as const, pattern: "*" as const, action: "deny" as const }]),
   ]
 }
+
+function parentAgentCeiling(
+  rule: PermissionV1.Rule,
+  subagent: PermissionV1.Ruleset,
+  parentHasCatchAllDeny: boolean | undefined,
+) {
+  // 父 catch-all 是自执行默认，不能抹掉 controller 委派的执行能力。
+  if (rule.permission === "*") return []
+  // catch-all deny 下仅继承 edit 限制；其他显式 deny 保留 source 的委派语义。
+  if (rule.action === "deny" && parentHasCatchAllDeny && rule.permission !== "edit") return []
+
+  const childAction = evaluateSubagentRule(subagent, rule.permission, rule.pattern)?.action ?? "ask"
+  if (rule.action === "allow") {
+    // 父 allow 只保留子代理也已允许的共享例外。
+    return childAction === "allow" ? [rule] : []
+  }
+  if (childAction === "deny") return childSpecificCeilings(rule, subagent)
+
+  const action = rule.action
+  if (action === childAction) return []
+  return [{ ...rule, action }]
+}
+
+function forwardParentSessionRule(rule: PermissionV1.Rule, subagent: PermissionV1.Ruleset) {
+  // 会话 allow 同样只转发双方共享的例外；ask/auto/deny 按原规则顺序下放。
+  if (rule.action === "allow")
+    return evaluateSubagentRule(subagent, rule.permission, rule.pattern)?.action === "allow" ? [rule] : []
+
+  const childAction = evaluateSubagentRule(subagent, rule.permission, rule.pattern)?.action ?? "ask"
+  if (childAction === "deny") return childSpecificCeilings(rule, subagent)
+  const action = rule.action
+  if (action === childAction) return []
+  return [{ ...rule, action }]
+}
+
+function childSpecificCeilings(parent: PermissionV1.Rule, subagent: PermissionV1.Ruleset) {
+  // 子代理用通配 deny 兜底时，只对其显式非 deny 能力推导父限制。
+  return subagent.flatMap((rule) => {
+    if (rule.action === "deny") return []
+    if (rule.permission === "*") return []
+    if (!Wildcard.match(rule.permission, parent.permission, process.platform === "win32")) return []
+    if (!Wildcard.match(rule.pattern, parent.pattern, process.platform === "win32")) return []
+    const action = parent.action
+    if (action === rule.action) return []
+    return [{ permission: rule.permission, pattern: rule.pattern, action }]
+  })
+}
+
+function subagentDenyOverrides(subagent: PermissionV1.Ruleset, ceilings: PermissionV1.Ruleset) {
+  if (ceilings.length === 0) return []
+  // 具体 deny 置于 ceiling 后；不重放通配兜底，以免覆盖已收紧的窄能力。
+  return subagent.filter(
+    (rule) =>
+      rule.action === "deny" &&
+      rule.permission !== "*" &&
+      rule.pattern !== "*" &&
+      ceilings.some((ceiling) => Wildcard.match(rule.permission, ceiling.permission, process.platform === "win32")),
+  )
+}
+
+function evaluateSubagentRule(ruleset: PermissionV1.Ruleset, permission: string, pattern: string) {
+  return ruleset.findLast(
+    (rule) =>
+      Wildcard.match(permission, rule.permission, process.platform === "win32") &&
+      Wildcard.match(pattern, rule.pattern, process.platform === "win32"),
+  )
+}
