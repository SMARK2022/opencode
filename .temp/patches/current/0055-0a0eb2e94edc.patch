+// PowerShell UTF-8 包装：强制 Console I/O 为 UTF-8（无 BOM），并把退出码透传给外层
+// 使用 UTF8Encoding($false) 避免 BOM；$OutputEncoding 与 Console 输出一致
+function psUtf8(command: string) {
+  return [
+    "[Console]::InputEncoding = [System.Text.UTF8Encoding]::new($false)",
+    "[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)",
+    "$OutputEncoding = [Console]::OutputEncoding",
+    command,
+    "if ($LASTEXITCODE -ne $null) { exit $LASTEXITCODE }",
+  ].join(String.fromCharCode(10))
+}
+
+// 将命令编码为 PowerShell -EncodedCommand 格式（UTF-16LE base64）
+// PowerShell 的 -Command 参数会丢失非 ASCII 字符，-EncodedCommand 解决此问题
+function psEncoded(command: string) {
+  return Buffer.from(psUtf8(command), "utf16le").toString("base64")
+}
 
