+  ].join("\n")
+  return {
+    command: file,
+    args: ["-NoLogo", "-NoProfile", "-NonInteractive", "-EncodedCommand", Buffer.from(script, "utf16le").toString("base64")],
+    // 显式 argv 不能再经 shell 包装，否则引号和中文会被第二次解释。
+    shell: false,
+  }
