+// Windows 平台 PowerShell UTF-8 输出编码测试
+describe("tool.shell windows encoding", () => {
+  if (process.platform !== "win32") return
+
+  for (const item of ps) {
+    it.live(
+      `PowerShell outputs Chinese without replacement characters [${item.label}]`,
+      () =>
+        withShell(
+          item,
+          Effect.gen(function* () {
+            const tmp = yield* tmpdirScoped()
+            yield* runIn(
+              tmp,
+              Effect.gen(function* () {
+                const bash = yield* initBash()
+                // 测试中文输出不产生替换字符（\uFFFD）
+                // 验证 -EncodedCommand 机制正确传递 UTF-8 中文
+                const result = yield* bash.execute(
+                  {
+                    command: `Write-Output "桌面 大学文档 毕业设计 压缩感知"`,
+                  },
+                  ctx,
+                )
+                expect(result.output).toContain("桌面")
+                expect(result.output).toContain("大学文档")
+                expect(result.output).toContain("毕业设计")
+                // 不应出现替换字符，说明编码正确
+                expect(result.output).not.toContain("\uFFFD")
+              }),
+            )
+          }),
+        ),
+    )
+  }
+})
