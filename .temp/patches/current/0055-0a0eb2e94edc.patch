+export function cmd(file: string, command: string, platform: string = process.platform) {
+  if (platform !== "win32" || !ps(file)) return { command, args: [], shell: file }
+  // UTF-16LE base64 只传输脚本文本；Console 与管道生产端使用无 BOM 的 UTF-8。
