 }
 
+// #279：这个 key 是 `/context` 面板的低成本刷新信号：它必须读取 streaming
+// part 的 nested 字段来保持响应式依赖，但不能像真正输入快照那样深拷贝
+// message/part 全量内容。否则高频 tool raw/text delta 会在 throttle 之前
+// 先触发 JSON roundtrip，正是本次修复要移除的热路径。
+export function contextUsageRefreshKey(input: {
+  messages: readonly Message[]
+  getParts: (id: string) => readonly Part[]
+  providers: readonly Provider[]
+  config?: Config
+  agents?: readonly Agent[]
+  lastUserModel?: { providerID: string; modelID: string }
+  vcs?: VcsInfo
+  paths: { cwd: string; worktree?: string }
+  columns?: number
+}) {
+  return [
+    // #279：列数变化会改变网格布局，必须参与 key
+    input.columns ?? "",
+    // #279：cwd/worktree 变化意味着实例迁移，面板标题与路径行需要重绘
+    input.paths.cwd,
+    input.paths.worktree ?? "",
+    // #279：模型切换同时改变窗口上限与模型行，是面板的关键信号
+    input.lastUserModel ? `${input.lastUserModel.providerID}/${input.lastUserModel.modelID}` : "",
+    configRefreshKey(input.config),
+    // #279：vcs 是小对象，直接序列化即可，无需逐字段展开
+    input.vcs ? refreshJson(input.vcs) : "",
+    input.providers.map(providerRefreshKey).join("|"),
+    (input.agents ?? [])
+      .map((agent) => `${agent.name}:${agent.mode}:${agent.hidden ? 1 : 0}:${agent.description ?? ""}:${refreshJson(agent.permission)}`)
+      .join("|"),
+    // #279：消息与其 parts 拼接成段，保证 part 级粒度的刷新信号；段间 \n、段内 ,/: ，层级唯一可解析
+    input.messages.map((message) => [messageRefreshKey(message), input.getParts(message.id).map(partRefreshKey).join(",")].join("=")).join("\n"),
+  ].join("\n")
+}
+
+// #279：仅取 JSON 序列化长度做信号：长度变化必然代表内容变化，且避免为 tool.input 生成完整字符串
+function refreshJsonLength(value: unknown) {
+  try {
+    return JSON.stringify(value)?.length ?? 0
+  } catch {
+    // #279：循环引用等序列化异常按 0 处理，保证 key 构建本身永不抛出
+    return 0
+  }
+}
+
+// #279：小对象（vcs、权限）直接序列化；循环引用等异常回退 String，不让 key 构建把面板炸掉
+function refreshJson(value: unknown) {
+  try {
+    return JSON.stringify(value) ?? ""
+  } catch {
+    return String(value)
+  }
+}
+
+// #279：provider 签名只含 id 与各模型的 id/status/limit：模型列表增减或限额调整才会刷新面板
+function providerRefreshKey(provider: Provider) {
+  return [
+    provider.id,
+    Object.values(provider.models)
+      .map((model) => `${model.id}:${model.status}:${model.limit.context}:${model.limit.input}:${model.limit.output}`)
+      .join(","),
+  ].join(":")
+}
+
+function configRefreshKey(config: Config | undefined) {
+  if (!config) return ""
+  // #279：computeContextData 只读取 compaction 预留、额外 instruction 路径与 skill 路径；
+  // 刻意不序列化完整 config，避免把无关配置变更接进 `/context` 面板的 streaming 热路径。
+  return [
+    // #279：缺省时留空而非 0，区分"未配置"与"配置为 0"
+    config.compaction?.reserved ?? "",
+    Array.isArray(config.instructions) ? config.instructions.join("\0") : "",
+    Array.isArray(config.skills?.paths) ? config.skills.paths.join("\0") : "",
+  ].join("|")
+}
+
+function messageRefreshKey(message: Message) {
+  // #279：inputChars/inputBreakdown 等字段在目标 SDK 型别上未声明，沿 util 惯例用 cast 读取
+  const extra = message as {
+    inputChars?: number
+    inputTokens?: number
+    inputBreakdown?: InputBreakdown
+  }
+  return [
+    message.id,
+    message.role,
+    // #279：parentID/providerID/modelID 是压缩过滤与模型行的输入，必须参与 key
+    "parentID" in message ? message.parentID : "",
+    "providerID" in message ? message.providerID : "",
+    "modelID" in message ? message.modelID : "",
+    // #279：completed 时间是压缩过滤的相关信号，缺失时留空即可
+    message.time && "completed" in message.time ? message.time.completed : "",
+    // #279：tokens 仅在 assistant 上存在，in 守卫同时收窄型别
+    "tokens" in message && message.tokens ? tokenRefreshKey(message.tokens) : "",
+    extra.inputChars ?? "",
+    extra.inputTokens ?? "",
+    extra.inputBreakdown ? inputBreakdownRefreshKey(extra.inputBreakdown) : "",
+  ].join(":")
+}
+
+function partRefreshKey(part: Part) {
+  const base = `${part.id ?? ""}:${part.type}`
+  if (part.type === "text") return `${base}:${part.text?.length ?? 0}:${part.ignored ? 1 : 0}`
+  // #279：ignored 标记影响分类归属，仅文本长度不足以表达它
+  if (part.type === "reasoning") return `${base}:${part.text?.length ?? 0}`
+  if (part.type === "tool") {
+    const state = part.state
+    // #279：pending 用 raw 长度、completed/error 用 input 长度+产物：流式 raw 增长必然改变 key
+    if (state.status === "pending") return `${base}:${part.tool}:${state.status}:${state.raw?.length ?? 0}`
+    if (state.status === "completed")
+      return `${base}:${part.tool}:${state.status}:${refreshJsonLength(state.input)}:${state.output?.length ?? 0}:${refreshJson(state.attachments)}`
+    if (state.status === "error")
+      return `${base}:${part.tool}:${state.status}:${refreshJsonLength(state.input)}:${state.error?.length ?? 0}`
+    return `${base}:${part.tool}:${state.status}`
+  }
+  // #279：step-start/step-finish 携带 inputBreakdown，直接参与 key，面板分类条才能跟随数值刷新
+  const steps = part as { inputTokens?: number; inputChars?: number; inputBreakdown?: InputBreakdown }
+  if (part.type === "step-start")
+    return `${base}:${steps.inputTokens ?? ""}:${steps.inputChars ?? ""}:${steps.inputBreakdown ? inputBreakdownRefreshKey(steps.inputBreakdown) : ""}`
+  if (part.type === "step-finish")
+    return `${base}:${part.cost ?? 0}:${"tokens" in part && part.tokens ? tokenRefreshKey(part.tokens) : ""}:${steps.inputChars ?? ""}:${steps.inputBreakdown ? inputBreakdownRefreshKey(steps.inputBreakdown) : ""}`
+  // #279：id+type 是 part 的最小 identity；文件附件长度变化必须刷新（图片/粘贴路径）
+  if (part.type === "file") return `${base}:${part.filename ?? ""}:${part.mime}:${part.url?.length ?? 0}`
+  return base
+}
+
+function tokenRefreshKey(tokens: { input: number; output: number; reasoning: number; cache: { read: number; write: number } }) {
+  // #279：五段数值完整展开；cache 读写分开，任一变化都应触发面板
+  return `${tokens.input}/${tokens.output}/${tokens.reasoning}/${tokens.cache.read}/${tokens.cache.write}`
+}
+
+// #279：inputBreakdown 是纯数值结构，逐字段展开：数值变化（如 100→200 同长度）也必须改变 key，
+// 只取 JSON 长度会漏掉同长度的数值变化，面板分类条就会停留在陈旧数字上。
+function inputBreakdownRefreshKey(input: InputBreakdown) {
+  return [
+    input.system,
+    input.instructions,
+    input.skills,
+    input.tools,
+    input.messages.userText,
+    input.messages.assistantText,
+    input.messages.reasoning,
+    input.messages.toolInput,
+    input.messages.toolOutput,
+    input.messages.attachments,
+    input.messages.total,
+  ].join("/")
+}
+
 
 // 格式化 token 数为人类可读的 k/m 简写
 function formatTokens(tokens: number) {
