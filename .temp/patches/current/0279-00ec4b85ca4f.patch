+/** @jsxImportSource @opentui/solid */
+// #279：DialogSelect identity-key 回归：稳定 key 标记 current、延迟 current 解析、无 key 对象回退
+import { expect, test } from "bun:test"
+import { mkdir } from "node:fs/promises"
+import path from "node:path"
+import { createDefaultOpenTuiKeymap } from "@opentui/keymap/opentui"
+import { testRender, useRenderer } from "@opentui/solid"
+import { createSignal, onCleanup, onMount } from "solid-js"
+import { tmpdir } from "../../fixture/fixture"
+import { createTuiResolvedConfig } from "../../fixture/tui-runtime"
+import { TestTuiContexts } from "../../fixture/tui-environment"
+import { DialogSelect, type DialogSelectOption } from "../../../src/ui/dialog-select"
+import { TuiConfigProvider } from "../../../src/config"
+import { ThemeProvider } from "../../../src/context/theme"
+import { KVProvider } from "../../../src/context/kv"
+import { ToastProvider } from "../../../src/ui/toast"
+import { DialogProvider } from "../../../src/ui/dialog"
+import { OpencodeKeymapProvider, registerOpencodeKeymap } from "../../../src/keymap"
+
+async function waitForFrame(app: Awaited<ReturnType<typeof testRender>>, text: string) {
+  // #279：2s 预算覆盖慢 CI；超时后仍返回末帧，让断言给出可读差异
+  const timeout = Date.now() + 2000
+  while (Date.now() < timeout) {
+    await app.renderOnce()
+    const frame = app.captureCharFrame()
+    if (frame.includes(text)) return frame
+    await Bun.sleep(10)
+  }
+  return app.captureCharFrame()
+}
+
+// Harness 复用 dialog-prompt.test.tsx 的 provider 栈：keymap/config/kv/theme/toast/dialog 缺一不可
+function DialogSelectHarness(props: {
+  root: string
+  state: string
+  options: DialogSelectOption<any>[]
+  current?: any
+  currentKey?: string
+  onMove?: (option: DialogSelectOption<any>) => void
+}) {
+  const renderer = useRenderer()
+  const keymap = createDefaultOpenTuiKeymap(renderer)
+  const resolvedConfig = createTuiResolvedConfig()
+  const off = registerOpencodeKeymap(keymap, renderer, resolvedConfig)
+  onCleanup(off)
+
+  return (
+    <TestTuiContexts
+      directory={props.root}
+      paths={{
+        home: props.root,
+        state: props.state,
+        worktree: props.root,
+      }}
+    >
+      <OpencodeKeymapProvider keymap={keymap}>
+        <TuiConfigProvider config={resolvedConfig}>
+          <KVProvider>
+            <ThemeProvider mode="dark">
+              <ToastProvider>
+                <DialogProvider>
+                  {/* #279：renderFilter=false 聚焦 identity 行为，过滤框非本用例范围 */}
+                  <DialogSelect
+                    title="Models"
+                    options={props.options}
+                    current={props.current}
+                    currentKey={props.currentKey}
+                    onMove={props.onMove}
+                    renderFilter={false}
+                  />
+                </DialogProvider>
+              </ToastProvider>
+            </ThemeProvider>
+          </KVProvider>
+        </TuiConfigProvider>
+      </OpencodeKeymapProvider>
+    </TestTuiContexts>
+  )
+}
+
+async function mountHarness(input: {
+  options: DialogSelectOption<any>[]
+  current?: any
+  currentKey?: string
+  onMove?: (option: DialogSelectOption<any>) => void
+  deferredKey?: (setCurrentKey: (key: string) => void) => void
+}) {
+  // #279：每用例独立 tmp 与 kv 状态，避免用例间串扰
+  await using tmp = await tmpdir()
+  const state = path.join(tmp.path, "state")
+  await mkdir(state, { recursive: true })
+  await Bun.write(path.join(state, "kv.json"), "{}")
+
+  function Harness() {
+    const [currentKey, setCurrentKey] = createSignal<string | undefined>(input.currentKey)
+    onMount(() => input.deferredKey?.((key) => setCurrentKey(key)))
+
+    return (
+      <DialogSelectHarness
+        root={tmp.path}
+        state={state}
+        options={input.options}
+        current={input.current}
+        currentKey={currentKey()}
+        onMove={input.onMove}
+      />
+    )
+  }
+
+  const app = await testRender(() => <Harness />, { width: 80, height: 30 })
+  return { app, cleanup: () => app.renderer.destroy() }
+}
+
+test("dialog select can mark the current object by stable key", async () => {
+  const app = await mountHarness({
+    // #279：current 与 currentKey 同时传入，验证 key 优先于对象比较
+    current: { providerID: "test", modelID: "two" },
+    currentKey: "test/two",
+    options: [
+      // #279：metadata 字段使深比较代价高：验证 key 路径完全绕开对象比较
+      {
+        key: "test/one",
+        title: "Model One",
+        value: { providerID: "test", modelID: "one", metadata: { created: 1 } },
+      },
+      {
+        key: "test/two",
+        title: "Model Two",
+        value: { providerID: "test", modelID: "two", metadata: { created: 2 } },
+      },
+    ],
+  })
+
+  try {
+    const frame = (await waitForFrame(app.app, "Model Two")).split("\n")
+    const current = frame.find((line) => line.includes("Model Two")) ?? ""
+    const other = frame.find((line) => line.includes("Model One")) ?? ""
+
+    // #279：current 标记只能落在 key 匹配行上，深比较对带 metadata 的对象不再参与判定
+    expect(current).toContain("●")
+    expect(other).not.toContain("●")
+  } finally {
+    app.cleanup()
+  }
+})
+
+test("dialog select resolves deferred current movement against the latest options", async () => {
+  const moves: string[] = []
+  let applyKey: ((key: string) => void) | undefined
+  // #279：onMove 是 moveTo 的可观测出口，用它验证延迟 current 的落点
+  const app = await mountHarness({
+    // #279：初始不传 key，验证纯延迟路径而非首帧命中
+    current: { providerID: "test", modelID: "two" },
+    deferredKey: (setCurrentKey) => {
+      applyKey = setCurrentKey
+    },
+    onMove: (option) => moves.push(option.title),
+    options: [
+      { key: "test/one", title: "Model One", value: { providerID: "test", modelID: "one" } },
+      { key: "test/two", title: "Model Two", value: { providerID: "test", modelID: "two" } },
+    ],
+  })
+
+  try {
+    await waitForFrame(app.app, "Model Two")
+    // #279：模拟 current 在 options 渲染后才到达：延迟效果必须在 timeout 回调里按最新 index 解析
+    // #279：延迟 current 晚于首帧到达，Bun.sleep 给 timeout(0) 回调执行窗口
+    applyKey?.("test/two")
+    await Bun.sleep(30)
+    await app.app.renderOnce()
+
+    expect(moves).toContain("Model Two")
+    expect(moves).not.toContain("Model One")
+  } finally {
+    app.cleanup()
+  }
+})
+
+test("dialog select keeps current fallback for unkeyed object values", async () => {
+  const app = await mountHarness({
+    // #279：current 同为无 key 对象，回退路径两端一致
+    current: { id: "two", label: "Model Two" },
+    options: [
+      { title: "Model One", value: { id: "one", label: "Model One" } },
+      { title: "Model Two", value: { id: "two", label: "Model Two" } },
+    ],
+  })
+
+  try {
+    const line = (await waitForFrame(app.app, "Model Two")).split("\n").find((item) => item.includes("Model Two")) ?? ""
+
+    // #279：无 key 的对象 value 仍走深比较回退，兼容既有无 key 调用方
+    expect(line).toContain("●")
+  } finally {
+    // #279：destroy 释放渲染器句柄，避免残留进程拖慢后续用例
+    app.cleanup()
+  }
+})
