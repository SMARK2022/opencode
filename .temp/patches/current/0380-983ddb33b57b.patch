+++ b/packages/opencode/src/server/routes/instance/httpapi/handlers/session.ts
@@ -10,5 +10,6 @@
 import { SessionShare } from "@/share/session"
 import { Session } from "@/session/session"
 import { SessionGoal } from "@/session/goal"
+import { GoalApiError } from "../groups/session"
 import { MessageV2 } from "@/session/message-v2"
 import { SessionRequestUsage } from "@/session/request-usage"
@@ -534,8 +534,14 @@
       objective: ctx.payload.objective,
       status: ctx.payload.status,
       tokenBudget: ctx.payload.tokenBudget,
-    }).pipe(Effect.catchTag("GoalError", () => Effect.fail(new HttpApiError.BadRequest({}))))
-    // [local-smark] GoalError→400 映射保持错误面契约：校验失败不伪装成 5xx
+    }).pipe(
+      // GoalError 的具体原因（空/超长/budget/无goal）透传到 wire 体 data.message，
+      // 让 TUI 能展示真实拒绝原因，而非通用 "Failed to update goal"；
+      // 校验失败仍映射为 4xx，保持错误面契约：不伪装成 5xx
+      Effect.catchTag("GoalError", (error) =>
+        Effect.fail(new GoalApiError({ name: "GoalError", data: { message: error.message } })),
+      ),
+    )
     return { goal }
   })
 
diff --git a/packages/opencode/src/session/goal.ts b/packages/opencode/src/session/goal.ts
--- a/packages/opencode/src/session/goal.ts
+++ b/packages/opencode/src/session/goal.ts
@@ -10,7 +10,7 @@
 
 // #364：goal objective 最大字符数，与 Codex 的 4000 字符限制对齐，
 // 防止超长 objective 污染上下文或触发 provider 请求体过大
-const MAX_OBJECTIVE_CHARS = 4000
+export const MAX_OBJECTIVE_CHARS = 4000
 
 // #364：goal 状态：只有 active 会触发自动续跑；
