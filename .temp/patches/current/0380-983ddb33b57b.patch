Subject: [PATCH] =?UTF-8?q?fix(goal):=20=E9=80=8F=E4=BC=A0=20goal=20?=
 =?UTF-8?q?=E6=A0=A1=E9=AA=8C=E5=A4=B1=E8=B4=A5=E5=8E=9F=E5=9B=A0=E5=88=B0?=
 =?UTF-8?q?=20TUI=EF=BC=8C=E9=81=BF=E5=85=8D=E9=80=9A=E7=94=A8=20"Failed?=
 =?UTF-8?q?=20to=20update=20goal"?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

handler 原先把 GoalError 映射为空 BadRequest({})，丢弃了具体拒绝原因（超长/空/budget/无goal），TUI 只能显示通用文案，用户无法定位问题。新增 GoalApiError（镜像 WorktreeApiError，httpApiStatus:400 + data.message）透传 GoalError.message；TUI setGoal 读取 body.data.message 展示。

client 侧加 4000 字符预检（跳过 status-only 更新，避免误拦 Pause/Resume），导出 MAX_OBJECTIVE_CHARS 供客户端复用唯一真值。保留 BadRequest 声明供框架 payload 校验，not-found 仍走 ApiNotFoundError(404)，二者语义分离。

diff --git a/packages/tui/src/component/dialog-goal.tsx b/packages/tui/src/component/dialog-goal.tsx
--- a/packages/tui/src/component/dialog-goal.tsx
+++ b/packages/tui/src/component/dialog-goal.tsx
@@ -6,6 +6,10 @@
 import { useToast } from "../ui/toast"
 import { createMemo } from "solid-js"
 
+// 与 packages/opencode/src/session/goal.ts 的 MAX_OBJECTIVE_CHARS（4000）对齐：
+// tui 不依赖 server 包内部模块，本地常量保持同一上限，两处需同步修改
+const MAX_OBJECTIVE_CHARS = 4000
+
 // [local-smark] goal 管理 dialog
 // SDK 未重新生成 goalSet/goalClear 方法，直接用 sdk.fetch 调用 HTTP 端点
 // POST/DELETE 需手动设置 directory query param（sdk.fetch 的 rewrite 仅处理 GET/HEAD）
@@ -33,6 +37,16 @@
 
   // POST /session/:id/goal — 设置或更新 goal
   const setGoal = async (input: { objective?: string; status?: string }) => {
+    // 仅对 objective 更新做长度预检；status-only 更新（Pause/Resume）objective 为 undefined，
+    // 必须跳过预检，否则会误拦状态切换。上限与 SessionGoal.MAX_OBJECTIVE_CHARS 保持一致，
+    // 提前拦截避免无效往返
+    if (input.objective !== undefined && input.objective.trim().length > MAX_OBJECTIVE_CHARS) {
+      toast.show({
+        message: `Goal objective must be at most ${MAX_OBJECTIVE_CHARS} characters`,
+        variant: "error",
+      })
+      return
+    }
     try {
       const resp = await sdk.fetch(goalUrl(), {
         method: "POST",
@@ -40,7 +54,11 @@
         body: JSON.stringify(input),
       })
       if (!resp.ok) {
-        toast.show({ message: "Failed to update goal", variant: "error" })
+        // 服务器返回 NamedError 形态 {name, data:{message}}；提取 data.message
+        // 让用户看到具体原因（如 budget/无goal 等 client 未预判的拒绝）。
+        // 解析失败或无 message 时回退通用文案，兼容中间件非 JSON 响应
+        const body = await resp.json().catch(() => null)
+        toast.show({ message: body?.data?.message ?? "Failed to update goal", variant: "error" })
         return
       }
       dialog.clear()
diff --git a/packages/opencode/src/server/routes/instance/httpapi/groups/session.ts b/packages/opencode/src/server/routes/instance/httpapi/groups/session.ts
index 4192bc2af098cbd0d9765404abed2a7bd5967e4a..f0991a15a9a772a43627dec7ef071c6dec51a456 100644
