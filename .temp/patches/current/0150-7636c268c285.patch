diff --git a/packages/core/test/network-proxy.test.ts b/packages/core/test/network-proxy.test.ts
new file mode 100644
index 0000000000..3643243ea9
--- /dev/null
+++ b/packages/core/test/network-proxy.test.ts
@@ -0,0 +1,30 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { NetworkProxy } from "../src/network-proxy"
+
+const originalFetch = globalThis.fetch
+
+afterEach(() => {
+  globalThis.fetch = originalFetch
+})
+
+describe("NetworkProxy", () => {
+  // #150：全局 fetch mock 不得劫持 routedFetch/native 主路径
+  test("routedFetch still uses proxy routing when global fetch is mocked", async () => {
+    let called = false
+    globalThis.fetch = Object.assign(
+      () => {
+        called = true
+        return Promise.resolve(new Response("mocked"))
+      },
+      { preconnect: originalFetch.preconnect },
+    )
+
+    const response = await NetworkProxy.routedFetch("http://127.0.0.1:1", { purpose: "infrastructure" }).catch(
+      (error) => error,
+    )
+
+    // #150：native 捕获路径不应触发全局 mock
+    expect(called).toBe(false)
+    expect(response).toBeInstanceOf(Error)
+  })
+})
diff --git a/packages/opencode/test/session/prompt.test.ts b/packages/opencode/test/session/prompt.test.ts
index 61bd0144c7..f4ac3462a1 100644
--- a/packages/opencode/test/session/prompt.test.ts
+++ b/packages/opencode/test/session/prompt.test.ts
@@ -578,6 +578,77 @@ withMcpInstructions.instance(
   15_000,
 )
 
+
+// #150：running task tool 取消必须传播到子会话 idle（异步 settle）
+// #150：tip harness 必须 user()+prompt.loop，禁止单独 prompt fiber（否则 task 不会 running）
+it.instance(
+  "cancel propagates from running task tool to child session",
+  () =>
+    Effect.gen(function* () {
+      const { llm } = yield* useServerConfig(providerCfg)
+      const prompt = yield* SessionPrompt.Service
+      const sessions = yield* Session.Service
+      const status = yield* SessionStatus.Service
+      const chat = yield* sessions.create({
+        title: "Pinned",
+        permission: [{ permission: "*", pattern: "*", action: "allow" }],
+      })
+      // #150：用 task tool 拉起真实子会话，覆盖 cancel 传播入口
+      yield* llm.tool("task", {
+        description: "inspect bug",
+        prompt: "look into the cache key path",
+        subagent_type: "general",
+      })
+      yield* llm.hang
+      yield* user(chat.id, "run a subagent")
+      // #150：fork loop fiber（与 preserves-metadata / slash-cancel 同入口）
+      const fiber = yield* prompt.loop({ sessionID: chat.id }).pipe(Effect.forkChild)
+      yield* llm.wait(1)
+
+      // #150：等到 task running 且带 child sessionId
+      const childID = yield* pollWithTimeout(
+        Effect.gen(function* () {
+          const msgs = yield* MessageV2.filterCompactedEffect(chat.id)
+          const taskMsg = msgs.find((item) => item.parts.some((part) => part.type === "tool" && part.tool === "task"))
+          const tool = taskMsg ? toolPart(taskMsg.parts) : undefined
+          if (tool?.state.status !== "running") return undefined
+          const sessionID = tool.state.metadata?.sessionId
+          if (typeof sessionID !== "string") return undefined
+          return SessionID.make(sessionID)
+        }),
+        "running task tool never exposed child session id",
+        "10 seconds",
+      )
+      // #150：先等到 child busy，再 cancel，避免未启动竞态
+      yield* pollWithTimeout(
+        Effect.gen(function* () {
+          const s = yield* status.get(childID)
+          return s.type === "busy" ? (true as const) : undefined
+        }),
+        `child ${childID} never became busy`,
+        "5 seconds",
+      )
+
+      yield* prompt.cancel(chat.id)
+      const exit = yield* Fiber.await(fiber)
+      expect(Exit.isSuccess(exit)).toBe(true)
+      // #150：父会话 cancel 后必须 idle
+      expect((yield* status.get(chat.id)).type).toBe("idle")
+      // #150：子会话 idle 需 wait/poll，禁止瞬时 get
+      yield* pollWithTimeout(
+        Effect.gen(function* () {
+          const s = yield* status.get(childID)
+          return s.type === "idle" ? (true as const) : undefined
+        }),
+        `child ${childID} never became idle after task cancel`,
+        "5 seconds",
+      )
+    }),
+  { config: cfg },
+  30_000,
+)
+
+
 it.instance("legacy prompt emits message events without session.next events", () =>
