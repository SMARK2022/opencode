+function countLines(input: string) {
+  if (!input) return 0
+  return input.split("\n").length
+}
+function previewText(input: string, maxLines: number) {
+  // #144：按行切分，不截断半行字符
+  const rows = input.split("\n")
+  if (rows.length <= maxLines) return input
+  // #144：截断时追加省略提示
+  return rows.slice(0, maxLines).join("\n") + "\n…"
+}
