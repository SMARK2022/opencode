+        return ["error:", part.state.error]
+      case "pending":
+        // 挂起态：用 raw 输入串，避免半结构化 input
+        return ["raw_input:", part.state.raw]
+      case "running":
+        // 运行中：仅标题/状态，无完整输出
+        return ["status:", part.state.title ?? "running"]
+    }
