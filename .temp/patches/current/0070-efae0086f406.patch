+/**
+ * `vscode_notebook_env` — returns a capability snapshot of the notebook runtime,
+ * including kernel info, Python/Jupyter extension states, and available commands.
+ */
+import * as vscode from "vscode"
+// 执行逻辑步骤
+import { extensionState, extensionInfo } from "../util"
+import { runtimeLabel } from "./format"
+import { resolveNotebook } from "./resolve"
+
+// ---------------------------------------------------------------------------
+// Handler
+// ---------------------------------------------------------------------------
+
+/**
+ * Bridge endpoint handler: returns kernel/environment information.
+ * Falls back gracefully when no notebook is open.
+ */
+export async function notebookEnv(filePath?: string) {
+// notebook 环境处理器：返回内核和扩展状态快照
+  const notebook = await resolveNotebook(filePath).catch(() => undefined)
+  // 环境端点容错：notebook 解析失败不报错
+  const commands = await vscode.commands.getCommands(true)
+  // 获取全部内部命令用于能力检测
+  const names = [
+  // 检测的 notebook/jupyter 相关命令列表
+    "notebook.cell.execute",
+    "notebook.execute",
+    "notebook.selectKernel",
+    "notebook.kernel.restart",
+    "jupyter.selectKernel",
+    // 执行逻辑步骤
+    "jupyter.restartkernel",
+    "python.setInterpreter",
+  ]
+  return {
+  // 返回 ran/summary/data/note 四段式响应
+    ran: false,
+    summary: `Notebook runtime: ${notebook ? (runtimeLabel(notebook) ?? "unknown") : "unknown"}; Python/Jupyter extensions: ${extensionState("ms-python.python")}/${extensionState("ms-toolsai.jupyter")}.`,
+    data: {
+      path: notebook?.uri.fsPath || notebook?.uri.toString(),
+      runtime: notebook ? runtimeLabel(notebook) : null,
+      // 执行逻辑步骤
+      active_notebook: vscode.window.activeNotebookEditor?.notebook.uri.toString(),
+      extensions: {
+        python: extensionInfo("ms-python.python"),
+        jupyter: extensionInfo("ms-toolsai.jupyter"),
+      },
+      // 执行逻辑步骤
+      commands: Object.fromEntries(names.map((name) => [name, commands.includes(name)])),
+    },
+    note: "Native public VS Code API does not expose full Jupyter kernel/package details; bridge can fallback to extension commands/tools when needed.",
+  }
+}
diff --git a/sdks/vscode/src/notebook/format.ts b/sdks/vscode/src/notebook/format.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0a32be47bd06e01c4c4a003b32415fe1fdab2946
--- /dev/null
+++ b/sdks/vscode/src/notebook/format.ts
@@ -0,0 +1,321 @@
+/**
+ * Notebook cell formatting, metadata extraction, and summary serialization.
+ *
+ * Provides compact cell representations, execution state text, MIME helpers,
+ * artifact summary formatting, and runtime/kernel label extraction.
+ * These are shared across all notebook handler modules.
+ */
+import * as vscode from "vscode"
+// 执行逻辑步骤
+import {
+  isRecord,
+  stringProp,
+  numberProp,
+  nestedStringAt,
+  // 执行逻辑步骤
+  firstString,
+  previewText,
+  formatBytes,
+  quoteForSummary,
+} from "../util"
+// 执行逻辑步骤
+
+// ---------------------------------------------------------------------------
+// MIME type helpers
+// ---------------------------------------------------------------------------
+
+/** Abbreviates a full MIME type into a short label for summary display. */
+export function shortMime(mime: string) {
+// 将完整 MIME 类型缩写为短标签
+  if (mime === "application/vnd.code.notebook.stdout") return "stdout"
+  // stdout MIME 缩写
+  if (mime === "application/vnd.code.notebook.stderr") return "stderr"
+  // stderr MIME 缩写
+  if (mime === "application/vnd.code.notebook.error") return "error"
+  // error MIME 缩写
+  if (mime === "image/png") return "png"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "image/jpeg") return "jpeg"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "text/plain") return "text"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "text/html") return "html"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "text/markdown") return "markdown"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "application/json") return "json"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime.includes("datawrangler")) return "datawrangler"
+  // 条件分支：按业务逻辑分流处理
+  return mime.split("/").pop() ?? mime
+  // 返回结果给调用方
+}
+
+/** Maps a MIME type to an appropriate file extension for artifact output files. */
+export function extensionForMime(mime: string) {
+// MIME 到文件扩展名映射
+  if (mime === "image/png") return ".png"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "image/jpeg") return ".jpg"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "image/svg+xml") return ".svg"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "text/html") return ".html"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime === "application/json") return ".json"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (mime.startsWith("text/")) return ".txt"
+  // 条件分支：按业务逻辑分流处理
+  return ".bin"
+  // 返回结果给调用方
+}
+
+/** Returns true if the MIME type carries text content that can be inlined in summaries. */
+export function isTextLikeMime(mime: string) {
+// 判断 MIME 是否为文本类
+  return (
+  // 返回结果给调用方
+    mime.startsWith("text/") ||
+    mime === "application/json" ||
+    mime === "application/vnd.code.notebook.stdout" ||
+    mime === "application/vnd.code.notebook.stderr" ||
+    mime === "application/vnd.code.notebook.error" ||
+    // 执行逻辑步骤
+    shortMime(mime) === "datawrangler"
+  )
+}
+
+// ---------------------------------------------------------------------------
+// Cell identity & metadata
+// ---------------------------------------------------------------------------
+
+/** Truncates a cell identifier to its first 8 chars, stripping the `#VSC-` / `#` prefix. */
+export function shortId(id: string) {
+// 截取标识符前 8 字符
+  return id.replace(/^#?VSC-/, "").replace(/^#/, "").slice(0, 8)
+  // 返回结果给调用方
+}
+
+/** Gathers all possible identifiers for a notebook cell (fragment, metadata id, etc.). */
+export function cellIdentifiers(cell: vscode.NotebookCell) {
+// 收集单元格全部标识符
+  return [
+  // 返回结果给调用方
+    cell.document.uri.fragment,
+    stringProp(cell.metadata, "id"),
+    stringProp(cell.metadata, "cellId"),
+    nestedStringAt(cell.metadata, "vscode", "cellId"),
+    nestedStringAt(cell.metadata, "custom", "id"),
+    // 执行逻辑步骤
+  ].filter((value): value is string => !!value)
+}
+
+/** Returns "markdown" or "code" for a cell kind enum value. */
+export function cellKindLabel(kind: vscode.NotebookCellKind) {
+// NotebookCellKind 转可读标签
+  return kind === vscode.NotebookCellKind.Markup ? "markdown" : "code"
+  // 返回结果给调用方
+}
+
+/** Returns de-duplicated short MIME labels for all output items on a cell. */
+export function existingOuts(cell: vscode.NotebookCell) {
+// 单元格输出 MIME 去重列表
+  return [...new Set(cell.outputs.flatMap((cellOutput) => cellOutput.items.map((item) => shortMime(item.mime))))]
+  // 返回结果给调用方
+}
+
+// ---------------------------------------------------------------------------
+// Execution state
+// ---------------------------------------------------------------------------
+
+/**
+ * Builds a compact, human-readable execution status string for a cell.
+ * Format: `<state> #<order> <status> <duration> ended=<ISO timestamp>`
+ */
+export function executionText(cell: vscode.NotebookCell) {
+// 构建执行状态文本
+  const summary = cell.executionSummary
+  // 定义 summary：保存关键中间值或配置
+  if (!summary?.executionOrder && !summary?.timing) {
+  // 无执行信息判断为未运行
+    if (cell.outputs.length === 0) return "not-run"
+    // 无输出 = 纯未运行
+    const saved = savedExecution(cell)
+    // 定义 saved：保存关键中间值或配置
+    return `not-run but-saved-output #${saved.order} ${saved.status}${saved.duration}${saved.ended}`
+    // 返回结果给调用方
+  }
+  const state = summary.timing ? "current-run" : "session-state"
+  // 有 timing = 本次会话执行
+  const status =
+    summary.success === false
+      ? "failed"
+      : summary.success === true || cell.outputs.length > 0
+        ? "succeeded"
+        // 执行逻辑步骤
+        : "unknown-status"
+  const order = summary.executionOrder ?? "?"
+  // 定义 order：保存关键中间值或配置
+  const duration = summary.timing ? ` ${Math.max(0, summary.timing.endTime - summary.timing.startTime)}ms` : " ?ms"
+  // 定义 duration：保存关键中间值或配置
+  const ended = summary.timing ? ` ended=${new Date(summary.timing.endTime).toISOString()}` : " ended=?"
+  // 定义 ended：保存关键中间值或配置
+  return `${state} #${order} ${status}${duration}${ended}`
+  // 返回结果给调用方
+}
+
+/**
+ * Reconstructs execution metadata from saved cell/output metadata.
+ * Used when `executionSummary` is unavailable but the cell has persisted outputs.
+ */
+function savedExecution(cell: vscode.NotebookCell) {
+// 从元数据重建执行信息
+  const outputMetadata = cell.outputs.map((output) => output.metadata).filter(isRecord)
+  // 收集输出元数据
+  const endedRaw = firstString(
+  // 定义 endedRaw：保存关键中间值或配置
+    stringProp(cell.metadata, "execution_end_time"),
+    stringProp(cell.metadata, "end_time"),
+    ...outputMetadata.flatMap((metadata) => [
+      stringProp(metadata, "execution_end_time"),
+      stringProp(metadata, "end_time"),
+      // 执行逻辑步骤
+      stringProp(metadata, "timestamp"),
+    ]),
+  )
+  const startedRaw = firstString(
+  // 定义 startedRaw：保存关键中间值或配置
+    stringProp(cell.metadata, "execution_start_time"),
+    stringProp(cell.metadata, "start_time"),
+    ...outputMetadata.flatMap((metadata) => [
+      stringProp(metadata, "execution_start_time"),
+      stringProp(metadata, "start_time"),
+      // 执行逻辑步骤
+    ]),
+  )
+  return {
+  // 返回结果给调用方
+    order: numberProp(cell.metadata, "execution_count") ?? "?",
+    status: existingOuts(cell).includes("error") ? "failed" : "succeeded",
+    duration: durationText(startedRaw, endedRaw),
+    ended: endedRaw ? ` ended=${formatDate(endedRaw)}` : " ended=?",
+  }
+}
+
+function durationText(startedRaw?: string, endedRaw?: string) {
+// 计算耗时
+  if (!startedRaw || !endedRaw) return " ?ms"
+  // 前置校验：排除非法输入或空值情况
+  const started = Date.parse(startedRaw)
+  // 定义 started：保存关键中间值或配置
+  const ended = Date.parse(endedRaw)
+  // 定义 ended：保存关键中间值或配置
+  if (!Number.isFinite(started) || !Number.isFinite(ended)) return " ?ms"
+  // 前置校验：排除非法输入或空值情况
+  return ` ${Math.max(0, ended - started)}ms`
+  // 返回结果给调用方
+}
+
+function formatDate(input: string) {
+// 格式化时间戳为 ISO 字符串
+  const value = Date.parse(input)
+  // 定义 value：保存关键中间值或配置
+  return Number.isFinite(value) ? new Date(value).toISOString() : input
+  // 返回结果给调用方
+}
+
+// ---------------------------------------------------------------------------
+// Notebook metadata
+// ---------------------------------------------------------------------------
+
+/** Extracts a kernel/runtime display label from notebook-level metadata. */
+export function runtimeLabel(notebook: vscode.NotebookDocument) {
+// 从元数据提取内核/语言标签
+  const kernelspec = isRecord(notebook.metadata.kernelspec) ? notebook.metadata.kernelspec : undefined
+  // 安全提取 kernelspec
+  const language = isRecord(notebook.metadata.language_info) ? notebook.metadata.language_info : undefined
+  // 定义 language：保存关键中间值或配置
+  const kernelName = stringProp(kernelspec ?? {}, "display_name") ?? stringProp(kernelspec ?? {}, "name")
+  // 定义 kernelName：保存关键中间值或配置
+  const languageName = stringProp(language ?? {}, "name")
+  // 定义 languageName：保存关键中间值或配置
+  const languageVersion = stringProp(language ?? {}, "version")
+  // 定义 languageVersion：保存关键中间值或配置
+  if (kernelName && languageName && languageVersion) return `${kernelName} (${languageName} ${languageVersion})`
+  // 条件分支：按业务逻辑分流处理
+  if (kernelName) return kernelName
+  // 条件分支：按业务逻辑分流处理
+  if (languageName && languageVersion) return `${languageName} ${languageVersion}`
+  // 条件分支：按业务逻辑分流处理
+  return languageName ?? null
+  // 返回结果给调用方
+}
+
+// ---------------------------------------------------------------------------
+// Compact cell representation
+// ---------------------------------------------------------------------------
+
+/** Builds a compact summary object for a single cell (used in summary / run / output responses). */
+export function compactCell(cell: vscode.NotebookCell) {
+// 构建单元格摘要对象
+  return {
+  // 返回结果给调用方
+    i: cell.index,
+    id: shortId(cellIdentifiers(cell)[0] ?? `cell-${cell.index}`),
+    kind: cell.kind === vscode.NotebookCellKind.Code ? "code" : "markdown",
+    lang: cell.document.languageId,
+    lines: cell.document.lineCount,
+    // 执行逻辑步骤
+    exec: executionText(cell),
+    existing_outs: existingOuts(cell),
+    first: previewText((cell.document.getText().split("\n")[0] ?? "").trim()).slice(0, 120),
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Artifact summary formatting
+// ---------------------------------------------------------------------------
+
+/** Extracts just the filename from a full artifact path. */
+function artifactName(p: string) {
+// 从路径提取文件名
+  return p.replace(/\\/g, "/").split("/").pop() ?? p
+  // 返回结果给调用方
+}
+
+/**
+ * Formats a single output artifact for inclusion in the LLM summary text.
+ *
+ * - Short text-like content (≤1024 chars) is inlined via `<content>` tags or `JSON.stringify`.
+ * - Large text shows a 1024-char preview plus a pointer to the artifact file.
+ * - Binary content (images, etc.) only references the artifact file path.
+ */
+export function formatArtifactSummary(a: any, cellIndex?: number) {
+// 格式化 artifact 摘要
+  const prefix = cellIndex !== undefined ? `c${cellIndex} ` : ""
+  // 定义 prefix：保存关键中间值或配置
+  const baseInfo = `${prefix}output=${a.output} item=${a.item} ${shortMime(a.mime)} ${formatBytes(a.bytes)}`
+  // 定义 baseInfo：保存关键中间值或配置
+
+  if (isTextLikeMime(a.mime) && a.text !== undefined && a.text.length <= 1024) {
+  // 短文本内联展示
+    if (a.text.includes("\n")) {
+    // 条件分支：按业务逻辑分流处理
+      return `${baseInfo}\n<content>\n${a.text}\n</content>`
+      // 返回结果给调用方
+    }
+    return `${baseInfo} ${JSON.stringify(a.text)}`
+    // 返回结果给调用方
+  }
+
+  if (isTextLikeMime(a.mime)) {
+  // 长文本截断并指向 artifact
+    const content = a.text !== undefined ? a.text.slice(0, 1024) : a.preview
+    // 定义 content：保存关键中间值或配置
+    return `${baseInfo} -> ${artifactName(a.artifactPath)}\n<content>\n${content}\n... (truncated, full output in the file)\n</content>`
+    // 返回结果给调用方
+  }
+
+  return `${baseInfo} -> ${artifactName(a.artifactPath)}${a.preview ? ` ${quoteForSummary(a.preview)}` : ""}`
+  // 返回结果给调用方
+}
diff --git a/sdks/vscode/src/notebook/output.ts b/sdks/vscode/src/notebook/output.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4f9373acd6c728a10ed7ba6b0ce2b88f3a80746d
--- /dev/null
+++ b/sdks/vscode/src/notebook/output.ts
@@ -0,0 +1,175 @@
+/**
+ * `vscode_notebook_output` — reads cell outputs, writes them to artifact files
+ * under `.opencode/cache/notebook-outputs/`, and returns a summary pointing
+ * to the artifact paths. Short text outputs are inlined in the summary.
+ */
+import * as vscode from "vscode"
+// 执行逻辑步骤
+import * as path from "node:path"
+import { previewText } from "../util"
+import {
+  existingOuts,
+  compactCell,
+  // 执行逻辑步骤
+  runtimeLabel,
+  shortMime,
+  isTextLikeMime,
+  extensionForMime,
+  formatArtifactSummary,
+  // 执行逻辑步骤
+} from "./format"
+import { resolveNotebook, resolveNotebookCell } from "./resolve"
+
+// ---------------------------------------------------------------------------
+// Handler
+// ---------------------------------------------------------------------------
+
+/** Bridge endpoint handler: reads and serializes all outputs for a specific cell. */
+export async function readNotebookCellOutput(filePath?: string, cellIndex?: number, cellId?: string) {
+// notebook 输出处理器：读取并序列化单元格输出
+  const notebook = await resolveNotebook(filePath)
+  // 定义 notebook：保存关键中间值或配置
+  const cell = resolveNotebookCell(notebook, cellIndex, cellId)
+  // 定义 cell：保存关键中间值或配置
+  return await serializeNotebookCellOutput(notebook, cell)
+  // 返回结果给调用方
+}
+
+// ---------------------------------------------------------------------------
+// Output serialization
+// ---------------------------------------------------------------------------
+
+async function serializeNotebookCellOutput(notebook: vscode.NotebookDocument, cell: vscode.NotebookCell) {
+// 序列化全部输出为 artifact 列表
+  const artifacts = (
+  // 并行序列化所有输出 item
+    await Promise.all(
+    // 并行等待全部异步操作完成
+      cell.outputs.flatMap((cellOutput, outputIndex) =>
+        cellOutput.items.map((item, itemIndex) =>
+          serializeNotebookOutputItem(notebook, cell, item, outputIndex, itemIndex),
+        ),
+      ),
+      // 执行逻辑步骤
+    )
+  ).flat()
+
+  const summaryLines = [
+  // 定义 summaryLines：保存关键中间值或配置
+    `Cell ${cell.index} existing outputs: ${existingOuts(cell).join(", ") || "none"}.`,
+    `ArtifactsRoot: .opencode/cache/notebook-outputs/`,
+    "",
+    "Artifacts:",
+    ...artifacts.map((a) => formatArtifactSummary(a)),
+    // 执行逻辑步骤
+  ].join("\n")
+
+  return {
+  // 返回结果给调用方
+    ran: false,
+    summary: summaryLines,
+    data: {
+      path: notebook.uri.fsPath || notebook.uri.toString(),
+      dirty: notebook.isDirty,
+      // 执行逻辑步骤
+      runtime: runtimeLabel(notebook),
+      cell: compactCell(cell),
+      artifacts,
+    },
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Single output item
+// ---------------------------------------------------------------------------
+
+/**
+ * Serializes a single output item: writes the raw data to an artifact file
+ * and returns metadata + optional text content for inline display.
+ * Exported so that `run.ts` can reuse it for per-cell run results.
+ */
+export async function serializeNotebookOutputItem(
+// 序列化单个输出 item
+  notebook: vscode.NotebookDocument,
+  cell: vscode.NotebookCell,
+  item: vscode.NotebookCellOutputItem,
+  outputIndex: number,
+  itemIndex: number,
+  // 执行逻辑步骤
+) {
+  const text = outputItemText(item)
+  // 文本类 MIME 尝试解码
+  const artifact = await writeArtifact(notebook, cell, item, outputIndex, itemIndex)
+  // 定义 artifact：保存关键中间值或配置
+  return {
+  // 返回结果给调用方
+    output: outputIndex,
+    item: itemIndex,
+    mime: item.mime,
+    bytes: item.data.byteLength,
+    preview: previewText(text ?? `<${item.mime} ${item.data.byteLength} bytes>`),
+    // 执行逻辑步骤
+    text: text && item.data.byteLength <= 8_192 ? text : undefined,
+    artifactPath: artifact.fsPath,
+  }
+}
+
+/** Attempts to decode an output item as UTF-8 text for text-like MIME types. */
+function outputItemText(item: vscode.NotebookCellOutputItem) {
+// 文本类 MIME UTF-8 解码
+  if (isTextLikeMime(item.mime)) {
+  // 条件分支：按业务逻辑分流处理
+    return Buffer.from(item.data).toString("utf8")
+    // 返回结果给调用方
+  }
+  return undefined
+  // 返回 undefined 表示无结果或用户取消
+}
+
+// ---------------------------------------------------------------------------
+// Artifact writing
+// ---------------------------------------------------------------------------
+
+/**
+ * Writes a single output item's raw data to a file under
+ * `.opencode/cache/notebook-outputs/` in the workspace folder.
+ */
+async function writeArtifact(
+// 写入 artifact 文件
+  notebook: vscode.NotebookDocument,
+  cell: vscode.NotebookCell,
+  item: vscode.NotebookCellOutputItem,
+  outputIndex: number,
+  itemIndex: number,
+  // 执行逻辑步骤
+) {
+  const root = artifactRoot(notebook)
+  // 获取 artifact 根目录
+  await vscode.workspace.fs.createDirectory(root)
+  // 异步调用 VS Code API
+  const filename =
+  // 构造 artifact 文件名
+    [
+      path.basename(notebook.uri.fsPath || "untitled", path.extname(notebook.uri.fsPath || "untitled")),
+      `cell-${cell.index}`,
+      `output-${outputIndex}`,
+      `item-${itemIndex}`,
+      // 执行逻辑步骤
+    ].join("-") + extensionForMime(item.mime)
+  const uri = vscode.Uri.joinPath(root, filename)
+  // 定义 uri：保存关键中间值或配置
+  await vscode.workspace.fs.writeFile(uri, item.data)
+  // 异步调用 VS Code API
+  return { uri, fsPath: uri.fsPath || uri.toString() }
+  // 返回结果给调用方
+}
+
+function artifactRoot(notebook: vscode.NotebookDocument) {
+// artifact 根目录：.opencode/cache/notebook-outputs/
+  const folder = vscode.workspace.getWorkspaceFolder(notebook.uri) ?? vscode.workspace.workspaceFolders?.[0]
+  // 定义 folder：保存关键中间值或配置
+  if (!folder) throw new Error("Notebook output artifacts require an open workspace folder")
+  // 无工作区文件夹时无法写 artifact
+  return vscode.Uri.joinPath(folder.uri, ".opencode", "cache", "notebook-outputs")
+  // 返回结果给调用方
+}
diff --git a/sdks/vscode/src/notebook/resolve.ts b/sdks/vscode/src/notebook/resolve.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d79059e6e31d8b7f4b0f5522026cbeb83a44df07
--- /dev/null
+++ b/sdks/vscode/src/notebook/resolve.ts
@@ -0,0 +1,110 @@
+/**
+ * Notebook and cell resolution — locating open notebooks and cells by path, index, or ID.
+ */
+import * as vscode from "vscode"
+import { stringProp, numberProp, uriFromInput } from "../util"
+// 执行逻辑步骤
+import { cellIdentifiers } from "./format"
+
+// ---------------------------------------------------------------------------
+// Notebook resolution
+// ---------------------------------------------------------------------------
+
+/**
+ * Resolves a notebook document from a file path, URI string, or falls back
+ * to the active/first-open notebook. Throws if nothing can be found.
+ */
+export async function resolveNotebook(filePath?: string) {
+// 解析 notebook：按路径匹配或回退到活动文档
+  if (!filePath) {
+  // 无 filePath 时回退到活动或首个 notebook
+    const active = vscode.window.activeNotebookEditor?.notebook
+    // 定义 active：保存关键中间值或配置
+    if (active) return active
+    // 条件分支：按业务逻辑分流处理
+    if (vscode.workspace.notebookDocuments.length > 0) return vscode.workspace.notebookDocuments[0]
+    // 条件分支：按业务逻辑分流处理
+    throw new Error("No active or open notebook document")
+    // 抛出异常：中断执行并让调用方处理错误
+  }
+
+  const existing = vscode.workspace.notebookDocuments.find(
+  // 按 fsPath 或 toString 匹配
+    (notebook) => notebook.uri.fsPath === filePath || notebook.uri.toString() === filePath,
+  )
+  if (existing) return existing
+  // 条件分支：按业务逻辑分流处理
+
+  return await vscode.workspace.openNotebookDocument(uriFromInput(filePath))
+  // 返回结果给调用方
+}
+
+// ---------------------------------------------------------------------------
+// Cell resolution
+// ---------------------------------------------------------------------------
+
+/**
+ * Resolves a single cell inside a notebook by index, cell ID, or falls back
+ * to the active editor's selection / cell 0.
+ */
+export function resolveNotebookCell(notebook: vscode.NotebookDocument, cellIndex?: number, cellId?: string) {
+// 解析单元格：index > id > 活动选区 > 首个
+  if (cellIndex !== undefined) return notebook.cellAt(cellIndex)
+  // 有 index 直接取
+
+  if (cellId) {
+  // 有 id 按稳定标识符匹配
+    const normalized = cellId.replace(/^#/, "")
+    // 定义 normalized：保存关键中间值或配置
+    const cell = notebook
+    // 定义 cell：保存关键中间值或配置
+      .getCells()
+      .find((candidate) => cellIdentifiers(candidate).some((id) => id.replace(/^#/, "") === normalized))
+    if (cell) return cell
+    // 条件分支：按业务逻辑分流处理
+    throw new Error(`Notebook cell not found: ${cellId}`)
+    // 抛出异常：中断执行并让调用方处理错误
+  }
+
+  const active = vscode.window.activeNotebookEditor
+  // 定义 active：保存关键中间值或配置
+  if (active?.notebook.uri.toString() === notebook.uri.toString()) {
+  // 条件分支：精确匹配检查确保类型和值安全
+    const range = active.selection
+    // 定义 range：保存关键中间值或配置
+    if (range && !range.isEmpty) return notebook.cellAt(range.start)
+    // 前置校验：排除非法输入或空值情况
+  }
+
+  return notebook.cellAt(0)
+  // 返回结果给调用方
+}
+
+// ---------------------------------------------------------------------------
+// Range construction
+// ---------------------------------------------------------------------------
+
+/**
+ * Converts a target descriptor (`{ type: "all"|"range"|"cell", ... }`) into
+ * a `vscode.NotebookRange`. Used by `runNotebook` to select which cells to execute.
+ */
+export function notebookRange(notebook: vscode.NotebookDocument, target: Record<string, unknown>, fallbackCellIndex?: number) {
+// 目标描述符转 NotebookRange
+  const type = stringProp(target, "type") ?? "cell"
+  // 定义 type：保存关键中间值或配置
+  if (type === "all") return new vscode.NotebookRange(0, notebook.cellCount)
+  // all 模式覆盖全部
+  if (type === "range") {
+  // range 模式按 start/end
+    const start = Math.max(0, numberProp(target, "start") ?? 0)
+    // 定义 start：保存关键中间值或配置
+    const end = Math.min(notebook.cellCount, numberProp(target, "end") ?? start + 1)
+    // 定义 end：保存关键中间值或配置
+    return new vscode.NotebookRange(start, Math.max(start + 1, end))
+    // 返回结果给调用方
+  }
+  const index = Math.max(0, Math.min(notebook.cellCount - 1, numberProp(target, "cellIndex") ?? fallbackCellIndex ?? 0))
+  // 定义 index：保存关键中间值或配置
+  return new vscode.NotebookRange(index, index + 1)
+  // 返回结果给调用方
+}
diff --git a/sdks/vscode/src/notebook/run.ts b/sdks/vscode/src/notebook/run.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ef54dbca6434620e62280184ce1208bfd5c249bd
--- /dev/null
+++ b/sdks/vscode/src/notebook/run.ts
@@ -0,0 +1,199 @@
+/**
+ * `vscode_notebook_run` — executes one cell, a range of cells, or all cells
+ * via the native VS Code `notebook.cell.execute` command, waits for completion,
+ * and returns per-cell execution results with artifact-first output.
+ */
+import * as vscode from "vscode"
+// 执行逻辑步骤
+import { isRecord, stringProp, numberProp, toPosixPath, quoteForSummary, formatBytes } from "../util"
+import {
+  shortId,
+  cellIdentifiers,
+  shortMime,
+  // 执行逻辑步骤
+  existingOuts,
+  executionText,
+  runtimeLabel,
+  formatArtifactSummary,
+} from "./format"
+// 执行逻辑步骤
+import { resolveNotebook, notebookRange } from "./resolve"
+import { serializeNotebookOutputItem } from "./output"
+
+// ---------------------------------------------------------------------------
+// Handler
+// ---------------------------------------------------------------------------
+
+/**
+ * Bridge endpoint handler: runs notebook cells and returns execution results.
+ * Accepts `target: { type: "all"|"range"|"cell", ... }` and optional `timeoutMs`.
+ */
+export async function runNotebook(input: Record<string, unknown>) {
+// notebook 执行处理器：运行单元格并等待完成
+  const notebook = await resolveNotebook(stringProp(input, "filePath"))
+  // 定义 notebook：保存关键中间值或配置
+  const target = isRecord(input.target) ? input.target : {}
+  // target 必须是对象
+  const range = notebookRange(notebook, target, typeof input.cellIndex === "number" ? input.cellIndex : undefined)
+  // 转 NotebookRange
+  const editor = await vscode.window.showNotebookDocument(notebook, { selections: [range] })
+  // 定义 editor：保存关键中间值或配置
+  editor.selection = range
+  editor.revealRange(range)
+
+  const commands = await vscode.commands.getCommands(true)
+  // 定义 commands：保存关键中间值或配置
+  if (!commands.includes("notebook.cell.execute")) {
+  // 检查原生执行命令可用性
+    throw new Error("VS Code command notebook.cell.execute is not available")
+    // 抛出异常：中断执行并让调用方处理错误
+  }
+
+  const startedAt = Date.now()
+  // 记录开始时间用于轮询
+  await vscode.commands.executeCommand("notebook.cell.execute")
+  // 异步调用 VS Code API
+  const completed = await waitForExecution(notebook, range, startedAt, numberProp(input, "timeoutMs") ?? 60_000)
+  // 等待执行完成或超时
+  return await compactRunResult(notebook, range, completed)
+  // 返回结果给调用方
+}
+
+// ---------------------------------------------------------------------------
+// Result builders
+// ---------------------------------------------------------------------------
+
+async function compactRunResult(notebook: vscode.NotebookDocument, range: vscode.NotebookRange, completed: boolean) {
+// 构建执行结果响应
+  const cells = await Promise.all(notebook.getCells(range).map((cell) => compactRunCell(notebook, cell)))
+  // 定义 cells：保存关键中间值或配置
+  return {
+  // 返回结果给调用方
+    ran: true,
+    summary: runSummaryText(notebook, range, completed, cells),
+    data: {
+      path: notebook.uri.fsPath || notebook.uri.toString(),
+      dirty: notebook.isDirty,
+      // 执行逻辑步骤
+      runtime: runtimeLabel(notebook),
+      target: runTarget(range, notebook.cellCount),
+      completed,
+      cells,
+    },
+    // 执行逻辑步骤
+  }
+}
+
+async function compactRunCell(notebook: vscode.NotebookDocument, cell: vscode.NotebookCell) {
+// 构建单个单元格执行结果
+  return {
+  // 返回结果给调用方
+    i: cell.index,
+    id: shortId(cellIdentifiers(cell)[0] ?? `cell-${cell.index}`),
+    exec: executionText(cell),
+    existing_outs: existingOuts(cell),
+    artifacts: await Promise.all(
+    // 执行逻辑步骤
+      cell.outputs.flatMap((cellOutput, outputIndex) =>
+        cellOutput.items.map((item, itemIndex) =>
+          serializeNotebookOutputItem(notebook, cell, item, outputIndex, itemIndex),
+        ),
+      ),
+      // 执行逻辑步骤
+    ),
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Summary text
+// ---------------------------------------------------------------------------
+
+function runSummaryText(
+// 生成执行摘要文本
+  notebook: vscode.NotebookDocument,
+  range: vscode.NotebookRange,
+  completed: boolean,
+  cells: Array<Awaited<ReturnType<typeof compactRunCell>>>,
+) {
+// 执行逻辑步骤
+  const artifactRoot = ".opencode/cache/notebook-outputs/"
+  // 定义 artifactRoot：保存关键中间值或配置
+  return [
+  // 返回结果给调用方
+    `Notebook: ${toPosixPath(notebook.uri.fsPath || notebook.uri.toString())}`,
+    `Run: target=${runTarget(range, notebook.cellCount)} completed=${completed} dirty=${notebook.isDirty} runtime=${runtimeLabel(notebook) ?? "unknown"}`,
+    `ArtifactsRoot: ${artifactRoot}`,
+    "",
+    "Cells:",
+    // 执行逻辑步骤
+    ...cells.map(
+      (c) =>
+        `c${c.i} id=${c.id} exec=${quoteForSummary(c.exec)} outs=${quoteForSummary(c.existing_outs.join(",") || "none")}`,
+    ),
+    "",
+    // 执行逻辑步骤
+    "Artifacts:",
+    ...cells.flatMap((c) => c.artifacts.map((a) => formatArtifactSummary(a, c.i))),
+  ].join("\n")
+}
+
+function runTarget(range: vscode.NotebookRange, cellCount: number) {
+// NotebookRange 转可读目标描述
+  if (range.start === 0 && range.end === cellCount) return "all"
+  // 条件分支：精确匹配检查确保类型和值安全
+  if (range.end === range.start + 1) return `cell ${range.start}`
+  // 条件分支：精确匹配检查确保类型和值安全
+  return `range ${range.start}-${range.end - 1}`
+  // 返回结果给调用方
+}
+
+// ---------------------------------------------------------------------------
+// Execution polling
+// ---------------------------------------------------------------------------
+
+/**
+ * Waits for all code cells in the given range to finish executing
+ * by watching `executionSummary.timing.endTime`. Returns `false` on timeout.
+ */
+async function waitForExecution(
+// 轮询等待执行完成
+  notebook: vscode.NotebookDocument,
+  range: vscode.NotebookRange,
+  startedAt: number,
+  timeoutMs: number,
+) {
+// 执行逻辑步骤
+  const done = () =>
+  // 完成判定：所有 code 单元格有新 endTime
+    notebook
+      .getCells(range)
+      .filter((cell) => cell.kind === vscode.NotebookCellKind.Code)
+      .every((cell) => {
+        const timing = cell.executionSummary?.timing
+        // 定义 timing：保存关键中间值或配置
+        return timing?.endTime !== undefined && timing.endTime >= startedAt
+        // 返回 undefined 表示无结果或用户取消
+      })
+
+  if (done()) return true
+  // 首次检查即完成
+
+  return await new Promise<boolean>((resolve) => {
+  // 返回结果给调用方
+    const timer = setTimeout(() => {
+    // 超时定时器
+      subscription.dispose()
+      resolve(false)
+    }, timeoutMs)
+    const subscription = vscode.workspace.onDidChangeNotebookDocument((event) => {
+    // 监听 notebook 变化
+      if (event.notebook.uri.toString() !== notebook.uri.toString()) return
+      // 条件分支：精确匹配检查确保类型和值安全
+      if (!done()) return
+      // 前置校验：排除非法输入或空值情况
+      clearTimeout(timer)
+      subscription.dispose()
+      resolve(true)
+    })
+  })
+}
diff --git a/sdks/vscode/src/notebook/source.ts b/sdks/vscode/src/notebook/source.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a5560d1ad560c2e112a9f77acd56e574fbf71daf
--- /dev/null
+++ b/sdks/vscode/src/notebook/source.ts
@@ -0,0 +1,184 @@
+/**
+ * `vscode_notebook_source` — reads cell source code as a flat virtual text document
+ * with 1-based global line numbering and offset/limit pagination.
+ *
+ * The virtual document format uses `--- cN kind/lang id=... lines=... ---` separators
+ * between cells so that line numbers are stable across the entire notebook.
+ */
+import * as vscode from "vscode"
+// 执行逻辑步骤
+import { stringProp, numberProp } from "../util"
+import { shortId, cellIdentifiers, cellKindLabel } from "./format"
+import { resolveNotebook } from "./resolve"
+
+// ---------------------------------------------------------------------------
+// Handler
+// ---------------------------------------------------------------------------
+
+/**
+ * Bridge endpoint handler: returns notebook source code with global line numbering.
+ * Supports `cellIndex` to focus on one cell, and `offset`/`limit` for pagination.
+ * Output is capped at 12 KB and 1000 lines per request.
+ */
+export async function notebookSource(input: Record<string, unknown>) {
+// notebook 源码处理器：返回虚拟行号文本
+  const notebook = await resolveNotebook(stringProp(input, "filePath"))
+  // 定义 notebook：保存关键中间值或配置
+  const limit = Math.max(1, Math.min(numberProp(input, "limit") ?? 1000, 1000))
+  // limit 限制 1–1000 行
+  const offset = Math.max(1, numberProp(input, "offset") ?? 1)
+  // 定义 offset：保存关键中间值或配置
+
+  const { lines, cellRanges } = buildVirtualLines(notebook)
+  // 构建虚拟行和单元格范围
+  const targetCellIndex = typeof input.cellIndex === "number" ? input.cellIndex : undefined
+  // 定义 targetCellIndex：保存关键中间值或配置
+
+  let globalStart = 1
+  let globalEnd = lines.length
+  let warning = ""
+
+  // When a specific cell is targeted, constrain the window to that cell's range
+  if (targetCellIndex !== undefined && cellRanges.has(targetCellIndex)) {
+  // 指定单元格时约束窗口
+    const range = cellRanges.get(targetCellIndex)!
+    // 定义 range：保存关键中间值或配置
+    if (input.offset !== undefined) {
+    // 有 offset 时校验
+      if (offset >= range.start && offset <= range.end) {
+      // offset 在范围内直接用
+        globalStart = offset
+      } else if (range.start + offset - 1 >= range.start && range.start + offset - 1 <= range.end) {
+        globalStart = range.start + offset - 1
+      } else {
+        globalStart = range.start
+        // 执行逻辑步骤
+        warning =
+          "WARNING: Offset out of bounds for the specified cell! ALWAYS use GLOBAL document line numbers. Offset reset to default."
+      }
+    } else {
+      globalStart = range.start
+      // 执行逻辑步骤
+    }
+    globalEnd = range.end
+  } else {
+    if (input.offset !== undefined) {
+    // 有 offset 时校验
+      globalStart = offset
+    }
+  }
+
+  globalStart = Math.max(1, Math.min(globalStart, lines.length > 0 ? lines.length : 1))
+  // 执行逻辑步骤
+
+  // Stream lines until the byte budget (12 KB) or line limit is reached
+  const maxBytes = 12 * 1024
+  // 字节上限 12 KB
+  let bytes = 0
+  let cut = false
+  const returnedLines: string[] = []
+  let currentLineIndex = globalStart - 1
+
+  while (currentLineIndex < globalEnd && currentLineIndex < lines.length && returnedLines.length < limit) {
+  // 逐行收集到上限
+    const line = lines[currentLineIndex]
+    // 定义 line：保存关键中间值或配置
+    const lineBytes = Buffer.byteLength(line, "utf8")
+    // 定义 lineBytes：保存关键中间值或配置
+    if (bytes + lineBytes > maxBytes && returnedLines.length > 0) {
+    // 超字节上限截断
+      cut = true
+      break
+    }
+    returnedLines.push(`${currentLineIndex + 1}: ${line}`)
+    // 返回结果给调用方
+    bytes += lineBytes
+    currentLineIndex++
+  }
+
+  const more = currentLineIndex < globalEnd && currentLineIndex < lines.length
+  // 判断是否还有更多行
+
+  // Assemble output in the same format as the opencode `read` tool
+  let output = warning ? `${warning}\n\n` : ""
+  output +=
+    [`<path>${notebook.uri.fsPath || notebook.uri.toString()}</path>`, `<type>notebook</type>`, "<content>"].join(
+    // 执行逻辑步骤
+      "\n",
+    ) + "\n"
+  output += returnedLines.join("\n")
+
+  if (cut) {
+  // 条件分支：按业务逻辑分流处理
+    output += `\n\n(Output capped at 12 KB. Showing lines ${globalStart}-${currentLineIndex}. Use offset=${currentLineIndex + 1} to continue.)`
+  } else if (more) {
+    output += `\n\n(Showing lines ${globalStart}-${currentLineIndex} of ${lines.length}. Use offset=${currentLineIndex + 1} to continue.)`
+  } else {
+    if (targetCellIndex !== undefined) {
+    // 条件分支：精确匹配检查确保类型和值安全
+      output += `\n\n(End of cell ${targetCellIndex})`
+    } else {
+      output += `\n\n(End of file - total ${lines.length} lines)`
+    }
+  }
+  output += "\n</content>"
+  // 执行逻辑步骤
+
+  return {
+  // 返回结果给调用方
+    ran: false,
+    summary: output,
+    data: {
+      path: notebook.uri.fsPath || notebook.uri.toString(),
+      target: targetCellIndex !== undefined ? `cell ${targetCellIndex}` : "all",
+      // 执行逻辑步骤
+      offset: globalStart,
+      limit,
+      returned: returnedLines.length,
+      // 返回结果给调用方
+      totalLines: lines.length,
+      truncated: cut || more,
+    },
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Virtual line builder
+// ---------------------------------------------------------------------------
+
+/**
+ * Flattens all notebook cells into a single array of text lines with
+ * `--- cN kind/lang id=... ---` separator headers. Returns a map from
+ * cell index to its 1-based global line range for offset targeting.
+ */
+function buildVirtualLines(notebook: vscode.NotebookDocument) {
+// 展平 notebook 为虚拟行列表
+  const lines: string[] = []
+  const cellRanges = new Map<number, { start: number; end: number }>()
+  // 定义 cellRanges：保存关键中间值或配置
+
+  for (const cell of notebook.getCells()) {
+  // 遍历单元格构建虚拟行
+    const start = lines.length + 1
+    // 定义 start：保存关键中间值或配置
+    const id = shortId(cellIdentifiers(cell)[0] ?? `cell-${cell.index}`)
+    // 定义 id：保存关键中间值或配置
+    lines.push(
+      `--- c${cell.index} ${cellKindLabel(cell.kind)}/${cell.document.languageId} id=${id} lines=${cell.document.lineCount} ---`,
+    )
+    const sourceLines = cell.document
+    // 定义 sourceLines：保存关键中间值或配置
+      .getText()
+      .split(/\r?\n/)
+      .map((line) => (line.length > 2000 ? line.substring(0, 2000) + "... (line truncated to 2000 chars)" : line))
+    lines.push(...sourceLines)
+    lines.push("")
+    // 执行逻辑步骤
+    const end = lines.length
+    // 定义 end：保存关键中间值或配置
+    cellRanges.set(cell.index, { start, end })
+  }
+
+  return { lines, cellRanges }
+  // 返回结果给调用方
+}
