-function readJson(request: http.IncomingMessage) {
-// 读取请求体并解析 JSON，空体返回空对象以兼容无 body 的 POST
-  return new Promise<unknown>((resolve, reject) => {
-  // 返回结果给调用方
-    let body = ""
-    // 声明 body：后续可能重新赋值
-    request.setEncoding("utf8")
-    // 强制 UTF-8 编码，避免多字节字符在 chunk 拼接时被截断
-    request.on("data", (chunk) => {
-    // 逐块拼接请求体字符串
-      body += chunk
-    })
-    request.on("end", () => {
-    // 请求体读取完毕后解析 JSON
-      try {
-        resolve(body ? JSON.parse(body) : {})
-      } catch (error) {
-        reject(error)
-      }
-    })
-    request.on("error", reject)
-    // 底层流错误转发为 Promise reject
-  })
-}
