From a686ccf720d66b558e300ec20b4a32d8c1579fee Mon Sep 17 00:00:00 2001
From: SMARK2022 <3222301373@qq.com>
Date: Mon, 18 May 2026 23:56:30 +0800
Subject: [PATCH] feat: Windows build uses direct Bun install (#170 tip)

diff --git a/.github/workflows/build-opencode.yml b/.github/workflows/build-opencode.yml
--- a/.github/workflows/build-opencode.yml
+++ b/.github/workflows/build-opencode.yml
@@ -274,7 +274,31 @@ jobs:
 
       - uses: microsoft/setup-msbuild@v2
 
-      - uses: ./.github/actions/setup-bun
+      # #170：Windows 跳过 setup-bun 多 GB cache restore/save，直装更快
+      # #170：mac/linux 仍走共享 composite；仅 Windows 旁路
+      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
+        with:
+          bun-version-file: package.json
+
+      - name: Install Windows dependencies
+        shell: pwsh
+        env:
+          # #170：跳过重型可选浏览器/桌面二进制下载
+          ELECTRON_SKIP_BINARY_DOWNLOAD: "1"
+          ELECTRON_SKIP_DOWNLOAD: "1"
+          PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: "1"
+          PUPPETEER_SKIP_DOWNLOAD: "1"
+          CYPRESS_INSTALL_BINARY: "0"
+          # #170：非交互 CI 禁止 husky prepare 挂载
+          HUSKY: "0"
+        run: |
+          $ErrorActionPreference = "Stop"
+          # #170：缺 setuptools 时显式安装，失败 fail-closed
+          python -c "import setuptools" 2>$null
+          if ($LASTEXITCODE -ne 0) {
+            python -m pip install --upgrade setuptools
+          }
+          bun install --linker hoisted
 
       - name: Build Windows x64 binary
         shell: pwsh
