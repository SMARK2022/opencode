   const duration = createMemo(() => {
     const end = props.part.time.end
@@ -1753,8 +1755,8 @@ const renderedContent = createMemo(() => displayContent() || content())
             {/* 用 content() 而非 summary().body：summary 可能只剩标题体为空 */}
