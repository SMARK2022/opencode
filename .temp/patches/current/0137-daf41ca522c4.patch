               streaming={!isDone()}
               syntaxStyle={syntax()}
               content={renderedContent().split(String.fromCharCode(10)).slice(0, 5).join(String.fromCharCode(10))}
@@ -1780,16 +1810,36 @@ const renderedContent = createMemo(() => displayContent() || content())
         </Show>
         <Show when={!opaque() && (!inMinimal() || expanded()) && summary().body}>
           <box paddingLeft={inMinimal() ? 2 : 0} marginTop={1}>
-            <code
-              filetype="markdown"
-              // #135：展开体同样绑定推理完成态
-              drawUnstyledText={!isDone()}
-              streaming={!isDone()}
-              syntaxStyle={syntax()}
-              content={summary().body}
-              conceal={ctx.conceal()}
-              fg={theme.textMuted}
-            />
+            <Switch>
+              <Match when={!isDone()}>
+                <code
+                  filetype="markdown"
+                  // #135/#137：流式推理 styled streaming，避免 unstyled 闪烁
+                  drawUnstyledText={false}
+                  streaming={true}
+                  syntaxStyle={syntax()}
+                  content={summary().body}
+                  conceal={ctx.conceal()}
+                  fg={theme.textMuted}
+                />
+              </Match>
+              {/* #137：推理完成后 keyed remount */}
+              <Match when={isDone()}>
+                <Show keyed when={completedKey()}>
+                  {(_key) => (
+                    <code
+                      filetype="markdown"
+                      drawUnstyledText={false}
+                      streaming={false}
+                      syntaxStyle={syntax()}
+                      content={summary().body}
+                      conceal={ctx.conceal()}
+                      fg={theme.textMuted}
+                    />
+                  )}
+                </Show>
+              </Match>
+            </Switch>
           </box>
         </Show>
       </box>
diff --git a/packages/opencode/test/session/prompt.test.ts b/packages/opencode/test/session/prompt.test.ts
index 491ad06aaf..8eba5efd9e 100644
--- a/packages/opencode/test/session/prompt.test.ts
+++ b/packages/opencode/test/session/prompt.test.ts
@@ -417,6 +417,28 @@ const seed = Effect.fn("test.seed")(function* (sessionID: SessionID, opts?: { fi
   return { user: msg, assistant }
 })
 
+const addCompletedTool = (sessionID: SessionID, messageID: MessageID) =>
+  Effect.gen(function* () {
+    const session = yield* Session.Service
+    // #137：构造已完成 tool 尾，验证手动压缩后 loop 不再二次 build
+    yield* session.updatePart({
+      id: PartID.ascending(),
+      messageID,
+      sessionID,
+      type: "tool",
+      callID: crypto.randomUUID(),
+      tool: "bash",
+      state: {
+        status: "completed",
+        input: { command: "printf tail" },
+        output: "tail output",
+        title: "done",
+        metadata: {},
+        time: { start: Date.now(), end: Date.now() },
+      },
+    })
+  })
+
 const addSubtask = (sessionID: SessionID, messageID: MessageID, model = ref) =>
   Effect.gen(function* () {
     const session = yield* Session.Service
@@ -664,6 +686,49 @@ it.instance("loop stops provider overflow instead of auto-compacting when disabl
   }),
 )
 
+// #137：手动压缩后只应有一次摘要 LLM 调用，不得把 retained tool tail 当新 build
+it.instance("manual compaction stops after summarizing retained tool tail", () =>
+  Effect.gen(function* () {
+    const { llm } = yield* useServerConfig((url) => ({
+      ...providerCfg(url),
+      compaction: { tail_turns: 1 },
+    }))
+    const prompt = yield* SessionPrompt.Service
+    const sessions = yield* Session.Service
+    // #137：显式 auto:false 走手动压缩终态分支
+    const compact = yield* SessionCompaction.Service
+    const chat = yield* sessions.create({
+      title: "Manual compact",
+      permission: [{ permission: "*", pattern: "*", action: "allow" }],
+    })
+
+    yield* seed(chat.id, { finish: "stop" })
+    const keep = yield* seed(chat.id, { finish: "stop" })
+    yield* addCompletedTool(chat.id, keep.assistant.id)
+    yield* compact.create({
+      sessionID: chat.id,
+      agent: "build",
+      model: ref,
+      auto: false,
+    })
+    // #137：仅排队一次摘要响应，用于断言 hits===1
+    yield* llm.text("summary")
+
+    // #137：loop 应在摘要后 break，不得再发起 build 调用
+    const result = yield* prompt.loop({ sessionID: chat.id })
+    const filtered = yield* MessageV2.filterCompactedEffect(chat.id)
+
+    // #137：核心断言——手动压缩后 provider 只调用一次
+    expect(yield* llm.hits).toHaveLength(1)
+    expect(result.info.role).toBe("assistant")
+    // #137：返回摘要 assistant，而非新 build 回合
+    if (result.info.role === "assistant") expect(result.info.summary).toBe(true)
+    // #137：retained tail 仍可见，但不得二次 provider 调用
+    expect(filtered.map((msg) => msg.info.id)).toContain(keep.user.id)
+    expect(filtered.map((msg) => msg.info.id)).toContain(keep.assistant.id)
+  }),
+)
+
 noLLMServer.instance.skip(
   "prompt emits v2 prompted and synthetic events (v2 projector disabled)",
   () =>
