+    let body = ""
+    // 声明 body：后续可能重新赋值
+    request.setEncoding("utf8")
+    // 强制 UTF-8 编码，避免多字节字符在 chunk 拼接时被截断
+    request.on("data", (chunk) => {
+    // 逐块拼接请求体字符串
+      body += chunk
+    })
+    request.on("end", () => {
+    // 请求体读取完毕后解析 JSON
+      try {
+        resolve(body ? JSON.parse(body) : {})
+      } catch (error) {
+        reject(error)
+      }
+    })
