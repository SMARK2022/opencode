+      { label: "all", description: "all cells" },
+      { label: "cell", description: "one cell" },
+    ],
+    { title: "vscode_notebook_source target" },
+    // 执行逻辑步骤
+  )
+  if (!target) {
+  // 前置校验：排除非法输入或空值情况
+    return undefined
+    // 返回 undefined 表示无结果或用户取消
+  }
+
+  if (target.label === "all") {
+  // 运行全部单元格
