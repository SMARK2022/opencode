+  // UTF-8 响应保留中文诊断与 notebook 内容，避免依赖系统默认编码。
+  response.writeHead(status, { "Content-Type": "application/json; charset=utf-8" })
+  // 一次结束响应并序列化原结构；异常沿请求错误边界传播，不能返回截断的成功 JSON。
+  response.end(JSON.stringify(value, null, 2))
