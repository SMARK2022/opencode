+  // 首次检查即完成则直接返回
+    return true
+    // 返回结果给调用方
+  }
+
+  return await new Promise<boolean>((resolve) => {
+  // 等待服务器 listen 回调，获取实际分配端口
+    const timer = setTimeout(() => {
+    // 超时定时器：到期后 dispose 订阅并返回 false
+      subscription.dispose()
+      resolve(false)
+    }, timeoutMs)
+    const subscription = vscode.workspace.onDidChangeNotebookDocument((event) => {
+    // 监听 notebook 变化事件，完成时清理并 resolve
+      if (event.notebook.uri.toString() !== notebook.uri.toString()) {
+      // 条件分支：精确匹配检查确保类型和值安全
+        return
+        // 返回结果给调用方
+      }
+      if (!done()) {
+      // 前置校验：排除非法输入或空值情况
+        return
+        // 返回结果给调用方
+      }
+      clearTimeout(timer)
+      subscription.dispose()
+      resolve(true)
+    })
+  })
