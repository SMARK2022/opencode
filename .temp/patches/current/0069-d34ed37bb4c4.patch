+  // 定义 started：保存关键中间值或配置
+  const ended = Date.parse(endedRaw)
+  // 定义 ended：保存关键中间值或配置
+  if (!Number.isFinite(started) || !Number.isFinite(ended)) {
+  // 时间戳解析失败返回 ?ms
+    return " ?ms"
+    // 返回结果给调用方
+  }
+  return ` ${Math.max(0, ended - started)}ms`
+  // 返回结果给调用方
