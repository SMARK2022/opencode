+    return `${kernelName} (${languageName} ${languageVersion})`
+    // 返回结果给调用方
+  }
+  if (kernelName) {
+  // 条件分支：按业务逻辑分流处理
+    return kernelName
+    // 返回结果给调用方
+  }
+  if (languageName && languageVersion) {
+  // 条件分支：按业务逻辑分流处理
