index 693e7267e5043e94bb6a055c13b0040f86fb7ce8..87eac81bde25805d83f0c711c0a3173aa0aa0550 100644
--- a/sdks/vscode/src/extension.ts
+++ b/sdks/vscode/src/extension.ts
@@ -1,11 +1,40 @@
-// This method is called when your extension is deactivated
-export function deactivate() {}
-
 import * as vscode from "vscode"
+import * as http from "node:http"
+import { randomUUID } from "node:crypto"
+import * as path from "node:path"
 
 const TERMINAL_NAME = "opencode"
+const BRIDGE_HOST = "127.0.0.1"
+// 桥接服务仅绑定本机回环地址，杜绝网络暴露风险
+
+let bridgeServer: http.Server | undefined
+// 模块级持有 HTTP 服务器实例，deactivate 时必须关闭以释放端口
+let bridgeOutput: vscode.OutputChannel | undefined
+// 模块级持有输出通道引用，deactivate 时必须 dispose 以避免泄漏
+
+type BridgeInfo = {
+// 桥接身份信息：端口号加随机 token，通过环境变量传递给 CLI 进程
+  port: number
+  token: string
+}
+
+export function deactivate() {
+// 扩展卸载钩子：关闭桥接服务器并释放输出通道，保证无残留资源
