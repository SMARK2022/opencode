+  // 前置校验：排除非法输入或空值情况
+    return undefined
+    // 返回 undefined 表示无结果或用户取消
+  }
+  const [start, end] = rangeText.split(",").map((value) => Number(value.trim()))
+  // 解析范围输入，end 在提示中为闭区间，转换为开区间
+  return await runNotebook({ filePath: notebook.uri.toString(), target: { type: "range", start, end: end + 1 } })
+  // 返回结果给调用方
