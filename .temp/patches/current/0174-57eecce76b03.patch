+// #174：周×星期密度非折线：只读报告生成终端行，不写库
+// #174：renderHeatmap 输出密度格/矩阵语义，供 heatmap 命令使用
+export const renderHeatmap = (input: {
+  title?: string
+  points: HeatPoint[]
+  color?: string
+  width?: number
+  formatter?: (n: number) => string
+}) => {
+  // week x weekday density — NOT a line/timeline projection
+  const lines = input.title ? [paint(input.title, "cyan", undefined, true)] : []
+  const byKey = new Map(input.points.map((p) => [`${p.day}-${p.dow}`, p.value]))
+  const vals = input.points.map((p) => p.value)
+  const hi = Math.max(1, ...vals, 0)
+  lines.push("    Mo Tu We Th Fr Sa Su")
+  const days = [...new Set(input.points.map((p) => p.day))].sort((a, b) => a - b).slice(-12)
+  for (const day of days) {
+    let row = fitVisible(String(day).slice(-4), 4)
+// #174：热力一周七列固定顺序
+    for (let dow = 0; dow < 7; dow++) {
+      const v = byKey.get(`${day}-${dow}`) ?? 0
+      const idx = Math.min(DENSITY.length - 1, Math.round((v / hi) * (DENSITY.length - 1)))
+      row += `  ${DENSITY[idx]}`
+    }
+    lines.push(row)
+  }
+  if (days.length === 0) lines.push("(empty heatmap)")
+  return lines
