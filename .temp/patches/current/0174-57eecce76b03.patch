+// #174：指标展示统一 formatNumber
+export const metricFormatter = (v: number) => formatNumber(v)
+// #174：UsageGroup 转 series 保留 id/label
+export const seriesFromUsage = (groups: UsageGroup[], metric: "tokens" | "cost" = "cost"): ChartSeries[] =>
