+}
+
+// insights 面板分三段双栏：卡片+雷达/建议、双动量表、置信仪表+方差直方
+export function renderInsights(report: StatsReport, options: { color?: ColorMode; limit?: number } = {}) {
+  const cards = buildInsights(report)
+  const forecast = buildForecast(report)
+  const lines = [
