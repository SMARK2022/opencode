+// #174：把 daily cost 映射为热力点
+// #174：dailyCostPoints 把 daily 转为热力点 day/dow/value
+export const dailyCostPoints = (report: StatsReport): HeatPoint[] =>
+  report.daily.flatMap((d) => {
