+// #174：bar 生成重复块字符
+const bar = (n: number, width: number, ch = "█") => ch.repeat(Math.max(0, Math.min(width, Math.round(n))))
+// #174：maxY 至少为 1 避免除零
+const maxY = (pts: ChartPoint[]) => Math.max(1, ...pts.map((p) => p.y))
