Subject: [PATCH] feat(shell): enhance execution notice for empty output and exit code
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit



diff --git a/packages/core/src/util/output-notice.ts b/packages/core/src/util/output-notice.ts
index f27b9a57a4b33dd9c1686d767b3746a7f69c83a1..e69fa6f2f69c28e4b365e2edd4e2d5b3f9a4d2c1 100644
--- a/packages/core/src/util/output-notice.ts
+++ b/packages/core/src/util/output-notice.ts
@@ -17,7 +17,11 @@
 type ExecutionNotice = {
-  severity: "warning"
-  reason: "timeout" | "user_abort"
+  // #289：execution notice 是 shell 输出里给模型看的执行状态，不是完整 metadata 回放。
+  // timeout/user_abort 继续用 warning；exit 只暴露退出码，避免把命令、环境变量或原始 metadata 放进模型上下文。
+  severity: "info" | "warning" | "error"
+  reason: "timeout" | "user_abort" | "exit"
   timeout_ms?: number
+  // #289：exit_code 在 reason 为 exit 时必填，携带原始进程退出码供审计
+  exit_code?: number
 }
 
 type Notice = Record<string, string | number | undefined>
@@ -51,4 +55,11 @@
 export function formatExecutionNotice(input: ExecutionNotice) {
   return formatNotice({ type: "execution", source: "shell", ...input })
 }
+
+// 采样遗漏只说明观察边界，不能替代真实错误摘录或吞掉失败退出码。
+export function formatExitNotice(code: number | null, emptyOutput: boolean, appendix = "") {
+  if (code === null || (!emptyOutput && (code === 0 || appendix.includes("<bash_high_signal_excerpt>")))) return
+  return formatExecutionNotice({ severity: code === 0 ? "info" : "error", reason: "exit", exit_code: code })
+}
+
 
diff --git a/packages/opencode/src/util/output-notice.ts b/packages/opencode/src/util/output-notice.ts
--- a/packages/opencode/src/util/output-notice.ts
+++ b/packages/opencode/src/util/output-notice.ts
@@ -1,1 +1,1 @@
-export { outputStats, formatOutputTruncatedNotice, formatExecutionNotice, formatCompactionClearedNotice, truncateForCompaction } from "@opencode-ai/core/util/output-notice"
+export { outputStats, formatOutputTruncatedNotice, formatExecutionNotice, formatExitNotice, formatCompactionClearedNotice, truncateForCompaction } from "@opencode-ai/core/util/output-notice"
diff --git a/packages/opencode/src/tool/shell.ts b/packages/opencode/src/tool/shell.ts
index e4b83d268..2489abcab 100644
--- a/packages/opencode/src/tool/shell.ts
+++ b/packages/opencode/src/tool/shell.ts
@@ -18,1 +18,1 @@
-import { formatExecutionNotice, formatOutputTruncatedNotice, outputStats } from "@/util/output-notice"
+import { formatExecutionNotice, formatExitNotice, formatOutputTruncatedNotice, outputStats } from "@/util/output-notice"
@@ -869,8 +869,9 @@
         file = yield* trunc.write(raw)
       }
 
-      let output = end.text
-      if (!output) output = "(no output)"
+      // #289：空输出检测前移，exit notice 依赖此标志决定是否追加退出码
+      const emptyOutput = end.text.length === 0
+      let output = emptyOutput ? "(no output)" : end.text
 
       if (cut && file) {
         // 末尾换行不额外算一行；内存只保留计数器与原有尾部窗口。
@@ -894,6 +895,11 @@
       // 先完成最终窗口再判定可见性，不能用截断前的原文隐藏附录。
       const appendix = renderDiagnosticAppendix(diagnostic, { durationMs: Date.now() - started, exitCode: code, visibleOutput: output, config: { enabled: input.compressOutput } })
       if (appendix) output += "\n\n" + appendix
+      // #289：metadata.exit 不进入模型回放，空输出或缺少诊断的失败需补退出码 notice。
+      // 这里刻意不回放命令文本、环境变量或原始 metadata，保持模型可见信息的最小安全边界。
+      const exitNotice = formatExitNotice(code, emptyOutput, appendix)
+      if (exitNotice) meta.push(exitNotice)
+
       if (meta.length > 0) {
         output += "\n\n" + meta.join("\n")
       }
diff --git a/packages/opencode/test/tool/shell.test.ts b/packages/opencode/test/tool/shell.test.ts
index ccf2e36dd..0b02c5013 100644
--- a/packages/opencode/test/tool/shell.test.ts
+++ b/packages/opencode/test/tool/shell.test.ts
@@ -1399,6 +1399,7 @@
           )
           expect(res.output).toContain("before")
           expect(res.output).toContain('<opencode_notice type="execution" source="shell" severity="warning" reason="user_abort" />')
+          expect(res.output).not.toContain('reason="exit"')
           expect(collected.length).toBeGreaterThan(0)
         }),
       ),
@@ -1418,6 +1419,8 @@
           expect(result.output).toContain(
             '<opencode_notice type="execution" source="shell" severity="warning" reason="timeout" timeout_ms="500" />',
           )
+          expect(result.output).not.toContain('reason="exit"')
+          // #289：abort/timeout notice 不带 exit reason——中止不是进程自身退出，防止状态混淆
         }),
