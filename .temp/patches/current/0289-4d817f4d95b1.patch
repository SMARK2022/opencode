     15_000,
@@ -1471,6 +1473,107 @@
     ),
   )
 
+  
+  it.live("reports exit notice for empty successful output", () =>
+  // #289：空输出成功（exit 0）仍需 notice——模型无法从空输出推断命令是否真的执行成功
+    runIn(
+      projectRoot,
+      Effect.gen(function* () {
+        const command = `${bin} -e ${evalarg("process.exit(0)")}`
+        const result = yield* run({
+          command: PS.has(sh()) ? `& ${command}` : command,
+        })
+
+        expect(result.metadata.exit).toBe(0)
+        expect(result.output).toContain("(no output)")
+        expect(result.output).toContain(
+          '<opencode_notice type="execution" source="shell" severity="info" reason="exit" exit_code="0" />',
+        )
+      }),
+    ),
+  )
+
+  it.live("reports exit notice for empty failed output", () =>
+  // #289：空输出失败必须携带退出码，模型才能区分静默失败与结果丢失
+    runIn(
+      projectRoot,
+      Effect.gen(function* () {
+        const command = `${bin} -e ${evalarg("process.exit(42)")}`
+        // #289：退出码 42 覆盖非 1 的任意错误码路径，验证 exit_code 原样透传
+        const result = yield* run({
+          command: PS.has(sh()) ? `& ${command}` : command,
+        })
+
+        expect(result.metadata.exit).toBe(42)
+        expect(result.output).toContain("(no output)")
+        expect(result.output).toContain(
+          '<opencode_notice type="execution" source="shell" severity="error" reason="exit" exit_code="42" />',
+        )
+      }),
+    ),
+  )
+
+  it.live("reports exit notice for non-empty failed output without diagnostics", () =>
+  // #289：非空但无诊断摘录的失败靠 exit notice 兜底，避免模型误读为成功产物
+    runIn(
+      projectRoot,
+      Effect.gen(function* () {
+        const command = `${bin} -e ${evalarg("console.log(String.fromCharCode(112,108,97,105,110,32,111,117,116,112,117,116)); process.exit(7)")}`
+        const result = yield* run({
+          command: PS.has(sh()) ? `& ${command}` : command,
+        })
+
+        expect(result.metadata.exit).toBe(7)
+        expect(result.output).toContain("plain output")
+        expect(result.output).toContain(
+          '<opencode_notice type="execution" source="shell" severity="error" reason="exit" exit_code="7" />',
+        )
+      }),
+    ),
+  )
+
+  it.live("omits exit notice when diagnostics already explain non-empty failure", () =>
+  // #289：已有高信号摘录时不重复 exit notice，同一失败只提示一次
+    runIn(
+      projectRoot,
+      Effect.gen(function* () {
+        const script = [
+          "console.error(String.fromCharCode(102,97,116,97,108,58,32,104,105,100,100,101,110,32,114,111,111,116,32,99,97,117,115,101))",
+          "await new Promise((resolve) => setTimeout(resolve, 2100))",
+          `for (let i = 0; i < ${Truncate.MAX_LINES + 20}; i++) console.log(String.fromCharCode(116,97,105,108,32,108,105,110,101,32) + i)`,
+          "process.exit(9)",
+        ].join(";")
+        const command = `${bin} -e ${evalarg(script)}`
+        // #289：诊断场景脚本较慢（2.1s 等待根因行）且触发截断，15s 超时留足余量
+        const result = yield* run({
+          command: PS.has(sh()) ? `& ${command}` : command,
+        })
+
+        expect(result.metadata.exit).toBe(9)
+        // #289：metadata.exit 仍记录真实退出码；模型可见输出里才省略 notice
+        expect(result.output).toContain("<bash_high_signal_excerpt>")
+        expect(result.output).not.toContain('reason="exit"')
+      }),
+    ),
+    15_000,
+  )
+
+  it.live("omits exit notice for non-empty successful output", () =>
+  // #289：非空成功是正常路径，零噪音不加 notice
+    runIn(
+      projectRoot,
+      Effect.gen(function* () {
+        const result = yield* run({
+          command: `echo ok`,
+        })
+
+        expect(result.metadata.exit).toBe(0)
+        expect(result.output).toContain("ok")
+        expect(result.output).not.toContain('reason="exit"')
+      }),
+    ),
+  )
+
   it.live("streams metadata updates progressively", () =>
     runIn(
       projectRoot,
diff --git a/packages/opencode/test/tool/bash-compress.test.ts b/packages/opencode/test/tool/bash-compress.test.ts
--- a/packages/opencode/test/tool/bash-compress.test.ts
+++ b/packages/opencode/test/tool/bash-compress.test.ts
@@ -2,1 +2,2 @@
-import { compressVisibleOutput, createTerminalDisplay, normalizePowerShellOutput } from "@opencode-ai/core/tool/bash-compress"
+import { BashDiagnosticCollector, compressVisibleOutput, createTerminalDisplay, normalizePowerShellOutput, renderDiagnosticAppendix } from "@opencode-ai/core/tool/bash-compress"
+import { formatExitNotice } from "@opencode-ai/core/util/output-notice"
@@ -5,1 +6,25 @@
 describe("tool.bash-compress", () => {
+  test("keeps failed exit status when only diagnostic sampling was omitted", () => {
+    const raw = "a".repeat(5_000)
+    const collector = new BashDiagnosticCollector()
+    collector.push(raw)
+    collector.end()
+    const snapshot = collector.snapshot()
+    const appendix = renderDiagnosticAppendix(snapshot, { durationMs: 3_000, exitCode: 7, visibleOutput: raw, config: { enabled: false } })
+    expect(snapshot.errorLikeLines).toBe(0)
+    expect(snapshot.discardedChars).toBeGreaterThan(0)
+    expect(appendix).toContain("diagnostic sampling omitted")
+    // 真实采样说明不含失败证据，仍须交付退出码；取消与超时不得伪造exit。
+    expect(formatExitNotice(7, false, appendix)).toBe('<opencode_notice type="execution" source="shell" severity="error" reason="exit" exit_code="7" />')
+    expect(formatExitNotice(0, true)).toContain('severity="info" reason="exit" exit_code="0"')
+    expect(formatExitNotice(42, true)).toContain('severity="error" reason="exit" exit_code="42"')
+    expect(formatExitNotice(null, false, appendix)).toBeUndefined()
+    expect(formatExitNotice(0, false, appendix)).toBeUndefined()
+    const failure = new BashDiagnosticCollector()
+    failure.push("fatal: hidden root cause\n")
+    failure.end()
+    const diagnosed = renderDiagnosticAppendix(failure.snapshot(), { durationMs: 3_000, exitCode: 9, visibleOutput: "tail" })
+    expect(diagnosed).toContain("<bash_high_signal_excerpt>")
+    expect(formatExitNotice(9, false, diagnosed)).toBeUndefined()
+  })
+
