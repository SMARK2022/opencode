From 595b0e8f3ede9e5696830aa05983e26d83fdf0aa Mon Sep 17 00:00:00 2001
From: SMARK <3222301373@qq.com>
Date: Tue, 19 May 2026 03:42:18 +0800
Subject: [PATCH] feat(text-decoding): buffer short ASCII for UTF-16LE (#172 tip)

diff --git a/packages/opencode/src/util/text-decoding.ts b/packages/opencode/src/util/text-decoding.ts
--- a/packages/opencode/src/util/text-decoding.ts
+++ b/packages/opencode/src/util/text-decoding.ts
@@ -7,6 +7,8 @@ type Options = {
 }
 
 const MAX_SEGMENT_BYTES = 8192
+// #172：UTF-16 对齐探测窗口（至少 1 个 code unit + 样本）
+const UTF16_PROBE_BYTES = 4
 const UTF16_NULL_RATIO = 0.2
 const EMPTY: Uint8Array<ArrayBuffer> = new Uint8Array(0)
 
@@ -64,6 +66,15 @@ function asciiPrefixLength(bytes: Uint8Array) {
   return i
 }
 
+// #172：短 ASCII 可能是无 BOM UTF-16LE 的低字节，非 final 时先缓冲
+function shouldBufferAsciiPrefix(bytes: Uint8Array, final: boolean) {
+  // #172：final 必须冲刷，不能再等
+  if (final) return false
+  // #172：达段上限仍强制 emit，避免死等
+  if (bytes.length >= MAX_SEGMENT_BYTES) return false
+  return bytes.length < UTF16_PROBE_BYTES
+}
+
 // #128：按换行切段，避免一段编码污染下一段
 function findLineEnd(bytes: Uint8Array) {
   const index = bytes.indexOf(0x0a)
@@ -304,9 +315,10 @@ export function createAutoTextDecoder(options?: Options) {
         output += next
         continue
       }
-      // ASCII prefix is safe in both UTF-8 and GB18030 — emit immediately.
+      // #172：ASCII 对 UTF-8/GB 安全，但短前缀可能是无 BOM UTF-16LE 半 code unit
       const ascii = asciiPrefixLength(pending)
       if (ascii > 0) {
+        if (shouldBufferAsciiPrefix(pending, final)) break
         output += emit(ascii, "utf-8")
         continue
       }
diff --git a/packages/opencode/test/util/text-decoding.test.ts b/packages/opencode/test/util/text-decoding.test.ts
--- a/packages/opencode/test/util/text-decoding.test.ts
+++ b/packages/opencode/test/util/text-decoding.test.ts
@@ -70,6 +70,27 @@ describe("text-decoding", () => {
     expect(decoder.encoding()).toBe("utf-16le")
   })
 
+  // #172：ASCII 开头的无 BOM UTF-16LE 以 1–3 字节 drip 时不得偷低字节
+  test("buffers short ASCII prefixes before detecting UTF-16LE", () => {
+    const text = "JAVA原始UTF16LE无BOM输出：中文编码检查\n"
+    const input = Buffer.from(text, "utf16le")
+
+    for (const splits of [[1], [2], [3], [1, 1], [1, 2], [2, 1], [1, 1, 1]]) {
+      const decoder = createAutoTextDecoder()
+      let offset = 0
+      let output = ""
+      for (const size of splits) {
+        output += decoder.write(input.subarray(offset, offset + size))
+        offset += size
+      }
+      output += decoder.write(input.subarray(offset)) + decoder.end()
+      expect(output).toBe(text)
+      expect(decoder.encoding()).toBe("utf-16le")
+    }
+  })
+
+
+
   // #128：ASCII 前缀不锁定编码，后续可切到 gb18030
   test("does not lock ASCII prefixes before Windows codepage bytes", () => {
     const decoder = createAutoTextDecoder()
