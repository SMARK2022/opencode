   const [expanded, setExpanded] = createSignal(false)
+  // 目标以 canCollapse() 承担上游 collapsible() 的语义——统一收敛为 collapsed memo，
+  // 让下方 JSX 与上游保持同构引用。
+  const collapsed = createMemo(() => canCollapse() && !expanded())
