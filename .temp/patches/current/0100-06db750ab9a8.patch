From 06db750ab9a854999b526ce4f157ca2c2dab489c Mon Sep 17 00:00:00 2001
From: SMARK <3222301373@qq.com>
Date: Thu, 7 May 2026 13:24:46 +0800
Subject: [PATCH] chore: update bunfig.toml to use hoisted linker and remove
 deprecated dependencies from package.json


diff --git a/.github/actions/setup-bun/action.yml b/.github/actions/setup-bun/action.yml
index 9d29724d86..243d9c5ccd 100644
--- a/.github/actions/setup-bun/action.yml
+++ b/.github/actions/setup-bun/action.yml
@@ -58,11 +58,8 @@ runs:
         # Workaround for patched peer variants
         # e.g. ./patches/ for standard-openapi
         # https://github.com/oven-sh/bun/issues/28147
-        if [ "$RUNNER_OS" = "Windows" ]; then
-          bun install --linker hoisted ${{ inputs.install-flags }}
-        else
-          bun install ${{ inputs.install-flags }}
-        fi
+        # 统一 hoisted linker：全平台避免 patched peer 冲突
+        bun install --linker hoisted ${{ inputs.install-flags }}
       shell: bash
 
     - name: Save Bun dependencies
diff --git a/.github/workflows/build-opencode.yml b/.github/workflows/build-opencode.yml
index 939c7d12dc..783b3eddb0 100644
--- a/.github/workflows/build-opencode.yml
+++ b/.github/workflows/build-opencode.yml
@@ -7,7 +7,7 @@ on:
   workflow_dispatch:
     inputs:
       version:
-        description: 'Version (e.g., 1.14.25-smark)'
+        description: 'Version (e.g., 1.14.31-smark)'
         required: false
         type: string
   # push 自动触发：dev-smark 分支推送时自动构建，路径过滤避免无关变更触发 CI
@@ -22,7 +22,7 @@ on:
 
 # 默认版本号：push 触发时无 inputs.version，回退到此常量保证产物命名一致
 env:
-  DEFAULT_VERSION: "1.14.25-smark"
+  DEFAULT_VERSION: "1.14.31-smark"
 
 jobs:
   # 三平台并行构建：Linux/macOS/Windows 互不依赖，提升 CI 吞吐
diff --git a/bun.lock b/bun.lock
index 7f58e4fd53..9dc5acb52a 100644
--- a/bun.lock
+++ b/bun.lock
@@ -1059,11 +1059,12 @@
   },
   "trustedDependencies": [
     "esbuild",
-    "tree-sitter-powershell",
+    "node-pty",
     "protobufjs",
-    "electron",
-    "web-tree-sitter",
+    "tree-sitter",
     "tree-sitter-bash",
+    "web-tree-sitter",
+    "electron"
   ],
   "patchedDependencies": {
     "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
diff --git a/bunfig.toml b/bunfig.toml
index c506ff57c4..646fca5dc3 100644
--- a/bunfig.toml
+++ b/bunfig.toml
@@ -1,5 +1,7 @@
 [install]
 exact = true
+# 与 CI 一致：hoisted 避免 peer 变体冲突
+linker = "hoisted"
 # Only install newly resolved package versions published at least 3 days ago.
 minimumReleaseAge = 259200
 minimumReleaseAgeExcludes = ["@ai-sdk/amazon-bedrock", "@ai-sdk/anthropic", "@opentui/core", "@opentui/core-darwin-arm64", "@opentui/core-darwin-x64", "@opentui/core-linux-arm64", "@opentui/core-linux-arm64-musl", "@opentui/core-linux-x64", "@opentui/core-linux-x64-musl", "@opentui/core-win32-arm64", "@opentui/core-win32-x64", "@opentui/keymap", "@opentui/solid", "opentui-spinner", "gitlab-ai-provider", "opencode-gitlab-auth", "@ff-labs/fff-node", "@ff-labs/fff-bun", "@ff-labs/fff-bin-darwin-arm64", "@ff-labs/fff-bin-darwin-x64", "@ff-labs/fff-bin-linux-arm64-gnu", "@ff-labs/fff-bin-linux-arm64-musl", "@ff-labs/fff-bin-linux-x64-gnu", "@ff-labs/fff-bin-linux-x64-musl", "@ff-labs/fff-bin-win32-arm64", "@ff-labs/fff-bin-win32-x64", "@pierre/diffs", "@pierre/theming", "app-builder-lib", "dmg-builder", "electron-builder", "electron-publish"]
diff --git a/package.json b/package.json
index 58f007e525..fa950adcb6 100644
--- a/package.json
+++ b/package.json
@@ -101,7 +101,6 @@
     "@typescript/native-preview": "catalog:",
     "glob": "13.0.5",
     "husky": "9.1.7",
-    "node-gyp": "11.2.0",
     "oxlint": "1.60.0",
     "oxlint-tsgolint": "0.21.0",
     "prettier": "3.6.2",
@@ -132,7 +131,6 @@
     "protobufjs",
     "tree-sitter",
     "tree-sitter-bash",
-    "tree-sitter-powershell",
     "web-tree-sitter",
     "electron"
   ],
