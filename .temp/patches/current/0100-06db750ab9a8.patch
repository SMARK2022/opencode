diff --git a/.github/actions/setup-bun/action.yml b/.github/actions/setup-bun/action.yml
index 9859174a2e35eab3e1b1ce2c4aabddb64507de18..c3d7c1e1dc6b48a441a35d6376c0cd81f49f476b 100644
