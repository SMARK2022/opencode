融合适配：目标 #194 已以 TokenEstimate/estimateUploadInput 承载 summary 输入估算（更强路径，保留）；
本 patch 补足源 0456 缺失语义——assistant msg 的 inputBreakdown 细分与 processor 流式交接（防压缩期间 TUI 闪零）。AttachmentToken 由 core re-home 为 TokenEstimate，无需 import。
diff --git a/packages/opencode/src/session/compaction.ts b/packages/opencode/src/session/compaction.ts
--- a/packages/opencode/src/session/compaction.ts
+++ b/packages/opencode/src/session/compaction.ts
@@ -543,6 +543,28 @@
         attachments: compactionEstimate.attachments,
         history: selected.head,
         model,
       }).inputTokens
+      // #456：pending 细分与 processor 交接——summary 请求绕过 prompt.ts，流式期间不能闪回 0。
+      const rawMessagesText = JSON.stringify(compactionMessages)
+      // userText/assistantText 按估算文本拆分；attachments 用 rawChars 表达未计入文本的附件体量。
+      const inputBreakdown = {
+        system: 0,
+        instructions: 0,
+        skills: 0,
+        tools: 0,
+        messages: {
+          userText: nextPrompt.length,
+          // userText 只含本次 summary prompt；其余估算文本归入 assistantText。
+          assistantText: Math.max(0, compactionEstimate.attachments.textChars + compactionEstimate.text.length - nextPrompt.length),
+          reasoning: 0,
+          toolInput: 0,
+          toolOutput: 0,
+          attachments: compactionEstimate.attachments.rawChars,
+          total: rawMessagesText.length,
+          // total 以序列化请求体长度为准，与 inputChars 同源。
+        },
+        // 附件仅在存在时给出 media 细分，避免空对象污染序列化形态。
+        ...(compactionEstimate.attachments.count > 0 ? { media: compactionEstimate.attachments } : {}),
+      }
       const ctx = yield* InstanceState.context
       const msg: SessionV1.Assistant = {
@@ -568,5 +590,6 @@
         // #194：inputChars/inputTokens 供 TUI pending 展示——与 prompt.ts 对齐
         inputChars: JSON.stringify(compactionMessages).length,
         inputTokens: estimatedInput,
+        inputBreakdown,
         modelID: model.id,
         providerID: model.providerID,
@@ -581,3 +604,6 @@
       })
+      // processor 把该快照复制进 step-start/step-finish，与 prompt.ts 主路径同构。
+      processor.inputChars = rawMessagesText.length
+      processor.inputBreakdown = inputBreakdown
       const result = yield* processor.process({
         user: userMessage,
diff --git a/packages/opencode/test/session/compaction.test.ts b/packages/opencode/test/session/compaction.test.ts
index ac1f7afc18c60d5430847ef684a4226f4bf9104a..247db46c9ac5c7a0bc3a18a80a525410f782cb66 100644
--- a/packages/opencode/test/session/compaction.test.ts
+++ b/packages/opencode/test/session/compaction.test.ts
@@ -875,6 +901,35 @@
     }),
   )
 
+  it.instance(
+    "stores pending input estimate on summary assistant before streaming",
+    Effect.gen(function* () {
+      const ssn = yield* SessionNs.Service
+      const session = yield* ssn.create({})
+      const msg = yield* createUserMessage(session.id, "hello")
+      const msgs = yield* ssn.messages({ sessionID: session.id })
+
+      yield* SessionCompaction.use.process({
+        parentID: msg.id,
+        messages: msgs,
+        sessionID: session.id,
+        auto: false,
+      })
+
+      const summary = (yield* ssn.messages({ sessionID: session.id })).find(
+        (item) => item.info.role === "assistant" && item.info.summary,
+      )
+
+      expect(summary?.info.role).toBe("assistant")
+      if (summary?.info.role !== "assistant") return
+      // 三个断言分别锁 pending 估算的三个落点：tokens、字符数、组件细分。
+      expect(summary.info.inputTokens).toBeGreaterThan(0)
+      expect(summary.info.inputChars).toBeGreaterThan(0)
+      // breakdown.total>0 证明 summary 消息携带了完整请求体口径，而非 0 占位。
+      expect(summary.info.inputBreakdown?.messages.total).toBeGreaterThan(0)
+    }),
+  )
+
   itCompaction.instance(
     "marks summary message as errored on compact result",
     Effect.gen(function* () {
