+    // 从未有客户端连接过，不启动退出计时器
+    if (!hadClient) return
+    idleTimer = setTimeout(() => void gracefulShutdown(), IDLE_TIMEOUT_MS)
+    idleTimer.unref?.()
+  })
+
+  // ── 启动任务 ───────────────────────────────────────────────────────────
+  // 启动 1 秒后非阻塞地检查升级，unref 避免阻止进程退出
+  setTimeout(async () => {
+    await InstanceRuntime.load({ directory: process.cwd() })
+    await upgrade().catch(() => {})
+  }, 1_000).unref?.()
+}
