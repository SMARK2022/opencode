diff --git a/packages/opencode/src/cli/cmd/tui.ts b/packages/opencode/src/cli/cmd/tui.ts
--- a/packages/opencode/src/cli/cmd/tui.ts
+++ b/packages/opencode/src/cli/cmd/tui.ts
@@ -215,10 +215,40 @@ export async function discoverOrSpawnDaemon(
       proc.unref()
       fwdPid = proc.pid
 
+      // #179：启动等待与 worker exited 竞态，崩溃则带 exit code 快速失败
+      // #179：兼容无 exited 的 spawn mock，缺失则永不完成
+      const exited =
+        "exited" in proc && (proc as { exited?: PromiseLike<number> | number }).exited !== undefined
+          ? // #179：统一 thenable/number exited 形态
+          Promise.resolve((proc as { exited: PromiseLike<number> | number }).exited).then(
+              (code) => ({ kind: "code" as const, code: Number(code) }),
+              () => ({ kind: "error" as const }),
+            )
+          : // #179：无 exited 时不完成，保持轮询语义
+          new Promise<{ kind: "code"; code: number }>(() => {})
+
+      // #179：将 sleep 与 exited 合并为可中断等待
+      const raceSleep = async (ms: number) => {
+        const sleepP = deps.sleep(ms).then(() => ({ kind: "sleep" as const }))
+        const result = await Promise.race([sleepP, exited])
+        // #179：仅 sleep 胜出才继续等待
+        if (result.kind === "sleep") return
+        // #179：失败文案引导 --print-logs，避免空等超时
+        const msg =
+          // #179：带 code 的文案便于对照日志
+          result.kind === "code"
+            ? `opencode daemon exited before startup with exit code ${result.code}. Re-run with --print-logs to show daemon startup logs.`
+            : `opencode daemon exited before startup. Re-run with --print-logs to show daemon startup logs.`
+        // #179：UI 与 throw 同步同一失败文案
+        UI.error(msg)
+        throw new Error(msg)
+      }
+
       const deadline = Date.now() + deps.waitMs
       // 启动后等待 1s 再轮询，避免过早健康检查失败
       // #49 启动后先 sleep 1s 再进入健康轮询
-      await deps.sleep(1000)
+      // #179：首等 1s 同样可被崩溃打断
+      await raceSleep(1000)
       // 轮询锁文件直到守护进程存活且健康检查通过（不校验 spawn PID）
       while (Date.now() < deadline) {
         const daemonLock = await deps.read()
@@ -234,7 +264,8 @@ export async function discoverOrSpawnDaemon(
             break
           }
         }
-        await deps.sleep(deps.pollMs)
+        // #179：轮询间隔同样可被崩溃打断
+        await raceSleep(Math.min(deps.pollMs, Math.max(0, deadline - Date.now())))
       }
 
       await electionLease.release()
@@ -242,10 +273,16 @@ export async function discoverOrSpawnDaemon(
 
       if (!existingUrl) {
         // 超时失败：杀死半拉起的进程并向上抛错
-        UI.error(`opencode daemon failed to start within ${DAEMON_START_TIMEOUT_MS / 1000} seconds`)
+        // #179：超时同样提示 --print-logs
+        UI.error(
+          `opencode daemon failed to start within ${DAEMON_START_TIMEOUT_MS / 1000} seconds. Re-run with --print-logs to show daemon startup logs.`,
+        )
+        // #179：仅超时路径 kill，崩溃路径不杀已退出进程
         proc.kill()
         // 超时文案与常量同源，避免 60 字面量与 waitMs 再次漂移
-        throw new Error(`opencode daemon failed to start within ${DAEMON_START_TIMEOUT_MS / 1000} seconds`)
+        throw new Error(
+          `opencode daemon failed to start within ${DAEMON_START_TIMEOUT_MS / 1000} seconds. Re-run with --print-logs to show daemon startup logs.`,
+        )
       }
     }
   }
diff --git a/packages/opencode/src/tool/shell.ts b/packages/opencode/src/tool/shell.ts
--- a/packages/opencode/src/tool/shell.ts
+++ b/packages/opencode/src/tool/shell.ts
@@ -498,6 +498,10 @@ function localCommands(root: Node) {
     let cur: Node | null = node
     while (cur) {
       // #158：string/raw_string 等类型包含 string 即视为载荷边界
+      // #179：ERROR 恢复节点中的 POSIX 碎片不算本地命令
+      // #179：与 string 载荷过滤叠加，避免 WSL/ssh 引号内误判
+      // #179：tree-sitter ERROR 节点上的 grep/cat 碎片不是本地命令意图
+      if (cur.type === "ERROR") return false
       if (cur.type.includes("string")) return false
       cur = cur.parent
     }
