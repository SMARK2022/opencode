diff --git a/packages/opencode/src/cli/cmd/tui.ts b/packages/opencode/src/cli/cmd/tui.ts
--- a/packages/opencode/src/cli/cmd/tui.ts
+++ b/packages/opencode/src/cli/cmd/tui.ts
@@ -223,12 +223,34 @@ export async function discoverOrSpawnDaemon(
+        let exitedBeforeReady = false
         try {
           // exited 的拒绝先安装 observer；read/unref 的同步异常仍由两层 finally 清理。
           void proc.exited.catch(() => undefined)
           proc.unref()
 
+          // 首等和轮询共用退出观察，崩溃不能一直占用选举租约直到超时。
+          const exited = proc.exited.then(
+            (code) => ({ kind: "code" as const, code }),
+            () => ({ kind: "error" as const }),
+          )
+          const raceSleep = async (ms: number) => {
+            const result = await Promise.race([deps.sleep(ms).then(() => ({ kind: "sleep" as const })), exited])
+            if (result.kind === "sleep") return
+            // Windows 启动器可退出而真实 daemon 已发布锁，交付仍经过唯一 read/reuse 的身份认证。
+            if (result.kind === "code" && result.code === 0) {
+              const lock = await deps.read(lockPath)
+              if (lock && deps.alive(lock.pid)) existingUrl = await reuse(lock)
+              if (existingUrl) { fwdPid = lock!.pid; return }
+            }
+            exitedBeforeReady = true
+            const msg = result.kind === "code"
+              ? `opencode daemon exited before startup with exit code ${result.code}. Re-run with --print-logs to show daemon startup logs.`
+              : "opencode daemon exited before startup. Re-run with --print-logs to show daemon startup logs."
+            UI.error(msg)
+            throw new Error(msg)
+          }
           // 等待放在 proc 与 lease 的 finally 内，sleep 拒绝也不能泄漏选举所有权。
           // 完整启动预算从 sleep 后开始，不能用避让早期探测的延迟吃掉健康等待时间。
-          await deps.sleep(1000)
+          await raceSleep(1000)
           const deadline = Date.now() + deps.waitMs
           // 启动器 PID 可不同；健康锁仍必须通过 reuse 的身份与稳定 owner 校验。
-          while (Date.now() < deadline) {
+          while (!existingUrl && Date.now() < deadline) {
             const daemonLock = await deps.read(lockPath)
@@ -244,1 +270,2 @@ export async function discoverOrSpawnDaemon(
-            await deps.sleep(deps.pollMs)
+            // 轮询间隔也被退出打断，不扩大原有健康等待期限。
+            await raceSleep(Math.min(deps.pollMs, Math.max(0, deadline - Date.now())))
@@ -250,2 +277,3 @@ export async function discoverOrSpawnDaemon(
-            UI.error(`opencode daemon failed to start within ${DAEMON_START_TIMEOUT_MS / 1000} seconds`)
-            throw new Error(`opencode daemon failed to start within ${DAEMON_START_TIMEOUT_MS / 1000} seconds`)
+            // 超时诊断与提前退出共享日志指引，资源仍由原 finally 清理。
+            UI.error(`opencode daemon failed to start within ${DAEMON_START_TIMEOUT_MS / 1000} seconds. Re-run with --print-logs to show daemon startup logs.`)
+            throw new Error(`opencode daemon failed to start within ${DAEMON_START_TIMEOUT_MS / 1000} seconds. Re-run with --print-logs to show daemon startup logs.`)
@@ -255,1 +283,2 @@ export async function discoverOrSpawnDaemon(
-          if (!existingUrl) proc.kill()
+          // 已观察退出不重复终止；其他未交付异常仍保留原清理责任。
+          if (!existingUrl && !exitedBeforeReady) proc.kill()
diff --git a/packages/opencode/src/tool/shell.ts b/packages/opencode/src/tool/shell.ts
--- a/packages/opencode/src/tool/shell.ts
+++ b/packages/opencode/src/tool/shell.ts
@@ -498,7 +498,11 @@ function localCommands(root: Node) {
     let cur: Node | null = node
     while (cur) {
       // #158：string/raw_string 等类型包含 string 即视为载荷边界
+      // #179：ERROR 恢复节点中的 POSIX 碎片不算本地命令
+      // #179：与 string 载荷过滤叠加，避免 WSL/ssh 引号内误判
+      // #179：根 ERROR 仍承载主机命令，不能清空权限扫描；只排除内部恢复碎片。
+      if (cur.id !== root.id && cur.type === "ERROR") return false
       if (cur.type.includes("string")) return false
       // #158：root 自身 type 不含 string，向上遍历到 null 自然终止
       cur = cur.parent
     }
diff --git a/packages/opencode/test/cli/tui/thread.test.ts b/packages/opencode/test/cli/tui/thread.test.ts
--- a/packages/opencode/test/cli/tui/thread.test.ts
+++ b/packages/opencode/test/cli/tui/thread.test.ts
@@ -15,6 +15,11 @@ import type { DiscoverDaemonDeps } from "../../../src/cli/cmd/tui"
 import { cliIt } from "../../lib/cli-process"
 
 // 测试真实 discover 函数的决策，只替换 I/O，不能另写一套单服务器模拟器。
+// #179：幸福路径 mock 使用永不 resolve 的 exited
+function hangingExited() {
+  return new Promise<number>(() => {})
+}
+
 describe("tui thread", () => {
   test("loads the TUI integration lazily", async () => {
     const source = await Bun.file(new URL("../../../src/cli/cmd/tui.ts", import.meta.url)).text()
@@ -184,6 +189,6 @@ describe("tui thread", () => {
         spawn: ((_cmd, _opts) => {
           daemonSpawnCount++
-          return { pid: FAKE_DAEMON_PID, exited: Promise.resolve(0), unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
+          return { pid: FAKE_DAEMON_PID, exited: hangingExited(), unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
         }) as DiscoverDaemonDeps["spawn"],
       }))
       expect(daemonSpawnCount).toBe(0)
@@ -244,3 +249,3 @@ describe("tui thread", () => {
               // 注入 proc handle 不创建进程；就绪仍走真实 PID、身份和 token 复查。
-              return { pid: FAKE_DAEMON_PID, exited: Promise.resolve(0), unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
+              return { pid: FAKE_DAEMON_PID, exited: hangingExited(), unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
             }) as DiscoverDaemonDeps["spawn"],
@@ -355,6 +360,6 @@ describe("tui thread", () => {
         spawn: ((_cmd, _opts) => {
           daemonSpawnCount++
-          return { pid: FAKE_DAEMON_PID, exited: Promise.resolve(0), unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
+          return { pid: FAKE_DAEMON_PID, exited: hangingExited(), unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
         }) as DiscoverDaemonDeps["spawn"],
       }))
       expect(daemonSpawnCount).toBe(1)
@@ -379,2 +384,2 @@ describe("tui thread", () => {
-            return { pid: FAKE_DAEMON_PID, exited: Promise.resolve(0),
+            return { pid: FAKE_DAEMON_PID, exited: hangingExited(),
               unref() { if (stage === "unref") fail() }, kill() { kills++ } } as ReturnType<typeof Bun.spawn>
@@ -430,3 +435,47 @@ describe("tui thread", () => {
     }),
   )
 })
+
+
+// #179：单元覆盖启动前崩溃的快速失败路径
+describe("daemon startup exit (#179)", () => {
+  test("reports daemon worker exit before startup instead of waiting for timeout", async () => {
+    const started = Date.now()
+    let killed = false
+    await expect(
+      discoverOrSpawnDaemon({} as never, {
+                // #179：超时故意很长，证明快速失败不是靠缩短 waitMs
+        waitMs: 60_000,
+        pollMs: 50,
+        electionTimeoutMs: 1000,
+        electionStaleMs: 1000,
+        read: async () => undefined,
+        alive: () => false,
+        ping: async () => false,
+        acquire: async () => ({ release: async () => undefined }),
+        clear: async () => undefined,
+        resolveDaemonFile: async () => "/tmp/fake-daemon.js",
+        identity: () => ({ dbPath: "/tmp/test.db", channel: "local" }),
+        placement: () => undefined,
+        resolveNetwork: async (args: Parameters<DiscoverDaemonDeps["resolveNetwork"]>[0]) => resolveNetworkOptionsNoConfig(args),
+        spawn: () =>
+          ({
+            pid: 4242,
+                        // #179：模拟启动前崩溃 exit 132
+            exited: Promise.resolve(132),
+            unref() {},
+            kill() {
+              killed = true
+            },
+          }) as never,
+        sleep: async (ms: number) => {
+          await new Promise((r) => setTimeout(r, Math.min(ms, 15)))
+        },
+      } as never),
+    ).rejects.toThrow(/exited before startup with exit code 132/)
+    expect(Date.now() - started).    // #179：必须远快于 60s 超时
+    toBeLessThan(5_000)
+    // #179：进程已退出，不应再 kill
+    expect(killed).toBe(false)
+  })
+})
diff --git a/packages/opencode/test/tool/shell.test.ts b/packages/opencode/test/tool/shell.test.ts
--- a/packages/opencode/test/tool/shell.test.ts
+++ b/packages/opencode/test/tool/shell.test.ts
@@ -126,6 +126,7 @@ const glob = (p: string) =>
   process.platform === "win32" ? Filesystem.normalizePathPattern(p) : p.replaceAll("\\", "/")
 
 const forms = (dir: string) => {
+    // #179：ERROR 节点用例主要覆盖 Windows PS
   if (process.platform !== "win32") return [dir]
   const full = Filesystem.normalizePath(dir)
   const slash = full.replaceAll("\\", "/")
@@ -1553,3 +1554,81 @@ describe("tool.shell windows PS stderr and progress", () => {
     )
   }
 })
+
+// #179：PowerShell ERROR 恢复节点上的本地 Unix 工具拒绝/放行
+describe("tool.shell local command ERROR nodes (#179)", () => {
+  // #179：ERROR 节点用例主要覆盖 Windows PS
+  if (process.platform !== "win32") return
+  // #179：无 PS 则跳过
+  if (ps.length === 0) return
+
+  for (const item of ps) {
+    it.live(`rejects local Unix text utilities in PowerShell pipelines [${item.label}]`, () =>
+      withShell(
+        item,
+        runIn(
+          projectRoot,
+          Effect.gen(function* () {
+            // #179：本地管道应拒绝 grep
+            expect(
+              yield* fail({
+                command: "Write-Output ok | grep ok",
+              }),
+            ).toMatchObject({
+              message: expect.stringContaining(`The current shell is ${item.label}`),
+            })
+          }),
+        ),
+      ),
+    )
+  }
+
+  for (const item of ps) {
+    it.live(`allows Unix text utilities inside WSL bash scripts [${item.label}]`, () =>
+      withShell(
+        item,
+        runIn(
+          projectRoot,
+          Effect.gen(function* () {
+            const err = new Error("stop after permission")
+            const requests: Array<Omit<PermissionV1.Request, "id" | "sessionID" | "tool">> = []
+            // #179：WSL 包装内允许 Unix 工具
+            expect(
+              yield* fail(
+                {
+                  command:
+                    "Write-Host before; wsl.exe -d Ubuntu-22.04 -- bash -lc 'set -euo pipefail; echo \"WSL $(cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2-)\"'",
+                },
+                capture(requests, err),
+              ),
+            ).toMatchObject({ message: err.message })
+          }),
+        ),
+      ),
+    )
+  }
+
+  for (const item of ps) {
+    it.live(`allows Unix text utilities inside SSH remote commands [${item.label}]`, () =>
+      withShell(
+        item,
+        runIn(
+          projectRoot,
+          Effect.gen(function* () {
+            const err = new Error("stop after permission")
+            const requests: Array<Omit<PermissionV1.Request, "id" | "sessionID" | "tool">> = []
+            // #179：SSH 远程串内允许 Unix 工具
+            expect(
+              yield* fail(
+                {
+                  command: "ssh example.com 'cat /etc/os-release | grep PRETTY_NAME'",
+                },
+                capture(requests, err),
+              ),
+            ).toMatchObject({ message: err.message })
+          }),
+        ),
+      ),
+    )
+  }
+})
