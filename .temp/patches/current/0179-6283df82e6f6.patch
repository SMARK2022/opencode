         spawn: ((_cmd, _opts) => {
           daemonSpawnCount++
-          return { pid: FAKE_DAEMON_PID, unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
+          return { pid: FAKE_DAEMON_PID,
