       expect(result.url).toBe("http://127.0.0.1:9999")
@@ -224,7 +235,9 @@ describe("tui thread", () => {
         },
         spawn: ((_cmd, _opts) => {
           daemonSpawnCount++
-          return { pid: FAKE_DAEMON_PID, unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
+          return { pid: FAKE_DAEMON_PID,
+          exited: hangingExited(),
+          unref() {}, kill() {} } as ReturnType<typeof Bun.spawn>
         }) as DiscoverDaemonDeps["spawn"],
       }))
       expect(daemonSpawnCount).toBe(1)
@@ -277,7 +290,9 @@ describe("tui thread", () => {
         ping: async () => true,
         clear: async () => {},
         acquire: async () => ({ release: async () => {} }) as never,
-        spawn: () => ({ pid: SPAWN_PID, unref() {}, kill() {} }) as ReturnType<typeof Bun.spawn>,
+        spawn: () => ({ pid: SPAWN_PID,
+          exited: hangingExited(),
+          unref() {}, kill() {} }) as ReturnType<typeof Bun.spawn>,
         sleep: async () => {},
         resolveDaemonFile: async () => "/tmp/daemon.ts",
         electionTimeoutMs: SERVER_ELECTION_TIMEOUT_MS,
@@ -289,3 +304,44 @@ describe("tui thread", () => {
     })
   })
 })
+
+
+// #179：单元覆盖启动前崩溃的快速失败路径
+describe("daemon startup exit (#179)", () => {
+  test("reports daemon worker exit before startup instead of waiting for timeout", async () => {
+    const started = Date.now()
+    let killed = false
+    await expect(
+      discoverOrSpawnDaemon({} as never, {
+                // #179：超时故意很长，证明快速失败不是靠缩短 waitMs
+        waitMs: 60_000,
+        pollMs: 50,
+        electionTimeoutMs: 1000,
+        electionStaleMs: 1000,
+        read: async () => undefined,
+        alive: () => false,
+        ping: async () => false,
+        acquire: async () => ({ release: async () => undefined }),
+        clear: async () => undefined,
+        resolveDaemonFile: async () => "/tmp/fake-daemon.js",
+        spawn: () =>
+          ({
+            pid: 4242,
+                        // #179：模拟启动前崩溃 exit 132
+            exited: Promise.resolve(132),
+            unref() {},
+            kill() {
+              killed = true
+            },
+          }) as never,
+        sleep: async (ms: number) => {
+          await new Promise((r) => setTimeout(r, Math.min(ms, 15)))
+        },
+      } as never),
+    ).rejects.toThrow(/exited before startup with exit code 132/)
+    expect(Date.now() - started).    // #179：必须远快于 60s 超时
+    toBeLessThan(5_000)
+    // #179：进程已退出，不应再 kill
+    expect(killed).toBe(false)
+  })
+})
diff --git a/packages/opencode/test/tool/shell.test.ts b/packages/opencode/test/tool/shell.test.ts
--- a/packages/opencode/test/tool/shell.test.ts
+++ b/packages/opencode/test/tool/shell.test.ts
@@ -126,6 +126,7 @@ const glob = (p: string) =>
   process.platform === "win32" ? Filesystem.normalizePathPattern(p) : p.replaceAll("\\", "/")
 
 const forms = (dir: string) => {
+    // #179：ERROR 节点用例主要覆盖 Windows PS
   if (process.platform !== "win32") return [dir]
   const full = Filesystem.normalizePath(dir)
   const slash = full.replaceAll("\\", "/")
@@ -1553,3 +1554,81 @@ describe("tool.shell windows PS stderr and progress", () => {
     )
   }
 })
+
+// #179：PowerShell ERROR 恢复节点上的本地 Unix 工具拒绝/放行
+describe("tool.shell local command ERROR nodes (#179)", () => {
+  // #179：ERROR 节点用例主要覆盖 Windows PS
+  if (process.platform !== "win32") return
+  // #179：无 PS 则跳过
+  if (ps.length === 0) return
+
+  for (const item of ps) {
+    it.live(`rejects local Unix text utilities in PowerShell pipelines [${item.label}]`, () =>
+      withShell(
+        item,
+        runIn(
+          projectRoot,
+          Effect.gen(function* () {
+            // #179：本地管道应拒绝 grep
+            expect(
+              yield* fail({
+                command: "Write-Output ok | grep ok",
+              }),
+            ).toMatchObject({
+              message: expect.stringContaining(`The current shell is ${item.label}`),
+            })
+          }),
+        ),
+      ),
+    )
+  }
+
+  for (const item of ps) {
+    it.live(`allows Unix text utilities inside WSL bash scripts [${item.label}]`, () =>
+      withShell(
+        item,
+        runIn(
+          projectRoot,
+          Effect.gen(function* () {
+            const err = new Error("stop after permission")
+            const requests: Array<Omit<PermissionV1.Request, "id" | "sessionID" | "tool">> = []
+            // #179：WSL 包装内允许 Unix 工具
+            expect(
+              yield* fail(
+                {
+                  command:
+                    "Write-Host before; wsl.exe -d Ubuntu-22.04 -- bash -lc 'set -euo pipefail; echo \"WSL $(cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2-)\"'",
+                },
+                capture(requests, err),
+              ),
+            ).toMatchObject({ message: err.message })
+          }),
+        ),
+      ),
+    )
+  }
+
+  for (const item of ps) {
+    it.live(`allows Unix text utilities inside SSH remote commands [${item.label}]`, () =>
+      withShell(
+        item,
+        runIn(
+          projectRoot,
+          Effect.gen(function* () {
+            const err = new Error("stop after permission")
+            const requests: Array<Omit<PermissionV1.Request, "id" | "sessionID" | "tool">> = []
+            // #179：SSH 远程串内允许 Unix 工具
+            expect(
+              yield* fail(
+                {
+                  command: "ssh example.com 'cat /etc/os-release | grep PRETTY_NAME'",
+                },
+                capture(requests, err),
+              ),
+            ).toMatchObject({ message: err.message })
+          }),
+        ),
+      ),
+    )
+  }
+})
