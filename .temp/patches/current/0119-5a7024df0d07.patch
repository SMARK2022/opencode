 =?UTF-8?q?=E4=B8=8A=20Bun=20=E5=91=BD=E4=BB=A4=E8=B7=AF=E5=BE=84=E9=97=AE?=
 =?UTF-8?q?=E9=A2=98=EF=BC=8C=E7=A1=AE=E4=BF=9D=E8=84=9A=E6=9C=AC=E6=AD=A3?=

diff --git a/.husky/pre-push b/.husky/pre-push
index 5d3cc53411..d9eb33f7f2 100644
--- a/.husky/pre-push
+++ b/.husky/pre-push
@@ -1,5 +1,18 @@
 #!/bin/sh
 set -e
+
+# #119：Windows Git Bash 可能缺少 Bun PATH，优先补上用户安装目录
+if ! command -v bun >/dev/null 2>&1 && [ -d "$HOME/.bun/bin" ]; then
+  PATH="$HOME/.bun/bin:$PATH"
+  export PATH
+fi
+
+# #119：仍找不到 bun 则明确失败，避免后续脚本抛难读错误
+if ! command -v bun >/dev/null 2>&1; then
+  echo "bun: command not found. Add ~/.bun/bin to PATH or install bun." >&2
+  exit 127
+fi
+
 # Check if bun version matches package.json
 # keep in sync with packages/script/src/index.ts semver qualifier
 bun -e '
diff --git a/packages/script/src/index.ts b/packages/script/src/index.ts
index d148ce0d2b..5e405ce4db 100644
--- a/packages/script/src/index.ts
+++ b/packages/script/src/index.ts
@@ -1,3 +1,5 @@
+// #119：pre-push 在 Windows 上需确保 bun 在 PATH（见 .husky/pre-push）
+// #119：标准用户安装路径为 ~/.bun/bin
 import { $ } from "bun"
 import semver from "semver"
 import path from "path"
