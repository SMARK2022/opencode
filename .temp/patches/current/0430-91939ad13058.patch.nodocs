+      yield* expectFailure(execute({ patchText }, ctx), "Failed to find expected lines")
+      expect(yield* readText(target)).toBe("line1\nline2\t\n")
+  // 两种缩进 trim 后相同但逐字不同，不能让 whole-line trim pass 抢在 substring failure 前成功。
