+        { content: "He said “hello”\n", old: ['He said "hello"'], name: "Unicode punctuation" },
+        { content: "foo", old: ["foo", ""], name: "trailing empty line" },
+      ]
+
+      for (const item of cases) {
+        expect(() =>
+          Patch.deriveNewContentsFromChunks(
