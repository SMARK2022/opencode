From 9768471cf3fc2b91537f5c4c5188be2227dcd12d Mon Sep 17 00:00:00 2001
From: SMARK <3222301373@qq.com>
Date: Mon, 4 May 2026 22:47:55 +0800
Subject: [PATCH] feat: 增强claudecode配置，支持推断Anthropic思维变体并扩展提供者功能

diff --git a/packages/opencode/src/provider/provider.ts b/packages/opencode/src/provider/provider.ts
index 82ceadb99c..4397fbee8b 100644
--- a/packages/opencode/src/provider/provider.ts
+++ b/packages/opencode/src/provider/provider.ts
@@ -181,15 +181,35 @@ function selectBedrockMantleLanguageModel(sdk: BundledSDK, modelID: string) {
   return sdk.responses?.(modelID) ?? sdk.languageModel(modelID)
 }
 
+// 检测 Anthropic extended-thinking 模型（3.7 / Claude 4 系列）
+// Claude 3.7 / 4 系列具备 extended thinking，用于默认 reasoning
+function isAnthropicThinkingModel(modelID: string) {
+  const id = modelID.toLowerCase()
+  return id.includes("claude-3-7") || id.includes("claude-3.7") || /claude-(haiku|sonnet|opus)-4/.test(id)
+}
+
+// claudecode 及 extends 默认走 Anthropic SDK，而非 openai-compatible
+// claudecode（含 baseType）默认 anthropic SDK，其余 openai-compatible
+function defaultConfigProviderNpm(providerID: string, baseType?: string) {
+  if ((baseType ?? providerID) === "claudecode") return "@ai-sdk/anthropic"
+  return "@ai-sdk/openai-compatible"
+}
+
 function custom(dep: CustomDep): Record<string, CustomLoader> {
   return {
     // claudecode 提供者：包装 Anthropic API，注入 Claude Code 风格的计费头和系统块
     claudecode: Effect.fnUntraced(function* (provider: Info) {
       const auth = yield* dep.auth(provider.id)
       const env = yield* dep.env()
-      // 优先使用 ANTHROPIC_AUTH_TOKEN/ANTHROPIC_BASE_URL，兼容 CLAUDECODE_* 环境变量
-      const apiKey = env["ANTHROPIC_AUTH_TOKEN"] || provider.options?.apiKey || env["CLAUDECODE_API_KEY"] || (auth?.type === "api" ? auth.key : undefined)
-      const baseURL = env["ANTHROPIC_BASE_URL"] || provider.options?.baseURL || env["CLAUDECODE_BASE_URL"] || "https://api.cubence.com"
+      // apiKey：env 与 auth 优先于 config options，避免本地 options 覆盖 token
+      // env/auth 优先于 options.apiKey，防止本地配置盖掉真实 token
+const authKey = auth?.type === "api" ? auth.key : undefined
+      const apiKey = env["ANTHROPIC_AUTH_TOKEN"] || env["CLAUDECODE_API_KEY"] || authKey || provider.options?.apiKey
+      const baseURL =
+        env["ANTHROPIC_BASE_URL"] ||
+        provider.options?.baseURL ||
+        env["CLAUDECODE_BASE_URL"] ||
+        "https://api.cubence.com"
 
       const autoload = Boolean(apiKey)
       if (!autoload) return { autoload: false }
@@ -1485,7 +1505,7 @@ const layer = Layer.effect(
               existingModel?.api.npm ??
               modelsDev[baseType ?? providerID]?.npm ??
               // claudecode 模型路由到 @ai-sdk/anthropic 而非默认的 openai-compatible
-              (providerID === "claudecode" ? "@ai-sdk/anthropic" : "@ai-sdk/openai-compatible")
+              defaultConfigProviderNpm(providerID, baseType)
             const name = iife(() => {
               if (model.name) return model.name
               if (model.id && model.id !== modelID) return modelID
@@ -1503,7 +1523,12 @@ const layer = Layer.effect(
               providerID: ProviderV2.ID.make(providerID),
               capabilities: {
                 temperature: model.temperature ?? existingModel?.capabilities.temperature ?? false,
-                reasoning: model.reasoning ?? existingModel?.capabilities.reasoning ?? false,
+                // 未显式配置时：Anthropic thinking 模型默认开启 reasoning 能力
+                reasoning:
+                  model.reasoning ??
+                  existingModel?.capabilities.reasoning ??
+                  // 无显式 reasoning 时按模型 ID 推断 thinking 能力
+(apiNpm === "@ai-sdk/anthropic" && isAnthropicThinkingModel(apiID)),
                 attachment: model.attachment ?? existingModel?.capabilities.attachment ?? false,
                 toolcall: model.tool_call ?? existingModel?.capabilities.toolcall ?? true,
                 input: {
@@ -1610,12 +1635,16 @@ const layer = Layer.effect(
           mergeProvider(providerID, patch)
         }
 
-        for (const [id, fn] of Object.entries(custom(dep))) {
+        // 封装 custom loader 为 Effect.fn，支持 configProviders.extends 复用同一 loader
+        // 先物化 loader 表，供内置与 extends 两次复用
+const customLoaders = custom(dep)
+        // Effect.fn 命名 loadCustom：便于追踪 extends 二次加载
+const loadCustom = Effect.fn("Provider.loadCustom")(function* (id: string, fn: CustomLoader) {
           const providerID = ProviderV2.ID.make(id)
-          if (disabled.has(providerID)) continue
+          if (disabled.has(providerID)) return
           const data = database[providerID]
           if (!data) {
-            continue
+            return
           }
           const result = yield* fn(data)
           if (result && (result.autoload || providers[providerID])) {
@@ -1626,6 +1655,19 @@ const layer = Layer.effect(
             const patch: Partial<Info> = providers[providerID] ? { options: opts } : { source: "custom", options: opts }
             mergeProvider(providerID, patch)
           }
+        })
+
+        for (const [id, fn] of Object.entries(customLoaders)) {
+          yield* loadCustom(id, fn)
+        }
+
+        // extends：用父 custom loader 加载 config 中的派生 provider（如 Cubence extends claudecode）
+        // config.extends：派生 provider 复用父 custom loader（如 Cubence→claudecode）
+for (const [id, provider] of configProviders) {
+          if (!provider.extends) continue
+          const fn = customLoaders[provider.extends]
+          if (!fn) continue
+          yield* loadCustom(id, fn)
         }
 
         // load config - re-apply with updated data
diff --git a/packages/opencode/test/provider/provider.test.ts b/packages/opencode/test/provider/provider.test.ts
index e656890b01..2c139cc635 100644
--- a/packages/opencode/test/provider/provider.test.ts
+++ b/packages/opencode/test/provider/provider.test.ts
@@ -406,6 +406,69 @@ it.instance(
   },
 )
 
+it.instance(
+  // 回归：config 模型应推断 reasoning 与 thinking variants
+"claudecode config models infer Anthropic thinking variants",
+  Effect.gen(function* () {
+    const providers = yield* list
+    const model = providers[ProviderV2.ID.make("claudecode")].models["claude-opus-4-6"]
+    // reasoning 应由 thinking-model 推断为 true，并带上 adaptive/max variants
+    // opus-4 命中 isAnthropicThinkingModel
+expect(model.capabilities.reasoning).toBe(true)
+    expect(model.variants?.low?.thinking?.type).toBe("adaptive")
+    expect(model.variants?.max?.effort).toBe("max")
+  }),
+  {
+    config: {
+      provider: {
+        claudecode: {
+          options: {
+            apiKey: "test-key",
+          },
+          models: {
+            "claude-opus-4-6": {
+              name: "Claude Opus 4.6",
+            },
+          },
+        },
+      },
+    },
+  },
+)
+
+it.instance(
+  // 回归：extends claudecode 应继承 anthropic npm 与 loader fetch
+"provider extending claudecode uses Anthropic SDK and ClaudeCode loader",
+  Effect.gen(function* () {
+    const providers = yield* list
+    const provider = providers[ProviderV2.ID.make("Cubence")]
+    const model = provider.models["claude-opus-4-6"]
+    // extends claudecode：npm 走 anthropic，并继承 loader 注入的 fetch
+    expect(model.api.npm).toBe("@ai-sdk/anthropic")
+    expect(provider.options.baseURL).toBe("https://api-dmit.cubence.com/v1")
+    // loader 注入的 fetch 证明走了 claudecode custom 路径
+expect(typeof provider.options.fetch).toBe("function")
+  }),
+  {
+    config: {
+      provider: {
+        Cubence: {
+          extends: "claudecode",
+          options: {
+            baseURL: "https://api-dmit.cubence.com/v1",
+            apiKey: "test-key",
+          },
+          models: {
+            "claude-opus-4-6": {
+              name: "Claude Opus 4.6",
+            },
+          },
+        },
+      },
+    },
+  },
+)
+
 it.instance(
   "model cost defaults to zero when not specified",
   Effect.gen(function* () {
diff --git a/packages/tui/src/routes/session/index.tsx b/packages/tui/src/routes/session/index.tsx
index af87480770..b1025b4f5c 100644
--- a/packages/tui/src/routes/session/index.tsx
+++ b/packages/tui/src/routes/session/index.tsx
@@ -47,6 +47,7 @@ import type {
 } from "@opencode-ai/sdk/v2"
 import { useLocal } from "../../context/local"
 import { Locale } from "../../util/locale"
+import { createThrottledSignal } from "../../util/signal"
 import { webSearchProviderLabel } from "../../util/tool-display"
 import { useRenderer, useTerminalDimensions, type JSX } from "@opentui/solid"
 import { useSDK } from "../../context/sdk"
@@ -1518,6 +1519,25 @@ function AssistantMessage(props: { message: AssistantMessage; parts: Part[]; las
   const final = createMemo(() => {
     return props.message.finish && !["tool-calls", "unknown"].includes(props.message.finish)
   })
+  // 有真实可见 part 才露 footer，避免空助手气泡先闪元信息
+  // 仅 text/reasoning/tool 视为“有内容”，空助手消息不露 footer
+const visibleParts = createMemo(() => {
+    return props.parts.some((part) => {
+      if (part.type === "text") return part.text.trim().length > 0
+      if (part.type === "reasoning") {
+        // 关闭 thinking 时不把 reasoning 算作可见内容
+if (!ctx.showThinking()) return false
+        return part.text.replace("[REDACTED]", "").trim().length > 0
+      }
+      if (part.type === "tool") return true
+      return false
+    })
+  })
+  // final 或 abort 且有可见内容时才显示模式/模型行
+const footerVisible = createMemo(() => {
+    if (!visibleParts() && !props.message.error) return false
+    return final() || props.message.error?.name === "MessageAbortedError"
+  })
 
   const duration = createMemo(() => {
     if (!final()) return 0
@@ -1587,7 +1607,7 @@ function AssistantMessage(props: { message: AssistantMessage; parts: Part[]; las
         </box>
       </Show>
       <Switch>
-        <Match when={props.last || final() || props.message.error?.name === "MessageAbortedError"}>
+        <Match when={footerVisible()}>
           <box ref={(el: BoxRenderable) => alwaysSeparate.add(el)} paddingLeft={3}>
             <text marginTop={1}>
               <span
@@ -1635,6 +1655,12 @@ function ReasoningPart(props: { last: boolean; part: ReasoningPart; message: Ass
     // OpenRouter encrypts some reasoning blocks; drop the placeholder.
     return props.part.text.replace("[REDACTED]", "").trim()
   })
+  // 50ms 节流：推理流式刷新过密时降低 markdown 重排开销
+  // 50ms 节流推理流，降低 markdown 重排频率
+const [displayContent, setDisplayContent] = createThrottledSignal("", 50)
+  createEffect(() => setDisplayContent(content()))
+  // 首帧无节流值时回退 content，避免空白一帧
+const renderedContent = createMemo(() => displayContent() || content())
   // Reasoning is finalized when the server sets `time.end` (see processor.ts).
   // Flips independently of the parent message completing.
   const isDone = createMemo(() => props.part.time.end !== undefined)
@@ -1643,7 +1669,7 @@ function ReasoningPart(props: { last: boolean; part: ReasoningPart; message: Ass
     const end = props.part.time.end
     return end === undefined ? 0 : Math.max(0, end - props.part.time.start)
   })
-  const summary = createMemo(() => reasoningSummary(content()))
+  const summary = createMemo(() => reasoningSummary(renderedContent()))
   const syntax = createSyntaxStyleMemo(() => generateSubtleSyntax(theme))
 
   const toggle = () => {
@@ -1678,12 +1704,12 @@ function ReasoningPart(props: { last: boolean; part: ReasoningPart; message: Ass
               drawUnstyledText={false}
               streaming={true}
               syntaxStyle={syntax()}
-              content={content().split(String.fromCharCode(10)).slice(0, 5).join(String.fromCharCode(10))}
+              content={renderedContent().split(String.fromCharCode(10)).slice(0, 5).join(String.fromCharCode(10))}
               conceal={ctx.conceal()}
               fg={theme.textMuted}
             />
             {/* 超出预览行时提示可展开；展开仍走 header toggle */}
-            <Show when={content().split(String.fromCharCode(10)).length > 5}>
+            <Show when={renderedContent().split(String.fromCharCode(10)).length > 5}>
               <text fg={theme.textMuted}>▼ 展开查看完整推理</text>
             </Show>
           </box>
