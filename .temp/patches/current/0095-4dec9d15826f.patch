--- /dev/null
+++ b/packages/opencode/src/tool/selection.ts
@@ -0,0 +1,21 @@
+
+import { Wildcard } from "@/util/wildcard"
+
+// 内部支持工具不暴露给模型的活跃工具列表
+const INTERNAL = new Set(["invalid", "_noop", "StructuredOutput"])
+
+export function isUserConfigurable(id: string) {
+  return !INTERNAL.has(id)
+}
+
+export function enabled(id: string, ruleset?: ReadonlyArray<{ permission: string; pattern: string; action: string }>) {
+  // 内部支持工具不暴露给模型，但部分 provider 修复路径仍需其定义保持注册
+  if (!isUserConfigurable(id)) return true
+  // 此处使用精确工具匹配，与权限的 edit/write/apply_patch 分组分离
+  // 因为该检查仅控制模型可见性
+  // findLast 实现 last-match-wins：多条规则匹配时取最后一条决定可见性
+  const rule = ruleset?.findLast((rule) => Wildcard.match(id, rule.permission) && rule.pattern === "*")
+  return rule?.action !== "deny"
+}
+
+export * as ToolSelection from "./selection"
