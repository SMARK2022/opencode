+// 默认 chars-per-token 比率：4 字符约等于 1 token（适用于英文文本）
+export const DEFAULT_CHARS_PER_TOKEN = 4
+
+// 从历史 step-finish 记录中校准 chars-per-token 比率
+// 逆序扫描 assistant 消息的 step-finish 部件，累积 inputChars 和对应的 input/cache token 数
+// 同时停止累积 numerator 和 denominator，保持比率准确
+// 返回校准后的比率；若无历史数据则回退到 DEFAULT_CHARS_PER_TOKEN
+export function charsPerTokenFromHistory(
+  allMessages: readonly any[],
+  getParts: (id: string) => readonly any[],
+): number {
+  let totalChars = 0
+  let totalTokens = 0
+  // 逆序遍历：近期数据更具代表性，累积到 100k 字符即停
+  for (let i = allMessages.length - 1; i >= 0 && totalChars < 100_000; i--) {
+    const msg = allMessages[i]
+    if ((msg.info?.role ?? msg.role) !== "assistant") continue
+    // getParts 接受消息 ID（字符串），不是消息对象
+    const parts = getParts(msg.info?.id ?? msg.id ?? "")
+    for (const p of parts) {
+      if (p.type !== "step-finish") continue
+      const inputChars = (p as any).inputChars
+      const inputTokens =
+        (p.tokens?.input ?? 0) + (p.tokens?.cache?.read ?? 0) + (p.tokens?.cache?.write ?? 0)
+      // 样本不足 100 字符忽略，避免早期噪声主导密度
+      if (typeof inputChars !== "number" || inputChars < 100 || inputTokens <= 0) continue
+      totalChars += inputChars
+      totalTokens += inputTokens
+    }
+  }
+  // 累计不足 500 字符不校准，回落默认 4
+  if (totalTokens === 0 || totalChars <= 500) return DEFAULT_CHARS_PER_TOKEN
+  const ratio = totalChars / totalTokens
+  // 比率合理范围：1~10，超出则使用默认值
+  if (ratio < 1 || ratio > 10 || !Number.isFinite(ratio)) return DEFAULT_CHARS_PER_TOKEN
+  return ratio
 }
 
