+// 守护进程/step-finish 下发的输入细分字符计数（与 schema inputBreakdown 对齐）
+export type InputBreakdown = {
+  system: number
+  instructions: number
+  skills: number
+  tools: number
+  messages: {
+    total: number
+    userText: number
+    assistantText: number
+    reasoning: number
+    toolInput: number
+    toolOutput: number
+    attachments: number
+  }
+}
+
+// 只认 step-finish.inputBreakdown：与 processor 落盘 owner 一致，禁止读 message.info
+function latestBreakdown(raw: Array<{ info: Message; parts: Part[] }>): InputBreakdown | undefined {
+  // 从 step-finish part 读取：producer 写在 part 上，不在 message.info
+  for (const msg of raw.toReversed()) {
+    if (msg.info.role !== "assistant") continue
+    for (const p of msg.parts.toReversed()) {
+      if ((p as { type?: string }).type !== "step-finish") continue
+      const bd = (p as { inputBreakdown?: InputBreakdown }).inputBreakdown
+      if (bd && bd.system >= 0 && bd.messages && bd.messages.total >= 0) return bd
+    }
+  }
+  return undefined
+}
+
+// 支持会话级 chars/token 比率；缺省 4 字符/token
+function estimate(input: unknown, ratio = 4) {
+  const text = typeof input === "string" ? input : stableJson(input)
+  return Math.max(0, Math.round(text.length / ratio))
 }
 
