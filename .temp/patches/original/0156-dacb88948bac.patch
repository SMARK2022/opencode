+verify_checksum_if_possible() {
+    local file_path="$1"
+    local asset_name="$2"
+    local tmp_dir="$3"
+
+    local actual
+    actual=$(sha256_file "$file_path")
+    if [ -z "$actual" ]; then
+        print_message warning "No sha256 tool found; skipping checksum verification."
+        return 0
+    fi
+
+    local checksums_file="${tmp_dir}/checksums.txt"
+    if ! curl -fsSL "${base_url}/checksums.txt" -o "$checksums_file"; then
+        print_message warning "checksums.txt not found; local sha256: $actual"
+        return 0
+    fi
+
+    local expected
+    expected=$(grep -E "[[:space:]]${asset_name}$" "$checksums_file" | awk '{print $1}' | head -n 1 || true)
+    if [ -z "$expected" ]; then
+        print_message warning "No checksum entry for ${asset_name}; local sha256: $actual"
+        return 0
+    fi
+
+    if [ "$expected" != "$actual" ]; then
+        print_message error "Checksum mismatch for ${asset_name}"
+        print_message error "Expected: $expected"
+        print_message error "Actual:   $actual"
+        exit 1
+    fi
+
+    print_message info "${MUTED}Checksum verified: ${NC}$actual"
+}
