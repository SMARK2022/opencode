+          if (task.status === "running" && task.processed > 0 && !aborted) {
+            aborted = true
+            controller.abort()
+          }
+          return Promise.resolve()
+        },
+      }
+      const interrupted = yield* Effect.promise(() =>
+        ColdStorage.maintain(
+          ColdStorage.prepareMaintenance({
+            operation: "compress",
