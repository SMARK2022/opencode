+  return [
+    {
+      info: {
+        id: MessageID.ascending(),
+        sessionID: SessionID.descending() as MessageV2.WithParts["info"]["sessionID"],
+        role: "assistant",
+        time: { created: 0 },
+      } as MessageV2.WithParts["info"],
+      parts,
+    },
+  ]
