+      yield* sessions.updateMessage(old.assistant)
+      yield* addCompletedTool(chat.id, old.assistant.id)
+      yield* addStepFinish(chat.id, old.assistant.id, 12_000, 3_000)
+      yield* SessionCompaction.Service.use((compact) =>
