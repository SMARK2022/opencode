       const result = yield* exec(dir, { filePath: path.join(dir, "image.bin") })
@@ -602,6 +607,16 @@ describe("tool.read truncation", () => {
     }),
   )
 
+  it.live("fails invalid image attachments instead of returning undecodable bytes", () =>
