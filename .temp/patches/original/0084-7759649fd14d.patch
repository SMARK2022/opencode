+async function enqueueBridgeRequest<T>(operation: () => Promise<T>) {
+  const previous = bridgeRequestQueue
+  let release!: () => void
+  bridgeRequestQueue = new Promise<void>((resolve) => {
+    release = resolve
+  })
+  await previous
+  try {
+    return await operation()
+  } finally {
+    release()
+  }
+}
