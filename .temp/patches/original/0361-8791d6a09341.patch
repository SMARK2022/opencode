+                  // DB 的 message.tokens 仍为 0，tokenAccounting 的 stepSF && !msgCompleted
+                  // 分支会取到 stale 0 而非 stepSF.tokens.input。
+                  yield* sessions.updateMessage(persist.message)
+                  return
+                }
                 if (event.type === "error") {
