diff --git a/packages/opencode/test/session/prompt.test.ts b/packages/opencode/test/session/prompt.test.ts
index 49f8e0addde0be7866c582c4551e27578b5ee20d..348a9ca249f477295ba82a2aa827571232426305 100644
--- a/packages/opencode/test/session/prompt.test.ts
+++ b/packages/opencode/test/session/prompt.test.ts
@@ -1855,6 +1855,88 @@ it.instance(
   30_000,
