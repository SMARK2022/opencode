+              temperature: undefined,
+              topP: undefined,
+              topK: undefined,
+              maxOutputTokens: ProviderTransform.maxOutputTokens(model),
+              options,
+            })
+            const headers = yield* plugin.trigger("chat.headers", hookInput, { headers: {} })
             const result = streamText({
