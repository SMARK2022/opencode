+gh run view 35139390176 -R SMARK2022/opencode --job 104939848394 --log
+gh run view 35139390176 -R SMARK2022/opencode --job 104941661013 --log
+gh api 'repos/SMARK2022/opencode/actions/runs/35139390176/jobs?per_page=100'
