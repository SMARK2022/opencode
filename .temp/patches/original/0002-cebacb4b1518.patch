+const HIGH_RISK_EXTENSIONS = new Set(["sh", "py", "js", "ts", "exe", "bat", "ps1", "rb", "psm1", "cmd"])
+
+// 不同文件类型的 token/byte 估算比率
+const TOKEN_BYTE_RATIOS: Record<string, number> = {
+  ts: 0.28,
+  js: 0.28,
+  py: 0.26,
+  rs: 0.27,
+  go: 0.27,
+  java: 0.26,
+  c: 0.27,
+  cpp: 0.27,
+  h: 0.27,
+  hpp: 0.27,
+  md: 0.24,
+  txt: 0.22,
+  json: 0.22,
+  xml: 0.2,
+  html: 0.2,
+  css: 0.22,
+  default: 0.25,
