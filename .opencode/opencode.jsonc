{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "mcp": {
    "chatgpt": {
      "type": "local",
      "command": [
        "D:\\Program Files\\nodejs\\node.exe",
        "F:\\ML\\PythonAIProject\\Claude-Code\\opencode\\.temp\\chatgpt-browser-agent\\mcp-server.js"
