{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  // #278：ChatGPT MCP 本地配置——node 与浏览器路径写死为本机绝对路径，
  // 避免 PATH/环境差异导致 daemon 启动失败；环境变量集中在此便于迁移
  "mcp": {
    "chatgpt": {
      "type": "local",
      "command": [
        "node",
        "F:\\ML\\PythonAIProject\\Claude-Code\\opencode\\.temp\\chatgpt-browser-agent\\mcp-server.js"
      ],
      "environment": {
        "CHATGPT_BROWSER_PATH": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
        "CHATGPT_PROJECT_URL": "https://chatgpt.com/g/g-p-6a1b384bc3688191b5e2c522d45fbe20/project",
        "CHATGPT_STATE_DIR": "F:\\ML\\PythonAIProject\\Claude-Code\\opencode\\.temp\\chatgpt-browser-agent\\.chatgpt-poc",
        "CHATGPT_RESPONSE_TIMEOUT_MS": "300000",
        "CHATGPT_CLI_TIMEOUT_MS": "310000",
        "CHATGPT_DAEMON_START_TIMEOUT_MS": "60000"
      },
      // #278：enabled 显式开启；timeout 覆盖 MCP 连接与工具调用的总上限，
      // 与 CHATGPT_*_TIMEOUT_MS 阶梯一致：daemon 启动 < CLI 调用 < 响应
      "enabled": true,
      "timeout": 320000
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
