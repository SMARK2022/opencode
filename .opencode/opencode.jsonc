{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {
    "bash": {
      "git commit *Guard-Allow-Large*": "ask",
      "git commit *-F*": "ask",
      "git commit *--file*": "ask",
      "git commit *--no-verify*": "ask",
      "git push *--force*": "ask",
    },
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
